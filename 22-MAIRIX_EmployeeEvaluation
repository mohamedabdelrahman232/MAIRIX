/************************************************
 * GENERIC TRANSACTION SCORE
 *
 * Safe baseline:
 * Until the corresponding operational
 * engine exposes a formal KPI, return 0.
 *
 * This prevents fabricated performance data.
 ************************************************/

function getEmployeeTransactionScore(
  employee,
  fromDate,
  toDate,
  transactionType
) {

  /*
   * MAIRIX reference architecture:
   *
   * Employee Evaluation
   *        |
   *        +--> Reports Engine
   *               |
   *               +--> Central Reference
   *
   * The evaluator never edits transaction data.
   */


  if (
    typeof getMAIRIXEmployeeKPI ===
    "function"
  ) {

    return normalizeEvaluationScore(
      getMAIRIXEmployeeKPI(
        employee.employeeId ||
          employee.userId,
        transactionType,
        fromDate,
        toDate
      )
    );

  }


  return 0;

}


/************************************************
 * REFERENCE LOOKUP
 ************************************************/

function getEvaluationReferences(
  transactionType,
  employee,
  fromDate,
  toDate
) {

  if (
    typeof getMAIRIXEmployeeReferences ===
    "function"
  ) {

    const result =
      getMAIRIXEmployeeReferences(
        employee.employeeId ||
          employee.userId,
        transactionType,
        fromDate,
        toDate
      );


    if (Array.isArray(result)) {
      return result;
    }

  }


  return [];

}


/************************************************
 * EMPLOYEE LOOKUP
 ************************************************/

function getMAIRIXEmployee(
  employeeId
) {

  /*
   * USERS is the primary identity source.
   */

  const user =
    getCurrentMAIRIXUser(
      employeeId
    );


  if (user) {

    return {

      employeeId:
        user.userId,

      userId:
        user.userId,

      name:
        user.name,

      role:
        user.role,

      warehouseScope:
        getEmployeeWarehouseScope(
          user.userId
        )

    };

  }


  /*
   * Optional EMPLOYEES sheet.
   */

  if (
    typeof getEmployeeRecord ===
    "function"
  ) {

    return getEmployeeRecord(
      employeeId
    );

  }


  return null;

}


/************************************************
 * WAREHOUSE SCOPE
 ************************************************/

function getEmployeeWarehouseScope(
  userId
) {

  if (
    typeof getUserWarehouseScope ===
    "function"
  ) {

    const scope =
      getUserWarehouseScope(
        userId
      );


    if (scope) {
      return scope;
    }

  }


  return "ALL";

}


/************************************************
 * FACTORS
 ************************************************/

function seedEvaluationFactors(
  sheet
) {

  if (!sheet) {

    throw new Error(
      "Evaluation factors sheet is required."
    );

  }


  /*
   * If factors already exist,
   * do not seed them again.
   */

  if (
    sheet.getLastRow() > 1
  ) {

    return;

  }


  const rows =
    MAIRIX_EVALUATION
      .DEFAULT_FACTORS
      .map(
        function(factor) {

          return [

            factor.code,

            factor.name,

            factor.weight,

            true

          ];

        }
      );


  if (
    rows.length === 0
  ) {

    return;

  }


  sheet
    .getRange(
      2,
      1,
      rows.length,
      4
    )
    .setValues(
      rows
    );

}


function getActiveEvaluationFactors() {

  const sheet =
    mairixgetSheet(
      MAIRIX_EVALUATION
        .FACTORS_SHEET_NAME
    );


  const data =
    getSheetDataAsObjects(
      sheet
    );


  return data
    .filter(
      function(row) {

        return (
          row["Active"] === true
        );

      }
    )
    .map(
      function(row) {

        return {

          code:
            mairixCleanText(
              row["Factor Code"]
            ),

          name:
            mairixCleanText(
              row["Factor Name"]
            ),

          weight:
            Number(
              row["Weight"]
            )

        };

      }
    );

}


/************************************************
 * RATINGS
 ************************************************/

function getEvaluationRating(
  score
) {

  const value =
    Number(score);


  if (value >= 90) {
    return "EXCELLENT";
  }


  if (value >= 80) {
    return "VERY GOOD";
  }


  if (value >= 70) {
    return "GOOD";
  }


  if (value >= 60) {
    return "ACCEPTABLE";
  }


  return "NEEDS IMPROVEMENT";

}


/************************************************
 * FINAL DISPLAY SCORE
 *
 * System and Manager remain visible
 * independently.
 *
 * Display score:
 * 70% System
 * 30% Manager
 ************************************************/

function calculateFinalDisplayScore(
  systemScore,
  managerScore
) {

  return roundMAIRIX(

    Number(systemScore) * 0.70 +

    Number(managerScore) * 0.30,

    2

  );

}


/************************************************
 * DETAILS
 ************************************************/

function writeEvaluationDetails(
  evaluationId,
  employeeId,
  details
) {

  const sheet =
    mairixgetSheet(
      MAIRIX_EVALUATION
        .DETAILS_SHEET_NAME
    );


  details.forEach(
    function(item) {

      sheet.appendRow([

        evaluationId,

        employeeId,

        item.factorCode,

        item.factorName,

        item.weight,

        item.rawValue,

        item.targetValue,

        item.achievement,

        item.factorScore,

        item.weightedScore,

        item.referenceCount,

        item.referenceIds.join(", ")

      ]);

    }
  );

}


/************************************************
 * ID
 ************************************************/

function generateEvaluationId() {

  const date =
    Utilities.formatDate(
      new Date(),
      Session.getScriptTimeZone(),
      "yyyyMMdd"
    );


  const time =
    Utilities.formatDate(
      new Date(),
      Session.getScriptTimeZone(),
      "HHmmss"
    );


  return (
    "EVAL-" +
    date +
    "-" +
    time +
    "-" +
    Utilities.getUuid()
      .substring(
        0,
        8
      )
      .toUpperCase()
  );

}


/************************************************
 * FIND EVALUATION ROW
 ************************************************/

function findEvaluationRow(
  sheet,
  evaluationId
) {

  const lastRow =
    sheet.getLastRow();


  if (lastRow < 2) {
    return -1;
  }


  const column =
    mairixgetColumnNumber(
      sheet,
      "Evaluation ID"
    );


  const values =
    sheet
      .getRange(
        2,
        column,
        lastRow - 1,
        1
      )
      .getDisplayValues();


  for (
    let i = 0;
    i < values.length;
    i++
  ) {

    if (
      mairixCleanText(
        values[i][0]
      ) ===
      evaluationId
    ) {

      return i + 2;

    }

  }


  return -1;

}


/************************************************
 * PERMISSION
 ************************************************/

function requireEvaluationPermission(
  userId,
  action
) {

  /*
   * Prefer dedicated permission.
   */

  if (
    typeof requireERPPermission ===
    "function"
  ) {

    return requireERPPermission(
      userId,
      "EMPLOYEE_EVALUATION",
      action
    );

  }


  /*
   * Fallback to USERS permission
   * only if the dedicated permission
   * has not yet been created.
   */

  return requireUsersEdit(
    userId
  );

}


/************************************************
 * CURRENT USER
 ************************************************/

function requireCurrentMAIRIXUser() {

  if (
    typeof requireCurrentUser ===
    "function"
  ) {

    return requireCurrentUser();

  }


  throw new Error(
    "MAIRIX authentication engine is not available."
  );

}


/************************************************
 * AUDIT
 ************************************************/

function writeMAIRIXEvaluationAudit(
  action,
  reference,
  employeeId,
  details
) {

  try {

    if (
      typeof logAction ===
      "function"
    ) {

      logAction(
        action,
        reference,
        details
      );

      return;

    }


    if (
      typeof writeUserLog ===
      "function"
    ) {

      writeUserLog(
        action,
        reference,
        details
      );

    }

  } catch (error) {

    Logger.log(
      "Evaluation audit failed: " +
      error.message
    );

  }

}


/************************************************
 * HELPERS
 ************************************************/

function getOrCreateMAIRIXSheet(
  ss,
  name
) {

  let sheet =
    ss.getSheetByName(
      name
    );


  if (!sheet) {

    sheet =
      ss.insertSheet(
        name
      );

  }


  return sheet;

}


function initializeSheetHeaders(
  sheet,
  headers
) {

  if (
    sheet.getLastRow() === 0
  ) {

    sheet
      .getRange(
        1,
        1,
        1,
        headers.length
      )
      .setValues([
        headers
      ]);

    return;

  }


  const currentHeaders =
    sheet
      .getRange(
        1,
        1,
        1,
        Math.max(
          sheet.getLastColumn(),
          headers.length
        )
      )
      .getDisplayValues()[0];


  const valid =
    headers.every(
      function(header) {

        return (
          currentHeaders.indexOf(
            header
          ) !== -1
        );

      }
    );


  if (!valid) {

    sheet.clear();

    sheet
      .getRange(
        1,
        1,
        1,
        headers.length
      )
      .setValues([
        headers
      ]);

  }

}


function getSheetHeaders(
  sheet
) {

  return sheet
    .getRange(
      1,
      1,
      1,
      sheet.getLastColumn()
    )
    .getDisplayValues()[0];

}


function requireMAIRIXValue(
  value,
  label
) {

  const text =
    mairixCleanText(
      value
    );


  if (!text) {

    throw new Error(
      label +
      " is required."
    );

  }


  return value;

}


function normalizeEvaluationScore(
  value
) {

  const number =
    Number(value);


  if (
    isNaN(number)
  ) {

    return 0;

  }


  return Math.max(
    0,
    Math.min(
      100,
      number
    )
  );

}


function roundMAIRIX(
  value,
  decimals
) {

  const factor =
    Math.pow(
      10,
      decimals
    );


  return Math.round(
    Number(value) *
      factor
  ) / factor;

}


/************************************************
 * FORMAT
 ************************************************/

function formatEvaluationSheets(
  summary,
  details,
  factors
) {

  [
    summary,
    details,
    factors

  ].forEach(
    function(sheet) {

      sheet.setFrozenRows(1);

      const lastColumn =
        sheet.getLastColumn();


      if (lastColumn > 0) {

        sheet
          .getRange(
            1,
            1,
            1,
            lastColumn
          )
          .setFontWeight(
            "bold"
          );


        sheet.autoResizeColumns(
          1,
          lastColumn
        );

      }

    }
  );

}


