/************************************************
 * CURRENT DATE / TIME
 ************************************************/

function mairixNow() {

  return new Date();

}


/************************************************
 * MAIRIX TIMEZONE
 ************************************************/

function mairixTimeZone() {

  if (
    MAIRIX.TIMEZONE
  ) {

    return MAIRIX.TIMEZONE;

  }

  return Session.getScriptTimeZone();

}


/************************************************
 * MAIRIX DATE KEY
 ************************************************/

function mairixDateKey(
  date
) {

  return Utilities.formatDate(
    date || new Date(),
    mairixTimeZone(),
    MAIRIX.REFERENCE.DATE_FORMAT
  );

}


/************************************************
 * SAFE TEXT
 ************************************************/

function mairixCleanText(
  value
) {

  if (
    value === null ||
    value === undefined
  ) {

    return "";

  }

  return String(value).trim();

}


/************************************************
 * GET SHEET NAME
 ************************************************/

function getMairixSheetName(
  key
) {

  if (
    !key ||
    !MAIRIX.SHEETS[key]
  ) {

    throw new Error(
      "Unknown MAIRIX sheet key: " +
      key
    );

  }

  return MAIRIX.SHEETS[key];

}


/************************************************
 * GET TRANSACTION TYPE
 ************************************************/

function getMairixTransactionType(
  key
) {

  if (
    !key ||
    !MAIRIX.TRANSACTION_TYPES[key]
  ) {

    throw new Error(
      "Unknown MAIRIX transaction type: " +
      key
    );

  }

  return MAIRIX.TRANSACTION_TYPES[key];

}


/************************************************
 * GET REFERENCE PREFIX
 ************************************************/

function getMairixReferencePrefix(
  transactionType
) {

  const normalized =
    mairixCleanText(
      transactionType
    ).toUpperCase();

  const transactionTypes =
    MAIRIX.TRANSACTION_TYPES;

  const prefixes =
    MAIRIX.REFERENCE_PREFIXES;

  for (
    const key in transactionTypes
  ) {

    if (
      transactionTypes[key] ===
      normalized
    ) {

      if (
        prefixes[key]
      ) {

        return prefixes[key];

      }

      break;

    }

  }

  throw new Error(
    "No reference prefix configured for transaction type: " +
    normalized
  );

}


/************************************************
 * GET SETTINGS SHEET
 ************************************************/

function getMairixSettingsSheet() {

  const spreadsheet =
    SpreadsheetApp
      .getActiveSpreadsheet();

  if (!spreadsheet) {

    throw new Error(
      "Active spreadsheet is not available."
    );

  }

  const sheet =
    spreadsheet.getSheetByName(
      MAIRIX.SHEETS.SETTINGS
    );

  if (!sheet) {

    throw new Error(
      "SETTINGS sheet does not exist."
    );

  }

  return sheet;

}


/************************************************
 * GET CENTRAL SETTING
 *
 * SETTINGS:
 *
 * A = Key
 * B = Value
 ************************************************/

function getMairixSetting(
  key
) {

  const normalizedKey =
    mairixCleanText(
      key
    );

  if (!normalizedKey) {

    throw new Error(
      "MAIRIX setting key is required."
    );

  }

  const sheet =
    getMairixSettingsSheet();

  const lastRow =
    sheet.getLastRow();

  if (
    lastRow < 2
  ) {

    return null;

  }

  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        2
      )
      .getDisplayValues();

  for (
    let i = 0;
    i < values.length;
    i++
  ) {

    const currentKey =
      mairixCleanText(
        values[i][0]
      );

    if (
      currentKey ===
      normalizedKey
    ) {

      return values[i][1];

    }

  }

  return null;

}


/************************************************
 * SET CENTRAL SETTING
 ************************************************/

function setMairixSetting(
  key,
  value
) {

  const normalizedKey =
    mairixCleanText(
      key
    );

  if (!normalizedKey) {

    const error =
      new Error(
        "MAIRIX setting key is required."
      );

    Logger.log(
      "=========================================="
    );

    Logger.log(
      "MAIRIX SETTING KEY ERROR"
    );

    Logger.log(
      "Caller stack:"
    );

    Logger.log(
      error.stack
    );

    Logger.log(
      "=========================================="
    );

    throw error;

  }

  const sheet =
    getMairixSettingsSheet();

  const lastRow =
    sheet.getLastRow();

  if (
    lastRow >= 2
  ) {

    const keys =
      sheet
        .getRange(
          2,
          1,
          lastRow - 1,
          1
        )
        .getDisplayValues();

    for (
      let i = 0;
      i < keys.length;
      i++
    ) {

      if (
        mairixCleanText(
          keys[i][0]
        ) ===
        normalizedKey
      ) {

        sheet
          .getRange(
            i + 2,
            2
          )
          .setValue(
            value
          );

        sheet
          .getRange(
            i + 2,
            6
          )
          .setValue(
            new Date()
          );

        return {

          success:
            true,

          updated:
            true,

          key:
            normalizedKey,

          value:
            value

        };

      }

    }

  }

  sheet.appendRow([

    normalizedKey,
    value,
    "",
    "",
    true,
    new Date()

  ]);

  return {

    success:
      true,

    updated:
      false,

    created:
      true,

    key:
      normalizedKey,

    value:
      value

  };

}


/************************************************
 * GET SYSTEM NAME
 ************************************************/

