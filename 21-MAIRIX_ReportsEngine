/************************************************
 * REPORT DATE NORMALIZATION
 ************************************************/

function mairixReportsNormalizeDate(
  value
) {

  if (
    value instanceof Date &&
    !isNaN(value.getTime())
  ) {

    return new Date(
      value.getFullYear(),
      value.getMonth(),
      value.getDate()
    );

  }


  if (
    value === null ||
    value === undefined ||
    String(value).trim() === ""
  ) {

    return null;

  }


  const parsed =
    new Date(value);


  if (
    isNaN(parsed.getTime())
  ) {

    return null;

  }


  return new Date(
    parsed.getFullYear(),
    parsed.getMonth(),
    parsed.getDate()
  );

}


/************************************************
 * REPORT PERIOD
 ************************************************/

function mairixReportsBuildPeriod(
  startDate,
  endDate
) {

  const start =
    mairixReportsNormalizeDate(
      startDate
    );

  const end =
    mairixReportsNormalizeDate(
      endDate
    );


  if (!start || !end) {

    throw new Error(
      "Valid report start date and end date are required."
    );

  }


  if (
    start.getTime() >
    end.getTime()
  ) {

    throw new Error(
      "Report start date cannot be after end date."
    );

  }


  const endInclusive =
    new Date(end);


  endInclusive.setHours(
    23,
    59,
    59,
    999
  );


  return {

    start:
      start,

    end:
      endInclusive

  };

}


/************************************************
 * READ SHEET
 ************************************************/

function mairixReportsGetSheet(
  name
) {

  const ss =
    SpreadsheetApp
      .getActiveSpreadsheet();


  const sheet =
    ss.getSheetByName(
      name
    );


  if (!sheet) {

    return null;

  }


  return sheet;

}


/************************************************
 * READ SHEET OBJECTS
 ************************************************/

function mairixReportsReadSheet(
  sheetName
) {

  const sheet =
    mairixReportsGetSheet(
      sheetName
    );


  if (!sheet) {

    return [];

  }


  const lastRow =
    sheet.getLastRow();


  const lastColumn =
    sheet.getLastColumn();


  if (
    lastRow < 2 ||
    lastColumn < 1
  ) {

    return [];

  }


  const headers =
    sheet
      .getRange(
        1,
        1,
        1,
        lastColumn
      )
      .getDisplayValues()[0]
      .map(
        function(header) {

          return mairixReportsClean(
            header
          );

        }
      );


  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        lastColumn
      )
      .getValues();


  return values.map(
    function(row) {

      const object = {};


      headers.forEach(
        function(header, index) {

          object[header] =
            row[index];

        }
      );


      return object;

    }
  );

}


/************************************************
 * CLEAN
 ************************************************/

function mairixReportsClean(
  value
) {

  if (
    value === null ||
    value === undefined
  ) {

    return "";

  }


  return String(
    value
  ).trim();

}


/************************************************
 * UPPER
 ************************************************/

function mairixReportsUpper(
  value
) {

  return mairixReportsClean(
    value
  ).toUpperCase();

}


/************************************************
 * NUMBER
 ************************************************/

function mairixReportsNumber(
  value
) {

  const number =
    Number(value);


  if (
    isNaN(number)
  ) {

    return 0;

  }


  return number;

}


/************************************************
 * ROUND
 ************************************************/

function mairixReportsRound(
  value
) {

  return Math.round(
    mairixReportsNumber(value) *
    100
  ) / 100;

}


/************************************************
 * TRUE VALUE
 ************************************************/

function mairixReportsIsTrue(
  value
) {

  if (
    value === true
  ) {

    return true;

  }


  const normalized =
    mairixReportsUpper(
      value
    );


  return (
    normalized === "TRUE" ||
    normalized === "YES" ||
    normalized === "Y" ||
    normalized === "1" ||
    normalized === "ACTIVE"
  );

}


/************************************************
 * DATE IN RANGE
 ************************************************/

function mairixReportsDateInRange(
  value,
  startDate,
  endDate
) {

  const date =
    mairixReportsNormalizeDate(
      value
    );


  if (!date) {

    return false;

  }


  const start =
    mairixReportsNormalizeDate(
      startDate
    );

  const end =
    mairixReportsNormalizeDate(
      endDate
    );


  if (!start || !end) {

    return false;

  }


  end.setHours(
    23,
    59,
    59,
    999
  );


  return (
    date.getTime() >=
      start.getTime() &&
    date.getTime() <=
      end.getTime()
  );

}


/************************************************
 * HEADER FINDER
 ************************************************/

function mairixReportsFindHeader(
  object,
  names
) {

  for (
    let i = 0;
    i < names.length;
    i++
  ) {

    const name =
      names[i];


    if (
      object[name] !== undefined
    ) {

      return name;

    }

  }


  return null;

}


/************************************************
 * FIELD VALUE
 ************************************************/

function mairixReportsField(
  object,
  names,
  defaultValue
) {

  const header =
    mairixReportsFindHeader(
      object,
      names
    );


  if (!header) {

    return (
      defaultValue === undefined
        ? ""
        : defaultValue
    );

  }


  return object[header];

}


/************************************************
 * DATE FIELD
 ************************************************/

function mairixReportsDateField(
  object
) {

  return mairixReportsField(
    object,
    [
      "Date",
      "Transaction Date",
      "Sale Date",
      "Purchase Date",
      "Return Date",
      "Collection Date",
      "Payment Date",
      "Expense Date",
      "Created At"
    ],
    null
  );

}


/************************************************
