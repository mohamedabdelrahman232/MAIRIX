/************************************************
 * TAX REPORT
 *
 * FinancialStatements also exposes tax
 * reporting. This operational report gives
 * transaction-level tax detail.
 ************************************************/

function getMAIRIXTaxReport(
  startDate,
  endDate,
  options
) {

  options =
    options || {};


  const period =
    mairixReportsBuildPeriod(
      startDate,
      endDate
    );


  let effects =
    mairixReportsReadSheet(
      MAIRIX_REPORTS.SHEETS.FINANCIAL_EFFECTS
    );


  effects =
    effects.filter(
      function(effect) {

        if (
          !mairixReportsIsPosted(
            effect
          )
        ) {

          return false;

        }


        if (
          !mairixReportsDateInRange(
            effect["Date"],
            period.start,
            period.end
          )
        ) {

          return false;

        }


        if (
          options.taxCode &&
          mairixReportsClean(
            effect["Tax Code"]
          ) !==
          mairixReportsClean(
            options.taxCode
          )
        ) {

          return false;

        }


        if (
          options.warehouseCode &&
          mairixReportsClean(
            effect["Warehouse ID"]
          ) !==
          mairixReportsClean(
            options.warehouseCode
          )
        ) {

          return false;

        }


        return true;

      }
    );


  const grouped = {};


  effects.forEach(
    function(effect) {

      const taxCode =
        mairixReportsClean(
          effect["Tax Code"]
        ) ||
        "UNSPECIFIED";


      if (!grouped[taxCode]) {

        grouped[taxCode] = {

          taxCode:
            taxCode,

          amount:
            0,

          signedAmount:
            0,

          taxEffect:
            0,

          transactionCount:
            0

        };

      }


      grouped[taxCode].amount +=
        mairixReportsNumber(
          effect["Amount"]
        );


      grouped[taxCode].signedAmount +=
        mairixReportsNumber(
          effect["Signed Amount"]
        );


      grouped[taxCode].taxEffect +=
        mairixReportsNumber(
          effect["Tax Effect"]
        );


      grouped[taxCode]
        .transactionCount++;

    }
  );


  return {

    report:
      "TAX",

    period: {

      startDate:
        period.start,

      endDate:
        period.end

    },

    filters:
      options,

    rows:
      Object.keys(grouped)
        .map(
          function(code) {

            const row =
              grouped[code];


            row.amount =
              mairixReportsRound(
                row.amount
              );

            row.signedAmount =
              mairixReportsRound(
                row.signedAmount
              );

            row.taxEffect =
              mairixReportsRound(
                row.taxEffect
              );


            return row;

          }
        ),

    totalTaxEffect:
      mairixReportsRound(
        Object.keys(grouped)
          .reduce(
            function(total, code) {

              return (
                total +
                grouped[code].taxEffect
              );

            },
            0
          )
      )

  };

}


/************************************************
 * CUSTOMER BALANCE REPORT
 *
 * Uses FinancialStatements' centralized
 * receivable effects.
 ************************************************/

function getMAIRIXCustomerBalanceReport(
  asOfDate,
  options
) {

  options =
    options || {};


  const date =
    mairixReportsNormalizeDate(
      asOfDate
    );


  if (!date) {

    throw new Error(
      "Valid customer balance date is required."
    );

  }


  const effects =
    mairixReportsReadSheet(
      MAIRIX_REPORTS.SHEETS.FINANCIAL_EFFECTS
    );


  const grouped = {};


  effects.forEach(
    function(effect) {

      if (
        !mairixReportsIsPosted(
          effect
        )
      ) {

        return;

      }


      const effectDate =
        mairixReportsNormalizeDate(
          effect["Date"]
        );


      if (
        !effectDate ||
        effectDate.getTime() >
        date.getTime()
      ) {

        return;

      }


      const customerCode =
        mairixReportsClean(
          effect["Customer Code"] ||
          effect["Customer ID"] ||
          ""
        );


      /*
       * Some FinancialEngine versions may
       * not store customer code directly.
       *
       * In that case Reference ID remains
       * available for drill-down.
       */

      const code =
        customerCode ||
        "UNSPECIFIED";


      if (!grouped[code]) {

        grouped[code] = {

          customerCode:
            code,

          receivable:
            0

        };

      }


      grouped[code].receivable +=
        mairixReportsNumber(
          effect["Receivable Effect"]
        );

    }
  );


  return {

    report:
      "CUSTOMER_BALANCES",

    asOfDate:
      date,

    filters:
      options,

    rows:
      Object.keys(grouped)
        .map(
          function(code) {

            grouped[code].receivable =
              mairixReportsRound(
                grouped[code].receivable
              );

            return grouped[code];

          }
        )

  };

}


