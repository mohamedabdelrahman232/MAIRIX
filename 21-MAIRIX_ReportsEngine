/************************************************
 * EXPENSES BY CATEGORY
 ************************************************/

function getMAIRIXExpensesByCategory(
  startDate,
  endDate,
  options
) {

  const report =
    getMAIRIXExpensesReport(
      startDate,
      endDate,
      options
    );


  const grouped = {};


  report.rows.forEach(
    function(row) {

      const category =
        mairixReportsClean(
          mairixReportsField(
            row,
            [
              "Classification",
              "Category",
              "Expense Category"
            ],
            "OTHER"
          )
        ) ||
        "OTHER";


      if (!grouped[category]) {

        grouped[category] = {

          category:
            category,

          amount:
            0,

          cashEffect:
            0,

          count:
            0

        };

      }


      grouped[category].count++;


      grouped[category].amount +=
        mairixReportsNumber(
          mairixReportsField(
            row,
            [
              "Signed Amount",
              "Expense Effect",
              "Amount"
            ],
            0
          )
        );


      grouped[category].cashEffect +=
        mairixReportsNumber(
          mairixReportsField(
            row,
            [
              "Cash Effect"
            ],
            0
          )
        );

    }
  );


  return {

    report:
      "EXPENSES_BY_CATEGORY",

    period:
      report.period,

    rows:
      Object.keys(grouped)
        .map(
          function(category) {

            const row =
              grouped[category];


            row.amount =
              mairixReportsRound(
                row.amount
              );


            row.cashEffect =
              mairixReportsRound(
                row.cashEffect
              );


            return row;

          }
        )

  };

}


