 ************************************************/

function getMAIRIXSalesReturnsReport(
  startDate,
  endDate,
  options
) {

  options =
    options || {};


  const period =
    mairixReportsBuildPeriod(
      startDate,
      endDate
    );


  const returns =
    mairixReportsFilterRecords(
      mairixReportsReadSheet(
        MAIRIX_REPORTS.SHEETS.SALES_RETURNS
      ),
      {

        startDate:
          period.start,

        endDate:
          period.end,

        customerCode:
          options.customerCode,

        salesmanCode:
          options.salesmanCode,

        warehouseCode:
          options.warehouseCode,

        postedOnly:
          options.postedOnly

      }
    );


  const net =
    mairixReportsSumSigned(
      returns,
      [
        "Financial Effect",
        "Net Effect",
        "Net Amount"
      ]
    );


  const cash =
    mairixReportsSumSigned(
      returns,
      [
        "Cash Effect"
      ]
    );


  const credit =
    mairixReportsSumSigned(
      returns,
      [
        "Credit Effect"
      ]
    );


  return {

    report:
      "SALES_RETURNS",

    period: {

      startDate:
        period.start,

      endDate:
        period.end

    },

    filters:
      options,

    transactionCount:
      returns.length,

    netEffect:
      net,

    cashEffect:
      cash,

    creditEffect:
      credit,

    inventoryEffect:
      mairixReportsSumSigned(
        returns,
        [
          "Inventory Effect"
        ]
      ),

    loyaltyPointsEffect:
      mairixReportsSumSigned(
        returns,
        [
          "Loyalty Points Effect"
        ]
      ),

    taxEffect:
      mairixReportsSumSigned(
        returns,
        [
          "Tax Effect"
        ]
      ),

    rows:
      returns

  };

}


