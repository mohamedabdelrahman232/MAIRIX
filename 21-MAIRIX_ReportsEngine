/************************************************
 * COMMISSION BY SALESMAN
 ************************************************/

function getMAIRIXCommissionBySalesman(
  startDate,
  endDate,
  options
) {

  const report =
    getMAIRIXCommissionReport(
      startDate,
      endDate,
      options
    );


  const grouped = {};


  report.rows.forEach(
    function(row) {

      const code =
        mairixReportsClean(
          mairixReportsField(
            row,
            [
              "Salesman Code",
              "Salesman ID",
              "Representative Code"
            ],
            "UNASSIGNED"
          )
        );


      if (!grouped[code]) {

        grouped[code] = {

          salesmanCode:
            code,

          salesmanName:
            mairixReportsField(
              row,
              [
                "Salesman Name",
                "Representative Name"
              ],
              ""
            ),

          accrued:
            0,

          paid:
            0,

          remaining:
            0

        };

      }


      const amount =
        mairixReportsNumber(
          mairixReportsField(
            row,
            [
              "Commission Effect",
              "Signed Amount",
              "Amount"
            ],
            0
          )
        );


      const type =
        mairixReportsUpper(
          mairixReportsField(
            row,
            [
              "Transaction Type",
              "Type",
              "Commission Type"
            ],
            ""
          )
        );


      if (
        type.indexOf("PAY") >= 0 ||
        type.indexOf("SETTLE") >= 0
      ) {

        grouped[code].paid +=
          Math.abs(amount);

      } else {

        grouped[code].accrued +=
          amount;

      }

    }
  );


  return {

    report:
      "COMMISSION_BY_SALESMAN",

    period:
      report.period,

    rows:
      Object.keys(grouped)
        .map(
          function(code) {

            const row =
              grouped[code];


            row.accrued =
              mairixReportsRound(
                row.accrued
              );


            row.paid =
              mairixReportsRound(
                row.paid
              );


            row.remaining =
              mairixReportsRound(
                row.accrued -
                row.paid
              );


            return row;

          }
        )

  };

}


