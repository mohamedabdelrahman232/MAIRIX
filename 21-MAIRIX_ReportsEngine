  );

}


/************************************************
 * STATUS FIELD
 ************************************************/

function mairixReportsStatusField(
  object
) {

  return mairixReportsUpper(
    mairixReportsField(
      object,
      [
        "Status",
        "Transaction Status"
      ],
      ""
    )
  );

}


/************************************************
 * ACTIVE RECORD
 ************************************************/

function mairixReportsIsPosted(
  object
) {

  const status =
    mairixReportsStatusField(
      object
    );


  if (!status) {

    return true;

  }


  return (
    status === "POSTED" ||
    status === "ACTIVE"
  );

}


/************************************************
 * FILTER COMMON RECORDS
 ************************************************/

function mairixReportsFilterRecords(
  records,
  options
) {

  options =
    options || {};


  return records.filter(
    function(record) {

      if (
        options.postedOnly !== false &&
        !mairixReportsIsPosted(record)
      ) {

        return false;

      }


      if (
        options.startDate ||
        options.endDate
      ) {

        if (
          !mairixReportsDateInRange(
            mairixReportsDateField(record),
            options.startDate,
            options.endDate
          )
        ) {

          return false;

        }

      }


      const filters = [

        [
          options.customerCode,
          [
            "Customer Code",
            "Customer ID"
          ]
        ],

        [
          options.vendorCode,
          [
            "Vendor Code",
            "Vendor ID",
            "Supplier Code"
          ]
        ],

        [
          options.salesmanCode,
          [
            "Salesman Code",
            "Salesman ID",
            "Representative Code"
          ]
        ],

        [
          options.warehouseCode,
          [
            "Warehouse Code",
            "Warehouse ID"
          ]
        ],

        [
          options.itemCode,
          [
            "Item Code",
            "Product Code",
            "SKU"
          ]
        ],

        [
          options.userId,
          [
            "User ID",
            "Created By",
            "Posted By"
          ]
        ]

      ];


      for (
        let i = 0;
        i < filters.length;
        i++
      ) {

        const filter =
          filters[i];


        if (
          filter[0] === undefined ||
          filter[0] === null ||
          mairixReportsClean(
            filter[0]
          ) === ""
        ) {

          continue;

        }


        const actual =
          mairixReportsClean(
            mairixReportsField(
              record,
              filter[1],
              ""
            )
          );


        if (
          actual !==
          mairixReportsClean(
            filter[0]
          )
        ) {

          return false;

        }

      }


      return true;

    }
  );

}


/************************************************
 * GENERIC SIGNED SUM
 ************************************************/

function mairixReportsSumSigned(
  records,
  fieldNames
) {

  let total = 0;


  records.forEach(
    function(record) {

      total +=
        mairixReportsNumber(
          mairixReportsField(
            record,
            fieldNames,
            0
          )
        );

    }
  );


  return mairixReportsRound(
    total
  );

}


/************************************************
 * GENERIC QUANTITY SUM
 ************************************************/

function mairixReportsSumQuantity(
  records
) {

  return mairixReportsSumSigned(
    records,
    [
      "Quantity Effect",
      "Signed Quantity",
      "Inventory Effect",
      "Quantity"
    ]
  );

}


/************************************************
 * INVENTORY MOVEMENT REPORT
 ************************************************/

function getMAIRIXInventoryMovementReport(
  startDate,
  endDate,
  options
) {

  options =
    options || {};


  const period =
    mairixReportsBuildPeriod(
      startDate,
      endDate
    );


  let movements =
    mairixReportsReadSheet(
      MAIRIX_REPORTS.SHEETS.INVENTORY_MOVEMENTS
    );


  if (
    movements.length === 0
  ) {

    movements =
      mairixReportsReadSheet(
        MAIRIX_REPORTS.SHEETS.INVENTORY
      );

  }


  movements =
    mairixReportsFilterRecords(
      movements,
      {

        startDate:
          period.start,

        endDate:
          period.end,

        warehouseCode:
          options.warehouseCode,

        itemCode:
          options.itemCode,

        userId:
          options.userId,

        postedOnly:
          options.postedOnly

      }
    );


  const result = {

    report:
      "INVENTORY_MOVEMENT",

    period: {

      startDate:
        period.start,

      endDate:
        period.end

    },

    filters:
      options,

    totalQuantityEffect:
      mairixReportsSumSigned(
        movements,
        [
          "Quantity Effect",
          "Signed Quantity"
        ]
      ),

    totalInventoryEffect:
      mairixReportsSumSigned(
        movements,
        [
          "Inventory Effect",
          "Signed Inventory Value"
        ]
      ),

    rows:
      movements

  };


  return result;

}


/************************************************
 * INVENTORY MOVEMENT BY ITEM
 ************************************************/

function getMAIRIXInventoryMovementByItem(
  startDate,
  endDate,
  options
) {

  const report =
    getMAIRIXInventoryMovementReport(
      startDate,
      endDate,
      options
    );


  const grouped = {};


  report.rows.forEach(
    function(row) {

      const itemCode =
        mairixReportsClean(
          mairixReportsField(
            row,
            [
              "Item Code",
              "Product Code",
              "SKU"
            ],
            "UNKNOWN"
          )
        );


      if (!grouped[itemCode]) {

        grouped[itemCode] = {

          itemCode:
            itemCode,

          itemName:
            mairixReportsField(
              row,
              [
                "Item Name",
                "Product Name"
              ],
              ""
            ),

          quantityEffect:
            0,

          inventoryEffect:
            0

        };

      }


      grouped[itemCode]
        .quantityEffect +=
        mairixReportsNumber(
          mairixReportsField(
            row,
            [
              "Quantity Effect",
              "Signed Quantity"
            ],
            0
          )
        );


      grouped[itemCode]
        .inventoryEffect +=
        mairixReportsNumber(
          mairixReportsField(
            row,
            [
              "Inventory Effect",
              "Signed Inventory Value"
            ],
            0
          )
        );

    }
  );


  return {

    report:
      "INVENTORY_MOVEMENT_BY_ITEM",

    period:
      report.period,

    filters:
      options || {},

    rows:
      Object.keys(grouped)
        .map(
          function(code) {

            grouped[code]
              .quantityEffect =
              mairixReportsRound(
                grouped[code]
                  .quantityEffect
              );

            grouped[code]
              .inventoryEffect =
              mairixReportsRound(
                grouped[code]
                  .inventoryEffect
              );

            return grouped[code];

          }
        )

  };

}


/************************************************
 * SALES REPORT
 ************************************************/

function getMAIRIXSalesReport(
  startDate,
  endDate,
  options
) {

  options =
    options || {};


  const period =
    mairixReportsBuildPeriod(
      startDate,
      endDate
    );


  let sales =
    mairixReportsReadSheet(
      MAIRIX_REPORTS.SHEETS.SALES
    );


  sales =
    mairixReportsFilterRecords(
      sales,
      {

        startDate:
          period.start,

        endDate:
          period.end,

        customerCode:
          options.customerCode,

        salesmanCode:
          options.salesmanCode,

        warehouseCode:
          options.warehouseCode,

        userId:
          options.userId,

        postedOnly:
          options.postedOnly

      }
    );


  const result = {

    report:
      "SALES",

    period: {

      startDate:
        period.start,

      endDate:
        period.end

    },

    filters:
      options,

    transactionCount:
      sales.length,

    grossSales:
      mairixReportsSumSigned(
        sales,
        [
          "Gross Amount",
          "Gross Total"
        ]
      ),

    discounts:
      mairixReportsSumSigned(
        sales,
        [
          "Discount Amount",
          "Total Discount"
        ]
      ),

    netSales:
      mairixReportsSumSigned(
        sales,
        [
          "Net Amount",
          "Net Total"
        ]
      ),

    tax:
      mairixReportsSumSigned(
        sales,
        [
          "Total Tax",
          "Tax Amount"
        ]
      ),

    cashEffect:
      mairixReportsSumSigned(
        sales,
        [
          "Cash Effect"
        ]
      ),

    creditEffect:
      mairixReportsSumSigned(
        sales,
        [
          "Credit Effect",
          "Receivable Effect"
        ]
      ),

    rows:
      sales

  };


  result.totalWithTax =
    mairixReportsRound(
      result.netSales +
      result.tax
    );


  return result;

}


/************************************************
 * SALES BY SALESMAN
 ************************************************/

function getMAIRIXSalesBySalesman(
  startDate,
  endDate,
  options
) {

  const report =
    getMAIRIXSalesReport(
      startDate,
      endDate,
      options
    );


  const grouped = {};


  report.rows.forEach(
    function(row) {

      const code =
        mairixReportsClean(
          mairixReportsField(
            row,
            [
              "Salesman Code",
              "Salesman ID"
            ],
            "UNASSIGNED"
          )
        );


      if (!grouped[code]) {

        grouped[code] = {

          salesmanCode:
            code,

          salesmanName:
            mairixReportsField(
              row,
              [
                "Salesman Name",
                "Representative Name"
              ],
              ""
            ),

          transactionCount:
            0,

          netSales:
            0,

          cashEffect:
            0,

          creditEffect:
            0

        };

      }


      const group =
        grouped[code];


      group.transactionCount++;


      group.netSales +=
        mairixReportsNumber(
          mairixReportsField(
            row,
            [
              "Net Amount",
              "Net Total"
            ],
            0
          )
        );


      group.cashEffect +=
        mairixReportsNumber(
          mairixReportsField(
            row,
            [
              "Cash Effect"
            ],
            0
          )
        );


      group.creditEffect +=
        mairixReportsNumber(
          mairixReportsField(
            row,
            [
              "Credit Effect",
              "Receivable Effect"
            ],
            0
          )
        );

    }
  );


  Object.keys(grouped)
    .forEach(
      function(code) {

        grouped[code].netSales =
          mairixReportsRound(
            grouped[code].netSales
          );

        grouped[code].cashEffect =
          mairixReportsRound(
            grouped[code].cashEffect
          );

        grouped[code].creditEffect =
          mairixReportsRound(
            grouped[code].creditEffect
          );

      }
    );


  return {

    report:
      "SALES_BY_SALESMAN",

    period:
      report.period,

    filters:
      options || {},

    rows:
      Object.keys(grouped)
        .map(
          function(code) {

            return grouped[code];

          }
        )

  };

}


