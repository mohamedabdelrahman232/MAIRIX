/************************************************
 * TRANSACTION REFERENCE REPORT
 ************************************************/

function getMAIRIXTransactionReferenceReport(
  reference
) {

  const normalized =
    mairixReportsClean(
      reference
    );


  if (!normalized) {

    throw new Error(
      "Transaction reference is required."
    );

  }


  /*
   * First try FinancialStatements'
   * centralized drill-down.
   */

  if (
    typeof getMAIRIXFinancialReferenceDetails ===
    "function"
  ) {

    const details =
      getMAIRIXFinancialReferenceDetails(
        normalized
      );


    if (
      details &&
      details.length
    ) {

      return {

        report:
          "TRANSACTION_REFERENCE",

        reference:
          normalized,

        effects:
          details

      };

    }

  }


  /*
   * Fallback:
   * search all operational sheets.
   */

  const sheets = [

    MAIRIX_REPORTS.SHEETS.SALES,

    MAIRIX_REPORTS.SHEETS.SALES_RETURNS,

    MAIRIX_REPORTS.SHEETS.PURCHASES,

    MAIRIX_REPORTS.SHEETS.PURCHASE_RETURNS,

    MAIRIX_REPORTS.SHEETS.CUSTOMER_COLLECTIONS,

    MAIRIX_REPORTS.SHEETS.VENDOR_PAYMENTS,

    MAIRIX_REPORTS.SHEETS.EXPENSES,

    MAIRIX_REPORTS.SHEETS.COMMISSIONS,

    MAIRIX_REPORTS.SHEETS.LOYALTY

  ];


  const result = [];


  sheets.forEach(
    function(sheetName) {

      const rows =
        mairixReportsReadSheet(
          sheetName
        );


      rows.forEach(
        function(row) {

          const referenceValue =
            mairixReportsClean(
              mairixReportsReferenceField(
                row
              )
            );


          const central =
            mairixReportsClean(
              mairixReportsField(
                row,
                [
                  "Central Reference"
                ],
                ""
              )
            );


          if (
            referenceValue === normalized ||
            central === normalized
          ) {

            result.push({

              sheet:
                sheetName,

              row:
                row

            });

          }

        }
      );

    }
  );


  return {

    report:
      "TRANSACTION_REFERENCE",

    reference:
      normalized,

    records:
      result

  };

}


/************************************************
 * TRANSACTION ACTIVITY REPORT
 ************************************************/

function getMAIRIXTransactionActivityReport(
  startDate,
  endDate,
  options
) {

  options =
    options || {};


  const period =
    mairixReportsBuildPeriod(
      startDate,
      endDate
    );


  const sources = [

    {
      type:
        "SALE",

      sheet:
        MAIRIX_REPORTS.SHEETS.SALES
    },

    {
      type:
        "SALES_RETURN",

      sheet:
        MAIRIX_REPORTS.SHEETS.SALES_RETURNS
    },

    {
      type:
        "PURCHASE",

      sheet:
        MAIRIX_REPORTS.SHEETS.PURCHASES
    },

    {
      type:
        "PURCHASE_RETURN",

      sheet:
        MAIRIX_REPORTS.SHEETS.PURCHASE_RETURNS
    },

    {
      type:
        "CUSTOMER_COLLECTION",

      sheet:
        MAIRIX_REPORTS.SHEETS.CUSTOMER_COLLECTIONS
    },

    {
      type:
        "VENDOR_PAYMENT",

      sheet:
        MAIRIX_REPORTS.SHEETS.VENDOR_PAYMENTS
    },

    {
      type:
        "EXPENSE",

      sheet:
        MAIRIX_REPORTS.SHEETS.EXPENSES
    },

    {
      type:
        "COMMISSION",

      sheet:
        MAIRIX_REPORTS.SHEETS.COMMISSIONS
    },

    {
      type:
        "LOYALTY",

      sheet:
        MAIRIX_REPORTS.SHEETS.LOYALTY
    }

  ];


  const rows = [];


  sources.forEach(
    function(source) {

      const records =
        mairixReportsReadSheet(
          source.sheet
        );


      records.forEach(
        function(record) {

          if (
            !mairixReportsIsPosted(
              record
            )
          ) {

            return;

          }


          if (
            !mairixReportsDateInRange(
              mairixReportsDateField(
                record
              ),
              period.start,
              period.end
            )
          ) {

            return;

          }


          rows.push({

            transactionType:
              source.type,

            reference:
              mairixReportsReferenceField(
                record
              ),

            date:
              mairixReportsDateField(
                record
              ),

            customerCode:
              mairixReportsField(
                record,
                [
                  "Customer Code"
                ],
                ""
              ),

            vendorCode:
              mairixReportsField(
                record,
                [
                  "Vendor Code"
                ],
                ""
              ),

            salesmanCode:
              mairixReportsField(
                record,
                [
                  "Salesman Code"
                ],
                ""
              ),

            warehouseCode:
              mairixReportsField(
                record,
                [
                  "Warehouse Code",
                  "Warehouse ID"
                ],
                ""
              ),

            amount:
              mairixReportsField(
                record,
                [
                  "Net Amount",
                  "Amount",
                  "Total Amount"
                ],
                0
              ),

            record:
              record

          });

        }
      );

    }
  );


  rows.sort(
    function(a, b) {

      const aDate =
        new Date(a.date || 0)
          .getTime();

      const bDate =
        new Date(b.date || 0)
          .getTime();


      return (
        aDate -
        bDate
      );

    }
  );


  return {

    report:
      "TRANSACTION_ACTIVITY",

    period: {

      startDate:
        period.start,

      endDate:
        period.end

    },

    filters:
      options,

    transactionCount:
      rows.length,

    rows:
      rows

  };

}


