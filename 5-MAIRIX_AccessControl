/************************************************
 * NORMALIZE WAREHOUSE LIST
 ************************************************/

function mairixNormalizeWarehouseCodes(
  warehouseCodes
) {

  if (!warehouseCodes) return [];

  if (!Array.isArray(warehouseCodes)) {

    warehouseCodes =
      [warehouseCodes];

  }

  var result = [];
  var seen = {};

  for (
    var i = 0;
    i < warehouseCodes.length;
    i++
  ) {

    var code =
      mairixAccessNormalizeCode(
        warehouseCodes[i]
      );

    if (!code) continue;

    if (seen[code]) continue;

    seen[code] = true;

    result.push(code);

  }

  return result;

}


/************************************************
 * VALIDATE WAREHOUSES
 ************************************************/

function mairixValidateWarehouseAssignments(
  warehouseCodes
) {

  warehouseCodes =
    mairixNormalizeWarehouseCodes(
      warehouseCodes
    );

  for (
    var i = 0;
    i < warehouseCodes.length;
    i++
  ) {

    var warehouse =
      mairixGetWarehouseByCode(
        warehouseCodes[i]
      );

    if (!warehouse) {

      throw new Error(
        "Warehouse not found: " +
        warehouseCodes[i]
      );

    }

    if (warehouse.active !== true) {

      throw new Error(
        "Warehouse is inactive: " +
        warehouseCodes[i]
      );

    }

  }

  return true;

}


/************************************************
 * CREATE EMPLOYEE + USER
 *
 * ONE SYSTEMATIC ACTION
 ************************************************/

function mairixCreateEmployee(input) {

  if (
    !input ||
    typeof input !== "object"
  ) {

    throw new Error(
      "Employee input is required."
    );

  }

  var lock =
    LockService.getScriptLock();

  lock.waitLock(30000);

  try {

    var employeeName =
      mairixAccessCleanText(
        input.name ||
        input.employeeName
      );

    var email =
      mairixAccessNormalizeEmail(
        input.email
      );

    var phone =
      mairixAccessCleanText(
        input.phone
      );

    var jobTitleCode =
      mairixAccessNormalizeCode(
        input.jobTitleCode
      );

    var password =
      mairixAccessCleanText(
        input.password
      );

    var confirmPassword =
      mairixAccessCleanText(
        input.confirmPassword
      );

    var warehouseCodes =
      mairixNormalizeWarehouseCodes(
        input.warehouseCodes
      );


    if (!employeeName) {

      throw new Error(
        "Employee name is required."
      );

    }

    if (!email) {

      throw new Error(
        "Employee email is required."
      );

    }

    if (
      !/^[^\s@]+@[^\s@]+\.[^\s@]+$/
        .test(email)
    ) {

      throw new Error(
        "Invalid employee email."
      );

    }

    if (!phone) {

      throw new Error(
        "Employee phone is required."
      );

    }

    if (!jobTitleCode) {

      throw new Error(
        "Job Title is required."
      );

    }


    if (
      mairixGetUserByEmail(email)
    ) {

      throw new Error(
        "Email is already registered: " +
        email
      );

    }


    var jobTitle =
      mairixGetJobTitleByCode(
        jobTitleCode
      );

    if (!jobTitle) {

      throw new Error(
        "Job Title not found: " +
        jobTitleCode
      );

    }

    if (jobTitle.active !== true) {

      throw new Error(
        "Job Title is inactive: " +
        jobTitleCode
      );

    }


    var role =
      mairixGetRoleByCode(
        jobTitle.roleCode
      );

    if (!role) {

      throw new Error(
        "Role not found for Job Title: " +
        jobTitle.roleCode
      );

    }

    if (role.active !== true) {

      throw new Error(
        "Role is inactive: " +
        role.roleCode
      );

    }


    mairixValidateWarehouseAssignments(
      warehouseCodes
    );


    if (password || confirmPassword) {

      mairixValidatePassword(
        password,
        confirmPassword
      );

    }


    var employeeCode =
      mairixGenerateAccessCode(
        MAIRIX_ACCESS.PREFIX.EMPLOYEE,
        MAIRIX_ACCESS.SHEETS.EMPLOYEES,
        "Employee Code"
      );


    var userId =
      mairixGenerateAccessCode(
        MAIRIX_ACCESS.PREFIX.USER,
        MAIRIX_ACCESS.SHEETS.USERS,
        "User ID"
      );


    var now = new Date();


    mairixAccessAppendObject(
      MAIRIX_ACCESS.SHEETS.EMPLOYEES,
      {

        "Employee Code":
          employeeCode,

        "Employee Name":
          employeeName,

        "Gmail":
          email,

        "Phone":
          phone,

        "Job Title Code":
          jobTitle.jobTitleCode,

        "Job Title":
          jobTitle.jobTitleName,

        "Department":
          jobTitle.department,

        "Active":
          true,

        "Created At":
          now,

        "Updated At":
          now

      }
    );


    mairixAccessAppendObject(
      MAIRIX_ACCESS.SHEETS.USERS,
      {

        "User ID":
          userId,

        "Employee Code":
          employeeCode,

        "Gmail":
          email,

        "Name":
          employeeName,

        "Role Code":
          role.roleCode,

        "Role Name":
          role.roleName,

        "Current Password":
          password || "",

        "Previous Password":
          "",

        "Password Last Changed At":
          password ? now : "",

        "Password Change Required":
          password ? false : true,

        "Active":
          true,

        "Created At":
          now,

        "Updated At":
          now

      }
    );


    for (
      var i = 0;
      i < warehouseCodes.length;
      i++
    ) {

      mairixAssignUserWarehouse(
        userId,
        warehouseCodes[i]
      );

    }


    return {

      success: true,

      employee: {

        employeeCode:
          employeeCode,

        employeeName:
          employeeName,

        email:
          email,

        phone:
          phone,

        jobTitleCode:
          jobTitle.jobTitleCode,

        jobTitle:
          jobTitle.jobTitleName,

        department:
          jobTitle.department,

        active:
          true

      },

      user: {

        userId:
          userId,

        employeeCode:
          employeeCode,

        userName:
          employeeName,

        email:
          email,

        roleCode:
          role.roleCode,

        roleName:
          role.roleName,

        active:
          true

      },

      role: role,

      warehouses:
        warehouseCodes,

      createdAt:
        now.toISOString()

    };

  }

  finally {

    lock.releaseLock();

  }

}


/************************************************
 * PASSWORD VALIDATION
 *
 * ACCEPTED:
 *
 * 6 digits
 * OR
 * 1 letter + 6 digits
 *
 * DIGITS MUST NOT BE:
 *
 * - repeated
 * - sequential
 ************************************************/

function mairixValidatePassword(
  password,
  confirmPassword
) {

  password =
    mairixAccessCleanText(password);

  confirmPassword =
    mairixAccessCleanText(
      confirmPassword
    );

  if (!password) {

    throw new Error(
      "Password is required."
    );

  }

  if (
    password !== confirmPassword
  ) {

    throw new Error(
      "Password confirmation does not match."
    );

  }


  var digits = password;

  if (
    /^[A-Za-z]\d{6}$/.test(password)
  ) {

    digits =
      password.substring(1);

  }
  else if (
    !/^\d{6}$/.test(password)
  ) {

    throw new Error(
      "Password must be 6 digits or 1 letter followed by 6 digits."
    );

  }


  var seen = {};

  for (
    var i = 0;
    i < digits.length;
    i++
  ) {

    if (seen[digits[i]]) {

      throw new Error(
        "Password digits must not repeat."
      );

    }

    seen[digits[i]] = true;

  }


  var ascending = true;
  var descending = true;

  for (
    var j = 1;
    j < digits.length;
    j++
  ) {

    var previous =
      parseInt(
        digits[j - 1],
        10
      );

    var current =
      parseInt(
        digits[j],
        10
      );

    if (
      current !== previous + 1
    ) {

      ascending = false;

    }

    if (
      current !== previous - 1
    ) {

      descending = false;

    }

  }


  if (
    ascending ||
    descending
  ) {

    throw new Error(
      "Password digits must not be sequential."
    );

  }

  return true;

}


/************************************************
 * CHANGE PASSWORD
 ************************************************/

function mairixChangeUserPassword(
  userId,
  currentPassword,
  newPassword,
  confirmPassword
) {

  var user =
    mairixGetUserById(userId);

  if (!user) {

    throw new Error(
      "User not found: " + userId
    );

  }

  if (
    user["Current Password"] !==
    currentPassword
  ) {

    throw new Error(
      "Current password is incorrect."
    );

  }

  mairixValidatePassword(
    newPassword,
    confirmPassword
  );


  mairixAccessUpdateObject(
    MAIRIX_ACCESS.SHEETS.USERS,
    user.__rowNumber,
    {

      "Previous Password":
        user["Current Password"],

      "Current Password":
        newPassword,

      "Password Last Changed At":
        new Date(),

      "Password Change Required":
        false,

      "Updated At":
        new Date()

    }
  );


  return {

    success: true,

    userId:
      mairixAccessNormalizeCode(userId)

  };

}


/************************************************
 * RESET PASSWORD
 *
 * ADMIN / AUTHORIZED CALLER
 ************************************************/

function mairixResetUserPassword(
  userId,
  newPassword,
  confirmPassword
) {

  var user =
    mairixGetUserById(userId);

  if (!user) {

    throw new Error(
      "User not found: " + userId
    );

  }

  mairixValidatePassword(
    newPassword,
    confirmPassword
  );


  mairixAccessUpdateObject(
    MAIRIX_ACCESS.SHEETS.USERS,
    user.__rowNumber,
    {

      "Previous Password":
        user["Current Password"],

      "Current Password":
        newPassword,

      "Password Last Changed At":
        new Date(),

