 ************************************************/

function mairixLogin(
  email,
  password
) {

  var user =
    mairixGetUserByEmail(
      email
    );

  if (!user) {

    throw new Error(
      "Invalid email or password."
    );

  }

  if (
    !mairixAccessIsTrue(
      user["Active"]
    )
  ) {

    throw new Error(
      "User account is inactive."
    );

  }

  if (
    mairixAccessCleanText(
      user["Current Password"]
    ) !==
    mairixAccessCleanText(password)
  ) {

    throw new Error(
      "Invalid email or password."
    );

  }

  return setCurrentMAIRIXUser(
    user["User ID"]
  );

}


