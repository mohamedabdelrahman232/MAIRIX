/************************************************
 * ASSIGN USER TO WAREHOUSE
 ************************************************/

function mairixAssignUserWarehouse(
  userId,
  warehouseCode
) {

  var normalizedUser =
    mairixAccessNormalizeCode(
      userId
    );

  var normalizedWarehouse =
    mairixAccessNormalizeCode(
      warehouseCode
    );


  var user =
    mairixGetUserById(
      normalizedUser
    );

  if (!user) {

    throw new Error(
      "User not found: " +
      normalizedUser
    );

  }


  var warehouse =
    mairixGetWarehouseByCode(
      normalizedWarehouse
    );

  if (!warehouse) {

    throw new Error(
      "Warehouse not found: " +
      normalizedWarehouse
    );

  }

  if (warehouse.active !== true) {

    throw new Error(
      "Warehouse is inactive: " +
      normalizedWarehouse
    );

  }


  var sheet =
    mairixAccessGetRequiredSheet(
      MAIRIX_ACCESS.SHEETS.USER_WAREHOUSES
    );

  var rows =
    mairixAccessReadSheetObjects(sheet);


  for (
    var i = 0;
    i < rows.length;
    i++
  ) {

    if (
      mairixAccessNormalizeCode(
        rows[i]["User ID"]
      ) === normalizedUser &&
      mairixAccessNormalizeCode(
        rows[i]["Warehouse Code"]
      ) === normalizedWarehouse
    ) {

      mairixAccessUpdateObject(
        MAIRIX_ACCESS.SHEETS.USER_WAREHOUSES,
        rows[i].__rowNumber,
        {

          "Employee Code":
            user["Employee Code"],

          "Warehouse Name":
            warehouse.warehouseName,

          "Active":
            true,

          "Updated At":
            new Date()

        }
      );

      return {

        success: true,
        action: "REACTIVATED",

        userId:
          normalizedUser,

        warehouseCode:
          normalizedWarehouse,

        warehouseName:
          warehouse.warehouseName

      };

    }

  }


  mairixAccessAppendObject(
    MAIRIX_ACCESS.SHEETS.USER_WAREHOUSES,
    {

      "User ID":
        normalizedUser,

      "Employee Code":
        user["Employee Code"],

      "Warehouse Code":
        normalizedWarehouse,

      "Warehouse Name":
        warehouse.warehouseName,

      "Active":
        true,

      "Created At":
        new Date(),

      "Updated At":
        new Date()

    }
  );


  return {

    success: true,
    action: "ASSIGNED",

    userId:
      normalizedUser,

    employeeCode:
      user["Employee Code"],

    warehouseCode:
      normalizedWarehouse,

    warehouseName:
      warehouse.warehouseName

  };

}


/************************************************
 * GET USER WAREHOUSES
 ************************************************/

function mairixGetUserWarehouses(
  userId
) {

  var target =
    mairixAccessNormalizeCode(
      userId
    );

  var sheet =
    mairixAccessGetRequiredSheet(
      MAIRIX_ACCESS.SHEETS.USER_WAREHOUSES
    );

  var rows =
    mairixAccessReadSheetObjects(sheet);

  var result = [];

  for (
    var i = 0;
    i < rows.length;
    i++
  ) {

    if (
      mairixAccessNormalizeCode(
        rows[i]["User ID"]
      ) !== target
    ) {

      continue;

    }

    if (
      !mairixAccessIsTrue(
        rows[i]["Active"]
      )
    ) {

      continue;

    }

    result.push({

      userId:
        target,

      employeeCode:
        mairixAccessCleanText(
          rows[i]["Employee Code"]
        ),

      warehouseCode:
        mairixAccessNormalizeCode(
          rows[i]["Warehouse Code"]
        ),

      warehouseName:
        mairixAccessCleanText(
          rows[i]["Warehouse Name"]
        ),

      active:
        true

    });

  }

  return result;

}


/************************************************
 * REQUIRE WAREHOUSE ACCESS
 ************************************************/

function mairixRuntimeHasWarehouseAccess(
  userId,
  warehouseCode
) {

  var normalizedWarehouse =
    mairixAccessNormalizeCode(
      warehouseCode
    );

  var warehouses =
    mairixGetUserWarehouses(
      userId
    );

  for (
    var i = 0;
    i < warehouses.length;
    i++
  ) {

    if (
      warehouses[i].warehouseCode ===
      normalizedWarehouse
    ) {

      return true;

    }

  }

  return false;

}


function mairixRuntimeRequireWarehouseAccess(
  userId,
  warehouseCode
) {

  if (
    !mairixRuntimeHasWarehouseAccess(
      userId,
      warehouseCode
    )
  ) {

    throw new Error(
      "Warehouse access denied: " +
      warehouseCode
    );

  }

  return true;

}


/************************************************
 * SESSION
 ************************************************/

function setCurrentMAIRIXUser(
  userId
) {

  var normalized =
    mairixAccessNormalizeCode(
      userId
    );

  if (!normalized) {

    throw new Error(
      "User ID is required."
    );

  }

  var user =
    mairixGetUserById(
      normalized
    );

  if (!user) {

    throw new Error(
      "MAIRIX user not found: " +
      normalized
    );

  }

  if (
    !mairixAccessIsTrue(
      user["Active"]
    )
  ) {

    throw new Error(
      "MAIRIX user is inactive: " +
      normalized
    );

  }

  PropertiesService
    .getUserProperties()
    .setProperty(
      MAIRIX_ACCESS.SESSION_PROPERTY,
      normalized
    );

  return mairixNormalizeCurrentUser(
    user
  );

}


function clearCurrentMAIRIXUser() {

  PropertiesService
    .getUserProperties()
    .deleteProperty(
      MAIRIX_ACCESS.SESSION_PROPERTY
    );

  return {
    success: true
  };

}


function getCurrentMAIRIXUser() {

  var userId =
    PropertiesService
      .getUserProperties()
      .getProperty(
        MAIRIX_ACCESS.SESSION_PROPERTY
      );

  if (!userId) {

    return null;

  }

  var user =
    mairixGetUserById(
      userId
    );

  if (!user) {

    clearCurrentMAIRIXUser();

    return null;

  }

  if (
    !mairixAccessIsTrue(
      user["Active"]
    )
  ) {

    clearCurrentMAIRIXUser();

    return null;

  }

  return mairixNormalizeCurrentUser(
    user
  );

}


