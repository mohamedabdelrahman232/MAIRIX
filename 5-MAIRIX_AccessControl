/************************************************
 * MAIRIX ERP
 * 5-MAIRIX_AccessControl.gs
 *
 * CENTRAL IDENTITY + ACCESS CONTROL ENGINE
 *
 * =================================================
 * SINGLE SOURCE OF TRUTH
 * =================================================
 *
 * EMPLOYEE
 *      ↓
 * USER
 *      ↓
 * ROLE
 *      ↓
 * ROLE_PERMISSIONS
 *      ↓
 * RUNTIME AUTHORIZATION
 *
 * SEPARATELY:
 *
 * USER
 *      ↓
 * USER_WAREHOUSES
 *      ↓
 * WAREHOUSE ACCESS
 *
 * IMPORTANT:
 *
 * EMPLOYEES DO NOT CONTROL PERMISSIONS.
 * USERS CONTROL IDENTITY.
 * ROLES CONTROL DEFAULT PERMISSIONS.
 * USER_WAREHOUSES CONTROL WHERE THE USER WORKS.
 *
 ************************************************/


/************************************************
 * CONFIGURATION
 ************************************************/

var MAIRIX_ACCESS = Object.freeze({

  SHEETS: {

    EMPLOYEES: "EMPLOYEES",
    USERS: "USERS",

    JOB_TITLES: "JOB_TITLES",

    ROLES: "ROLES",
    PERMISSIONS: "PERMISSIONS",
    ROLE_PERMISSIONS: "ROLE_PERMISSIONS",

    USER_WAREHOUSES: "USER_WAREHOUSES",
    WAREHOUSES: "WAREHOUSES",

    DISCOUNT_LIMITS: "DISCOUNT_LIMITS"

  },

  PREFIX: {

    EMPLOYEE: "EMP",
    USER: "USR"

  },

  CODE_WIDTH: 7,

  SESSION_PROPERTY:
    "MAIRIX_CURRENT_USER_ID"

});


/************************************************
 * ACTIONS
 ************************************************/

var MAIRIX_ACCESS_ACTIONS = Object.freeze({

  VIEW: "VIEW",
  CREATE: "CREATE",
  EDIT: "EDIT",
  DELETE: "DELETE",
  EXPORT: "EXPORT"

});


/************************************************
 * BASIC HELPERS
 ************************************************/

function mairixAccessCleanText(value) {

  if (
    value === null ||
    value === undefined
  ) {
    return "";
  }

  return String(value).trim();

}


function mairixAccessNormalizeCode(value) {

  return mairixAccessCleanText(value)
    .toUpperCase();

}


function mairixAccessNormalizeEmail(value) {

  return mairixAccessCleanText(value)
    .toLowerCase();

}


function mairixAccessIsTrue(value) {

  if (value === true) return true;
  if (value === 1) return true;

  var normalized =
    mairixAccessCleanText(value)
      .toUpperCase();

  return (
    normalized === "TRUE" ||
    normalized === "1" ||
    normalized === "YES" ||
    normalized === "Y"
  );

}


function isMAIRIXTrueValue(value) {

  return mairixAccessIsTrue(value);

}


/************************************************
 * REQUIRED SPREADSHEET
 ************************************************/

function mairixAccessGetSpreadsheet() {

  var ss =
    SpreadsheetApp.getActiveSpreadsheet();

  if (!ss) {

    throw new Error(
      "MAIRIX spreadsheet is not available."
    );

  }

  return ss;

}


/************************************************
 * REQUIRED SHEET
 ************************************************/

function mairixAccessGetRequiredSheet(sheetName) {

  var sheet =
    mairixAccessGetSpreadsheet()
      .getSheetByName(sheetName);

  if (!sheet) {

    throw new Error(
      "Required sheet not found: " +
      sheetName
    );

  }

  return sheet;

}


/************************************************
 * GET SHEET HEADERS
 ************************************************/

function mairixAccessGetHeaders(sheet) {

  if (!sheet) {

    throw new Error(
      "Sheet is required."
    );

  }

  if (sheet.getLastColumn() < 1) {

    throw new Error(
      "Sheet has no columns: " +
      sheet.getName()
    );

  }

  return sheet
    .getRange(
      1,
      1,
      1,
      sheet.getLastColumn()
    )
    .getDisplayValues()[0]
    .map(function(header) {

      return mairixAccessCleanText(header);

    });

}


/************************************************
 * REQUIRE HEADER
 ************************************************/

function mairixAccessRequireHeader(
  headers,
  headerName,
  sheetName
) {

  var index =
    headers.indexOf(headerName);

  if (index === -1) {

    throw new Error(
      "Required header missing: " +
      sheetName +
      " -> " +
      headerName
    );

  }

  return index;

}


/************************************************
 * READ SHEET AS OBJECTS
 ************************************************/

function mairixAccessReadSheetObjects(sheet) {

  var lastRow =
    sheet.getLastRow();

  var lastColumn =
    sheet.getLastColumn();

  if (
    lastRow < 2 ||
    lastColumn < 1
  ) {

    return [];

  }

  var headers =
    mairixAccessGetHeaders(sheet);

  var values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        lastColumn
      )
      .getDisplayValues();

  var result = [];

  for (
    var i = 0;
    i < values.length;
    i++
  ) {

    var row = {};
    var hasData = false;

    for (
      var j = 0;
      j < headers.length;
      j++
    ) {

      row[headers[j]] =
        values[i][j];

      if (
        mairixAccessCleanText(
          values[i][j]
        )
      ) {
        hasData = true;
      }

    }

    if (hasData) {

      row.__rowNumber = i + 2;

      result.push(row);

    }

  }

  return result;

}


/************************************************
 * APPEND OBJECT TO SHEET
 ************************************************/

function mairixAccessAppendObject(
  sheetName,
  object
) {

  var sheet =
    mairixAccessGetRequiredSheet(
      sheetName
    );

  var headers =
    mairixAccessGetHeaders(sheet);

  var row = [];

  for (
    var i = 0;
    i < headers.length;
    i++
  ) {

    var header =
      headers[i];

    var value =
      Object.prototype.hasOwnProperty.call(
        object,
        header
      )
        ? object[header]
        : "";

    row.push(value);

  }

  sheet.appendRow(row);

  return sheet.getLastRow();

}


/************************************************
 * UPDATE OBJECT ROW
 ************************************************/

function mairixAccessUpdateObject(
  sheetName,
  rowNumber,
  object
) {

  var sheet =
    mairixAccessGetRequiredSheet(
      sheetName
    );

  var headers =
    mairixAccessGetHeaders(sheet);

  var current =
    sheet
      .getRange(
        rowNumber,
        1,
        1,
        headers.length
      )
      .getValues()[0];

  for (
    var i = 0;
    i < headers.length;
    i++
  ) {

    var header =
      headers[i];

    if (
      Object.prototype.hasOwnProperty.call(
        object,
        header
      )
    ) {

      current[i] =
        object[header];

    }

  }

  sheet
    .getRange(
      rowNumber,
      1,
      1,
      headers.length
    )
    .setValues([current]);

}


/************************************************
 * GENERATE IDENTITY CODE
 *
 * EMP-0000001
 * USR-0000001
 ************************************************/

function mairixGenerateAccessCode(
  prefix,
  sheetName,
  codeHeader
) {

  var sheet =
    mairixAccessGetRequiredSheet(
      sheetName
    );

  var headers =
    mairixAccessGetHeaders(sheet);

  var codeIndex =
    mairixAccessRequireHeader(
      headers,
      codeHeader,
      sheetName
    );

  var lastRow =
    sheet.getLastRow();

  var maxNumber = 0;

  if (lastRow >= 2) {

    var values =
      sheet
        .getRange(
          2,
          codeIndex + 1,
          lastRow - 1,
          1
        )
        .getDisplayValues();

    var pattern =
      new RegExp(
        "^" +
        prefix +
        "-(\\d+)$",
        "i"
      );

    for (
      var i = 0;
      i < values.length;
      i++
    ) {

      var match =
        mairixAccessCleanText(
          values[i][0]
        ).match(pattern);

      if (!match) continue;

      var number =
        parseInt(
          match[1],
          10
        );

      if (
        !isNaN(number) &&
        number > maxNumber
      ) {

        maxNumber = number;

      }

    }

  }

  var next =
    maxNumber + 1;

  return (
    prefix +
    "-" +
    String(next).padStart(
      MAIRIX_ACCESS.CODE_WIDTH,
      "0"
    )
  );

}


/************************************************
 * EMPLOYEE LOOKUP
 ************************************************/

function mairixGetEmployeeByCode(
  employeeCode
) {

  var target =
    mairixAccessNormalizeCode(
      employeeCode
    );

  if (!target) return null;

  var sheet =
    mairixAccessGetRequiredSheet(
      MAIRIX_ACCESS.SHEETS.EMPLOYEES
    );

  var rows =
    mairixAccessReadSheetObjects(sheet);

  for (
    var i = 0;
    i < rows.length;
    i++
  ) {

    if (
      mairixAccessNormalizeCode(
        rows[i]["Employee Code"]
      ) === target
    ) {

      return rows[i];

    }

  }

  return null;

}


