/************************************************
 * REQUIRE PERMISSION
 ************************************************/

function mairixRuntimeRequirePermission(
  userId,
  permissionCode,
  action
) {

  var allowed =
    mairixRuntimeHasPermission(
      userId,
      permissionCode,
      action
    );

  if (!allowed) {

    mairixRuntimeRecordRejection(
      userId,
      permissionCode,
      "PERMISSION_DENIED:" +
      String(action || "")
    );

    throw new Error(
      "Permission denied: " +
      permissionCode +
      " / " +
      action
    );

  }

  return true;

}


