/************************************************
 * REQUIRE CURRENT USER
 ************************************************/

function requireCurrentUser() {

  var user =
    getCurrentMAIRIXUser();

  if (
    !user ||
    !user.userId
  ) {

    throw new Error(
      "MAIRIX authentication engine is not available."
    );

  }

  return user;

}


/************************************************
 * NORMALIZE USER
 ************************************************/

function mairixNormalizeCurrentUser(
  user
) {

  if (!user) {

    throw new Error(
      "Invalid current user."
    );

  }

  var userId =
    mairixAccessCleanText(
      user.userId ||
      user["User ID"]
    );

  var employeeCode =
    mairixAccessCleanText(
      user.employeeCode ||
      user["Employee Code"]
    );

  var roleCode =
    mairixAccessNormalizeCode(
      user.roleCode ||
      user["Role Code"] ||
      user.role
    );

  var roleName =
    mairixAccessCleanText(
      user.roleName ||
      user["Role Name"]
    );

  var userName =
    mairixAccessCleanText(
      user.userName ||
      user["Name"]
    );

  var email =
    mairixAccessNormalizeEmail(
      user.email ||
      user["Gmail"]
    );


  if (!userId) {

    throw new Error(
      "Current user has no User ID."
    );

  }

  return {

    userId:
      userId,

    employeeCode:
      employeeCode,

    userName:
      userName,

    email:
      email,

    role:
      roleCode,

    roleCode:
      roleCode,

    roleName:
      roleName,

    active:
      true

  };

}


/************************************************
 * CURRENT USER ROLE
 ************************************************/

function mairixRuntimeResolveRole(
  userId
) {

  var user =
    mairixGetUserById(
      userId
    );

  if (!user) {

    throw new Error(
      "User not found: " +
      userId
    );

  }

  if (
    !mairixAccessIsTrue(
      user["Active"]
    )
  ) {

    throw new Error(
      "User is inactive: " +
      userId
    );

  }

  var roleCode =
    mairixAccessNormalizeCode(
      user["Role Code"]
    );

  if (!roleCode) {

    throw new Error(
      "User has no Role Code: " +
      userId
    );

  }

  var role =
    mairixGetRoleByCode(
      roleCode
    );

  if (!role) {

    throw new Error(
      "Role not found: " +
      roleCode
    );

  }

  if (role.active !== true) {

    throw new Error(
      "Role is inactive: " +
      roleCode
    );

  }

  return role;

}


/************************************************
 * PERMISSION LOOKUP
 *
 * ONE ROW =
 *
 * Role Code
 * Permission Code
 *
 * Then:
 *
 * View
 * Create
 * Edit
 * Delete
 * Export
 * Active
 *
 ************************************************/

function mairixRuntimeGetRolePermission(
  roleCode,
  permissionCode
) {

  var normalizedRole =
    mairixAccessNormalizeCode(
      roleCode
    );

  var normalizedPermission =
    mairixAccessNormalizeCode(
      permissionCode
    );

  var sheet =
    mairixAccessGetRequiredSheet(
      MAIRIX_ACCESS.SHEETS.ROLE_PERMISSIONS
    );

  var rows =
    mairixAccessReadSheetObjects(sheet);

  for (
    var i = 0;
    i < rows.length;
    i++
  ) {

    if (
      mairixAccessNormalizeCode(
        rows[i]["Role Code"]
      ) !== normalizedRole
    ) {

      continue;

    }

    if (
      mairixAccessNormalizeCode(
        rows[i]["Permission Code"]
      ) !== normalizedPermission
    ) {

      continue;

    }

    return rows[i];

  }

  return null;

}


/************************************************
 * ACTION COLUMN
 ************************************************/

function mairixRuntimeGetActionColumn(
  action
) {

  var normalized =
    mairixAccessNormalizeCode(
      action
    );

  var map = {

    VIEW: "View",
    CREATE: "Create",
    EDIT: "Edit",
    DELETE: "Delete",
    EXPORT: "Export"

  };

  if (!map[normalized]) {

    throw new Error(
      "Invalid permission action: " +
      action
    );

  }

  return map[normalized];

}


/************************************************
 * RUNTIME HAS PERMISSION
 ************************************************/

function mairixRuntimeHasPermission(
  userId,
  permissionCode,
  action
) {

  try {

    var role =
      mairixRuntimeResolveRole(
        userId
      );

    var permission =
      mairixRuntimeGetRolePermission(
        role.roleCode,
        permissionCode
      );

    if (!permission) {

      return false;

    }

    if (
      !mairixAccessIsTrue(
        permission["Active"]
      )
    ) {

      return false;

    }

    var column =
      mairixRuntimeGetActionColumn(
        action
      );

    return mairixAccessIsTrue(
      permission[column]
    );

  }
  catch (error) {

    return false;

  }

}


