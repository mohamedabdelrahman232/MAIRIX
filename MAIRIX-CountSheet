const MAIRIX_COUNT_STATUS=Object.freeze({DRAFT:'DRAFT',OPEN:'OPEN',SUBMITTED:'SUBMITTED',UNDER_REVIEW:'UNDER_REVIEW',VALIDATED:'VALIDATED',POSTED:'POSTED',CANCELLED:'CANCELLED'});
function mairixCountSheet(n,h){const s=SpreadsheetApp.getActive();let x=s.getSheetByName(n);if(!x)x=s.insertSheet(n);if(x.getLastRow()===0)x.appendRow(h);return x;}
function mairixEnsureCountSheets(){mairixCountSheet('COUNT_REQUESTS',['COUNT_ID','COUNT_SERIAL','COUNT_DATE','WAREHOUSE_ID','STATUS','CREATED_BY','CREATED_AT','UPDATED_BY','UPDATED_AT','VALIDATED_BY','VALIDATED_AT','POSTED_BY','POSTED_AT','NOTES']);mairixCountSheet('COUNT_ASSIGNMENTS',['ASSIGNMENT_ID','COUNT_ID','EMPLOYEE_ID','STATUS','ASSIGNED_BY','ASSIGNED_AT','SUBMITTED_AT','COMMENT','UPDATED_AT']);mairixCountSheet('PHYSICAL_COUNT_LINES',['LINE_ID','COUNT_ID','ASSIGNMENT_ID','ITEM_ID','BARCODE','SYSTEM_QTY','PHYSICAL_QTY','VARIANCE_QTY','STATUS','COUNTED_BY','COUNTED_AT','UPDATED_AT']);mairixCountSheet('COUNT_CONSOLIDATION',['COUNT_ID','ITEM_ID','BARCODE','SYSTEM_QTY','FINAL_PHYSICAL_QTY','VARIANCE_QTY','UNIT_COST','VARIANCE_VALUE','STATUS','REVIEWED_BY','REVIEWED_AT','NOTES']);mairixCountSheet('INVENTORY_ADJUSTMENTS',['ADJUSTMENT_ID','COUNT_ID','REFERENCE_ID','ITEM_ID','QTY_EFFECT','UNIT_COST','INVENTORY_VALUE_EFFECT','FINANCIAL_EFFECT','STATUS','POSTED_BY','POSTED_AT']);}
function mairixCountId(){return 'CNT-'+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyy')+'-'+Utilities.getUuid().replace(/-/g,'').slice(0,10).toUpperCase();}
function mairixFindRowObject(sn,key,val){const sh=SpreadsheetApp.getActive().getSheetByName(sn);if(!sh||sh.getLastRow()<2)return null;const d=sh.getDataRange().getValues(),h=d[0],c=h.indexOf(key);for(let r=1;r<d.length;r++)if(String(d[r][c])===String(val)){const o={};h.forEach((k,i)=>o[k]=d[r][i]);return o;}return null;}
function mairixCreateInventoryCount(p,actor){mairixEnsureCountSheets();p=p||{};if(!p.countDate||!p.warehouseId)throw new Error('Count date and warehouse are required.');const id=mairixCountId(),now=new Date(),serial=typeof mairixGenerateNextCode==='function'?mairixGenerateNextCode('INVENTORY_COUNT'):id;mairixCountSheet('COUNT_REQUESTS',[]).appendRow([id,serial,new Date(p.countDate),p.warehouseId,'DRAFT',actor||'',now,actor||'',now,'','','','',p.notes||'']);return mairixFindRowObject('COUNT_REQUESTS','COUNT_ID',id);}
function mairixSetCountStatus(id,status,actor){const sh=mairixCountSheet('COUNT_REQUESTS',[]),d=sh.getDataRange().getValues(),h=d[0],c=h.indexOf('COUNT_ID');for(let r=1;r<d.length;r++)if(String(d[r][c])===String(id)){sh.getRange(r+1,h.indexOf('STATUS')+1).setValue(status);sh.getRange(r+1,h.indexOf('UPDATED_BY')+1).setValue(actor||'');sh.getRange(r+1,h.indexOf('UPDATED_AT')+1).setValue(new Date());return mairixFindRowObject('COUNT_REQUESTS','COUNT_ID',id);}throw new Error('Count request not found.');}
function mairixGetSheetObjects(sn){const sh=SpreadsheetApp.getActive().getSheetByName(sn);if(!sh||sh.getLastRow()<2)return [];const d=sh.getDataRange().getValues(),h=d[0];return d.slice(1).filter(r=>r.some(v=>v!==''&&v!==null)).map(r=>{const o={};h.forEach((k,i)=>o[k]=r[i]);return o;});}
function mairixAssignCountEmployee(countId,employeeId,actor){const c=mairixFindRowObject('COUNT_REQUESTS','COUNT_ID',countId);if(!c)throw new Error('Count not found.');const id='CAS-'+Utilities.getUuid().replace(/-/g,'').slice(0,10).toUpperCase();mairixCountSheet('COUNT_ASSIGNMENTS',[]).appendRow([id,countId,employeeId,'ASSIGNED',actor||'',new Date(),'','',new Date()]);return mairixFindRowObject('COUNT_ASSIGNMENTS','ASSIGNMENT_ID',id);}
function mairixGetCountAssignments(id){return mairixGetSheetObjects('COUNT_ASSIGNMENTS').filter(x=>String(x.COUNT_ID)===String(id));}
function mairixSubmitCountAssignment(id,employeeId,comment){const a=mairixFindRowObject('COUNT_ASSIGNMENTS','ASSIGNMENT_ID',id);if(!a||String(a.EMPLOYEE_ID)!==String(employeeId))throw new Error('Unauthorized assignment.');const sh=SpreadsheetApp.getActive().getSheetByName('COUNT_ASSIGNMENTS'),d=sh.getDataRange().getValues(),h=d[0],c=h.indexOf('ASSIGNMENT_ID');for(let r=1;r<d.length;r++)if(String(d[r][c])===String(id)){sh.getRange(r+1,h.indexOf('STATUS')+1).setValue('SUBMITTED');sh.getRange(r+1,h.indexOf('SUBMITTED_AT')+1).setValue(new Date());sh.getRange(r+1,h.indexOf('COMMENT')+1).setValue(comment||'');}const all=mairixGetCountAssignments(a.COUNT_ID);if(all.length&&all.every(x=>x.STATUS==='SUBMITTED'))mairixSetCountStatus(a.COUNT_ID,'SUBMITTED',employeeId);return mairixFindRowObject('COUNT_ASSIGNMENTS','ASSIGNMENT_ID',id);}
function mairixRecordPhysicalCountLine(p,employeeId){p=p||{};const a=mairixFindRowObject('COUNT_ASSIGNMENTS','ASSIGNMENT_ID',p.assignmentId);if(!a||String(a.EMPLOYEE_ID)!==String(employeeId)||a.STATUS==='SUBMITTED')throw new Error('Unauthorized or locked assignment.');if(p.itemId===undefined||p.physicalQty===undefined)throw new Error('Item and physical quantity are required.');const id='PCL-'+Utilities.getUuid().replace(/-/g,'').slice(0,12).toUpperCase(),sys=Number(p.systemQty||0),qty=Number(p.physicalQty);mairixCountSheet('PHYSICAL_COUNT_LINES',[]).appendRow([id,a.COUNT_ID,a.ASSIGNMENT_ID,p.itemId,p.barcode||'',sys,qty,qty-sys,'COUNTED',employeeId,new Date(),new Date()]);return mairixFindRowObject('PHYSICAL_COUNT_LINES','LINE_ID',id);}
function mairixGetPhysicalCountLines(countId,assignmentId){return mairixGetSheetObjects('PHYSICAL_COUNT_LINES').filter(x=>String(x.COUNT_ID)===String(countId)&&(!assignmentId||String(x.ASSIGNMENT_ID)===String(assignmentId)));}
function mairixConsolidateInventoryCount(countId,actor){const lines=mairixGetPhysicalCountLines(countId);if(!lines.length)throw new Error('No count lines found.');const sh=mairixCountSheet('COUNT_CONSOLIDATION',[]),all=mairixGetSheetObjects('COUNT_CONSOLIDATION'),d=sh.getDataRange().getValues(),h=d[0],cc=h.indexOf('COUNT_ID');for(let r=d.length-1;r>=1;r--)if(String(d[r][cc])===String(countId))sh.deleteRow(r+1);const g={};lines.forEach(l=>{const k=String(l.ITEM_ID);if(!g[k])g[k]={i:l.ITEM_ID,b:l.BARCODE,s:Number(l.SYSTEM_QTY||0),q:0};g[k].q+=Number(l.PHYSICAL_QTY||0);});Object.keys(g).forEach(k=>{const x=g[k];sh.appendRow([countId,x.i,x.b,x.s,x.q,x.q-x.s,'','','CONSOLIDATED',actor||'',new Date(),'']);});mairixSetCountStatus(countId,'UNDER_REVIEW',actor);return mairixGetSheetObjects('COUNT_CONSOLIDATION').filter(x=>String(x.COUNT_ID)===String(countId));}
function mairixGetInventoryVarianceCost(itemId,warehouseId,date){if(typeof mairixGetWeightedAverageCost==='function')return Number(mairixGetWeightedAverageCost(itemId,warehouseId,date)||0);return 0;}
function mairixCalculateInventoryVariances(countId,actor){const c=mairixFindRowObject('COUNT_REQUESTS','COUNT_ID',countId),sh=mairixCountSheet('COUNT_CONSOLIDATION',[]),d=sh.getDataRange().getValues(),h=d[0];let shortage=0,surplus=0;for(let r=1;r<d.length;r++)if(String(d[r][h.indexOf('COUNT_ID')])===String(countId)){const q=Number(d[r][h.indexOf('FINAL_PHYSICAL_QTY')])-Number(d[r][h.indexOf('SYSTEM_QTY')]),cost=mairixGetInventoryVarianceCost(d[r][h.indexOf('ITEM_ID')],c.WAREHOUSE_ID,c.COUNT_DATE),v=q*cost;sh.getRange(r+1,h.indexOf('VARIANCE_QTY')+1).setValue(q);sh.getRange(r+1,h.indexOf('UNIT_COST')+1).setValue(cost);sh.getRange(r+1,h.indexOf('VARIANCE_VALUE')+1).setValue(v);if(v<0)shortage+=Math.abs(v);else surplus+=v;}return {countId,totalShortageValue:shortage,totalSurplusValue:surplus,netVarianceValue:surplus-shortage};}
function mairixValidateInventoryCount(countId,actor){const c=mairixFindRowObject('COUNT_REQUESTS','COUNT_ID',countId);if(!c||c.STATUS!=='UNDER_REVIEW')throw new Error('Count must be under review.');mairixCalculateInventoryVariances(countId,actor);const sh=SpreadsheetApp.getActive().getSheetByName('COUNT_REQUESTS'),d=sh.getDataRange().getValues(),h=d[0],col=h.indexOf('COUNT_ID');for(let r=1;r<d.length;r++)if(String(d[r][col])===String(countId)){sh.getRange(r+1,h.indexOf('STATUS')+1).setValue('VALIDATED');sh.getRange(r+1,h.indexOf('VALIDATED_BY')+1).setValue(actor||'');sh.getRange(r+1,h.indexOf('VALIDATED_AT')+1).setValue(new Date());}return mairixFindRowObject('COUNT_REQUESTS','COUNT_ID',countId);}
function mairixPostInventoryCountAdjustments(countId,actor){const c=mairixFindRowObject('COUNT_REQUESTS','COUNT_ID',countId);if(!c||c.STATUS!=='VALIDATED')throw new Error('Only validated counts can be posted.');const ref=typeof mairixGenerateNextCode==='function'?mairixGenerateNextCode('INVENTORY_ADJUSTMENT'):'ADJ-'+Utilities.getUuid().slice(0,8).toUpperCase(),lines=mairixGetSheetObjects('COUNT_CONSOLIDATION').filter(x=>String(x.COUNT_ID)===String(countId));lines.forEach(l=>{const q=Number(l.VARIANCE_QTY||0),cost=Number(l.UNIT_COST||0),value=q*cost;if(!q)return;if(typeof mairixPostInventoryMovement==='function')mairixPostInventoryMovement({transactionType:'INVENTORY_COUNT_ADJUSTMENT',referenceId:ref,countId,itemId:l.ITEM_ID,warehouseId:c.WAREHOUSE_ID,quantityEffect:q,unitCost:cost,transactionDate:c.COUNT_DATE,actorId:actor});if(typeof mairixPostFinancialEffect==='function')mairixPostFinancialEffect({transactionType:q<0?'INVENTORY_VARIANCE_SHORTAGE':'INVENTORY_VARIANCE_SURPLUS',referenceId:ref,countId,amount:Math.abs(value),signedEffect:value,transactionDate:c.COUNT_DATE,actorId:actor});mairixCountSheet('INVENTORY_ADJUSTMENTS',[]).appendRow(['IAD-'+Utilities.getUuid().replace(/-/g,'').slice(0,12).toUpperCase(),countId,ref,l.ITEM_ID,q,cost,value,value,'POSTED',actor||'',new Date()]);});mairixSetCountStatus(countId,'POSTED',actor);return {countId,referenceId:ref,status:'POSTED'};}
  
