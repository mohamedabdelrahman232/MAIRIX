      headers.length
    ).fill("");


  const parentAccountCode =
    normalizeMairixMasterCode(
      data.parentAccountCode ||
      data.parentAccount
    );


  const normalBalance =
    mairixCleanText(
      data.normalBalance ||
      data.normalSign
    ).toUpperCase();


  setMairixHeaderValue(
    row,
    headers,
    "Account Code",
    code
  );

  setMairixHeaderValue(
    row,
    headers,
    "Account Name",
    name
  );

  setMairixHeaderValue(
    row,
    headers,
    "Account Type",
    mairixCleanText(
      data.accountType
    ).toUpperCase()
  );

  setMairixHeaderValue(
    row,
    headers,
    "Statement",
    mairixCleanText(
      data.statement
    ).toUpperCase()
  );

  setMairixHeaderValue(
    row,
    headers,
    "Parent Account Code",
    parentAccountCode
  );

  setMairixHeaderValue(
    row,
    headers,
    "Normal Balance",
    normalBalance
  );

  setMairixHeaderValue(
    row,
    headers,
    "Active",
    normalizeMairixActive(
      data.active
    )
  );

  setMairixHeaderValue(
    row,
    headers,
    "Created At",
    new Date()
  );

  setMairixHeaderValue(
    row,
    headers,
    "Updated At",
    new Date()
  );


  sheet.appendRow(
    row
  );


  return {

    success:
      true,

    code:
      code,

    name:
      name

  };

}


/************************************************
 * GET FINANCIAL ACCOUNT
 ************************************************/

function getMairixFinancialAccount(
  accountCode
) {

  const sheet =
    getMairixMasterSheet(
      MAIRIX_MASTER_DATA.SHEETS.FINANCIAL_ACCOUNTS
    );


  const rowNumber =
    findMairixMasterRecord(
      sheet,
      "Account Code",
      accountCode
    );


  if (!rowNumber) {
    return null;
  }


  return getMairixMasterRowAsObject(
    sheet,
    rowNumber
  );

}


/************************************************
 * INTERNAL HEADER HELPERS
 ************************************************/

function getMairixHeaders(
  sheet
) {

  return sheet
    .getRange(
      1,
      1,
      1,
      sheet.getLastColumn()
    )
    .getDisplayValues()[0]
    .map(
      function(header) {

        return mairixCleanText(
          header
        );

      }
    );

}


/************************************************
 * SET VALUE BY HEADER
 ************************************************/

function setMairixHeaderValue(
  row,
  headers,
  header,
  value
) {

  const index =
    headers.indexOf(
      header
    );


  if (
    index === -1
  ) {

    return;

  }


  row[index] =
    value;

}


/************************************************
 * CONVERT ROW TO OBJECT
 ************************************************/

function getMairixMasterRowAsObject(
  sheet,
  rowNumber
) {

  const headers =
    getMairixHeaders(
      sheet
    );


  const values =
    sheet
      .getRange(
        rowNumber,
        1,
        1,
        headers.length
      )
      .getValues()[0];


  const object = {};


  headers.forEach(
    function(
      header,
      index
    ) {

      object[header] =
        values[index];

    }
  );


  return object;

}


