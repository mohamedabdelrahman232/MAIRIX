 *
 * MASTER DATA:
 * 1. Items
 * 2. Customers
 * 3. Vendors
 * 4. Employees
 * 5. Warehouses
 * 6. Tax Types
 * 7. Financial Accounts
 *
 * IMPORTANT:
 * This file DOES NOT create transactions.
 * This file DOES NOT update inventory balances.
 * This file DOES NOT calculate financial statements.
 *
 * It only manages master records and their identity.
 ************************************************/


/************************************************
 * MAIRIX MASTER DATA CONFIGURATION
 ************************************************/

const MAIRIX_MASTER_DATA = {

  SHEETS: {

    ITEMS:
      "ITEMS",

    CUSTOMERS:
      "CUSTOMERS",

    VENDORS:
      "VENDORS",

    EMPLOYEES:
      "EMPLOYEES",

    WAREHOUSES:
      "WAREHOUSES",

    TAX_TYPES:
      "TAX_TYPES",

    FINANCIAL_ACCOUNTS:
      "FINANCIAL_ACCOUNTS"

  },


  STATUS: {

    ACTIVE:
      "ACTIVE",

    INACTIVE:
      "INACTIVE"

  },


  ENTITY_PREFIX: {

    ITEM:
      "ITM",

    CUSTOMER:
      "CUS",

    VENDOR:
      "VND",

    EMPLOYEE:
      "EMP",

    WAREHOUSE:
      "WH",

    TAX:
      "TAX",

    ACCOUNT:
      "ACC"

  }

};


/************************************************
 * GET MASTER SHEET
 ************************************************/

function getMairixMasterSheet(
  sheetName
) {

  const sheet =
    SpreadsheetApp
      .getActiveSpreadsheet()
      .getSheetByName(
        sheetName
      );


  if (!sheet) {

    throw new Error(
      "MAIRIX master sheet not found: " +
      sheetName
    );

  }


  return sheet;

}


/************************************************
 * NORMALIZE MASTER CODE
 ************************************************/

function normalizeMairixMasterCode(
  value
) {

  return mairixCleanText(
    value
  ).toUpperCase();

}


/************************************************
 * REQUIRE MASTER CODE
 ************************************************/

function requireMairixMasterCode(
  value,
  label
) {

  const code =
    normalizeMairixMasterCode(
      value
    );


  if (!code) {

    throw new Error(
      (label || "Master Code") +
      " is required."
    );

  }


  return code;

}


/************************************************
 * FIND MASTER RECORD
 ************************************************/

function findMairixMasterRecord(
  sheet,
  codeColumnName,
  code
) {

  const normalizedCode =
    normalizeMairixMasterCode(
      code
    );


  if (!normalizedCode) {
    return null;
  }


  const lastRow =
    sheet.getLastRow();


  if (lastRow < 2) {
    return null;
  }


  const codeColumn =
    mairixgetColumnNumber(
      sheet,
      codeColumnName
    );


  const values =
    sheet
      .getRange(
        2,
        codeColumn,
        lastRow - 1,
        1
      )
      .getDisplayValues();


  for (
    let i = 0;
    i < values.length;
    i++
  ) {

    if (
      normalizeMairixMasterCode(
        values[i][0]
      ) ===
      normalizedCode
    ) {

      return i + 2;

    }

  }


  return null;

}


/************************************************
 * GENERIC MASTER CODE GENERATOR
 ************************************************/

function generateMairixMasterCode(
  prefix,
  sheetName,
  codeColumnName
) {

  const sheet =
    getMairixMasterSheet(
      sheetName
    );


  const lastRow =
    sheet.getLastRow();


  let counter =
    1;


  if (lastRow >= 2) {

    const codeColumn =
      mairixgetColumnNumber(
        sheet,
        codeColumnName
      );


    const values =
      sheet
        .getRange(
          2,
          codeColumn,
          lastRow - 1,
          1
        )
        .getDisplayValues();


    const normalizedPrefix =
      String(prefix)
        .toUpperCase() +
      "-";


    values.forEach(
      function(row) {

        const value =
          normalizeMairixMasterCode(
            row[0]
          );


        if (
          value.indexOf(
            normalizedPrefix
          ) !== 0
        ) {

          return;

        }


        const number =
          parseInt(
            value.substring(
              normalizedPrefix.length
            ),
            10
          );


        if (
          !isNaN(number) &&
          number >= counter
        ) {

          counter =
            number + 1;

        }

      }
    );

  }


  return (
    String(prefix)
      .toUpperCase() +
    "-" +
    String(counter)
      .padStart(
        5,
        "0"
      )
  );

}


/************************************************
 * MASTER ACTIVE FLAG
 ************************************************/

function normalizeMairixActive(
  value
) {

  if (
    value === undefined ||
    value === null ||
    value === ""
  ) {

    return true;

  }


  if (
    value === true ||
    value === 1 ||
    String(value)
      .trim()
      .toUpperCase() ===
      "TRUE"
  ) {

    return true;

  }


  if (
    value === false ||
    value === 0 ||
    String(value)
      .trim()
      .toUpperCase() ===
      "FALSE"
  ) {

    return false;

  }


  throw new Error(
    "Invalid MAIRIX Active value: " +
    value
  );

}


/************************************************
 * ITEMS
 ************************************************/


function createMairixItem(
  data
) {

  if (!data) {

    throw new Error(
      "Item data is required."
    );

  }


  const sheet =
    getMairixMasterSheet(
      MAIRIX_MASTER_DATA.SHEETS.ITEMS
    );


  const name =
    mairixCleanText(
      data.name
    );


  if (!name) {

    throw new Error(
      "Item Name is required."
    );

  }


  const code =
    data.code
      ? normalizeMairixMasterCode(
          data.code
        )
      : generateMairixMasterCode(
          MAIRIX_MASTER_DATA.ENTITY_PREFIX.ITEM,
          MAIRIX_MASTER_DATA.SHEETS.ITEMS,
          "Item Code"
        );


  if (
    findMairixMasterRecord(
      sheet,
      "Item Code",
      code
    )
  ) {

    throw new Error(
      "Item Code already exists: " +
      code
    );

  }


  const headers =
    getMairixHeaders(
      sheet
    );


  const row =
    new Array(
      headers.length
    ).fill("");


  setMairixHeaderValue(
    row,
    headers,
    "Item Code",
    code
  );

  setMairixHeaderValue(
    row,
    headers,
    "Item Name",
    name
  );

  setMairixHeaderValue(
    row,
    headers,
    "Category",
    mairixCleanText(
      data.category
    )
  );

  setMairixHeaderValue(
    row,
    headers,
    "Unit",
    mairixCleanText(
      data.unit
    )
  );

  setMairixHeaderValue(
    row,
    headers,
    "Barcode",
    mairixCleanText(
      data.barcode
    )
  );

  setMairixHeaderValue(
    row,
    headers,
    "Selling Price",
    Number(
      data.sellingPrice || 0
    )
  );

  setMairixHeaderValue(
    row,
    headers,
    "Opening Quantity",
    Number(
      data.openingQuantity || 0
    )
  );

  setMairixHeaderValue(
    row,
    headers,
    "Opening Cost",
    Number(
      data.openingCost || 0
    )
  );

  setMairixHeaderValue(
    row,
    headers,
    "Active",
    normalizeMairixActive(
      data.active
    )
  );

  setMairixHeaderValue(
    row,
    headers,
    "Created At",
    new Date()
  );

  setMairixHeaderValue(
    row,
    headers,
    "Updated At",
    new Date()
  );


  sheet.appendRow(
    row
  );


  return {

    success:
      true,

    code:
      code,

    name:
      name

  };

}


/************************************************
 * GET ITEM
 ************************************************/

function getMairixItem(
