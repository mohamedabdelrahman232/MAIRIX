function mairixE2EPurchaseReturnCreate(data) {

  if (typeof apiCreatePurchaseReturn !== "function") {
    throw new Error("apiCreatePurchaseReturn() is not available.");
  }

  if (!data) {
    throw new Error("Purchase return data is required.");
  }

  var request = Object.assign({}, data);

  delete request.userId;
  delete request.serverUserId;
  delete request.createdBy;
  delete request.updatedBy;

  var result = apiCreatePurchaseReturn(request);

  if (!result || result.success !== true) {
    throw new Error(
      "Purchase return integration failed: " +
      JSON.stringify(result && result.error ? result.error : result)
    );
  }

  return result;
}

