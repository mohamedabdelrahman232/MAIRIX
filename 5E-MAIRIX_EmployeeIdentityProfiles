/************************************************
 * MAIRIX ERP
 * 5E-MAIRIX_EmployeeIdentityProfiles.gs
 *
 * EMPLOYEE IDENTITY & BUSINESS PROFILES
 *
 * RESPONSIBILITIES:
 *
 * 1. Central identity resolution
 * 2. Employee <-> User relationship
 * 3. Business profile management
 * 4. Salesman profile provisioning
 * 5. EMP <-> USR <-> SAL resolution
 * 6. Prevent duplicate salesman profiles
 * 7. Automatic salesman identity lookup
 *
 ************************************************/


/************************************************
 * CONSTANTS
 ************************************************/

const MAIRIX_SALES_PROFILES_SHEET =
  'SALES_PROFILES';


/************************************************
 * SALES PROFILE HEADERS
 ************************************************/

const MAIRIX_SALES_PROFILE_HEADERS = [

  'Salesman Code',

  'Employee Code',

  'User ID',

  'Employee Name',

  'Gmail',

  'Role Code',

  'Active',

  'Created At',

  'Created By',

  'Updated At'

];


/************************************************
 * GET SPREADSHEET
 ************************************************/

function mairixIdentityGetSpreadsheet() {

  if (
    typeof mairixGetSpreadsheet === 'function'
  ) {

    return mairixGetSpreadsheet();

  }

  return SpreadsheetApp.getActiveSpreadsheet();

}


/************************************************
 * GET SHEET
 ************************************************/

function mairixIdentityGetSheet(
  sheetName
) {

  const ss =
    mairixIdentityGetSpreadsheet();

  const sheet =
    ss.getSheetByName(
      sheetName
    );

  if (!sheet) {

    throw new Error(
      'Required sheet not found: ' +
      sheetName
    );

  }

  return sheet;

}


/************************************************
 * NORMALIZE STRING
 ************************************************/

function mairixIdentityString(
  value
) {

  return String(
    value || ''
  ).trim();

}


/************************************************
 * NORMALIZE BOOLEAN
 ************************************************/

function mairixIdentityBoolean(
  value
) {

  if (value === true) {
    return true;
  }

  const normalized =
    String(value || '')
      .trim()
      .toUpperCase();

  return (
    normalized === 'TRUE' ||
    normalized === 'YES' ||
    normalized === '1'
  );

}


/************************************************
 * GET HEADER MAP
 ************************************************/

function mairixIdentityGetHeaderMap(
  sheet
) {

  const lastColumn =
    sheet.getLastColumn();

  if (lastColumn < 1) {

    throw new Error(
      'Sheet has no headers: ' +
      sheet.getName()
    );

  }

  const headers =
    sheet
      .getRange(
        1,
        1,
        1,
        lastColumn
      )
      .getValues()[0];

  const map = {};

  headers.forEach(
    function(header, index) {

      const key =
        mairixIdentityString(
          header
        );

      if (key) {

        map[key] =
          index;

      }

    }
  );

  return map;

}


/************************************************
 * REQUIRE HEADER
 ************************************************/

function mairixIdentityRequireHeader(
  headerMap,
  headerName,
  sheetName
) {

  if (
    headerMap[headerName] === undefined
  ) {

    throw new Error(
      'Required header missing: ' +
      sheetName +
      ' -> ' +
      headerName
    );

  }

  return headerMap[headerName];

}


/************************************************
 * ENSURE SALES PROFILES SHEET
 ************************************************/

function mairixEnsureSalesProfilesSheet() {

  const ss =
    mairixIdentityGetSpreadsheet();

  let sheet =
    ss.getSheetByName(
      MAIRIX_SALES_PROFILES_SHEET
    );

  if (!sheet) {

    sheet =
      ss.insertSheet(
        MAIRIX_SALES_PROFILES_SHEET
      );

  }

  const currentHeaders =
    sheet
      .getRange(
        1,
        1,
        1,
        Math.max(
          sheet.getLastColumn(),
          1
        )
      )
      .getValues()[0];

  const currentFirstHeader =
    mairixIdentityString(
      currentHeaders[0]
    );

  if (
    sheet.getLastRow() === 0 ||
    !currentFirstHeader
  ) {

    sheet
      .getRange(
        1,
        1,
        1,
        MAIRIX_SALES_PROFILE_HEADERS.length
      )
      .setValues([
        MAIRIX_SALES_PROFILE_HEADERS
      ]);

    sheet.setFrozenRows(1);

  }

  return sheet;

}


/************************************************
 * GET NEXT SALESMAN CODE
 ************************************************/

function mairixGetNextSalesmanCode() {

  const sheet =
    mairixEnsureSalesProfilesSheet();

  const lastRow =
    sheet.getLastRow();

  if (lastRow < 2) {

    return 'SAL-0000001';

  }

  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        1
      )
      .getValues();

  let maxNumber = 0;

  values.forEach(
    function(row) {

      const code =
        mairixIdentityString(
          row[0]
        );

      const match =
        code.match(
          /^SAL-(\d+)$/
        );

      if (match) {

        const number =
          Number(match[1]);

        if (
          number > maxNumber
        ) {

          maxNumber =
            number;

        }

      }

    }
  );

  const nextNumber =
    maxNumber + 1;

  return (
    'SAL-' +
    String(nextNumber)
      .padStart(
        7,
        '0'
      )
  );

}


/************************************************
 * READ SALES PROFILE ROW
 ************************************************/

function mairixIdentityReadSalesProfileRow(
  row,
  headerMap
) {

  return {

    salesmanCode:
      mairixIdentityString(
        row[
          headerMap['Salesman Code']
        ]
      ),

    employeeCode:
      mairixIdentityString(
        row[
          headerMap['Employee Code']
        ]
      ),

    userId:
      mairixIdentityString(
        row[
          headerMap['User ID']
        ]
      ),

    employeeName:
      mairixIdentityString(
        row[
          headerMap['Employee Name']
        ]
      ),

    email:
      mairixIdentityString(
        row[
          headerMap['Gmail']
        ]
      ),

    roleCode:
      mairixIdentityString(
        row[
          headerMap['Role Code']
        ]
      ),

    active:
      mairixIdentityBoolean(
        row[
          headerMap['Active']
        ]
      ),

    createdAt:
      row[
        headerMap['Created At']
      ],

    createdBy:
      mairixIdentityString(
        row[
          headerMap['Created By']
        ]
      ),

    updatedAt:
      row[
        headerMap['Updated At']
      ]

  };

}


/************************************************
 * GET ALL SALES PROFILES
 ************************************************/

function mairixGetAllSalesProfiles(
  activeOnly
) {

  const sheet =
    mairixEnsureSalesProfilesSheet();

  const lastRow =
    sheet.getLastRow();

  if (lastRow < 2) {

    return [];

  }

  const headerMap =
    mairixIdentityGetHeaderMap(
      sheet
    );

  MAIRIX_SALES_PROFILE_HEADERS.forEach(
    function(header) {

      mairixIdentityRequireHeader(
        headerMap,
        header,
        MAIRIX_SALES_PROFILES_SHEET
      );

    }
  );

  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        sheet.getLastColumn()
      )
      .getValues();

  const profiles =
    values.map(
      function(row) {

        return mairixIdentityReadSalesProfileRow(
          row,
          headerMap
        );

      }
    );

  if (activeOnly === true) {

    return profiles.filter(
      function(profile) {

        return profile.active === true;

      }
    );

  }

  return profiles;

}


/************************************************
 * FIND SALES PROFILE
 ************************************************/

function mairixFindSalesProfile(
  criteria
) {

  criteria =
    criteria || {};

  const salesmanCode =
    mairixIdentityString(
      criteria.salesmanCode
    );

  const employeeCode =
    mairixIdentityString(
      criteria.employeeCode
    );

  const userId =
    mairixIdentityString(
      criteria.userId
    );

  const profiles =
    mairixGetAllSalesProfiles(
      false
    );

  for (
    let i = 0;
    i < profiles.length;
    i++
  ) {

    const profile =
      profiles[i];

    if (
      salesmanCode &&
      profile.salesmanCode === salesmanCode
    ) {

      return profile;

    }

    if (
      employeeCode &&
      profile.employeeCode === employeeCode
    ) {

      return profile;

    }

    if (
      userId &&
      profile.userId === userId
    ) {

      return profile;

    }

  }

  return null;

}


