/************************************************
 * CREATE SALESMAN PROFILE
 ************************************************/

function mairixCreateSalesmanProfile(
  employeeCode,
  options
) {

  options =
    options || {};

  employeeCode =
    mairixIdentityString(
      employeeCode
    );

  if (!employeeCode) {

    throw new Error(
      'Employee Code is required.'
    );

  }


  /**********************************************
   * CHECK EMPLOYEE
   **********************************************/

  const employee =
    mairixGetEmployeeIdentityByCode(
      employeeCode
    );

  if (!employee) {

    throw new Error(
      'Employee not found: ' +
      employeeCode
    );

  }


  /**********************************************
   * CHECK USER
   **********************************************/

  const user =
    mairixGetUserIdentityByEmployeeCode(
      employeeCode
    );

  if (!user) {

    throw new Error(
      'User not found for employee: ' +
      employeeCode
    );

  }


  /**********************************************
   * CHECK DUPLICATE
   **********************************************/

  const existing =
    mairixFindSalesProfile({

      employeeCode:
        employeeCode

    });

  if (existing) {

    return {

      success: true,

      action:
        'ALREADY_EXISTS',

      profile:
        existing

    };

  }


  /**********************************************
   * VALIDATE ROLE
   **********************************************/

  const roleCode =
  mairixIdentityString(
    user.roleCode
  ).toUpperCase();

  const allowedRoles = [

    'SALESMAN',

    'SENIOR_SALESMAN',

    'SALES_MANAGER'

  ];

  if (
    allowedRoles.indexOf(
      roleCode
    ) === -1
  ) {

    throw new Error(
      'Employee role is not eligible for a salesman profile: ' +
      roleCode
    );

  }


  /**********************************************
   * CREATE CODE
   **********************************************/

  const salesmanCode =
    mairixGetNextSalesmanCode();

  const sheet =
    mairixEnsureSalesProfilesSheet();

  const now =
    new Date();

  const createdBy =
    mairixIdentityString(
      options.createdBy ||
      ''
    );


  /**********************************************
   * CREATE PROFILE
   **********************************************/

  const profile = {

    salesmanCode:
      salesmanCode,

    employeeCode:
      employee.employeeCode,

    userId:
      user.userId,

    employeeName:
      employee.employeeName ||
      user.userName,

    email:
      employee.email ||
      user.email,

    roleCode:
      roleCode,

    active:
      (
        employee.active === true &&
        user.active === true
      ),

    createdAt:
      now,

    createdBy:
      createdBy,

    updatedAt:
      now

  };


  /**********************************************
   * SAVE
   **********************************************/

  sheet.appendRow([

    profile.salesmanCode,

    profile.employeeCode,

    profile.userId,

    profile.employeeName,

    profile.email,

    profile.roleCode,

    profile.active,

    profile.createdAt,

    profile.createdBy,

    profile.updatedAt

  ]);


  return {

    success: true,

    action:
      'CREATED',

    profile:
      profile

  };

}


/************************************************
 * ENSURE EMPLOYEE BUSINESS PROFILE
 *
 * Called after employee provisioning.
 ************************************************/

function mairixEnsureEmployeeBusinessProfile(
  employeeCode,
  options
) {

  options =
    options || {};

  const employee =
    mairixGetEmployeeIdentityByCode(
      employeeCode
    );

  if (!employee) {

    throw new Error(
      'Employee not found: ' +
      employeeCode
    );

  }

    const user =
    mairixGetUserIdentityByEmployeeCode(
      employee.employeeCode
    );

  if (!user) {
    throw new Error(
      'User not found for employee: ' +
      employee.employeeCode
    );
  }

  const roleCode =
    mairixIdentityString(
      user.roleCode
    ).toUpperCase();

    
  /**********************************************
   * SALES ROLES
   **********************************************/

  const salesRoles = [

    'SALESMAN',

    'SENIOR_SALESMAN',

    'SALES_MANAGER'

  ];

  if (
    salesRoles.indexOf(
      roleCode
    ) !== -1
  ) {

    return {

      success: true,

      profileType:
        'SALESMAN',

      result:
        mairixCreateSalesmanProfile(
          employee.employeeCode,
          options
        )

    };

  }


  /**********************************************
   * NO PROFILE REQUIRED
   **********************************************/

  return {

    success: true,

    profileType:
      null,

    result: null

  };

}


/************************************************
 * RESOLVE SALESMAN IDENTITY
 *
 * ACCEPTS:
 *
 * SAL-XXXXXXX
 * EMP-XXXXXXX
 * USR-XXXXXXX
 *
 ************************************************/

function mairixResolveSalesmanIdentity(
  identity
) {

  identity =
    mairixIdentityString(
      identity
    );

  if (!identity) {

    return null;

  }


  /**********************************************
   * SALESMAN CODE
   **********************************************/

  if (
    identity.indexOf('SAL-') === 0
  ) {

    const profile =
      mairixFindSalesProfile({

        salesmanCode:
          identity

      });

    if (!profile) {

      return null;

    }

    return profile;

  }


  /**********************************************
   * EMPLOYEE CODE
   **********************************************/

  if (
    identity.indexOf('EMP-') === 0
  ) {

    return mairixFindSalesProfile({

      employeeCode:
        identity

    });

  }


  /**********************************************
   * USER ID
   **********************************************/

  if (
    identity.indexOf('USR-') === 0
  ) {

    return mairixFindSalesProfile({

      userId:
        identity

    });

  }


  return null;

}


/************************************************
 * REQUIRE ACTIVE SALESMAN
 ************************************************/

function mairixRequireActiveSalesman(
  identity
) {

  const profile =
    mairixResolveSalesmanIdentity(
      identity
    );

  if (!profile) {

    throw new Error(
      'Salesman not found: ' +
      identity
    );

  }

  if (
    profile.active !== true
  ) {

    throw new Error(
      'Salesman is inactive: ' +
      profile.salesmanCode
    );

  }

  return profile;

}


/************************************************
 * GET CURRENT USER SALESMAN
 ************************************************/

function mairixGetCurrentUserSalesman() {

  if (
    typeof requireCurrentUser !== 'function'
  ) {

    throw new Error(
      'requireCurrentUser() is not available.'
    );

  }

  const currentUser =
    requireCurrentUser();

  if (
    !currentUser ||
    !currentUser.userId
  ) {

    throw new Error(
      'Current authenticated user is required.'
    );

  }

  return mairixRequireActiveSalesman(
    currentUser.userId
  );

}


/************************************************
 * PROVISION ALL EXISTING SALES EMPLOYEES
 *
 * SAFE TO RUN MULTIPLE TIMES.
 *
 * ROLE SOURCE:
 *
 * EMPLOYEES
 *      ↓ Employee Code
 * USERS
 *      ↓ Role Code
 *
 ************************************************/

function mairixProvisionExistingSalesProfiles() {

  const employeeSheet =
    mairixIdentityGetSheet(
      'EMPLOYEES'
    );

  const employeeHeaderMap =
    mairixIdentityGetHeaderMap(
      employeeSheet
    );

  const requiredEmployeeHeaders = [

    'Employee Code',

    'Active'

  ];

  requiredEmployeeHeaders.forEach(
    function(header) {

      mairixIdentityRequireHeader(
        employeeHeaderMap,
        header,
        'EMPLOYEES'
      );

    }
  );


  /**********************************************
   * USERS
   **********************************************/

  const userSheet =
    mairixIdentityGetSheet(
      'USERS'
    );

  const userHeaderMap =
    mairixIdentityGetHeaderMap(
      userSheet
    );

  const requiredUserHeaders = [

    'Employee Code',

    'Role Code',

    'Active'

  ];

  requiredUserHeaders.forEach(
    function(header) {

      mairixIdentityRequireHeader(
        userHeaderMap,
        header,
        'USERS'
      );

    }
  );


  /**********************************************
   * EMPTY EMPLOYEES
   **********************************************/

  const employeeLastRow =
    employeeSheet.getLastRow();

  if (employeeLastRow < 2) {

    return {

      success: true,

      processed: 0,

      created: 0,

      existing: 0,

      skipped: 0,

      results: []

    };

  }


  /**********************************************
   * BUILD USER ROLE MAP
   *
   * Employee Code → User
   **********************************************/

  const userLastRow =
    userSheet.getLastRow();

  const userMap = {};

  if (userLastRow >= 2) {

    const userValues =
      userSheet
        .getRange(
          2,
          1,
          userLastRow - 1,
          userSheet.getLastColumn()
        )
        .getValues();


    userValues.forEach(
      function(row) {

        const employeeCode =
          mairixIdentityString(
            row[
              userHeaderMap[
                'Employee Code'
              ]
            ]
          );

        if (!employeeCode) {
          return;
        }


        userMap[employeeCode] = {

          employeeCode:
            employeeCode,

          roleCode:
            mairixIdentityString(
              row[
                userHeaderMap[
                  'Role Code'
                ]
              ]
            ).toUpperCase(),

          active:
            mairixIdentityBoolean(
              row[
                userHeaderMap[
                  'Active'
                ]
              ]
            )

        };

      }
    );

  }


  /**********************************************
   * EMPLOYEE DATA
   **********************************************/

  const employeeValues =
    employeeSheet
      .getRange(
        2,
        1,
        employeeLastRow - 1,
        employeeSheet.getLastColumn()
      )
      .getValues();


  const salesRoles = [

    'SALESMAN',

    'SENIOR_SALESMAN',

    'SALES_MANAGER'

  ];


  let processed = 0;

  let created = 0;

  let existing = 0;

  let skipped = 0;


  const results = [];


  /**********************************************
   * PROCESS EMPLOYEES
   **********************************************/

  employeeValues.forEach(
    function(row) {

      const employeeCode =
        mairixIdentityString(
          row[
            employeeHeaderMap[
              'Employee Code'
            ]
          ]
        );


      const employeeActive =
        mairixIdentityBoolean(
          row[
            employeeHeaderMap[
              'Active'
            ]
          ]
        );


      if (
        !employeeCode ||
        !employeeActive
      ) {

        skipped++;

        return;

      }


      /********************************************
       * GET USER FROM MAP
       ********************************************/

      const user =
        userMap[employeeCode];


      if (
        !user ||
        user.active !== true
      ) {

        skipped++;

        results.push({

          employeeCode:
            employeeCode,

          action:
            'SKIPPED_NO_ACTIVE_USER',

          roleCode:
            null

        });

        return;

      }


      const roleCode =
        mairixIdentityString(
          user.roleCode
        ).toUpperCase();


      /********************************************
       * CHECK SALES ROLE
       ********************************************/

      if (
        salesRoles.indexOf(
          roleCode
        ) === -1
      ) {

        skipped++;

        return;

      }


      processed++;


      /********************************************
       * CREATE / ENSURE PROFILE
       ********************************************/

      const result =
        mairixEnsureEmployeeBusinessProfile(
          employeeCode,
          {

            createdBy:
              'SYSTEM_MIGRATION'

          }
        );


      if (
        result.result &&
        result.result.action === 'CREATED'
      ) {

        created++;

      }
      else if (
        result.result &&
        result.result.action ===
          'ALREADY_EXISTS'
      ) {

        existing++;

      }


      results.push({

        employeeCode:
          employeeCode,

        roleCode:
          roleCode,

        result:
          result

      });

    }
  );


  /**********************************************
   * RESULT
   **********************************************/

  return {

    success: true,

    processed:
      processed,

    created:
      created,

    existing:
      existing,

    skipped:
      skipped,

    results:
      results

  };

}


