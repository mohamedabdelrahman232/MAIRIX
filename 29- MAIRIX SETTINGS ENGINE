 * SETTINGS TYPE TEST
 ************************************************/

function testMairixSettingsTypes() {

  const booleanValue =
    mairixSettingsConvertValue(
      "TRUE",
      "BOOLEAN"
    );


  if (
    booleanValue !==
    true
  ) {

    throw new Error(
      "BOOLEAN conversion failed."
    );

  }


  const integerValue =
    mairixSettingsConvertValue(
      "4",
      "INTEGER"
    );


  if (
    integerValue !==
    4
  ) {

    throw new Error(
      "INTEGER conversion failed."
    );

  }


  const numberValue =
    mairixSettingsConvertValue(
      "14.5",
      "NUMBER"
    );


  if (
    numberValue !==
    14.5
  ) {

    throw new Error(
      "NUMBER conversion failed."
    );

  }


  const textValue =
    mairixSettingsConvertValue(
      " MAIRIX ",
      "TEXT"
    );


  if (
    textValue !==
    "MAIRIX"
  ) {

    throw new Error(
      "TEXT conversion failed."
    );

  }


  Logger.log(
    "MAIRIX SETTINGS TYPE TEST: PASS"
  );


  return {

    success:
      true

  };

}


/************************************************
 * SETTINGS VALIDATION TEST
 ************************************************/

function testMairixSettingsValidation() {

  const valid =
    validateMairixSetting(
      "POINTS_PER_UNIT",
      1
    );


  if (
    !valid.valid
  ) {

    throw new Error(
      "Valid setting was rejected."
    );

  }


  let failed =
    false;


  try {

    validateMairixSetting(
      "COST_DECIMAL_PLACES",
      99
    );

  } catch (error) {

    failed = true;

  }


  if (
    !failed
  ) {

    throw new Error(
      "Invalid COST_DECIMAL_PLACES was accepted."
    );

  }


  Logger.log(
    "MAIRIX SETTINGS VALIDATION TEST: PASS"
  );


  return {

    success:
      true

  };

}


/************************************************
 * SETTINGS OPTIONS TEST
 ************************************************/

function testMairixSettingsOptions() {

  setupMairixSettings();


  /*
   * Use a custom setting so the test does not
   * alter a core runtime policy.
   */

  const testKey =
    "TEST_SETTING_OPTION";


  if (
    !mairixSettingsGetDefinition(
      testKey
    )
  ) {

    registerMairixCustomSetting({

      key:
        testKey,

      type:
        "TEXT",

      category:
        "TEST",

      defaultValue:
        "A",

      editable:
        true,

      description:
        "Temporary settings engine test."

    });

  }


  addMairixSettingOption(
    testKey,
    "A",
    "Option A",
    1
  );


  addMairixSettingOption(
    testKey,
    "B",
    "Option B",
    2
  );


  const options =
    getMairixSettingOptions(
      testKey
    );


  if (
    options.length < 2
  ) {

    throw new Error(
      "SETTINGS_OPTIONS test failed."
    );

  }


  if (
    !validateMairixSettingOption(
      testKey,
      "B"
    )
  ) {

    throw new Error(
      "Valid setting option was rejected."
    );

  }


  Logger.log(
    "MAIRIX SETTINGS OPTIONS TEST: PASS"
  );


  return {

    success:
      true,

    options:
      options

  };

}


