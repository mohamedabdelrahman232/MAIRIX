 * MAIRIX ERP
 * FILE 29- MAIRIX SETTINGS ENGINE
 *
 * RESPONSIBILITIES:
 *
 *   1. Manage runtime SETTINGS.
 *   2. Maintain SETTINGS_OPTIONS.
 *   3. Validate setting keys and values.
 *   4. Provide defaults without duplicating CONFIG.
 *   5. Support typed settings.
 *   6. Support editable / protected settings.
 *   7. Audit setting changes.
 *   8. Keep compatibility with:
 *
 *        getMairixSetting()
 *        setMairixSetting()
 *
 *   9. Runtime policy belongs here.
 *  10. Static system configuration belongs in
 *      1-MAIRIX CONFIG.gs.
 *
 * IMPORTANT:
 *
 * This file does NOT redefine:
 *
 *   MAIRIX
 *   mairixCleanText()
 *   getMairixSetting()
 *   setMairixSetting()
 *   getMairixSettingsSheet()
 *
 ************************************************/


/************************************************
 * SETTINGS SHEETS
 ************************************************/

const MAIRIX_SETTINGS = {

  SETTINGS_SHEET:
    "SETTINGS",

  OPTIONS_SHEET:
    "SETTINGS_OPTIONS",

  STATUS_ACTIVE:
    "ACTIVE",

  STATUS_INACTIVE:
    "INACTIVE"

};


/************************************************
 * SETTINGS HEADERS
 *
 * SETTINGS:
 *
 * A = KEY
 * B = VALUE
 * C = TYPE
 * D = CATEGORY
 * E = DEFAULT VALUE
 * F = EDITABLE
 * G = DESCRIPTION
 * H = STATUS
 * I = UPDATED BY
 * J = UPDATED AT
 *
 *
 * SETTINGS_OPTIONS:
 *
 * A = KEY
 * B = OPTION VALUE
 * C = LABEL
 * D = SORT ORDER
 * E = ACTIVE
 ************************************************/

const MAIRIX_SETTINGS_HEADERS = [

  "KEY",
  "VALUE",
  "TYPE",
  "CATEGORY",
  "DEFAULT VALUE",
  "EDITABLE",
  "DESCRIPTION",
  "STATUS",
  "UPDATED BY",
  "UPDATED AT"

];


const MAIRIX_SETTINGS_OPTION_HEADERS = [

  "KEY",
  "OPTION VALUE",
  "LABEL",
  "SORT ORDER",
  "ACTIVE"

];


/************************************************
 * SETUP
 ************************************************/

function setupMairixSettings() {

  const ss =
    SpreadsheetApp
      .getActiveSpreadsheet();


  if (!ss) {

    throw new Error(
      "Active spreadsheet is not available."
    );

  }


  const settingsSheet =
    mairixSettingsGetOrCreateSheet(
      ss,
      MAIRIX_SETTINGS.SETTINGS_SHEET
    );


  const optionsSheet =
    mairixSettingsGetOrCreateSheet(
      ss,
      MAIRIX_SETTINGS.OPTIONS_SHEET
    );


  mairixSettingsEnsureHeaders(
    settingsSheet,
    MAIRIX_SETTINGS_HEADERS
  );


  mairixSettingsEnsureHeaders(
    optionsSheet,
    MAIRIX_SETTINGS_OPTION_HEADERS
  );


  settingsSheet.setFrozenRows(1);
  optionsSheet.setFrozenRows(1);


  mairixSettingsApplyFormatting(
    settingsSheet,
    optionsSheet
  );


  mairixSettingsSeedDefaults();

  mairixSettingsSeedDefaultOptions();

  /************************************************
   * SEED DEFAULT SETTINGS OPTIONS
   ************************************************/

  function mairixSettingsSeedDefaultOptions() {

    const sheet =
      mairixSettingsGetOptionsSheet();

    const definitions =
      mairixGetDefaultSettingsOptions();

    const existingRows =
      mairixSettingsGetAllOptionRows();

    definitions.forEach(
      function(definition) {

        const exists =
          existingRows.some(
            function(row) {

              return (
                mairixCleanText(row.key)
                  .toUpperCase() ===
                mairixCleanText(definition.key)
                  .toUpperCase()
                &&
                String(row.value) ===
                String(definition.value)
              );

            }
          );

        if (exists) {
          return;
        }

        sheet.appendRow([
          definition.key,
          definition.value,
          definition.label,
          definition.sortOrder,
          definition.active
        ]);

      }
    );

  }


  /************************************************
   * GET ALL SETTINGS OPTIONS
   ************************************************/

  function mairixSettingsGetAllOptionRows() {

    const sheet =
      mairixSettingsGetOptionsSheet();

    const lastRow =
      sheet.getLastRow();

    if (lastRow < 2) {
      return [];
    }

    const values =
      sheet
        .getRange(
          2,
          1,
          lastRow - 1,
          5
        )
        .getValues();

    return values.map(
      function(row) {

        return {
          key: row[0],
          value: row[1],
          label: row[2],
          sortOrder: row[3],
          active: row[4]
        };

      }
    );

  }

  return {

    success:
      true,

    settingsSheet:
      MAIRIX_SETTINGS.SETTINGS_SHEET,

    optionsSheet:
      MAIRIX_SETTINGS.OPTIONS_SHEET

  };

}


