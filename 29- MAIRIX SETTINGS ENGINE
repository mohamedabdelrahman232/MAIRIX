/************************************************
 * MAIRIX REJECTION ADAPTER
 *
 * Every rejected transaction should be recorded.
 ************************************************/

function mairixRecordRejection(
  details
) {

  try {

    if (
      typeof mairixWriteRejectionReport ===
      "function"
    ) {

      return mairixWriteRejectionReport(
        details
      );

    }

    /*
     * Temporary fallback until the
     * official rejection report engine
     * is connected.
     */

    Logger.log(
      "[MAIRIX REJECTION] " +
      JSON.stringify(
        details
      )
    );

    return {
      success:
        true,

      fallback:
        true

    };

  } catch (error) {

    Logger.log(
      "Rejection report failed: " +
      error.message
    );

    return {
      success:
        false,

      error:
        error.message

    };

  }

}

