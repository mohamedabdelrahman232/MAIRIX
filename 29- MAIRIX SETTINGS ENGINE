 * SET RUNTIME SETTING
 ************************************************/

function setMairixRuntimeSetting(
  key,
  value
) {

  const normalizedKey =
    mairixSettingsNormalizeKey(
      key
    );


  const definition =
    mairixSettingsGetDefinition(
      normalizedKey
    );


  if (
    !definition
  ) {

    throw new Error(
      "Unknown MAIRIX runtime setting: " +
      normalizedKey
    );

  }


  if (
    definition.editable !== true
  ) {

    throw new Error(
      "Setting is protected and cannot be modified: " +
      normalizedKey
    );

  }


  const normalizedValue =
    mairixSettingsValidateAndNormalizeValue(
      value,
      definition
    );

    if (
    !validateMairixSettingOption(
      normalizedKey,
      normalizedValue
    )
  ) {

    throw new Error(
      "Invalid option for setting " +
      normalizedKey +
      ": " +
      normalizedValue
    );

  }


  const oldValue =
    getMairixSetting(
      normalizedKey
    );


  const user =
    mairixSettingsGetCurrentUser();


  const result =
    setMairixSetting(
      normalizedKey,
      normalizedValue
    );


  mairixSettingsUpdateMetadataByKey(
    normalizedKey,
    user
  );


  mairixSettingsAudit(
    "UPDATE_SETTING",
    normalizedKey,
    oldValue,
    normalizedValue,
    user
  );


  return {

    success:
      true,

    key:
      normalizedKey,

    oldValue:
      oldValue,

    value:
      normalizedValue,

    updatedBy:
      user
        ? user.userId
        : "SYSTEM",

    result:
      result

  };

}


/************************************************
 * FORCE SET SYSTEM SETTING
 *
 * Intended for controlled setup/migration.
 ************************************************/

function setMairixSystemSetting(
  key,
  value
) {

  const normalizedKey =
    mairixSettingsNormalizeKey(
      key
    );


  const definition =
    mairixSettingsGetDefinition(
      normalizedKey
    );


  if (
    !definition
  ) {

    throw new Error(
      "Unknown MAIRIX setting: " +
      normalizedKey
    );

  }


  const normalizedValue =
    mairixSettingsValidateAndNormalizeValue(
      value,
      definition
    );


  const oldValue =
    getMairixSetting(
      normalizedKey
    );


  const result =
    setMairixSetting(
      normalizedKey,
      normalizedValue
    );


  mairixSettingsUpdateMetadataByKey(
    normalizedKey,
    null
  );


  mairixSettingsAudit(
    "SYSTEM_UPDATE_SETTING",
    normalizedKey,
    oldValue,
    normalizedValue,
    null
  );


  return {

    success:
      true,

    key:
      normalizedKey,

    oldValue:
      oldValue,

    value:
      normalizedValue,

    result:
      result

  };

}


/************************************************
 * GET ALL SETTINGS
 ************************************************/

function getAllMairixRuntimeSettings() {

  const sheet =
    mairixSettingsGetSheet();


  const headers =
    mairixSettingsGetHeaders(
      sheet
    );


  const lastRow =
    sheet.getLastRow();


  if (
    lastRow < 2
  ) {

    return [];

  }


  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        headers.length
      )
      .getValues();


  return values
    .map(
      function(row) {

        const object = {};


        headers.forEach(
          function(header, index) {

            object[
              header
            ] =
              row[index];

          }
        );


        return object;

      }
    )
    .filter(
      function(setting) {

        return (
          mairixCleanText(
            setting.KEY
          ) !== ""
        );

      }
    );

}


/************************************************
 * GET ACTIVE SETTINGS
 ************************************************/

function getActiveMairixRuntimeSettings() {

  return getAllMairixRuntimeSettings()
    .filter(
      function(setting) {

        return (
          mairixCleanText(
            setting.STATUS
          ).toUpperCase() !==
          MAIRIX_SETTINGS.STATUS_INACTIVE
        );

      }
    );

}


/************************************************
 * GET SETTING DEFINITION
 ************************************************/

function getMairixSettingDefinition(
  key
) {

  const normalizedKey =
    mairixSettingsNormalizeKey(
      key
    );


  return mairixSettingsGetDefinition(
    normalizedKey
  );

}


/************************************************
 * GET SETTINGS BY CATEGORY
 ************************************************/

function getMairixSettingsByCategory(
  category
) {

  const normalizedCategory =
    mairixCleanText(
      category
    ).toUpperCase();


  return getAllMairixRuntimeSettings()
    .filter(
      function(setting) {

        return (
          mairixCleanText(
            setting.CATEGORY
          ).toUpperCase() ===
          normalizedCategory
        );

      }
    );

}


/************************************************
 * RESET SETTING TO DEFAULT
 ************************************************/

function resetMairixSettingToDefault(
  key
) {

  const normalizedKey =
    mairixSettingsNormalizeKey(
      key
    );


  const definition =
    mairixSettingsGetDefinition(
      normalizedKey
    );


  if (
    !definition
  ) {

    throw new Error(
      "Unknown MAIRIX setting: " +
      normalizedKey
    );

  }


  if (
    definition.editable !== true
  ) {

    throw new Error(
      "Protected setting cannot be reset: " +
      normalizedKey
    );

  }


  return setMairixRuntimeSetting(
    normalizedKey,
    definition.defaultValue
  );

}


/************************************************
 * ENABLE SETTING
 ************************************************/

function enableMairixSetting(
  key
) {

  return mairixSettingsSetStatus(
    key,
    MAIRIX_SETTINGS.STATUS_ACTIVE
  );

}


/************************************************
 * DISABLE SETTING
 ************************************************/

function disableMairixSetting(
  key
) {

  return mairixSettingsSetStatus(
    key,
    MAIRIX_SETTINGS.STATUS_INACTIVE
  );

}


/************************************************
 * SET STATUS
 ************************************************/

function mairixSettingsSetStatus(
  key,
  status
) {

  const normalizedKey =
    mairixSettingsNormalizeKey(
      key
    );


  const definition =
    mairixSettingsGetDefinition(
      normalizedKey
    );


  if (
    !definition
  ) {

    throw new Error(
      "Unknown MAIRIX setting: " +
      normalizedKey
    );

  }


    if (
    definition.editable !== true
  ) {

    throw new Error(
      "Protected setting status cannot be changed: " +
      normalizedKey
    );

  }



  const normalizedStatus =
    mairixCleanText(
      status
    ).toUpperCase();


  if (
    normalizedStatus !==
    MAIRIX_SETTINGS.STATUS_ACTIVE &&
    normalizedStatus !==
    MAIRIX_SETTINGS.STATUS_INACTIVE
  ) {

    throw new Error(
      "Invalid setting status: " +
      status
    );

  }


  const sheet =
    mairixSettingsGetSheet();


  const row =
    mairixSettingsFindRow(
      sheet,
      normalizedKey
    );


  if (
    row === -1
  ) {

    throw new Error(
      "Setting row not found: " +
      normalizedKey
    );

  }


  const headers =
    mairixSettingsGetHeaders(
      sheet
    );


  const statusIndex =
    headers.indexOf(
      "STATUS"
    );


  if (
    statusIndex === -1
  ) {

    throw new Error(
      "SETTINGS STATUS column is missing."
    );

  }


  sheet
    .getRange(
      row,
      statusIndex + 1
    )
    .setValue(
      normalizedStatus
    );


  const user =
    mairixSettingsGetCurrentUser();


  mairixSettingsUpdateMetadataByKey(
    normalizedKey,
    user
  );


  mairixSettingsAudit(
    "SETTING_STATUS_CHANGE",
    normalizedKey,
    "",
    normalizedStatus,
    user
  );


  return {

    success:
      true,

    key:
      normalizedKey,

    status:
      normalizedStatus

  };

}


/************************************************
 * ADD / UPDATE CUSTOM SETTING
 *
 * Allows future settings without changing
 * CONFIG or this engine.
 ************************************************/

function registerMairixCustomSetting(
  definition
) {

  if (
    !definition
  ) {

    throw new Error(
      "Setting definition is required."
    );

  }


  const key =
    mairixSettingsNormalizeKey(
      definition.key
    );


  if (!key) {

    throw new Error(
      "Setting key is required."
    );

  }


  if (
    mairixSettingsGetDefinition(
      key
    )
  ) {

    throw new Error(
      "Setting already exists: " +
      key
    );

  }


  const type =
    mairixSettingsNormalizeType(
      definition.type || "TEXT"
    );


  const category =
    mairixCleanText(
      definition.category ||
      "CUSTOM"
    ).toUpperCase();


  const defaultValue =
    mairixSettingsValidateAndNormalizeValue(
      definition.defaultValue,
      {
        key:
          key,

        type:
          type,

        editable:
          true
      }
    );


  const editable =
    definition.editable !== false;


  const description =
    mairixCleanText(
      definition.description
    );


  const sheet =
    mairixSettingsGetSheet();


  const row =
    mairixSettingsBuildRow(
      key,
      defaultValue,
      {

        type:
          type,

        category:
          category,

        defaultValue:
          defaultValue,

        editable:
          editable,

        description:
          description

      }
    );


  sheet.appendRow(
    row
  );


  mairixSettingsAudit(
    "REGISTER_SETTING",
    key,
    "",
    defaultValue,
    mairixSettingsGetCurrentUser()
  );


  return {

    success:
      true,

    key:
      key,

    type:
      type,

    category:
      category,

    defaultValue:
      defaultValue,

    editable:
      editable

  };

}


/************************************************
 * SETTINGS OPTIONS
 ************************************************/

function addMairixSettingOption(
  key,
  optionValue,
  label,
  sortOrder
) {

  const normalizedKey =
    mairixSettingsNormalizeKey(
      key
    );


  if (
    !mairixSettingsGetDefinition(
      normalizedKey
    )
  ) {

    throw new Error(
      "Cannot add option for unknown setting: " +
      normalizedKey
    );

  }


  const sheet =
    mairixSettingsGetOptionsSheet();


  const existing =
    mairixSettingsFindOptionRow(
      sheet,
      normalizedKey,
      optionValue
    );


  const rowData = [

    normalizedKey,

    optionValue,

    label || optionValue,

    Number(
      sortOrder || 0
    ),

    true

  ];


  if (
    existing !== -1
  ) {

    sheet
      .getRange(
        existing,
        1,
        1,
        rowData.length
      )
      .setValues([
        rowData
      ]);

  } else {

    sheet.appendRow(
      rowData
    );

  }


  return {

    success:
      true,

    key:
      normalizedKey,

    optionValue:
      optionValue,

    label:
      label || optionValue

  };

}


/************************************************
 * GET SETTING OPTIONS
 ************************************************/

function getMairixSettingOptions(
  key
) {

  const normalizedKey =
    mairixSettingsNormalizeKey(
      key
    );


  const sheet =
    mairixSettingsGetOptionsSheet();


  const lastRow =
    sheet.getLastRow();


  if (
    lastRow < 2
  ) {

    return [];

  }


  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        5
      )
      .getValues();


  return values
  .filter(
    function(row) {

      return (
        mairixCleanText(
          row[0]
        ).toUpperCase() ===
        normalizedKey &&
        String(
          row[4]
        ).toUpperCase() !==
        "FALSE"
      );

    }
  )

    .sort(
      function(a, b) {

        return (
          Number(a[3] || 0) -
          Number(b[3] || 0)
        );

      }
    )
    .map(
      function(row) {

        return {

          key:
            row[0],

          value:
            row[1],

          label:
            row[2],

          sortOrder:
            row[3],

          active:
            row[4]

        };

      }
    );

}


/************************************************
 * REMOVE SETTING OPTION
 ************************************************/

function removeMairixSettingOption(
  key,
  optionValue
) {

  const sheet =
    mairixSettingsGetOptionsSheet();


  const row =
    mairixSettingsFindOptionRow(
      sheet,
      mairixSettingsNormalizeKey(key),
      optionValue
    );


  if (
    row === -1
  ) {

    throw new Error(
      "Setting option not found."
    );

  }


  sheet
    .getRange(
      row,
      5
    )
    .setValue(
      false
    );


  return {

    success:
      true,

    removed:
      true

  };

}


/************************************************
 * VALIDATE OPTION SETTING
 ************************************************/

function validateMairixSettingOption(
  key,
  value
) {

  const options =
    getMairixSettingOptions(
      key
    );


  if (
    !options.length
  ) {

    return true;

  }


  const normalized =
    mairixCleanText(
      value
    );


  return options.some(
    function(option) {

      return (
        mairixCleanText(
          option.value
        ) ===
        normalized
      );

    }
  );

}


/************************************************
 * VALIDATE SETTING
 ************************************************/

function validateMairixSetting(
  key,
  value
) {

  const normalizedKey =
    mairixSettingsNormalizeKey(
      key
    );


  const definition =
    mairixSettingsGetDefinition(
      normalizedKey
    );


  if (
    !definition
  ) {

    throw new Error(
      "Unknown MAIRIX setting: " +
      normalizedKey
    );

  }


  const normalizedValue =
    mairixSettingsValidateAndNormalizeValue(
      value,
      definition
    );


  if (
    !validateMairixSettingOption(
      normalizedKey,
      normalizedValue
    )
  ) {

    throw new Error(
      "Invalid option for setting " +
      normalizedKey +
      ": " +
      normalizedValue
    );

  }


  return {

    valid:
      true,

    key:
      normalizedKey,

    value:
      normalizedValue

  };

}


/************************************************
 * SETTING TYPE CONVERTER
 ************************************************/

function mairixSettingsConvertValue(
  value,
  type
) {

  const normalizedType =
    mairixSettingsNormalizeType(
      type
    );


  if (
    value === null ||
    value === undefined
  ) {

    return null;

  }


  switch (
    normalizedType
  ) {

    case "BOOLEAN":

      if (
        typeof value ===
        "boolean"
      ) {

        return value;

      }


      const boolText =
        mairixCleanText(
          value
        ).toUpperCase();


      if (
        boolText === "TRUE" ||
        boolText === "1" ||
        boolText === "YES"
      ) {

        return true;

      }


      if (
        boolText === "FALSE" ||
        boolText === "0" ||
        boolText === "NO"
      ) {

        return false;

      }


      throw new Error(
        "Invalid BOOLEAN setting value: " +
        value
      );


    case "INTEGER":

      const integerValue =
        Number(
          value
        );


      if (
        !isFinite(integerValue) ||
        Math.floor(integerValue) !==
        integerValue
      ) {

        throw new Error(
          "Invalid INTEGER setting value: " +
          value
        );

      }


      return integerValue;


    case "NUMBER":

      const numberValue =
        Number(
          value
        );


      if (
        !isFinite(numberValue)
      ) {

        throw new Error(
          "Invalid NUMBER setting value: " +
          value
        );

      }


      return numberValue;


    case "PERCENT":

      const percentValue =
        Number(
          value
        );


      if (
        !isFinite(percentValue) ||
        percentValue < 0 ||
        percentValue > 100
      ) {

        throw new Error(
          "Invalid PERCENT setting value: " +
          value
        );

      }


      return percentValue;


    case "JSON":

      if (
        typeof value ===
        "object"
      ) {

        return value;

      }


      try {

        return JSON.parse(
          value
        );

      } catch (error) {

        throw new Error(
          "Invalid JSON setting value."
        );

      }


    case "TEXT":

    default:

      return mairixCleanText(
        value
      );

  }

}


/************************************************
 * VALIDATE + NORMALIZE VALUE
 ************************************************/

function mairixSettingsValidateAndNormalizeValue(
  value,
  definition
) {

  const normalizedType =
    mairixSettingsNormalizeType(
      definition.type
    );


  if (
    value === null ||
    value === undefined
  ) {

    throw new Error(
      "Setting value is required: " +
      definition.key
    );

  }


  const normalized =
    mairixSettingsConvertValue(
      value,
      normalizedType
    );


  /*
   * Business-level validations.
   */

  if (
    definition.key ===
    "INVENTORY_COST_METHOD"
  ) {

    if (
      String(
        normalized
      ).toUpperCase() !==
      "WAC"
    ) {

      throw new Error(
        "MAIRIX inventory cost method must remain WAC."
      );

    }

  }


  if (
    definition.key ===
    "COST_DECIMAL_PLACES"
  ) {

    if (
      normalized < 0 ||
      normalized > 6
    ) {

      throw new Error(
        "COST_DECIMAL_PLACES must be between 0 and 6."
      );

    }

  }


  if (
    definition.key ===
    "AMOUNT_DECIMAL_PLACES"
  ) {

    if (
      normalized < 0 ||
      normalized > 6
    ) {

      throw new Error(
        "AMOUNT_DECIMAL_PLACES must be between 0 and 6."
      );

    }

  }


  if (
    definition.key ===
    "QUANTITY_DECIMAL_PLACES"
  ) {

    if (
      normalized < 0 ||
      normalized > 6
    ) {

      throw new Error(
        "QUANTITY_DECIMAL_PLACES must be between 0 and 6."
      );

    }

  }


  if (
    definition.key ===
    "POINTS_PER_UNIT"
  ) {

    if (
      normalized < 0
    ) {

      throw new Error(
        "POINTS_PER_UNIT cannot be negative."
      );

    }

  }


  return normalized;

}


/************************************************
 * TYPE NORMALIZATION
 ************************************************/

function mairixSettingsNormalizeType(
  type
) {

  const normalized =
    mairixCleanText(
      type
    ).toUpperCase();


  const supported = [

    "TEXT",
    "BOOLEAN",
    "INTEGER",
    "NUMBER",
    "PERCENT",
    "JSON"

  ];


  if (
    supported.indexOf(
      normalized
    ) === -1
  ) {

    throw new Error(
      "Unsupported MAIRIX setting type: " +
      type
    );

  }


  return normalized;

}


/************************************************
 * KEY NORMALIZATION
 ************************************************/

function mairixSettingsNormalizeKey(
  key
) {

  const normalized =
    mairixCleanText(
      key
    ).toUpperCase();


  if (!normalized) {

    throw new Error(
      "MAIRIX setting key is required."
    );

  }


  if (
    !/^[A-Z0-9_]+$/.test(
      normalized
    )
  ) {

    throw new Error(
      "Invalid MAIRIX setting key: " +
      normalized
    );

  }


  return normalized;

}


/************************************************
 * GET DEFINITION
 ************************************************/

function mairixSettingsGetDefinition(
  key
) {

  const normalizedKey =
    mairixSettingsNormalizeKey(
      key
    );


  const defaults =
    mairixGetDefaultSettings();


  for (
    let i = 0;
    i < defaults.length;
    i++
  ) {

    if (
      defaults[i].key ===
      normalizedKey
    ) {

      return defaults[i];

    }

  }


  /*
   * Look inside SETTINGS itself so custom
   * registered settings are supported.
   */

  const sheet =
    mairixSettingsGetSheet();


  const row =
    mairixSettingsFindRow(
      sheet,
      normalizedKey
    );


  if (
    row === -1
  ) {

    return null;

  }


  const headers =
    mairixSettingsGetHeaders(
      sheet
    );


  const values =
    sheet
      .getRange(
        row,
        1,
        1,
        headers.length
      )
      .getValues()[0];


  const object = {};


  headers.forEach(
    function(header, index) {

      object[
        header
      ] =
        values[index];

    }
  );


  return {

    key:
      normalizedKey,

    type:
      mairixSettingsNormalizeType(
        object.TYPE || "TEXT"
      ),

    category:
      mairixCleanText(
        object.CATEGORY ||
        "CUSTOM"
      ).toUpperCase(),

    defaultValue:
      object[
        "DEFAULT VALUE"
      ],

    editable:
      object.EDITABLE !== false &&
      String(
        object.EDITABLE
      ).toUpperCase() !==
      "FALSE",

    description:
      mairixCleanText(
        object.DESCRIPTION
      )

  };

}


/************************************************
 * BUILD SETTINGS ROW
 ************************************************/

function mairixSettingsBuildRow(
  key,
  value,
  definition
) {

  return [

    key,

    value,

    definition.type ||
      "TEXT",

    definition.category ||
      "CUSTOM",

    definition.defaultValue,

    definition.editable !== false,

    definition.description ||
      "",

    MAIRIX_SETTINGS.STATUS_ACTIVE,

    "SYSTEM",

    new Date()

  ];

}


/************************************************
 * UPDATE METADATA
 ************************************************/

function mairixSettingsUpdateMetadata(
  sheet,
  row,
  definition
) {

  const headers =
    mairixSettingsGetHeaders(
      sheet
    );


  const mappings = {

    "TYPE":
      definition.type,

    "CATEGORY":
      definition.category,

    "DEFAULT VALUE":
      definition.defaultValue,

    "EDITABLE":
      definition.editable,

    "DESCRIPTION":
      definition.description

  };


  Object.keys(
    mappings
  ).forEach(
    function(header) {

      const index =
        headers.indexOf(
          header
        );


      if (
        index !== -1
      ) {

        sheet
          .getRange(
            row,
            index + 1
          )
          .setValue(
            mappings[header]
          );

      }

    }
  );

}


/************************************************
 * UPDATE METADATA BY KEY
 ************************************************/

function mairixSettingsUpdateMetadataByKey(
  key,
  user
) {

  const sheet =
    mairixSettingsGetSheet();


  const row =
    mairixSettingsFindRow(
      sheet,
      key
    );


  if (
    row === -1
  ) {

    return;

  }


  const headers =
    mairixSettingsGetHeaders(
      sheet
    );


  const userIndex =
    headers.indexOf(
      "UPDATED BY"
    );


  const dateIndex =
    headers.indexOf(
      "UPDATED AT"
    );


  if (
    userIndex !== -1
  ) {

    sheet
      .getRange(
        row,
        userIndex + 1
      )
      .setValue(
        user
          ? user.userId
          : "SYSTEM"
      );

  }


  if (
    dateIndex !== -1
  ) {

    sheet
      .getRange(
        row,
        dateIndex + 1
      )
      .setValue(
        new Date()
      );

  }

}


/************************************************
 * GET SETTINGS SHEET
 ************************************************/

function mairixSettingsGetSheet() {

  const ss =
    SpreadsheetApp
      .getActiveSpreadsheet();


  if (!ss) {

    throw new Error(
      "Active spreadsheet is not available."
    );

