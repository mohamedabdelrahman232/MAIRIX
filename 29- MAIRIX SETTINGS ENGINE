/************************************************
 * SEED DEFAULT SETTINGS
 ************************************************/

function mairixSettingsSeedDefaults() {

  const sheet =
    mairixSettingsGetSheet();


  const definitions =
    mairixGetDefaultSettings();


  definitions.forEach(
    function(definition) {

      const existing =
        mairixSettingsFindRow(
          sheet,
          definition.key
        );


      if (
        existing !== -1
      ) {

        /*
         * Do not overwrite an existing
         * runtime value.
         */

        mairixSettingsUpdateMetadata(
          sheet,
          existing,
          definition
        );

        return;

      }


      const row =
        mairixSettingsBuildRow(
          definition.key,
          definition.defaultValue,
          definition
        );


      sheet.appendRow(
        row
      );

    }
  );

}


/************************************************
 * GET SETTING
 *
 * This is the preferred typed API.
 ************************************************/

function getMairixRuntimeSetting(
  key,
  options
) {

  const normalizedKey =
    mairixSettingsNormalizeKey(
      key
    );


  const definition =
    mairixSettingsGetDefinition(
      normalizedKey
    );


  const raw =
    getMairixSetting(
      normalizedKey
    );


  if (
    raw === null ||
    raw === undefined ||
    mairixCleanText(raw) === ""
  ) {

    if (
      definition
    ) {

      return mairixSettingsConvertValue(
        definition.defaultValue,
        definition.type
      );

    }


    return null;

  }


  const type =
    definition
      ? definition.type
      : (
          options &&
          options.type
            ? options.type
            : "TEXT"
        );


  return mairixSettingsConvertValue(
    raw,
    type
  );

}


/************************************************
 * GET SETTING WITH DEFAULT
 ************************************************/

function getMairixRuntimeSettingOrDefault(
  key,
  defaultValue,
  type
) {

  const value =
    getMairixRuntimeSetting(
      key,
      {
        type:
          type || "TEXT"
      }
    );


  if (
    value === null ||
    value === undefined ||
    value === ""
  ) {

    return defaultValue;

  }


  return value;

}


