/************************************************
 * FIND SETTINGS ROW
 ************************************************/

function mairixSettingsFindRow(
  sheet,
  key
) {

  const lastRow =
    sheet.getLastRow();


  if (
    lastRow < 2
  ) {

    return -1;

  }


  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        1
      )
      .getDisplayValues();


  const normalized =
    mairixSettingsNormalizeKey(
      key
    );


  for (
    let i = 0;
    i < values.length;
    i++
  ) {

    if (
      mairixCleanText(
        values[i][0]
      ).toUpperCase() ===
      normalized
    ) {

      return i + 2;

    }

  }


  return -1;

}


/************************************************
 * FIND OPTION ROW
 ************************************************/

function mairixSettingsFindOptionRow(
  sheet,
  key,
  optionValue
) {

  const lastRow =
    sheet.getLastRow();


  if (
    lastRow < 2
  ) {

    return -1;

  }


  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        2
      )
      .getDisplayValues();


  const normalizedKey =
    mairixSettingsNormalizeKey(
      key
    );


  const normalizedValue =
    mairixCleanText(
      optionValue
    );


  for (
    let i = 0;
    i < values.length;
    i++
  ) {

    if (
      mairixCleanText(
        values[i][0]
      ).toUpperCase() ===
      normalizedKey &&
      mairixCleanText(
        values[i][1]
      ) ===
      normalizedValue
    ) {

      return i + 2;

    }

  }


  return -1;

}


/************************************************
 * GET HEADERS
 ************************************************/

function mairixSettingsGetHeaders(
  sheet
) {

  return sheet
    .getRange(
      1,
      1,
      1,
      sheet.getLastColumn()
    )
    .getDisplayValues()[0]
    .map(
      function(header) {

        return mairixCleanText(
          header
        ).toUpperCase();

      }
    );

}


/************************************************
 * ENSURE HEADERS
 ************************************************/

function mairixSettingsEnsureHeaders(
  sheet,
  requiredHeaders
) {

  if (
    sheet.getLastRow() === 0
  ) {

    sheet
      .getRange(
        1,
        1,
        1,
        requiredHeaders.length
      )
      .setValues([
        requiredHeaders
      ]);

    return;

  }


  const currentLastColumn =
    Math.max(
      sheet.getLastColumn(),
      requiredHeaders.length
    );


  const existing =
    sheet
      .getRange(
        1,
        1,
        1,
        currentLastColumn
      )
      .getDisplayValues()[0];


  requiredHeaders.forEach(
    function(header, index) {

      if (
        mairixCleanText(
          existing[index]
        ).toUpperCase() !==
        header
      ) {

        sheet
          .getRange(
            1,
            index + 1
          )
          .setValue(
            header
          );

      }

    }
  );

}


/************************************************
 * CREATE SHEET
 ************************************************/

function mairixSettingsGetOrCreateSheet(
  ss,
  name
) {

  let sheet =
    ss.getSheetByName(
      name
    );


  if (!sheet) {

    sheet =
      ss.insertSheet(
        name
      );

  }


  return sheet;

}


/************************************************
 * FORMATTING
 ************************************************/

function mairixSettingsApplyFormatting(
  settingsSheet,
  optionsSheet
) {

  if (
    settingsSheet.getLastColumn() >=
    MAIRIX_SETTINGS_HEADERS.length
  ) {

    settingsSheet
      .getRange(
        1,
        1,
        1,
        MAIRIX_SETTINGS_HEADERS.length
      )
      .setFontWeight(
        "bold"
      );

  }


  if (
    optionsSheet.getLastColumn() >=
    MAIRIX_SETTINGS_OPTION_HEADERS.length
  ) {

    optionsSheet
      .getRange(
        1,
        1,
        1,
        MAIRIX_SETTINGS_OPTION_HEADERS.length
      )
      .setFontWeight(
        "bold"
      );

  }


  settingsSheet
    .setFrozenRows(1);


  optionsSheet
    .setFrozenRows(1);

}


