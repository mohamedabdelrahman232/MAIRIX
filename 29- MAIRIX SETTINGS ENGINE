/************************************************
 * AUDIT BRIDGE
 ************************************************/

function mairixSettingsAudit(
  action,
  key,
  oldValue,
  newValue,
  user
) {

  try {

    if (
      MAIRIX.SECURITY &&
      MAIRIX.SECURITY.AUDIT_ENABLED !== true
    ) {

      return;

    }


    if (
      typeof logAction ===
      "function"
    ) {

      logAction(

        action,

        key,

        "Old Value: " +
          mairixSettingsAuditValue(
            oldValue
          ) +
          " | New Value: " +
          mairixSettingsAuditValue(
            newValue
          )

      );

      return;

    }


    const ss =
      SpreadsheetApp
        .getActiveSpreadsheet();


    let sheet =
      ss.getSheetByName(
        "MAIRIX_AUDIT"
      );


    if (!sheet) {

      sheet =
        ss.insertSheet(
          "MAIRIX_AUDIT"
        );


      sheet
        .appendRow([

          "Timestamp",
          "User ID",
          "Action",
          "Reference",
          "Details"

        ]);

    }


    sheet.appendRow([

      new Date(),

      user
        ? user.userId
        : "SYSTEM",

      action,

      key,

      "Old Value: " +
        mairixSettingsAuditValue(
          oldValue
        ) +
        " | New Value: " +
        mairixSettingsAuditValue(
          newValue
        )

    ]);

  } catch (error) {

    Logger.log(
      "Settings audit failed: " +
      error.message
    );

  }

}


/************************************************
 * AUDIT VALUE
 ************************************************/

function mairixSettingsAuditValue(
  value
) {

  if (
    value === null ||
    value === undefined
  ) {

    return "";

  }


  if (
    typeof value ===
    "object"
  ) {

    try {

      return JSON.stringify(
        value
      );

    } catch (error) {

      return String(
        value
      );

    }

  }


  return String(
    value
  );

}


/************************************************
 * SETTINGS SELF TEST
 ************************************************/

function testMairixSettingsSetup() {

  const result =
    setupMairixSettings();


  if (
    !result ||
    result.success !== true
  ) {

    throw new Error(
      "MAIRIX Settings setup failed."
    );

  }


  const systemName =
    getMairixRuntimeSetting(
      "SYSTEM_NAME"
    );


  if (
    systemName !==
    MAIRIX.SYSTEM_NAME
  ) {

    throw new Error(
      "SYSTEM_NAME setting test failed."
    );

  }


  const currency =
    getMairixRuntimeSetting(
      "REPORTING_CURRENCY"
    );


  if (
    currency !==
    MAIRIX.ACCOUNTING.REPORTING_CURRENCY
  ) {

    throw new Error(
      "REPORTING_CURRENCY setting test failed."
    );

  }


  const loyalty =
    getMairixRuntimeSetting(
      "LOYALTY_ENABLED"
    );


  if (
    loyalty !==
    true
  ) {

    throw new Error(
      "LOYALTY_ENABLED setting test failed."
    );

  }


  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX SETTINGS SETUP TEST: PASS"
  );

  Logger.log(
    "=========================================="
  );


  return {

    success:
      true

  };

}


