/************************************************
 * CLEAN TEXT
 *
 * Normalizes text safely.
 ************************************************/

function mairixcleanText(value) {

  if (
    value === null ||
    value === undefined
  ) {

    return "";

  }


  return String(value)
    .trim()
    .replace(/\s+/g, " ");

}


/************************************************
 * BACKWARD COMPATIBILITY ALIAS
 *
 * Some MAIRIX modules/tests may reference
 * mairixCleanText().
 ************************************************/

function mairixCleanText(value) {

  return mairixcleanText(
    value
  );

}


/************************************************
 * GET SHEET
 *
 * Returns a sheet by its actual name.
 *
 * Throws a clear error when the sheet
 * does not exist.
 ************************************************/

function mairixgetSheet(sheetName) {

  const normalizedSheetName =
    mairixcleanText(
      sheetName
    );


  if (
    !normalizedSheetName
  ) {

    throw new Error(
      "Sheet name is required."
    );

  }


  const spreadsheet =
    SpreadsheetApp
      .getActiveSpreadsheet();


  const sheet =
    spreadsheet.getSheetByName(
      normalizedSheetName
    );


  if (
    !sheet
  ) {

    throw new Error(
      "Missing sheet: " +
      normalizedSheetName
    );

  }


  return sheet;

}


/************************************************
 * GET COLUMN NUMBER
 *
 * Finds a column by its header name.
 *
 * Returns a 1-based column number because
 * Google Sheets APIs use 1-based indexes.
 ************************************************/

function mairixgetColumnNumber(
  sheet,
  headerName
) {

  if (
    !sheet
  ) {

    throw new Error(
      "Sheet is required."
    );

  }


  const normalizedHeader =
    mairixcleanText(
      headerName
    );


  if (
    !normalizedHeader
  ) {

    throw new Error(
      "Header name is required."
    );

  }


  const lastColumn =
    sheet.getLastColumn();


  if (
    lastColumn < 1
  ) {

    throw new Error(
      "Sheet has no columns: " +
      sheet.getName()
    );

  }


  const headers =
    sheet
      .getRange(
        1,
        1,
        1,
        lastColumn
      )
      .getValues()[0];


  for (
    let index = 0;
    index < headers.length;
    index++
  ) {

    if (
      mairixcleanText(
        headers[index]
      ) === normalizedHeader
    ) {

      return index + 1;

    }

  }


  throw new Error(
    "Missing column [" +
    normalizedHeader +
    "] in sheet [" +
    sheet.getName() +
    "]"
  );

}

/************************************************
 * MAIRIX SECURITY CONTRACT COMPATIBILITY
 *
 * PURPOSE:
 * Provide the security contracts expected by
 * MAIRIX modules and the Central Test Suite.
 *
 * IMPORTANT:
 * These functions DO NOT grant permissions
 * automatically.
 *
 * The actual permission engine remains the
 * authority whenever available.
 ************************************************/


/************************************************
 * REQUIRE ACTIVE USER
 *
 * Returns the authenticated MAIRIX user.
 *
 * SECURITY RULE:
 * Never invent an active user.
 * Never silently grant access.
 ************************************************/

function requireActiveUser() {

  /**********************************************
   * Preferred MAIRIX authenticated context
   **********************************************/

  if (
    typeof mairixApiContext === "function"
  ) {

    const context =
      mairixApiContext();


    if (
      context &&
      context.userId
    ) {

      return context;

    }

  }


  /**********************************************
   * Fallback:
   * Resolve the Apps Script active user email.
   **********************************************/

  const email =
    String(
      Session
        .getActiveUser()
        .getEmail() ||
      ""
    )
    .trim();


  if (!email) {

    throw new Error(
      "Unable to identify the active MAIRIX user."
    );

  }


  /**********************************************
   * If a MAIRIX user lookup engine exists,
   * use it.
   **********************************************/

  if (
    typeof mairixGetUserByEmail ===
    "function"
  ) {

    const user =
      mairixGetUserByEmail(
        email
      );


    if (
      !user
    ) {

      throw new Error(
        "Active MAIRIX user was not found."
      );

    }


    if (
      user.active === false ||
      user.Active === false
    ) {

      throw new Error(
        "Active MAIRIX user is inactive."
      );

    }


    return user;

  }


  /**********************************************
   * Contract-level fallback.
   *
   * This identifies the authenticated account
   * only. It does NOT grant any permission.
   **********************************************/

  return {

    email:
      email,

    active:
      true

  };

}


/************************************************
 * REQUIRE REPORT PERMISSION
 *
 * Delegates authorization to the actual
 * MAIRIX permission engine.
 ************************************************/

function requireReportPermission(
  permissionCode,
  action
) {

  const user =
    requireActiveUser();


  const requiredAction =
    action ||
    "View";


  /**********************************************
   * Preferred permission guard
   **********************************************/

  if (
    typeof mairixApiRequirePermission ===
    "function"
  ) {

    return mairixApiRequirePermission(
      permissionCode,
      requiredAction
    );

  }


  /**********************************************
   * Permission engine
   **********************************************/

  if (
    typeof mairixHasPermission ===
    "function"
  ) {

    const userId =
      user.userId ||
      user["User ID"] ||
      user.id;


    if (
      !userId
    ) {

      throw new Error(
        "Cannot resolve MAIRIX User ID for permission validation."
      );

    }


    const allowed =
      mairixHasPermission(
        userId,
        permissionCode,
        requiredAction
      );


    if (
      allowed !== true
    ) {

      throw new Error(
        "Permission denied: " +
        permissionCode +
        " / " +
        requiredAction
      );

    }


    return {

      success:
        true,

      user:
        user,

      permission:
        permissionCode,

      action:
        requiredAction

    };

  }


  throw new Error(
    "MAIRIX permission engine is unavailable."
  );

}


/************************************************
 * GENERIC PERMISSION CONTRACT
 *
 * Used by modules that require a centralized
 * permission gateway.
 ************************************************/

function requireERPPermission(
  permissionCode,
  action
) {

  return requireReportPermission(
    permissionCode,
    action
  );

}

/**
 * MAIRIX ERP
 * Central Boolean Normalizer
 *
 * Converts spreadsheet/config values into a reliable boolean.
 */
function isTrueValue(value) {
  if (value === true) return true;
  if (value === false || value === null || value === undefined) return false;

  if (typeof value === 'number') {
    return value === 1;
  }

  var normalized = String(value)
    .trim()
    .toLowerCase();

  return [
    'true',
    '1',
    'yes',
    'y',
    'on',
    'active',
    'enabled'
  ].indexOf(normalized) !== -1;
}
