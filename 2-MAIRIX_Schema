/************************************************
 * CREATE / REBUILD EMPTY SYSTEM
 *
 * RUN THIS ON THE NEW WHITE SHEET.
 *
 * WARNING:
 *
 * This function intentionally clears the
 * MAIRIX-created sheets before rebuilding them.
 *
 * It does NOT touch unrelated sheets.
 ************************************************/

function setupMairixSystem() {

  const ss =
    SpreadsheetApp
      .getActiveSpreadsheet();


  const sheetNames =
    Object.keys(
      MAIRIX.SHEETS
    ).map(
      function(key) {

        return MAIRIX.SHEETS[key];

      }
    );


  Logger.log(
    "RUNTIME COMMISSION_LEDGER SCHEMA = " +
    JSON.stringify(
      MAIRIX_SCHEMA.HEADERS.COMMISSION_LEDGER
    )
  );


  Logger.log(
    "RUNTIME COMMISSION_RULES SCHEMA = " +
    JSON.stringify(
      MAIRIX_SCHEMA.HEADERS.COMMISSION_RULES
    )
  );


  Logger.log(
    "RUNTIME FINANCIAL_EFFECTS SCHEMA = " +
    JSON.stringify(
      MAIRIX_SCHEMA.HEADERS.FINANCIAL_EFFECTS
    )
  );


  Logger.log(
    "RUNTIME FINANCIAL_STATEMENTS SCHEMA = " +
    JSON.stringify(
      MAIRIX_SCHEMA.HEADERS.FINANCIAL_STATEMENTS
    )
  );


  /**********************************************
   * CREATE SHEETS
   **********************************************/

  sheetNames.forEach(
    function(sheetName) {

      let sheet =
        ss.getSheetByName(
          sheetName
        );


      if (!sheet) {

        sheet =
          ss.insertSheet(
            sheetName
          );

      }


      sheet.clear();


      const schemaKey =
        Object.keys(
          MAIRIX.SHEETS
        ).find(
          function(key) {

            return (
              MAIRIX.SHEETS[key] ===
              sheetName
            );

          }
        );


      const headers =
        MAIRIX_SCHEMA.HEADERS[
          schemaKey
        ];


      if (!headers) {

        throw new Error(
          "Missing schema headers for: " +
          sheetName
        );

      }


      sheet
        .getRange(
          1,
          1,
          1,
          headers.length
        )
        .setValues([
          headers
        ]);


      formatSchemaHeader(
        sheet,
        headers.length
      );

    }
  );


  /**********************************************
   * INITIAL SETTINGS
   **********************************************/

  seedMairixSettings();


  /**********************************************
   * INITIAL TAX STRUCTURE
   **********************************************/

  seedMairixTaxTypes();


  /**********************************************
   * INITIAL FINANCIAL STRUCTURE
   **********************************************/

  seedMairixFinancialAccounts();


  /**********************************************
   * INITIAL PERMISSION CATALOG
   **********************************************/

  seedMairixPermissionCatalog();


  /**********************************************
   * INITIAL ROLES
   **********************************************/

  seedMairixRoles();


  Logger.log(
    "=========================================="
  );


  Logger.log(
    "MAIRIX SYSTEM STRUCTURE CREATED"
  );


  Logger.log(
    "Schema Version: " +
    MAIRIX_SCHEMA.VERSION
  );


  Logger.log(
    "=========================================="
  );


  return {

    success:
      true,

    schemaVersion:
      MAIRIX_SCHEMA.VERSION,

    sheetsCreated:
      sheetNames.length

  };

}


/************************************************
 * HEADER FORMAT
 ************************************************/

function formatSchemaHeader(
  sheet,
  numberOfColumns
) {

  if (!sheet) {

    throw new Error(
      "formatSchemaHeader: sheet is required."
    );

  }


  if (
    !numberOfColumns ||
    numberOfColumns < 1
  ) {

    return;

  }


  sheet
    .setFrozenRows(
      1
    );


  sheet
    .getRange(
      1,
      1,
      1,
      numberOfColumns
    )
    .setFontWeight(
      "bold"
    );


  sheet
    .getRange(
      1,
      1,
      1,
      numberOfColumns
    )
    .setWrap(
      true
    );


  sheet.autoResizeColumns(
    1,
    numberOfColumns
  );

}


