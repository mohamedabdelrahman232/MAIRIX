/************************************************
 * GET SCHEMA SHEET
 ************************************************/

function getMairixSchemaSheet(
  schemaKey
) {

  const sheetName =
    MAIRIX.SHEETS[
      schemaKey
    ];


  if (!sheetName) {

    throw new Error(
      "Unknown MAIRIX schema key: " +
      schemaKey
    );

  }


  const sheet =
    SpreadsheetApp
      .getActiveSpreadsheet()
      .getSheetByName(
        sheetName
      );


  if (!sheet) {

    throw new Error(
      "Required MAIRIX sheet does not exist: " +
      sheetName
    );

  }


  return sheet;

}


/************************************************
 * SCHEMA VALIDATION
 ************************************************/

function validateMairixSchema() {

  const ss =
    SpreadsheetApp
      .getActiveSpreadsheet();


  const results = [];


  Object.keys(
    MAIRIX.SHEETS
  ).forEach(
    function(schemaKey) {

      const sheetName =
        MAIRIX.SHEETS[
          schemaKey
        ];


      const expected =
        MAIRIX_SCHEMA.HEADERS[
          schemaKey
        ];


      const sheet =
        ss.getSheetByName(
          sheetName
        );


      if (!sheet) {

        results.push({

          sheet:
            sheetName,

          status:
            "MISSING"

        });

        return;

      }


      const rawActual =
        sheet
          .getRange(
            1,
            1,
            1,
            sheet.getLastColumn()
          )
          .getDisplayValues()[0];


      const actual =
        rawActual
          .map(
            function(header) {

              return String(
                header
              ).trim();

            }
          );


      while (
        actual.length > 0 &&
        actual[
          actual.length - 1
        ] === ""
      ) {

        actual.pop();

      }


      const same =
        expected.length ===
          actual.length &&
        expected.every(
          function(header, index) {

            return (
              header ===
              actual[index]
            );

          }
        );


      results.push({

        sheet:
          sheetName,

        status:
          same
            ? "OK"
            : "INVALID"

      });

    }
  );


  const invalid =
    results.filter(
      function(result) {

        return (
          result.status !==
          "OK"
        );

      }
    );


  Logger.log(
    JSON.stringify(
      results,
      null,
      2
    )
  );


  if (
    invalid.length
  ) {

    throw new Error(
      "MAIRIX schema validation failed. Invalid sheets: " +
      invalid
        .map(
          function(item) {

            return item.sheet;

          }
        )
        .join(", ")
    );

  }


  Logger.log(
    "MAIRIX SCHEMA VALIDATION: PASS"
  );


  return {

    success:
      true,

    sheets:
      results.length

  };

}


/************************************************
 * MAIRIX - GET COLUMN NUMBER
 ************************************************/

function mairixgetColumnNumber(
  sheet,
  headerName
) {

  if (!sheet) {

    throw new Error(
      "mairixgetColumnNumber: sheet is required."
    );

  }


  if (
    headerName === null ||
    headerName === undefined ||
    String(headerName).trim() === ""
  ) {

    throw new Error(
      "mairixgetColumnNumber: header name is required."
    );

  }


  const lastColumn =
    sheet.getLastColumn();


  if (
    !lastColumn ||
    lastColumn < 1
  ) {

    throw new Error(
      "mairixgetColumnNumber: sheet has no columns."
    );

  }


  const headers =
    sheet
      .getRange(
        1,
        1,
        1,
        lastColumn
      )
      .getDisplayValues()[0];


  const target =
    String(headerName)
      .trim();


  for (
    let i = 0;
    i < headers.length;
    i++
  ) {

    if (
      String(
        headers[i]
      ).trim() ===
      target
    ) {

      return i + 1;

    }

  }


  throw new Error(
    'mairixgetColumnNumber: Header "' +
    target +
    '" was not found.'
  );

}


/************************************************
 * MAIRIX - SCHEMA HEADER DIAGNOSTIC
 ************************************************/

function diagnoseMairixSchemaHeaders() {

  const ss =
    SpreadsheetApp
      .getActiveSpreadsheet();


  const problems = [];


  Object.keys(
    MAIRIX.SHEETS
  ).forEach(
    function(schemaKey) {

      const sheetName =
        MAIRIX.SHEETS[
          schemaKey
        ];


      const expected =
        MAIRIX_SCHEMA.HEADERS[
          schemaKey
        ];


      const sheet =
        ss.getSheetByName(
          sheetName
        );


      if (!sheet) {

        return;

      }


      const rawActual =
        sheet
          .getRange(
            1,
            1,
            1,
            sheet.getLastColumn()
          )
          .getDisplayValues()[0];


      const actual =
        rawActual
          .map(
            function(header) {

              return String(
                header
              ).trim();

            }
          );


      while (
        actual.length > 0 &&
        actual[
          actual.length - 1
        ] === ""
      ) {

        actual.pop();

      }


      const same =
        expected.length ===
          actual.length &&
        expected.every(
          function(header, index) {

            return (
              String(header).trim() ===
              String(actual[index]).trim()
            );

          }
        );


      if (same) {

        return;

      }


      Logger.log(
        "=========================================="
      );


      Logger.log(
        "SCHEMA HEADER MISMATCH: " +
        sheetName
      );


      Logger.log(
        "Expected:"
      );


      Logger.log(
        JSON.stringify(
          expected,
          null,
          2
        )
      );


      Logger.log(
        "Actual:"
      );


      Logger.log(
        JSON.stringify(
          actual,
          null,
          2
        )
      );


      const maxLength =
        Math.max(
          expected.length,
          actual.length
        );


      for (
        let i = 0;
        i < maxLength;
        i++
      ) {

        const e =
          expected[i] !== undefined
            ? String(expected[i])
            : "<MISSING>";


        const a =
          actual[i] !== undefined
            ? String(actual[i])
            : "<MISSING>";


        if (
          e !== a
        ) {

          Logger.log(
            "Column " +
            (i + 1) +
            " | Expected: [" +
            e +
            "] | Actual: [" +
            a +
            "]"
          );

        }

      }


      problems.push({

        sheet:
          sheetName,

        expected:
          expected,

        actual:
          actual

      });

    }
  );


  Logger.log(
    "=========================================="
  );


  Logger.log(
    "MAIRIX SCHEMA HEADER DIAGNOSTIC"
  );


  Logger.log(
    "Mismatched sheets: " +
    problems.length
  );


  Logger.log(
    JSON.stringify(
      problems,
      null,
      2
    )
  );


  return problems;

}


