/************************************************
 * MAIRIX ERP
 * UI APPLICATION SHELL
 *
 * FILE:
 * MAIRIX_UI_App.gs
 *
 * PURPOSE:
 *
 * 1. Web App entry point.
 * 2. Serve the MAIRIX UI.
 * 3. Provide the application shell bootstrap.
 * 4. Keep UI routing separate from business logic.
 * 5. Never access Sheets directly from the UI.
 * 6. Never perform authorization decisions here.
 *
 * IMPORTANT:
 *
 * UI = Presentation / Interaction Layer
 *
 * AUTHORIZATION remains server-side.
 * TRANSACTIONS remain server-side.
 * VALIDATION remains server-side.
 * DATABASE access remains server-side.
 ************************************************/


/************************************************
 * WEB APP ENTRY POINT
 ************************************************/

function doGet() {

  return HtmlService
    .createTemplateFromFile(
      'MAIRIX_UI_Index'
    )
    .evaluate()
    .setTitle(
      'MAIRIX ERP'
    )
    .setXFrameOptionsMode(
      HtmlService.XFrameOptionsMode.ALLOWALL
    );

}


/************************************************
 * INCLUDE UI FILE
 *
 * Used later for modular HTML files.
 *
 * Example:
 *
 * <?!= include('MAIRIX_UI_Components'); ?>
 *
 * IMPORTANT:
 *
 * This is only an HTML composition helper.
 * It does not access business data.
 ************************************************/

function include(
  filename
) {

  if (
    !filename ||
    typeof filename !== 'string'
  ) {

    throw new Error(
      'Invalid UI include filename.'
    );

  }


  return HtmlService
    .createHtmlOutputFromFile(
      filename
    )
    .getContent();

}


/************************************************
 * UI APPLICATION CONFIGURATION
 *
 * Static UI configuration only.
 *
 * No sensitive information.
 * No passwords.
 * No authorization secrets.
 * No database credentials.
 ************************************************/

function apiGetUIConfiguration() {

  return {

    success:
      true,

    application:
      'MAIRIX ERP',

    version:
      '1.0',

    ui:
      {

        defaultLanguage:
          'ar',

        direction:
          'rtl',

        initialSaleRows:
          5,

        allowAdditionalSaleRows:
          true

      }

  };

}


/************************************************
 * APPLICATION HEALTH CHECK
 *
 * This does NOT replace transaction validation
 * or authorization.
 *
 * It only verifies that the UI backend endpoint
 * is reachable.
 ************************************************/

function apiUIHealthCheck() {

  return {

    success:
      true,

    service:
      'MAIRIX ERP UI',

    status:
      'AVAILABLE'

  };

}


