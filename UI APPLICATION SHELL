/************************************************
 * APPLICATION START CONTRACT
 *
 * The Index file calls this function if the
 * Application Shell is loaded.
 *
 * IMPORTANT:
 *
 * This function does not authenticate a user.
 *
 * Authentication / current-user resolution is
 * performed by the existing server-side user
 * context contract.
 ************************************************/

function apiInitializeApplication() {

  var userResult =
    apiGetCurrentUser();

  if (
    !userResult ||
    userResult.success !== true
  ) {

    return {

      success:
        false,

      error:
        {

          code:
            'UI_USER_CONTEXT_FAILED',

          message:
            'تعذر الحصول على بيانات المستخدم الحالي.'

        }

    };

  }


  var configuration =
    apiGetUIConfiguration();


  var routes =
    apiGetUIRoutes();


  return {

    success:
      true,

    user:
      userResult,

    configuration:
      configuration,

    routes:
      routes

  };

}


/************************************************
 * SERVER-SIDE CURRENT USER CONTRACT
 *
 * IMPORTANT:
 *
 * Do NOT trust a userId supplied by the UI.
 *
 * The existing MAIRIX access layer is the
 * authority for resolving the authenticated
 * user.
 *
 * This wrapper intentionally delegates to the
 * existing function if available.
 ************************************************/

function apiGetCurrentUser() {

  /*
   * Existing MAIRIX user-context implementation
   * must be used here.
   *
   * This wrapper does not accept userId.
   */


  if (
    typeof getCurrentUserContext ===
    'function'
  ) {

    return getCurrentUserContext();

  }


  if (
    typeof getCurrentUser ===
    'function'
  ) {

    return getCurrentUser();

  }


  /*
   * Do not silently invent a user.
   *
   * If the project does not expose the expected
   * current-user contract, fail closed.
   */

  return {

    success:
      false,

    error:
      {

        code:
          'CURRENT_USER_API_NOT_AVAILABLE',

        message:
          'خدمة المستخدم الحالي غير متاحة.'

      }

  };

}


/************************************************
 * UI ROUTE ACCESS HELPER
 *
 * IMPORTANT:
 *
 * This function is NOT an authorization engine.
 *
 * It only resolves whether a UI route exists.
 *
 * Actual permission checking must be performed
 * by the server-side Access Control layer.
 ************************************************/

function apiResolveUIRoute(
  routeId
) {

  if (
    !routeId ||
    typeof routeId !== 'string'
  ) {

    return {

      success:
        false,

      error:
        {

          code:
            'INVALID_ROUTE_ID',

          message:
            'Route ID غير صالح.'

        }

    };

  }


  var result =
    apiGetUIRoutes();


  if (
    !result ||
    result.success !== true
  ) {

    return {

      success:
        false,

      error:
        {

          code:
            'UI_ROUTES_UNAVAILABLE',

          message:
            'تعذر تحميل مسارات الواجهة.'

        }

    };

  }


  for (
    var i = 0;
    i < result.routes.length;
    i++
  ) {

    if (
      result.routes[i].id ===
      routeId
    ) {

      return {

        success:
          true,

        route:
          result.routes[i]

      };

    }

  }


  return {

    success:
      false,

    error:
      {

        code:
          'ROUTE_NOT_FOUND',

        message:
          'الشاشة المطلوبة غير موجودة.'

      }

  };

}
