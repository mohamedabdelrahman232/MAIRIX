/************************************************
 * SALESMAN CONSISTENCY
 *
 * IMPORTANT:
 *
 * A salesman code supplied by the UI is NOT
 * an authentication identity.
 *
 * For salesman users, the runtime must resolve
 * the authenticated salesman profile.
 ************************************************/

function mairixValidateSalesmanForTransaction(
  salesmanCode
) {

  const requestedCode =
    String(
      salesmanCode ||
      ""
    )
      .trim();


  if (!requestedCode) {

    throw new Error(
      "Salesman Code is required."
    );

  }


  const context =
    mairixTransactionAuthCurrentUser();


  const userId =
    context.userId;


  if (
    typeof mairixRuntimeGetSalesmanForUser !==
    "function"
  ) {

    /*
     * Do not silently trust the submitted
     * salesman code.
     */

    throw new Error(
      "Salesman authorization runtime is unavailable."
    );

  }


  const salesman =
    mairixRuntimeGetSalesmanForUser(
      userId
    );


  if (!salesman) {

    throw new Error(
      "Authenticated user is not linked to an active salesman profile."
    );

  }


  const resolvedCode =
    String(
      salesman["Salesman Code"] ||
      ""
    )
      .trim();


  if (
    resolvedCode !==
    requestedCode
  ) {

    mairixTransactionAuthRecordRejection(
      userId,
      "SALE",
      "SALESMAN_MISMATCH: " +
      requestedCode +
      " != " +
      resolvedCode
    );


    throw new Error(
      "Salesman does not match the authenticated user."
    );

  }


  return salesman;

}


/************************************************
 * BUILD AUTHORIZED TRANSACTION CONTEXT
 *
 * This creates a server-side context object
 * that can be passed to the business layer.
 *
 * No client identity is copied into it.
 ************************************************/

function mairixBuildAuthorizedTransactionContext(
  transactionType,
  action,
  warehouseCode
) {

  const authorization =
    mairixRequireTransactionAuthorization(
      transactionType,
      action,
      warehouseCode
    );


  const context =
    mairixTransactionAuthCurrentUser();


  return {

    authorized:
      true,

    userId:
      context.userId,

    email:
      context.email ||
      "",

    name:
      context.name ||
      "",

    role:
      context.role ||
      "",

    transactionType:
      authorization.transactionType,

    action:
      authorization.action,

    permissionCode:
      authorization.permissionCode,

    warehouseCode:
      authorization.warehouseCode

  };

}


/************************************************
 * SANITIZE TRANSACTION REQUEST
 *
 * SECURITY RULE:
 *
 * UI supplied identity fields are removed.
 *
 * The caller may still submit:
 *
 * - customerCode
 * - salesmanCode
 * - warehouseCode
 * - paymentMethod
 * - items
 * - notes
 *
 * But user identity is always server-owned.
 ************************************************/

function mairixSanitizeTransactionRequest(
  data,
  transactionContext
) {

  const request =
    Object.assign(
      {},
      data || {}
    );


  /*
   * Remove client-controlled identity.
   */

  delete request.userId;

  delete request.serverUserId;

  delete request.user;

  delete request.role;

  delete request.email;

  delete request.userEmail;

  delete request.userName;

  delete request.createdBy;

  delete request.updatedBy;


  /*
   * Server-owned identity.
   */

  request.serverUserId =
    transactionContext.userId;


  request.serverUserEmail =
    transactionContext.email;


  request.serverUserName =
    transactionContext.name;


  return request;

}


/************************************************
 * ASSERT AUTHORIZED CONTEXT
 *
 * Business engines may use this before
 * executing protected work.
 ************************************************/

function mairixAssertAuthorizedTransactionContext(
  transactionContext,
  expectedTransactionType
) {

  if (
    !transactionContext ||
    transactionContext.authorized !== true
  ) {

    throw new Error(
      "Unauthorized transaction context."
    );

  }


  if (
    !transactionContext.userId
  ) {

    throw new Error(
      "Authorized transaction context is missing user ID."
    );

  }


  if (
    expectedTransactionType
  ) {

    const expected =
      mairixTransactionAuthNormalizeType(
        expectedTransactionType
      );


    if (
      transactionContext.transactionType !==
      expected
    ) {

      throw new Error(
        "Transaction type mismatch."
      );

    }

  }


  return true;

}


/************************************************
 * TRANSACTION AUTHORIZATION HEALTH CHECK
 *
 * Structural only.
 *
 * Does NOT create transactions.
 ************************************************/

function testMairixTransactionAuthorizationContract() {

  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX TRANSACTION AUTHORIZATION CONTRACT TEST"
  );

  Logger.log(
    "=========================================="
  );


  const requiredFunctions = [

    "mairixTransactionAuthCurrentUser",

    "mairixTransactionAuthPermissionForType",

    "mairixRequireTransactionAuthorization",

    "mairixRequireTransactionCreateAuthorization",

    "mairixRequireSaleAuthorization",

    "mairixRequireSalesReturnAuthorization",

    "mairixRequirePurchaseAuthorization",

    "mairixRequirePurchaseReturnAuthorization",

    "mairixRequireCollectionAuthorization",

    "mairixRequireVendorPaymentAuthorization",

    "mairixRequireExpenseAuthorization",

    "mairixBuildAuthorizedTransactionContext",

    "mairixSanitizeTransactionRequest",

    "mairixAssertAuthorizedTransactionContext"

  ];


  requiredFunctions.forEach(
    function(functionName) {

      if (
        typeof globalThis[
          functionName
        ] !==
        "function"
      ) {

        throw new Error(
          "Required transaction authorization function missing: " +
          functionName
        );

      }

    }
  );


  /*
   * Verify central permission mappings.
   */

  const expectedMappings = {

    SALE:
      "SALES",

    SALES_RETURN:
      "SALES_RETURNS_CREATE",

    PURCHASE:
      "PURCHASES_CREATE",

    PURCHASE_RETURN:
      "PURCHASE_RETURNS_CREATE",

    COLLECTION:
      "COLLECTIONS_CREATE",

    VENDOR_PAYMENT:
      "VENDOR_PAYMENTS_CREATE",

    EXPENSE:
      "EXPENSES_CREATE"

  };


  Object.keys(
    expectedMappings
  )
    .forEach(
      function(transactionType) {

        const actual =
          mairixTransactionAuthPermissionForType(
            transactionType
          );


        if (
          actual !==
          expectedMappings[
            transactionType
          ]
        ) {

          throw new Error(
            "Invalid permission mapping for " +
            transactionType +
            ": expected " +
            expectedMappings[
              transactionType
            ] +
            ", received " +
            actual
          );

        }

      }
    );


  /*
   * Ensure invalid transaction types
   * cannot silently pass.
   */

  let rejected =
    false;


  try {

    mairixTransactionAuthPermissionForType(
      "UNKNOWN_TRANSACTION"
    );

  } catch (
    error
  ) {

    rejected =
      true;

  }


  if (
    !rejected
  ) {

    throw new Error(
      "Unknown transaction type was not rejected."
    );

  }


  Logger.log(
    "TRANSACTION AUTHORIZATION CONTRACT TEST: PASS"
  );


  return {

    success:
      true,

    message:
      "Transaction authorization contract passed structural verification."

  };

}
