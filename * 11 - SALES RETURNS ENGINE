/************************************************
 * CENTRAL LOCK
 ************************************************/

function mairixWithReturnLock(
  callback
) {

  if (
    typeof withMairixTransactionLock ===
    "function"
  ) {

    return withMairixTransactionLock(
      callback,
      10000
    );

  }


  const lock =
    LockService
      .getScriptLock();


  lock.waitLock(
    10000
  );


  try {

    return callback();

  } finally {

    lock.releaseLock();

  }

}


/************************************************
 * AUDIT
 ************************************************/

function mairixWriteReturnAudit(
  action,
  reference,
  user,
  details
) {

  try {

    if (
      typeof logAction ===
      "function"
    ) {

      logAction(
        action,
        reference,
        details
      );

      return;

    }


    const ss =
      SpreadsheetApp
        .getActiveSpreadsheet();


    let sheet =
      ss.getSheetByName(
        "MAIRIX_AUDIT"
      );


    if (!sheet) {

      sheet =
        ss.insertSheet(
          "MAIRIX_AUDIT"
        );


      sheet
        .appendRow([

          "Timestamp",
          "User ID",
          "Action",
          "Reference",
          "Details"

        ]);

    }


    sheet
      .appendRow([

        new Date(),

        user
          ? user.userId
          : "SYSTEM",

        action,

        reference,

        details || ""

      ]);

  } catch (error) {

    Logger.log(
      "Sales Return audit failed: " +
      error.message
    );

  }

}


