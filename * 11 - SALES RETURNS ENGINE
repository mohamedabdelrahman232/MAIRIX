/************************************************
 * FIND ROW
 ************************************************/

function mairixFindReferenceRow(
  sheet,
  header,
  reference
) {

  const headers =
    mairixGetHeaders(
      sheet
    );


  const index =
    headers.indexOf(
      header
    );


  if (index === -1) {

    throw new Error(
      "Column not found: " +
      header
    );

  }


  const lastRow =
    sheet.getLastRow();


  if (lastRow < 2) {
    return -1;
  }


  const values =
    sheet
      .getRange(
        2,
        index + 1,
        lastRow - 1,
        1
      )
      .getDisplayValues();


  const normalized =
    mairixClean(
      reference
    );


  for (
    let i = 0;
    i < values.length;
    i++
  ) {

    if (
      mairixClean(
        values[i][0]
      ) ===
      normalized
    ) {

      return i + 2;

    }

  }


  return -1;

}


/************************************************
 * READ OBJECT
 ************************************************/

function mairixReadObject(
  sheet,
  row,
  headers
) {

  const values =
    sheet
      .getRange(
        row,
        1,
        1,
        headers.length
      )
      .getValues()[0];


  const object = {};


  headers.forEach(
    function(header, index) {

      object[header] =
        values[index];

    }
  );


  /*
   * Normalize important fields.
   */

  object.status =
    mairixClean(
      object.Status
    ).toUpperCase();


  object.returnReference =
    mairixClean(
      object[
        "Return Reference"
      ]
    );


  object.originalSaleReference =
    mairixClean(
      object[
        "Original Sale Reference"
      ]
    );


  object.customerCode =
    mairixClean(
      object[
        "Customer Code"
      ]
    );


  object.warehouseCode =
    mairixClean(
      object[
        "Warehouse Code"
      ]
    );


  object.returnType =
    mairixClean(
      object[
        "Return Type"
      ]
    ).toUpperCase();


  object.netAmount =
    Number(
      object[
        "Net Amount"
      ] || 0
    );


  object.totalTax =
    Number(
      object[
        "Total Tax"
      ] || 0
    );


  object.cashEffect =
    Number(
      object[
        "Cash Effect"
      ] || 0
    );


  object.creditEffect =
    Number(
      object[
        "Credit Effect"
      ] || 0
    );


  object.taxableAmount =
    Number(
      object[
        "Taxable Amount"
      ] || 0
    );


  object.loyaltyPointsEffect =
    Number(
      object[
        "Loyalty Points Effect"
      ] || 0
    );


  object.centralReference =
    mairixClean(
      object[
        "Central Reference"
      ]
    );


  return object;

}


/************************************************
 * SET CELL BY HEADER
 ************************************************/

function mairixSetCellByHeader(
  sheet,
  row,
  headers,
  header,
  value
) {

  const index =
    headers.indexOf(
      header
    );


  if (index === -1) {

    throw new Error(
      "Column not found: " +
      header
    );

  }


  sheet
    .getRange(
      row,
      index + 1
    )
    .setValue(
      value
    );

}


/************************************************
 * TRANSACTION FINDER
 ************************************************/

function mairixFindTransactionInSheet(
  sheet,
  referenceHeader,
  reference
) {

  const row =
    mairixFindReferenceRow(
      sheet,
      referenceHeader,
      reference
    );


  if (row === -1) {
    return null;
  }


  const headers =
    mairixGetHeaders(
      sheet
    );


  return mairixReadObject(
    sheet,
    row,
    headers
  );

}


/************************************************
 * CLEAN
 ************************************************/

function mairixClean(
  value
) {

  if (
    value === null ||
    value === undefined
  ) {

    return "";

  }


  return String(
    value
  )
    .trim();

}


/************************************************
 * ROUND
 ************************************************/

function mairixRound(
  value
) {

  return Math.round(
    Number(value || 0) *
    100
  ) / 100;

}


