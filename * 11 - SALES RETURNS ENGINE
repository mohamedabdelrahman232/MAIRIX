/************************************************
 * MAIRIX ERP
 * 11 - SALES RETURNS ENGINE
 *
 * SYSTEM:
 *   MAIRIX
 *
 * PURPOSE:
 *   Sales return processing.
 *
 * DESIGN PRINCIPLES:
 *
 *   1. Every return is a new centralized transaction.
 *   2. Every return MUST reference the original sale.
 *   3. Inventory effect:
 *        SALES RETURN = POSITIVE (+)
 *
 *   4. Financial effect:
 *        SALES RETURN = NEGATIVE (-)
 *
 *      Cash and credit are maintained separately.
 *
 *   5. Loyalty:
 *        Returned quantity removes the same number
 *        of loyalty points.
 *
 *   6. Tax:
 *        Every tax type receives its own signed effect.
 *        Sales return reverses the tax effect of sale.
 *
 *   7. No destructive editing of posted transactions.
 *
 *   8. Central reference:
 *        Every return has a unique transaction reference.
 *
 *   9. Multi-warehouse:
 *        The warehouse is part of the transaction.
 *
 *  10. Every operation records:
 *        User
 *        Date
 *        Original reference
 *        Return reference
 *        Warehouse
 *        Customer
 *
 ************************************************/


/************************************************
 * CONSTANTS
 ************************************************/

const MAIRIX_SALES_RETURN = {

  SHEET:
    "SALES_RETURNS",

  ITEMS_SHEET:
    "SALES_RETURN_ITEMS",

  TRANSACTION_TYPE:
    "SALES_RETURN",

  INVENTORY_SIGN:
    1,

  FINANCIAL_SIGN:
    -1,

  TAX_SIGN:
    -1,

  LOYALTY_SIGN:
    -1

};


/************************************************
 * SHEET HEADERS
 ************************************************/

const MAIRIX_SALES_RETURN_HEADERS = [

  "Return Reference",
  "Return Date",
  "Original Sale Reference",

  "Customer Code",
  "Customer Name",

  "Warehouse Code",
  "Warehouse Name",

  "Salesman Code",
  "Salesman Name",

  "Return Type",

  "Gross Amount",
  "Discount Amount",
  "Net Amount",

  "Taxable Amount",
  "Total Tax",

  "Cash Effect",
  "Credit Effect",

  "Inventory Effect",
  "Loyalty Points Effect",

  "Status",

  "Created By",
  "Created At",

  "Posted By",
  "Posted At",

  "Void Reason",

  "Central Reference"

];


const MAIRIX_SALES_RETURN_ITEM_HEADERS = [

  "Return Reference",

  "Line No",

  "Original Sale Reference",

  "Original Sale Line",

  "Item Code",
  "Item Name",

  "Warehouse Code",

  "Returned Quantity",

  "Unit Price",

  "Gross Amount",
  "Discount Amount",
  "Net Amount",

  "Unit Cost",
  "Inventory Value",

  "Taxable Amount",
  "Total Tax",

  "Loyalty Points",

  "Inventory Effect",
  "Financial Effect",
  "Tax Effect",

  "Central Reference"

];


/************************************************
 * SETUP
 ************************************************/

function setupMairixSalesReturns() {

  const ss =
    SpreadsheetApp
      .getActiveSpreadsheet();


  const headerSheet =
    mairixGetOrCreateSheet(
      ss,
      MAIRIX_SALES_RETURN.SHEET
    );


  const itemSheet =
    mairixGetOrCreateSheet(
      ss,
      MAIRIX_SALES_RETURN.ITEMS_SHEET
    );


  mairixEnsureHeaders(
    headerSheet,
    MAIRIX_SALES_RETURN_HEADERS
  );


  mairixEnsureHeaders(
    itemSheet,
    MAIRIX_SALES_RETURN_ITEM_HEADERS
  );


  headerSheet.setFrozenRows(1);
  itemSheet.setFrozenRows(1);


  return {

    success: true,

    sheets: [

      MAIRIX_SALES_RETURN.SHEET,
      MAIRIX_SALES_RETURN.ITEMS_SHEET

    ]

  };

}


/************************************************
 * CREATE SALES RETURN
 *
 * INPUT:
 *
 * {
 *   originalSaleReference: "...",
 *
 *   returnDate: Date,
 *
 *   customerCode: "...",
 *
 *   warehouseCode: "...",
 *
 *   returnType: "CASH" / "CREDIT",
 *
 *   items: [
 *
 *     {
 *       originalSaleLine: 1,
 *       itemCode: "...",
 *       quantity: 2
 *     }
 *
 *   ]
 *
 * }
 *
 ************************************************/

function createMairixSalesReturn(data) {

  if (!data) {

    throw new Error(
      "Sales return data is required."
    );

  }


  /**********************************************
   * CURRENT USER
   **********************************************/

  const user =
    mairixRequireCurrentUser();


  /**********************************************
   * PERMISSION
   **********************************************/

  mairixRequireSalesReturnCreate(
    user
  );


  /**********************************************
   * BASIC VALIDATION
   **********************************************/

  const originalSaleReference =
    mairixClean(
      data.originalSaleReference
    );


  if (!originalSaleReference) {

    throw new Error(
      "Original Sale Reference is required."
    );

  }


  if (
    !Array.isArray(data.items) ||
    data.items.length === 0
  ) {

    throw new Error(
      "At least one return item is required."
    );

  }


  const returnType =
    mairixNormalizeReturnType(
      data.returnType
    );


  /**********************************************
   * LOAD ORIGINAL SALE
   **********************************************/

  const sale =
    mairixGetOriginalSale(
      originalSaleReference
    );


  if (!sale) {

    throw new Error(
      "Original sale not found: " +
      originalSaleReference
    );

  }


  /**********************************************
   * PREVENT RETURN OF RETURN
   **********************************************/

  if (
    mairixClean(
      sale.transactionType
    ).toUpperCase() ===
    "SALES_RETURN"
  ) {

    throw new Error(
      "A sales return cannot itself be returned."
    );

  }


  /**********************************************
   * CUSTOMER
   **********************************************/

  const customerCode =
    mairixClean(
      data.customerCode ||
      sale.customerCode
    );


  const customerName =
    mairixClean(
      data.customerName ||
      sale.customerName
    );


  if (
    customerCode &&
    sale.customerCode &&
    customerCode !==
    mairixClean(sale.customerCode)
  ) {

    throw new Error(
      "Return customer does not match original sale."
    );

  }


  /**********************************************
   * WAREHOUSE
   **********************************************/

  const warehouseCode =
    mairixClean(
      data.warehouseCode ||
      sale.warehouseCode
    );


  if (!warehouseCode) {

    throw new Error(
      "Warehouse is required for sales return."
    );

  }


  /**********************************************
   * RETURN REFERENCE
   **********************************************/

  const returnReference =
    mairixGenerateReference(
      "SRET"
    );


  /**********************************************
   * DATE
   **********************************************/

  const returnDate =
    data.returnDate
      ? new Date(data.returnDate)
      : new Date();


  if (
    isNaN(
      returnDate.getTime()
    )
  ) {

    throw new Error(
      "Invalid return date."
    );

  }


  /**********************************************
   * VALIDATE ITEMS
   **********************************************/

  const preparedItems =
    [];


  let totalGross = 0;
  let totalDiscount = 0;
  let totalNet = 0;
  let totalTaxable = 0;
  let totalTax = 0;
  let totalInventory = 0;
  let totalLoyalty = 0;


  data.items.forEach(
    function(inputItem, index) {

      const item =
        mairixPrepareReturnItem(
          inputItem,
          sale,
          warehouseCode,
          originalSaleReference
        );


      if (!item) {

        throw new Error(
          "Invalid return item at line " +
          (index + 1)
        );

      }


      preparedItems.push(item);


      totalGross +=
        item.grossAmount;

      totalDiscount +=
        item.discountAmount;

      totalNet +=
        item.netAmount;

      totalTaxable +=
        item.taxableAmount;

      totalTax +=
        item.totalTax;

      totalInventory +=
        item.inventoryValue;

      totalLoyalty +=
        item.loyaltyPoints;

    }
  );


  /**********************************************
   * ENSURE RETURN DOES NOT EXCEED ALLOWED QTY
   **********************************************/

  mairixValidateReturnQuantities(
    originalSaleReference,
    preparedItems
  );


  /**********************************************
   * BUILD TRANSACTION
   **********************************************/

  const transaction = {

    returnReference:
      returnReference,

    returnDate:
      returnDate,

    originalSaleReference:
      originalSaleReference,

    customerCode:
      customerCode,

    customerName:
      customerName,

    warehouseCode:
      warehouseCode,

    warehouseName:
      mairixGetWarehouseName(
        warehouseCode
      ),

    salesmanCode:
      mairixClean(
        data.salesmanCode ||
        sale.salesmanCode
      ),

    salesmanName:
      mairixClean(
        data.salesmanName ||
        sale.salesmanName
      ),

    returnType:
      returnType,

    grossAmount:
      mairixRound(totalGross),

    discountAmount:
      mairixRound(totalDiscount),

    netAmount:
      mairixRound(totalNet),

    taxableAmount:
      mairixRound(totalTaxable),

    totalTax:
      mairixRound(totalTax),

    cashEffect:
      returnType === "CASH"
        ? mairixRound(
            totalNet + totalTax
          ) *
          MAIRIX_SALES_RETURN.FINANCIAL_SIGN
        : 0,

    creditEffect:
      returnType === "CREDIT"
        ? mairixRound(
            totalNet + totalTax
          ) *
          MAIRIX_SALES_RETURN.FINANCIAL_SIGN
        : 0,

    inventoryEffect:
      mairixRound(totalInventory) *
      MAIRIX_SALES_RETURN.INVENTORY_SIGN,

    loyaltyPointsEffect:
      Math.round(
        totalLoyalty
      ) *
      MAIRIX_SALES_RETURN.LOYALTY_SIGN,

    status:
      "DRAFT",

    createdBy:
      user.userId,

    createdAt:
      new Date(),

    centralReference:
      returnReference

  };


  /**********************************************
   * SAVE DRAFT
   **********************************************/

  mairixSaveSalesReturn(
    transaction,
    preparedItems
  );


  /**********************************************
   * AUDIT
   **********************************************/

  mairixWriteReturnAudit(
    "CREATE_SALES_RETURN",
    returnReference,
    user,
    "Original Sale: " +
      originalSaleReference
  );


  return {

    success: true,

    status:
      "DRAFT",

    returnReference:
      returnReference,

    originalSaleReference:
      originalSaleReference,

    transaction:
      transaction,

    items:
      preparedItems

  };

}


/************************************************
 * POST SALES RETURN
 *
 * Posting is the point where the transaction
 * affects:
 *
 *   Inventory
 *   Cash
 *   Credit
 *   Taxes
 *   Loyalty
 *   Financial statements
 ************************************************/

function postMairixSalesReturn(
  returnReference
) {

  const user =
    mairixRequireCurrentUser();


  mairixRequireSalesReturnCreate(
    user
  );


  const reference =
    mairixClean(
      returnReference
    );


  if (!reference) {

    throw new Error(
      "Return Reference is required."
    );

  }


  const transaction =
    mairixGetSalesReturn(
      reference
    );


  if (!transaction) {

    throw new Error(
      "Sales return not found: " +
      reference
    );

  }


  if (
    transaction.status ===
    "POSTED"
  ) {

    throw new Error(
      "Sales return is already posted."
    );

  }


  if (
    transaction.status ===
    "VOID"
  ) {

    throw new Error(
      "Voided sales return cannot be posted."
    );

  }


  const items =
    mairixGetSalesReturnItems(
      reference
    );


  if (!items.length) {

    throw new Error(
      "Sales return contains no items."
    );

  }


  /**********************************************
   * REVALIDATE BEFORE POSTING
   **********************************************/

  mairixValidateReturnQuantities(
    transaction.originalSaleReference,
    items
  );


  /**********************************************
   * CENTRAL TRANSACTION LOCK
   **********************************************/

  return mairixWithReturnLock(
    function() {

      /******************************************
       * INVENTORY
       ******************************************/

      mairixPostReturnInventory(
        transaction,
        items,
        user
      );


      /******************************************
       * FINANCIAL
       ******************************************/

      mairixPostReturnFinancial(
        transaction,
        items,
        user
      );


      /******************************************
       * TAX
       ******************************************/

      mairixPostReturnTaxes(
        transaction,
        items,
        user
      );


      /******************************************
       * LOYALTY
       ******************************************/

      mairixPostReturnLoyalty(
        transaction,
        items,
        user
      );


      /******************************************
       * MARK POSTED
       ******************************************/

      mairixMarkReturnPosted(
        reference,
        user
      );


      /******************************************
       * AUDIT
       ******************************************/

      mairixWriteReturnAudit(
        "POST_SALES_RETURN",
        reference,
        user,
        "Original Sale: " +
          transaction.originalSaleReference
      );


      return {

        success: true,

        status:
          "POSTED",

        returnReference:
          reference,

        originalSaleReference:
          transaction.originalSaleReference

      };

    }
  );

}


/************************************************
 * VOID SALES RETURN
 *
 * A posted return is NOT deleted.
 *
 * It is reversed through a controlled
 * financial/inventory reversal mechanism.
 ************************************************/

function voidMairixSalesReturn(
  returnReference,
  reason
) {

  const user =
    mairixRequireCurrentUser();


  mairixRequireSalesReturnEdit(
    user
  );


  const reference =
    mairixClean(
      returnReference
    );


  const voidReason =
    mairixClean(
      reason
    );


  if (!voidReason) {

    throw new Error(
      "Void reason is required."
    );

  }


  const transaction =
    mairixGetSalesReturn(
      reference
    );


  if (!transaction) {

    throw new Error(
      "Sales return not found."
    );

  }


  if (
    transaction.status ===
    "VOID"
  ) {

    throw new Error(
      "Sales return is already void."
    );

  }


  /*
   * DRAFT:
   * Can be voided without financial impact.
   */

  if (
    transaction.status ===
    "DRAFT"
  ) {

    mairixMarkReturnVoid(
      reference,
      voidReason,
      user
    );


    return {

      success: true,

      status:
        "VOID",

      financialReversal:
        false

    };

  }


  /*
   * POSTED:
   *
   * Create a controlled reversal
   * through the central engines.
   */

  return mairixWithReturnLock(
    function() {

      mairixReversePostedReturn(
        transaction,
        user,
        voidReason
      );


      mairixMarkReturnVoid(
        reference,
        voidReason,
        user
      );


      mairixWriteReturnAudit(
        "VOID_SALES_RETURN",
        reference,
        user,
        "Reason: " +
          voidReason
      );


      return {

        success: true,

        status:
          "VOID",

        financialReversal:
          true

      };

    }
  );

}


/************************************************
 * PREPARE RETURN ITEM
 ************************************************/

function mairixPrepareReturnItem(
  input,
  sale,
  warehouseCode,
  originalSaleReference
) {

  if (!input) {
    return null;
  }


  const itemCode =
    mairixClean(
      input.itemCode
    );


  const quantity =
    Number(
      input.quantity
    );


  if (!itemCode) {

    throw new Error(
      "Return item code is required."
    );

  }


  if (
    !isFinite(quantity) ||
    quantity <= 0
  ) {

    throw new Error(
      "Return quantity must be greater than zero."
    );

  }


  const saleLine =
    mairixFindSaleLine(
      sale,
      input.originalSaleLine,
      itemCode
    );


  if (!saleLine) {

    throw new Error(
      "Original sale line not found for item: " +
      itemCode
    );

  }


  const saleQuantity =
    Number(
      saleLine.quantity
    );


  if (
    !isFinite(saleQuantity) ||
    saleQuantity <= 0
  ) {

    throw new Error(
      "Original sale quantity is invalid for item: " +
      itemCode
    );

  }


  const unitPrice =
    Number(
      saleLine.unitPrice || 0
    );


  const discountAmount =
    mairixCalculateReturnDiscount(
      saleLine,
      quantity
    );


  const grossAmount =
    mairixRound(
      unitPrice *
      quantity
    );


  const netAmount =
    mairixRound(
      grossAmount -
      discountAmount
    );


  const unitCost =
    Number(
      saleLine.unitCost || 0
    );


  const inventoryValue =
    mairixRound(
      unitCost *
      quantity
    );


  const taxableAmount =
    mairixGetReturnTaxableAmount(
      saleLine,
      netAmount
    );


  const taxDetails =
    mairixCalculateReturnTaxes(
      saleLine,
      taxableAmount,
      quantity
    );


  const loyaltyPoints =
    mairixCalculateReturnLoyalty(
      saleLine,
      quantity
    );


  return {

    returnReference:
      "",

    lineNo:
      0,

    originalSaleReference:
      originalSaleReference,

    originalSaleLine:
      input.originalSaleLine ||
      saleLine.lineNo,

    itemCode:
      itemCode,

    itemName:
      mairixClean(
        saleLine.itemName
      ),

    warehouseCode:
      warehouseCode,

    returnedQuantity:
      quantity,

    unitPrice:
      mairixRound(
        unitPrice
      ),

    grossAmount:
      grossAmount,

    discountAmount:
      discountAmount,

    netAmount:
      netAmount,

    unitCost:
      mairixRound(
        unitCost
      ),

    inventoryValue:
      inventoryValue,

    taxableAmount:
      taxableAmount,

    totalTax:
      taxDetails.totalTax,

    taxDetails:
      taxDetails,

    loyaltyPoints:
      loyaltyPoints,

    inventoryEffect:
      inventoryValue *
      MAIRIX_SALES_RETURN.INVENTORY_SIGN,

    financialEffect:
      netAmount *
      MAIRIX_SALES_RETURN.FINANCIAL_SIGN,

    taxEffect:
      taxDetails.totalTax *
      MAIRIX_SALES_RETURN.TAX_SIGN,

    centralReference:
      ""

  };

}


/************************************************
 * VALIDATE RETURN QUANTITIES
 ************************************************/

function mairixValidateReturnQuantities(
  originalSaleReference,
  items
) {

  const previousReturns =
    mairixGetPostedReturnQuantities(
      originalSaleReference
    );


  const requested = {};


  items.forEach(
    function(item) {

      const key =
        mairixClean(
          item.itemCode
        ) +
        "|" +
        String(
          item.originalSaleLine
        );


      requested[key] =
        (requested[key] || 0) +
        Number(
          item.returnedQuantity
        );

    }
  );


  Object.keys(
    requested
  ).forEach(
    function(key) {

      const parts =
        key.split("|");


      const itemCode =
        parts[0];


      const lineNo =
        parts[1];


      const originalQuantity =
        mairixGetOriginalSaleLineQuantity(
          originalSaleReference,
          itemCode,
          lineNo
        );


      const alreadyReturned =
        previousReturns[key] || 0;


      const requestedQuantity =
        requested[key];


      const remaining =
        originalQuantity -
        alreadyReturned;


      if (
        requestedQuantity >
        remaining
      ) {

        throw new Error(
          "Return quantity exceeds remaining quantity. " +
          "Item: " +
          itemCode +
          " | Sale Line: " +
          lineNo +
          " | Remaining: " +
          remaining
        );

      }

    }
  );

}


/************************************************
 * POST INVENTORY
 ************************************************/

function mairixPostReturnInventory(
  transaction,
  items,
  user
) {

  /*
   * Inventory engine integration.
   *
   * The return sends a POSITIVE quantity effect.
   */

  if (
    typeof postInventoryMovement !==
    "function"
  ) {

    throw new Error(
      "Inventory Engine is not connected: postInventoryMovement()."
    );

  }


  items.forEach(
    function(item) {

      postInventoryMovement({

        transactionReference:
          transaction.returnReference,

        centralReference:
          transaction.centralReference,

        transactionType:
          "SALES_RETURN",

        transactionDate:
          transaction.returnDate,

        warehouseCode:
          transaction.warehouseCode,

        itemCode:
          item.itemCode,

        quantity:
          item.returnedQuantity,

        quantityEffect:
          item.returnedQuantity *
          MAIRIX_SALES_RETURN.INVENTORY_SIGN,

        unitCost:
          item.unitCost,

        inventoryValue:
          item.inventoryValue,

        originalReference:
          transaction.originalSaleReference,

        userId:
          user.userId

      });

    }
  );

}


/************************************************
 * POST FINANCIAL
 ************************************************/

function mairixPostReturnFinancial(
  transaction,
  items,
  user
) {

  /*
   * Cash and credit MUST remain separate.
   */

  if (
    typeof postFinancialTransaction !==
    "function"
  ) {

    throw new Error(
      "Financial Engine is not connected: postFinancialTransaction()."
    );

  }


  const total =
    mairixRound(
      transaction.netAmount +
      transaction.totalTax
    );


  postFinancialTransaction({

    transactionReference:
      transaction.returnReference,

    centralReference:
      transaction.centralReference,

    transactionType:
      "SALES_RETURN",

    transactionDate:
      transaction.returnDate,

    customerCode:
      transaction.customerCode,

    warehouseCode:
      transaction.warehouseCode,

    returnType:
      transaction.returnType,

    netAmount:
      transaction.netAmount,

    taxAmount:
      transaction.totalTax,

    totalAmount:
      total,

    cashEffect:
      transaction.cashEffect,

    creditEffect:
      transaction.creditEffect,

    financialSign:
      MAIRIX_SALES_RETURN.FINANCIAL_SIGN,

    originalReference:
      transaction.originalSaleReference,

    userId:
      user.userId

  });

}


/************************************************
 * POST TAXES
 ************************************************/

function mairixPostReturnTaxes(
  transaction,
  items,
  user
) {

  if (
    typeof postTaxTransaction !==
    "function"
  ) {

    throw new Error(
      "Tax Engine is not connected: postTaxTransaction()."
    );

  }


  items.forEach(
    function(item) {

      if (
        !item.taxDetails
      ) {

        return;

      }


      postTaxTransaction({

        transactionReference:
          transaction.returnReference,

        centralReference:
          transaction.centralReference,

        transactionType:
          "SALES_RETURN",

        originalReference:
          transaction.originalSaleReference,

        itemCode:
          item.itemCode,

        taxableAmount:
          item.taxableAmount,

        taxEffectSign:
          MAIRIX_SALES_RETURN.TAX_SIGN,

        totalTax:
          item.totalTax,

        taxes:
          item.taxDetails.taxes,

        userId:
          user.userId

      });

    }
  );

}


/************************************************
 * POST LOYALTY
 ************************************************/

function mairixPostReturnLoyalty(
  transaction,
  items,
  user
) {

  if (
    typeof postLoyaltyTransaction !==
    "function"
  ) {

    throw new Error(
      "Loyalty Engine is not connected: postLoyaltyTransaction()."
    );

  }


  const points =
    Math.round(
      transaction.loyaltyPointsEffect
    );


  postLoyaltyTransaction({

    transactionReference:
      transaction.returnReference,

    originalReference:
      transaction.originalSaleReference,

    customerCode:
      transaction.customerCode,

    pointsEffect:
      points,

    transactionType:
      "SALES_RETURN",

    userId:
      user.userId

  });

}


/************************************************
 * REVERSE POSTED RETURN
 ************************************************/

function mairixReversePostedReturn(
  transaction,
  user,
  reason
) {

  if (
    typeof postInventoryMovement !==
    "function"
  ) {

    throw new Error(
      "Inventory Engine is not connected."
    );

  }


  if (
    typeof postFinancialTransaction !==
    "function"
  ) {

    throw new Error(
      "Financial Engine is not connected."
    );

  }


  const items =
    mairixGetSalesReturnItems(
      transaction.returnReference
    );


  /**********************************************
   * INVENTORY REVERSAL
   *
   * Original return:
   *   +
   *
   * Void reversal:
   *   -
   **********************************************/

  items.forEach(
    function(item) {

      postInventoryMovement({

        transactionReference:
          transaction.returnReference +
          "-VOID",

        centralReference:
          transaction.centralReference,

        transactionType:
          "SALES_RETURN_VOID",

        transactionDate:
          new Date(),

        warehouseCode:
          transaction.warehouseCode,

        itemCode:
          item.itemCode,

        quantity:
          Number(
            item.returnedQuantity
          ) *
          -1,

        quantityEffect:
          Number(
            item.returnedQuantity
          ) *
          -1,

        unitCost:
          item.unitCost,

        inventoryValue:
          Number(
            item.inventoryValue
          ) *
          -1,

        originalReference:
          transaction.returnReference,

        userId:
          user.userId

      });

    }
  );


  /**********************************************
   * FINANCIAL REVERSAL
   *
   * Reverse the return's negative effect.
   **********************************************/

  postFinancialTransaction({

    transactionReference:
      transaction.returnReference +
      "-VOID",

    centralReference:
      transaction.centralReference,

    transactionType:
      "SALES_RETURN_VOID",

    transactionDate:
      new Date(),

    customerCode:
      transaction.customerCode,

    warehouseCode:
      transaction.warehouseCode,

    returnType:
      transaction.returnType,

    netAmount:
      Number(
        transaction.netAmount
      ) *
      -1,

    taxAmount:
      Number(
        transaction.totalTax
      ) *
      -1,

    totalAmount:
      Number(
        transaction.netAmount
      ) *
      -1 +
      Number(
        transaction.totalTax
      ) *
      -1,

    cashEffect:
      Number(
        transaction.cashEffect
      ) *
      -1,

    creditEffect:
      Number(
        transaction.creditEffect
      ) *
      -1,

    financialSign:
      1,

    originalReference:
      transaction.returnReference,

    reversalReason:
      reason,

    userId:
      user.userId

  });


  /**********************************************
   * TAX REVERSAL
   **********************************************/

  if (
    typeof postTaxTransaction ===
    "function"
  ) {

    postTaxTransaction({

      transactionReference:
        transaction.returnReference +
        "-VOID",

      centralReference:
        transaction.centralReference,

      transactionType:
        "SALES_RETURN_VOID",

      originalReference:
        transaction.returnReference,

      taxableAmount:
        Number(
          transaction.taxableAmount
        ) *
        -1,

      taxEffectSign:
        1,

      totalTax:
        Number(
          transaction.totalTax
        ) *
        -1,

      userId:
        user.userId

    });

  }


  /**********************************************
   * LOYALTY REVERSAL
   **********************************************/

  if (
    typeof postLoyaltyTransaction ===
    "function"
  ) {

    postLoyaltyTransaction({

      transactionReference:
        transaction.returnReference +
        "-VOID",

      originalReference:
        transaction.returnReference,

      customerCode:
        transaction.customerCode,

      pointsEffect:
        Number(
          transaction.loyaltyPointsEffect
        ) *
        -1,

      transactionType:
        "SALES_RETURN_VOID",

      userId:
        user.userId

    });

  }

}


