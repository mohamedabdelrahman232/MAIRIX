/************************************************
 * SAVE RETURN
 ************************************************/

function mairixSaveSalesReturn(
  transaction,
  items
) {

  const sheet =
    mairixGetSheet(
      MAIRIX_SALES_RETURN.SHEET
    );


  const itemSheet =
    mairixGetSheet(
      MAIRIX_SALES_RETURN.ITEMS_SHEET
    );


  const headers =
    mairixGetHeaders(
      sheet
    );


  const itemHeaders =
    mairixGetHeaders(
      itemSheet
    );


  const row =
    mairixBuildRow(
      headers,
      transaction
    );


  sheet
    .getRange(
      sheet.getLastRow() + 1,
      1,
      1,
      headers.length
    )
    .setValues([row]);


  const itemRows =
    items.map(
      function(item, index) {

        item.returnReference =
          transaction.returnReference;

        item.lineNo =
          index + 1;

        item.centralReference =
          transaction.centralReference;


        return mairixBuildRow(
          itemHeaders,
          item
        );

      }
    );


  if (itemRows.length) {

    itemSheet
      .getRange(
        itemSheet.getLastRow() + 1,
        1,
        itemRows.length,
        itemHeaders.length
      )
      .setValues(
        itemRows
      );

  }

}


