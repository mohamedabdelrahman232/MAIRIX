function mairixGetSheet(
  name
) {

  const sheet =
    SpreadsheetApp
      .getActiveSpreadsheet()
      .getSheetByName(
        name
      );


  if (!sheet) {

    throw new Error(
      "Required MAIRIX sheet not found: " +
      name
    );

  }


  return sheet;

}


function mairixEnsureHeaders(
  sheet,
  headers
) {

  if (
    sheet.getLastRow() === 0
  ) {

    sheet
      .getRange(
        1,
        1,
        1,
        headers.length
      )
      .setValues([
        headers
      ]);

    return;

  }


  const existing =
    sheet
      .getRange(
        1,
        1,
        1,
        Math.max(
          sheet.getLastColumn(),
          headers.length
        )
      )
      .getDisplayValues()[0];


  headers.forEach(
    function(header, index) {

      if (
        mairixClean(
          existing[index]
        ) !==
        header
      ) {

        sheet
          .getRange(
            1,
            index + 1
          )
          .setValue(
            header
          );

      }

    }
  );

}


function mairixGetHeaders(
  sheet
) {

  return sheet
    .getRange(
      1,
      1,
      1,
      sheet.getLastColumn()
    )
    .getDisplayValues()[0]
    .map(
      function(header) {

        return mairixClean(
          header
        );

      }
    );

}


/************************************************
 * BUILD ROW
 ************************************************/

function mairixBuildRow(
  headers,
  object
) {

  return headers.map(
    function(header) {

      const key =
        mairixClean(
          header
        );


      if (
        object[key] !== undefined
      ) {

        return object[key];

      }


      /*
       * Map internal camelCase names
       * to sheet headers.
       */

      const aliases = {

        "Return Reference":
          "returnReference",

        "Return Date":
          "returnDate",

        "Original Sale Reference":
          "originalSaleReference",

        "Customer Code":
          "customerCode",

        "Customer Name":
          "customerName",

        "Warehouse Code":
          "warehouseCode",

        "Warehouse Name":
          "warehouseName",

        "Salesman Code":
