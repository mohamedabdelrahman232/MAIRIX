/************************************************
 * GET RETURN ITEMS
 ************************************************/

function mairixGetSalesReturnItems(
  reference
) {

  const sheet =
    mairixGetSheet(
      MAIRIX_SALES_RETURN.ITEMS_SHEET
    );


  const headers =
    mairixGetHeaders(
      sheet
    );


  const lastRow =
    sheet.getLastRow();


  if (lastRow < 2) {
    return [];
  }


  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        headers.length
      )
      .getValues();


  const output = [];


  values.forEach(
    function(row) {

      if (
        mairixClean(
          row[
            headers.indexOf(
              "Return Reference"
            )
          ]
        ) !==
        mairixClean(reference)
      ) {

        return;

      }


      const object = {};


      headers.forEach(
        function(header, index) {

          object[
            mairixClean(header)
          ] =
            row[index];

        }
      );


      output.push(
        object
      );

    }
  );


  return output;

}


/************************************************
