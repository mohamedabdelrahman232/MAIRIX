 ************************************************/

function mairixGetOriginalSale(
  reference
) {

  if (
    typeof getMairixSaleByReference ===
    "function"
  ) {

    return getMairixSaleByReference(
      reference
    );

  }


  /*
   * Fallback for the new blank project.
   *
   * This allows the Sales Engine to be
   * connected later without rewriting
   * Sales Returns.
   */

  const sheetName =
    "SALES";


  const ss =
    SpreadsheetApp
      .getActiveSpreadsheet();


  const sheet =
    ss.getSheetByName(
      sheetName
    );


  if (!sheet) {

    throw new Error(
      "Sales Engine is not connected: " +
      "getMairixSaleByReference() is missing."
    );

  }


  return mairixFindTransactionInSheet(
    sheet,
    "Sale Reference",
    reference
  );

}


/************************************************
 * SALE LINE FINDER
 ************************************************/

function mairixFindSaleLine(
  sale,
  originalSaleLine,
  itemCode
) {

  if (
    !sale.items ||
    !Array.isArray(
      sale.items
    )
  ) {

    throw new Error(
      "Original sale does not contain line details."
    );

  }


  const requestedLine =
    originalSaleLine !== undefined &&
    originalSaleLine !== null &&
    String(
      originalSaleLine
    ) !== "";


  for (
    let i = 0;
    i < sale.items.length;
    i++
  ) {

    const line =
      sale.items[i];


    const sameItem =
      mairixClean(
        line.itemCode
      ) ===
      mairixClean(
        itemCode
      );


    if (!sameItem) {
      continue;
    }


    if (!requestedLine) {
      return line;
    }


    if (
      String(
        line.lineNo
      ) ===
      String(
        originalSaleLine
      )
    ) {

      return line;

    }

  }


  return null;

}


/************************************************
 * PREVIOUS RETURN QUANTITIES
 ************************************************/

function mairixGetPostedReturnQuantities(
  originalReference
) {

  const returns =
    mairixGetAllReturnsForSale(
      originalReference
    );


  const result = {};


  returns.forEach(
    function(ret) {

      if (
        mairixClean(
          ret.Status
        ).toUpperCase() !==
        "POSTED"
      ) {

        return;

      }


      const items =
        mairixGetSalesReturnItems(
          ret[
            "Return Reference"
          ]
        );


      items.forEach(
        function(item) {

          const key =
            mairixClean(
              item["Item Code"]
            ) +
            "|" +
            String(
              item["Original Sale Line"]
            );


          result[key] =
            (result[key] || 0) +
            Number(
              item["Returned Quantity"] || 0
            );

        }
      );

    }
  );


  return result;

}


/************************************************
