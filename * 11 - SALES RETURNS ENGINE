/************************************************
 * REFERENCE
 ************************************************/

function mairixGenerateReference(
  prefix
) {

  const timestamp =
    Utilities.formatDate(
      new Date(),
      Session.getScriptTimeZone(),
      "yyyyMMdd-HHmmss"
    );


  const random =
    Math.floor(
      Math.random() *
      9000
    ) +
    1000;


  return (
    prefix +
    "-" +
    timestamp +
    "-" +
    random
  );

}


