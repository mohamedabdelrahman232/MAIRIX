/************************************************
 * DISCOUNT
 ************************************************/

function mairixCalculateReturnDiscount(
  saleLine,
  quantity
) {

  if (
    saleLine.discountAmount !==
    undefined
  ) {

    const originalQuantity =
      Number(
        saleLine.quantity || 0
      );


    if (
      originalQuantity > 0
    ) {

      return mairixRound(
        Number(
          saleLine.discountAmount
        ) *
        (
          quantity /
          originalQuantity
        )
      );

    }

  }


  const gross =
    Number(
      saleLine.unitPrice || 0
    ) *
    quantity;


  const discountRate =
    Number(
      saleLine.discountRate || 0
    );


  return mairixRound(
    gross *
    discountRate /
    100
  );

}


/************************************************
 * TAXABLE AMOUNT
 ************************************************/

function mairixGetReturnTaxableAmount(
  saleLine,
  netAmount
) {

  if (
    saleLine.taxableAmount !==
    undefined
  ) {

    const originalQuantity =
      Number(
        saleLine.quantity || 0
      );


    if (
      originalQuantity > 0
    ) {

      const lineTaxable =
        Number(
          saleLine.taxableAmount || 0
        );


      const quantity =
        Number(
          saleLine.returnQuantity ||
          saleLine.quantity
        );


      if (quantity > 0) {

        return mairixRound(
          Math.min(
            netAmount,
            lineTaxable
          )
        );

      }

    }

  }


  return mairixRound(
    netAmount
  );

}


/************************************************
 * TAX CALCULATION
 *
 * Supports UNLIMITED TAX TYPES.
 *
 * Expected tax configuration from Tax Engine:
 *
 * [
 *   {
 *     code: "VAT",
 *     rate: 14
 *   },
 *
 *   {
 *     code: "WITHHOLDING",
 *     rate: 1
 *   }
 * ]
 *
 ************************************************/

function mairixCalculateReturnTaxes(
  saleLine,
  taxableAmount,
  quantity
) {

  /*
   * If original sale already contains
   * exact tax amounts per tax type,
   * reverse proportionally.
   */

  if (
    Array.isArray(
      saleLine.taxes
    )
  ) {

    const originalQuantity =
      Number(
        saleLine.quantity || 0
      );


    const taxes = [];


    let totalTax = 0;


    saleLine.taxes.forEach(
      function(tax) {

        const originalAmount =
          Number(
            tax.amount || 0
          );


        let amount =
          originalAmount;


        if (
          originalQuantity > 0
        ) {

          amount =
            originalAmount *
            (
              quantity /
              originalQuantity
            );

        }


        amount =
          mairixRound(
            amount
          );


        taxes.push({

          code:
            mairixClean(
              tax.code
            ),

          name:
            mairixClean(
              tax.name
            ),

          rate:
            Number(
              tax.rate || 0
            ),

          taxableAmount:
            taxableAmount,

          amount:
            amount,

          effectSign:
            MAIRIX_SALES_RETURN.TAX_SIGN,

          signedAmount:
            amount *
            MAIRIX_SALES_RETURN.TAX_SIGN

        });


        totalTax +=
          amount;

      }
    );


    return {

      taxes:
        taxes,

      totalTax:
        mairixRound(
          totalTax
        )

    };

  }


  /*
   * If Tax Engine exists, delegate
   * calculation to it.
   */

  if (
    typeof calculateMairixTaxes ===
    "function"
  ) {

    const result =
      calculateMairixTaxes({

        transactionType:
          "SALES_RETURN",

        taxableAmount:
          taxableAmount,

        quantity:
          quantity,

        source:
          saleLine

      });


    return {

      taxes:
        result.taxes || [],

      totalTax:
        mairixRound(
          result.totalTax || 0
        )

    };

  }


  /*
   * No tax data available yet.
   */

  return {

    taxes: [],

    totalTax: 0

  };

}


/************************************************
 * LOYALTY
 ************************************************/

function mairixCalculateReturnLoyalty(
  saleLine,
  quantity
) {

  if (
    saleLine.loyaltyPoints !==
    undefined
  ) {

    const originalQuantity =
      Number(
        saleLine.quantity || 0
      );


    const originalPoints =
      Number(
        saleLine.loyaltyPoints || 0
      );


    if (
      originalQuantity > 0
    ) {

      return Math.round(
        originalPoints *
        (
          quantity /
          originalQuantity
        )
      );

    }

  }


  /*
   * MAIRIX default:
   * one purchased piece = one point.
   */

  return Math.round(
    quantity
  );

}


/************************************************
 * RETURN TYPE
 ************************************************/

function mairixNormalizeReturnType(
  value
) {

  const normalized =
    mairixClean(
      value
