}


/************************************************
 * UI HELPER
 *
 * Returns only the data required to render
 * a reference popup/modal.
 ************************************************/

function getReferenceDetails(
  reference
) {

  const result =
    viewReference(
      reference
    );


  return {

    success:
      true,

    reference:
      result.reference,

    transactionType:
      result.transactionType,

    transaction:
      result.transaction,

    financial:
      result.financial,

    inventory:
      result.inventory,

    taxes:
      result.taxes,

    linkedOperations:
      result.linkedOperations,

    references:
      result.references

  };

}
