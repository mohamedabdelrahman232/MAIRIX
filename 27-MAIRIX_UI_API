 ************************************************/

function apiSearch(
  request
) {

  try {

    const context =
      mairixApiRequirePermission(
        "MASTER_DATA",
        "View"
      );


    if (
      typeof searchMAIRIX !==
      "function"
    ) {

      throw new Error(
        "searchMAIRIX() is not available."
      );

    }


    const searchRequest =
      Object.assign(
        {},
        request || {}
      );


    /*
     * Never trust client-side identity.
     */

    delete searchRequest.userId;

    delete searchRequest.serverUserId;


    searchRequest.serverUserId =
      context.userId;


    const result =
      searchMAIRIX(
        searchRequest
      );


    return mairixApiSuccess(
      result,
      "Search completed."
    );

  } catch (error) {

    return mairixApiError(
      error,
      "SEARCH_ERROR"
    );

