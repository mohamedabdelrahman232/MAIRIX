/************************************************
 * PRODUCT EXACT LOOKUP
 *
 * Used after:
 *
 * - barcode scan
 * - selected search result
 * - exact Product Code
 *
 * Search is NOT used as authorization.
 ************************************************/

function apiGetProduct(
  lookup
) {

  try {

    mairixApiRequirePermission(
      "MASTER_DATA",
      "View"
    );


    const key =
      mairixUIApiCleanText(
        lookup
      );


    if (!key) {

      throw new Error(
        "Product Code or Barcode is required."
      );

    }


    /*
     * Prefer existing MAIRIX inventory/product
     * resolver so the transaction layer and
     * UI layer resolve products consistently.
     */

    let product =
      null;


    if (
      typeof getProductForInventory ===
      "function"
    ) {

      product =
        getProductForInventory(
          key
        );

    }


    if (
      !product &&
      typeof mairixGetItem ===
      "function"
    ) {

      product =
        mairixGetItem(
          key
        );

    }


    /*
     * Controlled fallback against PRODUCTS
     * Master Data.
     */

    if (!product) {

      const records =
        mairixUIApiReadSheetRecords(
          "PRODUCTS"
        );


      const normalizedKey =
        mairixUIApiNormalizeSearch(
          key
        );


      for (
        let i = 0;
        i < records.length;
        i++
      ) {

        const record =
          records[i];


        if (
          !mairixUIApiIsActive(
            record["Active"]
          )
        ) {

          continue;

        }


        const code =
          mairixUIApiNormalizeSearch(
            record["Product Code"]
          );


        const barcode =
          mairixUIApiNormalizeSearch(
            record["Barcode"]
          );


        if (
          normalizedKey === code ||
          normalizedKey === barcode
        ) {

          product =
            mairixUIApiNormalizeProduct(
              record
            );

          break;

        }

      }

    }


    if (!product) {

      return mairixApiError(
        new Error(
          "Product not found."
        ),
        "PRODUCT_NOT_FOUND"
      );

    }


    return mairixApiSuccess(
      product,
      "Product loaded."
    );

  } catch (error) {

    return mairixApiError(
      error,
      "PRODUCT_LOOKUP_ERROR"
    );

  }

}


/************************************************
