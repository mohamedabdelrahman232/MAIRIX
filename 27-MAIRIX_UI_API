/************************************************
 * SANITIZE CLIENT TRANSACTION PAYLOAD
 *
 * Client supplied security identity is ignored.
 *
 * Server identity is authoritative.
 ************************************************/

function mairixApiSanitizeTransactionPayload(
  data,
  context
) {

  const request =
    Object.assign(
      {},
      data || {}
    );


  /*
   * Never trust these values from UI.
   */

  delete request.userId;

  delete request.serverUserId;

  delete request.user;

  delete request.role;

  delete request.email;

  delete request.userEmail;

  delete request.userName;

  delete request.createdBy;

  delete request.updatedBy;


  /*
   * Server-owned identity.
   */

  request.serverUserId =
    context.userId;

  request.serverUserEmail =
    context.email;

  request.serverUserName =
    context.name;


  return request;

}
