/************************************************
 * PRODUCT SEARCH
 *
 * SEARCH BY:
 *
 * 1. Product Code
 * 2. Barcode
 * 3. Product Name
 *
 * ONLY ACTIVE PRODUCTS.
 *
 * SERVER-SIDE SEARCH.
 *
 * The UI may type a name or barcode,
 * but the selected record always comes
 * from PRODUCTS Master Data.
 ************************************************/

function apiSearchProducts(
  query
) {

  try {

    mairixApiRequirePermission(
      "MASTER_DATA",
      "View"
    );


    const search =
      mairixUIApiNormalizeSearch(
        query
      );


    if (!search) {

      return mairixApiSuccess(
        [],
        "No product search query supplied."
      );

    }


    const records =
      mairixUIApiReadSheetRecords(
        "PRODUCTS"
      );


    const results =
      [];


    for (
      let i = 0;
      i < records.length;
      i++
    ) {

      const record =
        records[i];


      if (
        !mairixUIApiIsActive(
          record["Active"]
        )
      ) {

        continue;

      }


      const productCode =
        mairixUIApiNormalizeSearch(
          record["Product Code"]
        );


      const barcode =
        mairixUIApiNormalizeSearch(
          record["Barcode"]
        );


      const productName =
        mairixUIApiNormalizeSearch(
          record["Product Name"]
        );


      const matched =

        productCode.indexOf(
          search
        ) !== -1 ||

        barcode.indexOf(
          search
        ) !== -1 ||

        productName.indexOf(
          search
        ) !== -1;


      if (!matched) {

        continue;

      }


      results.push(
        mairixUIApiNormalizeProduct(
          record
        )
      );


      if (
        results.length >=
        MAIRIX_UI_SEARCH_LIMITS.PRODUCTS
      ) {

        break;

      }

    }


    return mairixApiSuccess(
      results,
      "Product search completed."
    );

  } catch (error) {

    return mairixApiError(
      error,
      "PRODUCT_SEARCH_ERROR"
    );

  }

}


