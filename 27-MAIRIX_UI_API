/************************************************
 * GET ACTIVE SETTINGS OPTIONS
 ************************************************/

function getMairixActiveSettingOptions(
  key
) {

  const normalizedKey =
    mairixCleanText(key)
      .toUpperCase();

  return mairixSettingsGetAllOptionRows()

    .filter(
      function(option) {

        return (
          mairixCleanText(option.key)
            .toUpperCase() ===
          normalizedKey
          &&
          option.active === true
        );

      }
    )

    .sort(
      function(a, b) {

        return (
          Number(a.sortOrder || 0) -
          Number(b.sortOrder || 0)
        );

      }
    );

}

/************************************************
 * API ROUTER
 ************************************************/

function mairixApiRouter(action, payload) {

  /************************************************
   * SECURITY HARDENING
   *
   * Never trust identity coming from UI.
   ************************************************/

  const secureRequest =
    mairixSecurityPrepareRequest(
      action,
      payload
    );

  action =
    secureRequest.action;

  payload =
    secureRequest.payload;

  const context =
    secureRequest.context;


  /************************************************
   * EXISTING ROUTER CODE CONTINUES BELOW
   ************************************************/


  // اترك باقي الكود الأصلي للدالة هنا كما هو

  try {

    const normalizedAction =
      mairixUIApiCleanText(
        action
      );


    switch (
      normalizedAction
    ) {

      case "CURRENT_USER":

        return apiGetCurrentUser();


      case "MY_PERMISSIONS":

        return apiGetMyPermissions();


      case "HAS_PERMISSION":

        return apiHasPermission(
          payload &&
            payload.permissionCode,
          payload &&
            payload.action
        );


      case "MASTER_DATA":

        return apiGetMasterData(
          payload
        );


      case "SEARCH":

        return apiSearch(
          payload
        );


      case "SEARCH_PRODUCTS":

        return apiSearchProducts(
          payload &&
            (
              payload.query ||
              payload.search ||
              payload.value
            )
        );


      case "SEARCH_CUSTOMERS":

        return apiSearchCustomers(
          payload &&
            (
              payload.query ||
              payload.search ||
              payload.value
            )
        );


      case "SEARCH_VENDORS":

        return apiSearchVendors(
          payload &&
            (
              payload.query ||
              payload.search ||
              payload.value
            )
        );


      case "SEARCH_WAREHOUSES":

        return apiSearchWarehouses(
          payload &&
            (
              payload.query ||
              payload.search ||
              payload.value
            )
        );


      case "GET_PRODUCT":

        return apiGetProduct(
          payload &&
            (
              payload.lookup ||
              payload.productCode ||
              payload.barcode ||
              payload.itemCode
