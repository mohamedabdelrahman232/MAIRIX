/************************************************
 * MAIRIX ERP
 * 27-MAIRIX_UI_API
 *
 * UI <-> SERVER API
 *
 * RESPONSIBILITIES:
 *
 * 1. Single server-side gateway for the UI
 * 2. Never trust UI userId
 * 3. Identify authenticated MAIRIX user server-side
 * 4. Enforce permissions before every operation
 * 5. Route requests to the correct engine
 * 6. Return standardized responses
 * 7. Keep UI independent from spreadsheet structure
 * 8. Provide controlled server-side search
 * 9. Provide controlled exact lookups
 *
 * IMPORTANT:
 *
 * UI MUST NOT:
 *
 * - write directly to sheets
 * - calculate balances
 * - calculate taxes
 * - calculate inventory
 * - calculate financial statements
 * - decide permissions
 * - create master-data records implicitly
 *
 * All business logic remains server-side.
 ************************************************/


/************************************************
 * API VERSION
 ************************************************/

const MAIRIX_UI_API_VERSION = "1.1.0";


/************************************************
 * UI SEARCH LIMITS
 ************************************************/

const MAIRIX_UI_SEARCH_LIMITS = {

  PRODUCTS:
    20,

  CUSTOMERS:
    20,

  VENDORS:
    20,

  WAREHOUSES:
    50

};


/************************************************
 * STANDARD SUCCESS RESPONSE
 ************************************************/

function mairixApiSuccess(
  data,
  message
){

  return {

    success:
      true,

    apiVersion:
      MAIRIX_UI_API_VERSION,

    message:
      message ||
      "Operation completed successfully.",

    data:
      data === undefined
        ? null
        : data

  };

}


/************************************************
 * STANDARD ERROR RESPONSE
 *
 * IMPORTANT:
 *
 * Rejected operations record the
 * authenticated server-side User ID.
 *
 * UI supplied userId is NEVER trusted.
 ************************************************/

function mairixApiError(
  error,
  code,
  context
) {

  const message =
    error &&
    error.message
      ? error.message
      : String(error);


  let trustedContext =
    context || null;


  if (
    !trustedContext
  ) {

    try {

      if (
        typeof mairixApiContext ===
        "function"
      ) {

        trustedContext =
          mairixApiContext();

      }

    } catch (
      authError
    ) {

      trustedContext =
        null;

    }

  }


  const rejection = {

    timestamp:
      new Date(),

    source:
      "MAIRIX_UI_API",

    code:
      code ||
      "MAIRIX_API_ERROR",

    message:
      message,

    userId:
      trustedContext &&
      trustedContext.userId
        ? trustedContext.userId
        : "",

    reference:
      trustedContext &&
      trustedContext.reference
        ? trustedContext.reference
        : "",

    rejected:
      true

  };


  /*
   * Record rejection centrally.
   *
   * The rejection engine remains responsible
   * for persistence / rejection reporting.
   */

  if (
    typeof mairixRecordRejection ===
    "function"
  ) {

    try {

      mairixRecordRejection(
        rejection
      );

    } catch (
      rejectionError
    ) {

      /*
       * Never replace the original API
       * error with a rejection-log error.
       */

      console.error(
        rejectionError
      );

    }

  }


  return {

    success:
      false,

    apiVersion:
      MAIRIX_UI_API_VERSION,

    error: {

      code:
        code ||
        "MAIRIX_API_ERROR",

      message:
        message

    }

  };

}


/************************************************
 * TEXT NORMALIZATION
 ************************************************/

function mairixUIApiCleanText(
  value
) {

  if (
    value === null ||
    value === undefined
  ) {

    return "";

  }


  return String(
    value
  ).trim();

}


/************************************************
 * SEARCH NORMALIZATION
 *
 * Used only for comparison.
 *
 * Original Master Data is never modified.
 ************************************************/

function mairixUIApiNormalizeSearch(
  value
) {

  return mairixUIApiCleanText(
    value
  )
    .toLowerCase();

}


/************************************************
 * ACTIVE FLAG NORMALIZATION
 ************************************************/

function mairixUIApiIsActive(
  value
) {

  if (
    value === true
  ) {

    return true;

  }


  if (
    value === false
  ) {

    return false;

  }


  const normalized =
    mairixUIApiNormalizeSearch(
      value
    );


  return (

    normalized === "true" ||

    normalized === "1" ||

    normalized === "yes" ||

    normalized === "active"

  );

}


/************************************************
 * TRUSTED CURRENT USER
 *
 * IMPORTANT:
 *
 * UI userId is NEVER trusted.
 *
 * Authentication must come from
 * server-side MAIRIX authentication layer.
 ************************************************/

function mairixApiCurrentUser() {

  if (
    typeof mairixRequireCurrentUser ===
    "function"
  ) {

    return mairixRequireCurrentUser();

  }


  if (
    typeof requireCurrentUser ===
    "function"
  ) {

    return requireCurrentUser();

  }


  throw new Error(
    "MAIRIX authentication engine is unavailable."
  );

}


/************************************************
 * API CONTEXT
 *
 * Creates the trusted server-side context.
 ************************************************/

function mairixApiContext() {

  const user =
    mairixApiCurrentUser();


  return {

    userId:
      user.userId,

    email:
      user.email,

    name:
      user.name,

    role:
      user.role,

    active:
      user.active === true

  };

}


/************************************************
 * GENERIC API PERMISSION CHECK
 ************************************************/

function mairixApiRequirePermission(
  permissionCode,
  action
) {

  const context =
    mairixApiContext();


  mairixRequirePermission(
    context.userId,
    permissionCode,
    action
  );


  return context;

}


/************************************************
 * GET CURRENT USER FOR UI
 ************************************************/

function apiGetCurrentUser() {

  try {

    const user =
      mairixApiCurrentUser();


    return mairixApiSuccess(
      {

        userId:
          user.userId,

        name:
          user.name,

        email:
          user.email,

        role:
          user.role,

        active:
          user.active

      },
      "Current user loaded."
    );

  } catch (error) {

    return mairixApiError(
      error,
      "AUTHENTICATION_ERROR"
    );

  }

}


/************************************************
 * GET USER PERMISSIONS
 ************************************************/

function apiGetMyPermissions() {

  try {

    const context =
      mairixApiContext();


    if (
      context.role === "ADMIN"
    ) {

      return mairixApiSuccess(
        {

          userId:
            context.userId,

          role:
            context.role,

          admin:
            true,

          fullAccess:
            true

        },
        "Administrator permissions loaded."
      );

    }


    const permissionData =
      mairixGetCurrentUserPermissions(
        context.userId
      );


    return mairixApiSuccess(
      {

        userId:
          context.userId,

        role:
          context.role,

        admin:
          permissionData.admin,

        fullAccess:
          permissionData.fullAccess,

        permissions:
          permissionData.permissions

      },
      "User permissions loaded."
    );

  } catch (error) {

    return mairixApiError(
      error,
      "PERMISSIONS_ERROR"
    );

  }

}


/************************************************
 * GENERIC PERMISSION QUERY
 *
 * UI visibility only.
 *
 * NEVER replaces server-side enforcement.
 ************************************************/

function apiHasPermission(
  permissionCode,
  action
) {

  try {

    const context =
      mairixApiContext();


    const allowed =
      mairixHasPermission(
        context.userId,
        permissionCode,
        action
      );


    return mairixApiSuccess(
      {

        permissionCode:
          permissionCode,

        action:
          action,

        allowed:
          allowed === true

      },
      "Permission checked."
    );

  } catch (error) {

    return mairixApiError(
      error,
      "PERMISSION_CHECK_ERROR"
    );

  }

}


/************************************************
 * MASTER DATA
 ************************************************/

function apiGetMasterData(
  request
) {

  try {

    mairixApiRequirePermission(
      "MASTER_DATA",
      "View"
    );


    if (
      typeof getMasterData !==
      "function"
    ) {

      throw new Error(
        "getMasterData() is not available."
      );

    }


    const result =
      getMasterData(
        request || {}
      );


    return mairixApiSuccess(
      result,
      "Master data loaded."
    );

  } catch (error) {

    return mairixApiError(
      error,
      "MASTER_DATA_ERROR"
    );

  }

}


/************************************************
 * MASTER DATA SHEET READER
 *
 * READ ONLY.
 *
 * This is used ONLY for controlled UI search.
 *
 * No transaction writes.
 * No calculations.
 * No business decisions.
 ************************************************/

function mairixUIApiReadSheetRecords(
  sheetName
) {

  if (
    typeof mairixgetSheet !==
    "function"
  ) {

    throw new Error(
      "mairixgetSheet() is not available."
    );

  }


  const sheet =
    mairixgetSheet(
      sheetName
    );


  if (!sheet) {

    throw new Error(
      "Sheet not found: " +
      sheetName
    );

  }


  const lastRow =
    sheet.getLastRow();


  const lastColumn =
    sheet.getLastColumn();


  if (
    lastRow < 2 ||
    lastColumn < 1
  ) {

    return [];

  }


  const headers =
    sheet
      .getRange(
        1,
        1,
        1,
        lastColumn
      )
      .getDisplayValues()[0];


  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        lastColumn
      )
      .getDisplayValues();


  const records =
    [];


  for (
    let rowIndex = 0;
    rowIndex < values.length;
    rowIndex++
  ) {

    const record =
      {};


    for (
      let columnIndex = 0;
      columnIndex < headers.length;
      columnIndex++
    ) {

      const header =
        mairixUIApiCleanText(
          headers[columnIndex]
        );


      if (!header) {

        continue;

      }


      record[header] =
        values[rowIndex][
          columnIndex
        ];

    }


    records.push(
      record
    );

  }


  return records;

}


/************************************************
 * PRODUCT NORMALIZER
 *
 * PRODUCT MASTER DATA
 *
 * Product Code
 * Barcode
 * Product Name
 * Category
 * Unit
 * Opening Stock
 * Opening Cost
 * Min Stock
 * Active
 * Sale Price
 * WAC
 * Current Stock
 ************************************************/

function mairixUIApiNormalizeProduct(
  record
) {

  if (!record) {

    return null;

  }


  const productCode =
    mairixUIApiCleanText(
      record["Product Code"]
    );


  const barcode =
    mairixUIApiCleanText(
      record["Barcode"]
    );


  const productName =
    mairixUIApiCleanText(
      record["Product Name"]
    );


  const category =
    mairixUIApiCleanText(
      record["Category"]
    );


  return {

    productCode:
      productCode,

    barcode:
      barcode,

    productName:
      productName,

    name:
      productName,

    itemCode:
      productCode,

    itemName:
      productName,

    category:
      category,

    categoryName:
      category,

    unit:
      mairixUIApiCleanText(
        record["Unit"]
      ),

    openingStock:
      record["Opening Stock"],

    openingCost:
      record["Opening Cost"],

    minStock:
      record["Min Stock"],

    active:
      mairixUIApiIsActive(
        record["Active"]
      ),

    salePrice:
      record["Sale Price"],

    wac:
      record["WAC"],

    currentStock:
      record["Current Stock"]

  };

}


