/************************************************
 * MAIRIX ERP
 * CENTRAL REFERENCE INTEGRATION TEST
 *
 * PURPOSE:
 *
 * Prove that one central Reference ID can act as
 * the parent identity of a complete transaction.
 *
 * TESTS:
 *
 * 1. Generate one central Reference.
 * 2. Validate the Reference.
 * 3. Create SALE transaction context.
 * 4. Validate transaction context.
 * 5. Verify child records reuse the exact same
 *    Reference ID.
 * 6. Verify transaction type protection.
 * 7. Verify invalid Reference rejection.
 * 8. Verify duplicate Reference protection.
 *
 * IMPORTANT:
 *
 * This test does NOT create production
 * transactions or ledger records.
 ************************************************/


function testMairixCentralReferenceIntegration() {

  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX CENTRAL REFERENCE INTEGRATION TEST"
  );

  Logger.log(
    "=========================================="
  );


  /************************************************
   * TEST 1
   * CREATE CENTRAL REFERENCE
   ************************************************/

  const referenceResult =
    createMairixTransactionReference();


  if (
    !referenceResult ||
    referenceResult.success !== true ||
    !referenceResult.referenceId
  ) {

    throw new Error(
      "Central Reference generation failed."
    );

  }


  const referenceId =
    referenceResult.referenceId;


  Logger.log(
    "Generated Reference: " +
    referenceId
  );


  /************************************************
   * TEST 2
   * VALIDATE REFERENCE
   ************************************************/

  const validatedReference =
    validateMairixReferenceId(
      referenceId
    );


  if (
    validatedReference !==
    referenceId
  ) {

    throw new Error(
      "Reference validation returned an unexpected value."
    );

  }


  Logger.log(
    "Reference validation: PASS"
  );


  /************************************************
   * TEST 3
   * CREATE TRANSACTION CONTEXT
   *
   * IMPORTANT:
   *
   * We intentionally verify that a transaction
   * context can carry the same Reference ID.
   ************************************************/

  const context =
    {

      referenceId:
        referenceId,

      transactionType:
        "SALE",

      createdAt:
        new Date()

    };


  const validatedContext =
    requireMairixReferenceContext(
      context
    );


  if (
    validatedContext.referenceId !==
    referenceId
  ) {

    throw new Error(
      "Transaction context changed the Reference ID."
    );

  }


  if (
    validatedContext.transactionType !==
    "SALE"
  ) {

    throw new Error(
      "Transaction context type is invalid."
    );

  }


  Logger.log(
    "Transaction context: PASS"
  );


  /************************************************
   * TEST 4
   * CHILD REFERENCE REUSE
   *
   * Every child ledger must receive the exact
   * parent Reference ID.
   ************************************************/

  const childReferences = [

    {
      name:
        "TRANSACTION_LINES",

      referenceId:
        context.referenceId
    },

    {
      name:
        "INVENTORY_LEDGER",

      referenceId:
        context.referenceId
    },

    {
      name:
        "FINANCIAL_LEDGER",

      referenceId:
        context.referenceId
    },

    {
      name:
        "CUSTOMER_LEDGER",

      referenceId:
        context.referenceId
    },

    {
      name:
        "SALESMAN_LEDGER",

      referenceId:
        context.referenceId
    },

    {
      name:
        "COMMISSIONS",

      referenceId:
        context.referenceId
    },

    {
      name:
        "LOYALTY",

      referenceId:
        context.referenceId
    },

    {
      name:
        "AUDIT_LOG",

      referenceId:
        context.referenceId
    }

  ];


  childReferences.forEach(
    function(child) {

      const childReference =
        assertMairixChildReference(
          child.referenceId
        );


      if (
        childReference !==
        referenceId
      ) {

        throw new Error(
          child.name +
          " does not reuse the parent Reference ID."
        );

      }

    }
  );


  Logger.log(
    "Child Reference Reuse: PASS"
  );


  /************************************************
   * TEST 5
   * CHILD CONTEXT TYPE VALIDATION
   ************************************************/

  const childContext =
    assertMairixChildContext(
      context,
      "SALE"
    );


  if (
    childContext.referenceId !==
    referenceId
  ) {

    throw new Error(
      "Child context lost the parent Reference ID."
    );

  }


  Logger.log(
    "Child Context Validation: PASS"
  );


  /************************************************
   * TEST 6
   * TRANSACTION TYPE MISMATCH MUST FAIL
   ************************************************/

  let typeMismatchRejected =
    false;


  try {

    assertMairixChildContext(
      context,
      "PURCHASE"
    );

  } catch (
    error
  ) {

    typeMismatchRejected =
      true;

    Logger.log(
      "Expected type mismatch rejection: " +
      error.message
    );

  }


  if (
    !typeMismatchRejected
  ) {

    throw new Error(
      "Transaction type mismatch was not rejected."
    );

  }


  Logger.log(
    "Transaction Type Protection: PASS"
  );


  /************************************************
   * TEST 7
   * INVALID REFERENCE MUST FAIL
   ************************************************/

  let invalidReferenceRejected =
    false;


  try {

    validateMairixReferenceId(
      "INVALID-REFERENCE"
    );

  } catch (
    error
  ) {

    invalidReferenceRejected =
      true;

    Logger.log(
      "Expected invalid Reference rejection: " +
      error.message
    );

  }


  if (
    !invalidReferenceRejected
  ) {

    throw new Error(
      "Invalid Reference ID was not rejected."
    );

  }


  Logger.log(
    "Invalid Reference Protection: PASS"
  );


  /************************************************
   * TEST 8
   * SECOND GENERATED REFERENCE MUST DIFFER
   ************************************************/

  const secondReferenceResult =
    createMairixTransactionReference();


  if (
    !secondReferenceResult ||
    !secondReferenceResult.referenceId
  ) {

    throw new Error(
      "Second Reference generation failed."
    );

  }


  const secondReferenceId =
    secondReferenceResult.referenceId;


  if (
    secondReferenceId ===
    referenceId
  ) {

    throw new Error(
      "Central Reference generator produced duplicate IDs."
    );

  }


  Logger.log(
    "Reference Uniqueness: PASS"
  );


  /************************************************
   * TEST 9
   * CHILD CANNOT CREATE A DIFFERENT REFERENCE
   *
   * This simulates the rule that every child
   * must inherit the parent Reference.
   ************************************************/

  let childMismatchRejected =
    false;


  try {

    if (
      secondReferenceId !==
      referenceId
    ) {

      throw new Error(
        "Child attempted to use a different Reference ID."
      );

    }

  } catch (
    error
  ) {

    childMismatchRejected =
      true;

    Logger.log(
      "Expected child Reference mismatch rejection: " +
      error.message
    );

  }


  if (
    !childMismatchRejected
  ) {

    throw new Error(
      "Child Reference mismatch was not detected."
    );

  }


  Logger.log(
    "Child Reference Integrity: PASS"
  );


  /************************************************
   * FINAL RESULT
   ************************************************/

  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX CENTRAL REFERENCE INTEGRATION TEST: PASS"
  );

  Logger.log(
    "=========================================="
  );


  return {

    success:
      true,

    referenceId:
      referenceId,

    secondReferenceId:
      secondReferenceId,

    transactionType:
      validatedContext.transactionType,

    childCount:
      childReferences.length

  };

}

