  };


  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX USERS & PERMISSIONS AUDIT"
  );

  Logger.log(
    "=========================================="
  );


  sheetNames.forEach(
    function(sheetName) {

      const sheet =
        spreadsheet.getSheetByName(
          sheetName
        );


      if (!sheet) {

        result.sheets[sheetName] = {

          exists: false,

          headers: [],

          records: 0

        };


        Logger.log(
          "MISSING SHEET: " +
          sheetName
        );


        return;

      }


      const lastRow =
        sheet.getLastRow();


      const lastColumn =
        sheet.getLastColumn();


      let headers = [];

      let records = 0;


      if (
        lastRow >= 1 &&
        lastColumn >= 1
      ) {

        headers =
          sheet
            .getRange(
              1,
              1,
              1,
              lastColumn
            )
            .getValues()[0]
            .map(
              function(value) {

                return String(
                  value || ""
                ).trim();

              }
            );

      }


      if (
        lastRow > 1 &&
        lastColumn > 0
      ) {

        const rows =
          sheet
            .getRange(
              2,
              1,
              lastRow - 1,
              lastColumn
            )
            .getValues();


        rows.forEach(
          function(row) {

            const hasData =
              row.some(
                function(cell) {

                  return String(
                    cell === null ||
                    cell === undefined
                      ? ""
                      : cell
                  ).trim() !== "";

                }
              );


            if (hasData) {

              records++;

            }

          }
        );

      }


      result.sheets[sheetName] = {

        exists: true,

        headers: headers,

        records: records

      };


      Logger.log(
        "------------------------------------------"
      );

      Logger.log(
        "SHEET: " +
        sheetName
      );

      Logger.log(
        "RECORDS: " +
        records
      );

      Logger.log(
        "HEADERS:"
      );

      Logger.log(
        JSON.stringify(headers)
      );

    }
  );


  /**********************************************
   * BUILD SUMMARY
   **********************************************/

  result.summary.users =
    result.sheets.USERS
      ? result.sheets.USERS.records
      : 0;


  result.summary.roles =
    result.sheets.ROLES
      ? result.sheets.ROLES.records
      : 0;


  result.summary.permissions =
    result.sheets.PERMISSIONS
      ? result.sheets.PERMISSIONS.records
      : 0;


  result.summary.permissionCatalog =
    result.sheets.PERMISSION_CATALOG
      ? result.sheets.PERMISSION_CATALOG.records
      : 0;


  result.summary.rolePermissions =
    result.sheets.ROLE_PERMISSIONS
      ? result.sheets.ROLE_PERMISSIONS.records
      : 0;


  result.summary.userPermissions =
    result.sheets.USER_PERMISSIONS
      ? result.sheets.USER_PERMISSIONS.records
      : 0;


  /**********************************************
   * LOG RESULT
   **********************************************/

  Logger.log(
    "=========================================="
  );

  Logger.log(
    "USERS & PERMISSIONS SUMMARY"
  );

  Logger.log(
    "=========================================="
  );

  Logger.log(
    JSON.stringify(
      result.summary,
      null,
      2
    )
  );


  Logger.log(
    "=========================================="
  );

  Logger.log(
    "FULL USERS & PERMISSIONS RESULT"
  );

  Logger.log(
    "=========================================="
  );

  Logger.log(
    JSON.stringify(
      result,
      null,
      2
    )
  );


  return result;

}

/************************************************
 * MAIRIX ROLE & PERMISSION INTEGRITY AUDIT
 *
 * READ ONLY
 *
 * Checks:
 * - Roles
 * - ADMIN role existence
 * - Role permissions
 * - Permission catalog references
 * - Orphan permission mappings
 ************************************************/

function mairixAuditRolePermissionIntegrity() {

  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX ROLE & PERMISSION INTEGRITY AUDIT"
  );

  Logger.log(
    "=========================================="
  );


  const roles =
    mairixAuditReadSheetObjects(
      "ROLES"
    );


  const permissionCatalog =
    mairixAuditReadSheetObjects(
      "PERMISSION_CATALOG"
    );


  const rolePermissions =
    mairixAuditReadSheetObjects(
      "ROLE_PERMISSIONS"
    );


  /**********************************************
   * LOOKUPS
   **********************************************/

  const roleLookup =
    new Map();


  roles.forEach(
    function(role) {

      const roleCode =
        String(
          role["Role Code"] || ""
        ).trim();


      if (roleCode) {

        roleLookup.set(
          roleCode,
          role
        );

      }

    }
  );


  const permissionLookup =
    new Set();


  permissionCatalog.forEach(
    function(permission) {

      const permissionCode =
        String(
          permission["Permission Code"] || ""
        ).trim();


      if (permissionCode) {

        permissionLookup.add(
          permissionCode
        );

      }

    }
  );


  /**********************************************
   * RESULT
   **********************************************/

  const result = {

    roles: [],

    adminRoles: [],

    orphanRoleMappings: [],

    orphanPermissionMappings: [],

    totalRoles:
      roles.length,

    totalPermissionCatalog:
      permissionCatalog.length,

    totalRolePermissions:
      rolePermissions.length

  };


  /**********************************************
   * ANALYZE EACH ROLE
   **********************************************/

  roles.forEach(
    function(role) {

      const roleCode =
        String(
          role["Role Code"] || ""
        ).trim();


      const roleName =
        String(
          role["Role Name"] || ""
        ).trim();


      const active =
        role["Active"];


      const mappings =
        rolePermissions.filter(
          function(mapping) {

            return String(
              mapping["Role Code"] || ""
            ).trim() === roleCode;

          }
        );


      const activeMappings =
        mappings.filter(
          function(mapping) {

            return mapping["Active"] !== false;

          }
        );


      const roleResult = {

        roleCode:
          roleCode,

        roleName:
          roleName,

        active:
          active,

        permissionMappings:
          mappings.length,

        activePermissionMappings:
          activeMappings.length

      };


      result.roles.push(
        roleResult
      );


      const normalizedRoleCode =
        roleCode.toUpperCase();


      const normalizedRoleName =
        roleName.toUpperCase();


      if (
        normalizedRoleCode === "ADMIN" ||
        normalizedRoleCode === "ADMINISTRATOR" ||
        normalizedRoleName.indexOf("ADMIN") !== -1
      ) {

        result.adminRoles.push(
          roleResult
        );

      }

    }
  );


  /**********************************************
   * CHECK ROLE PERMISSION REFERENCES
   **********************************************/

  rolePermissions.forEach(
    function(mapping) {

      const roleCode =
        String(
          mapping["Role Code"] || ""
        ).trim();


      const permissionCode =
        String(
          mapping["Permission Code"] || ""
        ).trim();


      if (
        roleCode &&
        !roleLookup.has(roleCode)
      ) {

        result.orphanRoleMappings.push({

          roleCode:
            roleCode,

          permissionCode:
            permissionCode

        });

      }


      if (
        permissionCode &&
        !permissionLookup.has(permissionCode)
      ) {

        result.orphanPermissionMappings.push({

          roleCode:
            roleCode,

          permissionCode:
            permissionCode

        });

      }

    }
  );


  /**********************************************
   * LOG ROLES
   **********************************************/

  Logger.log(
    "------------------------------------------"
  );

  Logger.log(
    "ROLES SUMMARY"
  );

  Logger.log(
    JSON.stringify(
      result.roles,
      null,
      2
    )
  );


  Logger.log(
    "------------------------------------------"
  );

  Logger.log(
    "ADMIN ROLES"
  );

  Logger.log(
    JSON.stringify(
      result.adminRoles,
      null,
      2
    )
  );


  Logger.log(
    "------------------------------------------"
  );

  Logger.log(
    "ORPHAN ROLE MAPPINGS: " +
    result.orphanRoleMappings.length
  );


  Logger.log(
    "ORPHAN PERMISSION MAPPINGS: " +
    result.orphanPermissionMappings.length
  );


  Logger.log(
    "=========================================="
  );

  Logger.log(
    "FINAL RESULT"
  );

  Logger.log(
    JSON.stringify(
      result,
      null,
      2
    )
  );


  return result;

}
