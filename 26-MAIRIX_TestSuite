/************************************************
 * MAIRIX ERP
 * UI API SECURITY TEST
 *
 * TEST:
 * API PERMISSION REJECTION
 *
 * PURPOSE:
 * Verify that the UI API rejects an operation
 * when the authenticated user does not have
 * the required permission.
 *
 * IMPORTANT:
 * - Does NOT trust UI userId.
 * - Does NOT modify production transaction data.
 * - Does NOT call the transaction engine after
 *   permission rejection.
 * - Rejection must pass through mairixApiError()
 *   and therefore reach Rejection Report.
 ************************************************/

function testMAIRIXUIPermissionRejection() {

  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX UI API PERMISSION REJECTION TEST"
  );

  Logger.log(
    "=========================================="
  );


  /**********************************************
   * 1. GET AUTHENTICATED USER
   **********************************************/

  const context =
    mairixApiContext();


  Logger.log(
    "AUTHENTICATED USER:"
  );

  Logger.log(
    JSON.stringify(
      context,
      null,
      2
    )
  );


  if (
    !context ||
    !context.userId
  ) {

    throw new Error(
      "Authenticated user context is unavailable."
    );

  }


  /**********************************************
   * 2. ADMIN MUST NOT BE USED FOR THIS TEST
   *
   * ADMIN has full access, therefore the test
   * cannot prove rejection when executed as ADMIN.
   **********************************************/

  if (
    context.role === "ADMIN"
  ) {

    throw new Error(
      "PERMISSION REJECTION TEST REQUIRES A NON-ADMIN USER."
    );

  }


  /**********************************************
   * 3. USE A KNOWN RESTRICTED PERMISSION
   *
   * This must be a permission that the current
   * authenticated user does NOT have.
   *
   * We use USERS / Create because normal users
   * should not be able to create system users.
   **********************************************/

  const permissionCode =
    "USERS";

  const action =
    "Create";


  /**********************************************
   * 4. VERIFY PERMISSION IS ACTUALLY DENIED
   **********************************************/

  let permissionDenied =
    false;


  try {

    mairixApiRequirePermission(
      permissionCode,
      action
    );

  } catch (error) {

    permissionDenied =
      true;


    Logger.log(
      "EXPECTED PERMISSION REJECTION:"
    );

    Logger.log(
      JSON.stringify(
        {
          message:
            error &&
            error.message
              ? error.message
              : String(error)
        },
        null,
        2
      )
    );

  }


  if (
    permissionDenied !== true
  ) {

    throw new Error(
      "SECURITY TEST FAILED: " +
      "Current user was allowed to pass the restricted permission."
    );

  }


  /**********************************************
   * 5. VERIFY THE ACTUAL API ENDPOINT
   *
   * We now call an endpoint protected by the
   * same permission.
   *
   * The endpoint must reject BEFORE createUser()
   * is executed.
   **********************************************/

  const result =
    apiCreateUser(
      {
        email:
          "TEST_PERMISSION_REJECTION@INVALID",

        name:
          "TEST PERMISSION REJECTION",

        role:
          "USER"

      }
    );


  Logger.log(
    "API RESULT:"
  );

  Logger.log(
    JSON.stringify(
      result,
      null,
      2
    )
  );


  /**********************************************
   * 6. API MUST RETURN FAILURE
   **********************************************/

  if (
    !result ||
    result.success !== false
  ) {

    throw new Error(
      "SECURITY TEST FAILED: " +
      "Restricted API request was not rejected."
    );

  }


  /**********************************************
   * 7. ERROR MUST CONTAIN A CODE
   **********************************************/

  if (
    !result.error ||
    !result.error.code
  ) {

    throw new Error(
      "SECURITY TEST FAILED: " +
      "Rejected API response has no error code."
    );

  }


  /**********************************************
   * 8. FINAL
   **********************************************/

  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX UI API PERMISSION REJECTION: PASS"
  );

  Logger.log(
    "=========================================="
  );

}

