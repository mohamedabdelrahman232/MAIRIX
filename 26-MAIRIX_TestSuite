    Logger.log(
      "Expected type mismatch rejection: " +
      error.message
    );

  }


  if (!mismatchRejected) {

    throw new Error(
      "Transaction type mismatch was not rejected."
    );

  }


  Logger.log(
    "Transaction Type Protection: PASS"
  );


  /*
