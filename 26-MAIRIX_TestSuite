/************************************************
 * MAIRIX TEST USERS CLEANUP
 *
 * Removes completely empty USER rows.
 *
 * IMPORTANT:
 * Does NOT delete real users.
 ************************************************/

function testMairixCleanupEmptyUserRows() {

  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX CLEANUP EMPTY USER ROWS"
  );

  Logger.log(
    "=========================================="
  );


  const sheet =
    getMAIRIXUsersSheet();


  if (!sheet) {

    throw new Error(
      "USERS sheet was not found."
    );

  }


  const lastRow =
    sheet.getLastRow();


  if (
    lastRow < 2
  ) {

    Logger.log(
      "USERS already contains no data rows."
    );

    return {
      success: true,
      removed: 0
    };

  }


  const lastColumn =
    sheet.getLastColumn();


  const headers =
    sheet
      .getRange(
        1,
        1,
        1,
        lastColumn
      )
      .getDisplayValues()[0];


  const userIdIndex =
    headers.indexOf(
      "User ID"
    );


  const emailIndex =
    headers.indexOf(
      "Gmail"
    );


  const nameIndex =
    headers.indexOf(
      "Name"
    );


  const roleIndex =
    headers.indexOf(
      "Role"
    );


  if (
    userIdIndex === -1
  ) {

    throw new Error(
      'USERS is missing "User ID" header.'
    );

  }


  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        lastColumn
      )
      .getDisplayValues();


  let removed =
    0;


  /*
   * Delete from bottom to top so row
   * indexes remain stable.
   */

  for (
    let i = values.length - 1;
    i >= 0;
    i--
  ) {

    const row =
      values[i];


    const userId =
      String(
        row[userIdIndex] || ""
      ).trim();


    const email =
      emailIndex !== -1
        ? String(
            row[emailIndex] || ""
          ).trim()
        : "";


    const name =
      nameIndex !== -1
        ? String(
            row[nameIndex] || ""
          ).trim()
        : "";


    const role =
      roleIndex !== -1
        ? String(
            row[roleIndex] || ""
          ).trim()
        : "";


    /*
     * Only remove rows that have
     * absolutely no user identity.
     */

    if (
      !userId &&
      !email &&
      !name &&
      !role
    ) {

      sheet.deleteRow(
        i + 2
      );

      removed++;

    }

  }


  Logger.log(
    "Removed empty USER rows: " +
    removed
  );


  Logger.log(
    "Remaining USER rows: " +
    Math.max(
      0,
      sheet.getLastRow() - 1
    )
  );


  Logger.log(
    "=========================================="
  );


  return {

    success:
      true,

    removed:
      removed

  };

}

