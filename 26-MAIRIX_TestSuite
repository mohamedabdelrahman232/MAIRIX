/************************************************
 * TEST USER HELPER
 *
 * Creates an isolated user directly in the
 * existing user-permission layer.
 *
 * The actual authentication/user master remains
 * untouched.
 ************************************************/

function ensureMAIRIXTestUser(
  userId,
  role
) {

  /*
   * IMPORTANT:
   *
   * mairixGetUserById() must resolve this user
   * for the permission engine.
   *
   * If the project USER master requires a
   * specific schema, this function will stop
   * and report that instead of guessing.
   */

  const user =
    mairixGetUserById(
      userId
    );


  if (!user) {

    throw new Error(
      "TEST USER DOES NOT EXIST IN USER MASTER: " +
      userId +
      ". Create the isolated test user through the existing user engine first."
    );

  }


  if (
    mairixAccessClean(
      user.role
    ).toUpperCase() !==
    role
  ) {

    throw new Error(
      "Test user role mismatch. Expected: " +
      role +
      " | Actual: " +
      user.role
    );

  }


  if (
    user.active !== true
  ) {

    throw new Error(
      "Test user must be ACTIVE."
    );

  }

}


