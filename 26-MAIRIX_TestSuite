 *
 * READ-ONLY AUDIT
 *
 * Checks:
 * - Sheet existence
 * - Actual headers
 * - Last row
 * - Real data rows
 ************************************************/

function mairixAuditMasterDataStructure() {

  const spreadsheet =
    SpreadsheetApp.getActiveSpreadsheet();


  const masterSheets = [

    "CUSTOMERS",

    "SALESMEN",

    "WAREHOUSES",

    "ITEMS",

