/************************************************
 * CENTRAL NUMBERING SYSTEM TEST
 *
 * Tests every entity registered in the
 * MAIRIX_NUMBERING_REGISTRY.
 *
 * Does NOT generate new codes.
 ************************************************/
function testMairixCentralNumberingSystem() {

  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX CENTRAL NUMBERING TEST"
  );

  Logger.log(
    "=========================================="
  );


  const validation =
    mairixValidateNumberingRegistry();


  Logger.log(
    "REGISTRY VALIDATION:"
  );

  Logger.log(
    JSON.stringify(
      validation,
      null,
      2
    )
  );


  const entities =
    Object.keys(
      MAIRIX_NUMBERING_REGISTRY
    );


  const results =
    [];


  for (
    let i = 0;
    i < entities.length;
    i++
  ) {

    const entity =
      entities[i];


    try {

      const config =
        mairixGetNumberingEntityConfig(
          entity
        );


      const highest =
        mairixGetHighestExistingSequence(
          entity
        );


      const result = {

        entity:
          entity,

        sheet:
          config.sheet,

        highestExistingSequence:
          highest,

        success:
          true

      };


      results.push(
        result
      );


      Logger.log(
        JSON.stringify(
          result,
          null,
          2
        )
      );


    } catch (error) {


      const failure = {

        entity:
          entity,

        success:
          false,

        error:
          error.message

      };


      results.push(
        failure
      );


      Logger.log(
        JSON.stringify(
          failure,
          null,
          2
        )
      );

    }

  }


  const failed =
    results.filter(
      function(result) {

        return result.success === false;

      }
    );


  const summary = {

    total:
      results.length,

    passed:
      results.length -
      failed.length,

    failed:
      failed.length,

    success:
      failed.length === 0,

