/************************************************
 * MAIRIX REAL SALE TRANSACTION ROLLBACK TEST
 *
 * PURPOSE:
 *
 * Prove that a real sale-like transaction can:
 *
 * 1. Start transaction
 * 2. Snapshot required data
 * 3. Modify multiple sale-related values
 * 4. Fail intentionally
 * 5. Rollback ALL modifications
 *
 * IMPORTANT:
 *
 * This test uses a dedicated temporary sheet.
 * It does NOT touch production sales/inventory data.
 ************************************************/

function testMairixRealSaleTransactionRollback() {

  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX REAL SALE TRANSACTION ROLLBACK TEST"
  );

  Logger.log(
    "=========================================="
  );


  const ss =
    SpreadsheetApp
      .getActiveSpreadsheet();


  const sheetName =
    "MAIRIX_TX_REAL_SALE_TEST";


  /**********************************************
   * CREATE / GET TEST SHEET
   **********************************************/

  let sheet =
    ss.getSheetByName(
      sheetName
    );


  if (
    !sheet
  ) {

    sheet =
      ss.insertSheet(
        sheetName
      );

  }


  /**********************************************
   * RESET TEST SHEET
   **********************************************/

  sheet.clear();


  /**********************************************
   * INITIAL STATE
   *
   * Simulates:
   *
   * INVENTORY
   * CUSTOMER LEDGER
   * SALES LEDGER
   **********************************************/

  const initialData = [

    [
      "ENTITY",
      "QTY",
      "BALANCE",
      "STATUS"
    ],

    [
      "INVENTORY",
      100,
      0,
      "BEFORE"
    ],

    [
      "CUSTOMER_LEDGER",
      0,
      500,
      "BEFORE"
    ],

    [
      "SALES_LEDGER",
      0,
      0,
      "BEFORE"
    ]

  ];


  sheet
    .getRange(
      1,
      1,
      initialData.length,
      initialData[0].length
    )
    .setValues(
      initialData
    );


  SpreadsheetApp
    .flush();


  /**********************************************
   * CAPTURE COMPLETE PRE-TRANSACTION STATE
   **********************************************/

  const beforeValues =
    sheet
      .getDataRange()
      .getValues();


  const beforeFormulas =
    sheet
      .getDataRange()
      .getFormulas();


  Logger.log(
    "BEFORE:"
  );


  Logger.log(
    JSON.stringify(
      beforeValues
    )
  );


  /**********************************************
   * RUN TRANSACTION
   **********************************************/

  const result =
    mairixRunTransaction(

      {

        source:
          "TRANSACTION_REAL_SALE_ROLLBACK_TEST",

        reference:
          "TX-REAL-SALE-ROLLBACK-TEST"

      },

      function(
        transaction
      ) {

        /****************************************
         * SNAPSHOT
         *
         * MUST happen before ANY mutation.
         ****************************************/

        mairixTransactionSnapshotRange(
          transaction,
          sheet,
          1,
          1,
          initialData.length,
          initialData[0].length
        );


        /****************************************
         * STEP 1
         *
         * Simulate inventory deduction.
         ****************************************/

        sheet
          .getRange(
            "B2"
          )
          .setValue(
            90
          );


        sheet
          .getRange(
            "D2"
          )
          .setValue(
            "MODIFIED"
          );


        /****************************************
         * STEP 2
         *
         * Simulate customer ledger update.
         ****************************************/

        sheet
          .getRange(
            "C3"
          )
          .setValue(
            600
          );


        sheet
          .getRange(
            "D3"
          )
          .setValue(
            "MODIFIED"
          );


        /****************************************
         * STEP 3
         *
         * Simulate sales ledger update.
         ****************************************/

        sheet
          .getRange(
            "B4"
          )
          .setValue(
            10
          );


        sheet
          .getRange(
            "C4"
          )
          .setValue(
            100
          );


        sheet
          .getRange(
            "D4"
          )
          .setValue(
            "MODIFIED"
          );


        SpreadsheetApp
          .flush();


        /****************************************
         * DURING TRANSACTION
         ****************************************/

        Logger.log(
          "DURING TRANSACTION:"
        );


        Logger.log(
          JSON.stringify(
            sheet
              .getDataRange()
              .getValues()
          )
        );


        /****************************************
         * FORCE FAILURE
         *
         * This MUST happen after all
         * modifications.
         ****************************************/

        throw new Error(
          "INTENTIONAL_REAL_SALE_ROLLBACK_FAILURE"
        );

      }

    );


  /**********************************************
   * TRANSACTION RESULT
   **********************************************/

  Logger.log(
    "TRANSACTION RESULT:"
  );


  Logger.log(
    JSON.stringify(
      result,
      null,
      2
    )
  );


  /**********************************************
   * EXPECTED FAILURE
   **********************************************/

  if (
    !result ||
    result.success !== false
  ) {

    throw new Error(
      "Expected transaction failure."
    );

  }


  /**********************************************
   * EXPECTED ROLLBACK
   **********************************************/

  if (
    result.rolledBack !== true
  ) {

    throw new Error(
      "Transaction did not rollback."
    );

  }


  /**********************************************
   * READ AFTER ROLLBACK
   **********************************************/

  SpreadsheetApp
    .flush();


  const afterValues =
    sheet
      .getDataRange()
      .getValues();


  const afterFormulas =
    sheet
      .getDataRange()
      .getFormulas();


  Logger.log(
    "AFTER ROLLBACK VALUES:"
  );


  Logger.log(
    JSON.stringify(
      afterValues
    )
  );


  Logger.log(
    "AFTER ROLLBACK FORMULAS:"
  );


  Logger.log(
    JSON.stringify(
      afterFormulas
    )
  );


  /**********************************************
   * VERIFY VALUES
   **********************************************/

  if (
    JSON.stringify(
      beforeValues
    ) !==
    JSON.stringify(
      afterValues
    )
  ) {

    throw new Error(
      "REAL SALE ROLLBACK FAILED: values were not restored."
    );

  }


  /**********************************************
   * VERIFY FORMULAS
   **********************************************/

  if (
    JSON.stringify(
      beforeFormulas
    ) !==
    JSON.stringify(
      afterFormulas
    )
  ) {

    throw new Error(
      "REAL SALE ROLLBACK FAILED: formulas were not restored."
    );

  }


  /**********************************************
   * FINAL
   **********************************************/

  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX REAL SALE TRANSACTION ROLLBACK: PASS"
  );

  Logger.log(
    "VALUES RESTORED."
  );

  Logger.log(
    "FORMULAS RESTORED."
  );

  Logger.log(
    "NO PARTIAL TRANSACTION REMAINS."
  );

  Logger.log(
    "=========================================="
  );

}


