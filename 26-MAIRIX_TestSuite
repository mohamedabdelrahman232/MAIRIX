/************************************************
 * RUN ALL TESTS
 *
 * SECURITY RULE:
 * ZERO TESTS CAN NEVER PASS
 ************************************************/

function runMairixTestSuite() {

  Logger.log(
    "=========================================="
  );

  Logger.log("MAIRIX ERP");

  Logger.log(
    "CENTRAL TEST SUITE"
  );

  Logger.log(
    "=========================================="
  );


  const registry =
    getMairixTestRegistry();


  if (
    !Array.isArray(registry) ||
    registry.length === 0
  ) {

    throw new Error(
      "MAIRIX TEST SUITE INVALID: No tests are registered."
    );

  }


  const tests = [];


  registry.forEach(
    function(entry) {

      tests.push(

        mairixRunRegisteredTest(
          entry.name,
          entry.test
        )

      );

    }
  );


  const passed =
    tests.filter(
      function(test) {

        return (
          test &&
          test.success === true
        );

      }
    ).length;


  const failed =
    tests.length - passed;


  const summary = {

    total: tests.length,

    passed: passed,

    failed: failed,

    success:
      tests.length > 0 &&
      failed === 0,

    tests: tests

  };


  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX TEST SUITE SUMMARY"
  );

  Logger.log(
    "=========================================="
  );


  Logger.log(
    JSON.stringify(
      summary,
      null,
      2
    )
  );


  if (summary.total === 0) {

    throw new Error(
      "MAIRIX TEST SUITE FAILED: Zero tests were executed."
    );

  }


  if (failed > 0) {

    throw new Error(
      "MAIRIX TEST SUITE FAILED: " +
      failed +
      " test(s)."
    );

  }


  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX TEST SUITE: PASS"
  );

  Logger.log(
    "=========================================="
  );


  return summary;

}


