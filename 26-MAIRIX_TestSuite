 ************************************************/

function testMairixCashSaleCentralFlow() {

  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX CASH SALE CENTRAL FLOW TEST"
  );

  Logger.log(
    "=========================================="
  );


  /*
   * TEST USER
   *
   * The test must execute through the real
   * MAIRIX authentication engine.
   *
   * IMPORTANT:
   * Replace this only if your dedicated test
   * user has a different User ID.
   */

  const testUserId =
    "USR-20260825-00001";


  /*
   * Establish a real MAIRIX session.
   */

  const authenticatedUser =
    setCurrentMAIRIXUser(
      testUserId
    );


  if (
    !authenticatedUser ||
    !authenticatedUser.userId
  ) {

    throw new Error(
      "Unable to establish MAIRIX test user session."
    );

  }


  Logger.log(
    "Authenticated Test User: " +
    authenticatedUser.userId
  );


  try {

    /*
     * Pre-generate a reference.
     *
     * This reference must NOT be silently reused
     * by createMairixSale().
     */

    const testReference =
      createMairixReferenceContext(
        "SALE"
      );


    Logger.log(
      "Pre-generated Reference: " +
      testReference.referenceId
    );


    /*
     * REAL CENTRAL SALE FLOW
     */

    const result =
      createMairixSale({

        customerCode:
          "TEST-CUSTOMER-001",

        salesmanCode:
          "TEST-SALESMAN-001",

        warehouseCode:
          "WH-001",

        paymentMethod:
          "CASH",

        discountPercent:
          0,

        referenceNote:
          "MAIRIX CASH SALE CENTRAL FLOW TEST",

        items: [

          {
            itemCode:
              "TEST-ITEM-001",

            quantity:
              2,

            unitPrice:
              100

          }

        ]

      });


    if (
      !result ||
      result.success !== true
    ) {

      throw new Error(
        "Cash sale creation failed."
      );

    }


    Logger.log(
      "Sale Reference: " +
      result.referenceId
    );


    /*
     * The sale must receive its own central
     * transaction reference.
     */

    if (
      result.referenceId ===
      testReference.referenceId
    ) {

      throw new Error(
        "Unexpected pre-generated reference reuse."
      );

    }


    const reference =
      result.referenceId;


    /*
     * Validate central reference.
     */

    validateMairixReferenceId(
      reference
    );


    /*
     * Basic financial classification
     */

    if (
      result.financialEffect <= 0
    ) {

      throw new Error(
        "Cash sale financial effect must be positive."
      );

    }


    if (
      result.cashEffect !==
      result.financialEffect
    ) {

      throw new Error(
        "Cash Effect does not match Financial Effect."
      );

    }


    if (
      result.customerCreditEffect !==
      0
    ) {

      throw new Error(
        "Cash sale must not create customer credit."
      );

    }


    /*
     * Inventory must decrease.
     */

    if (
      result.inventoryEffect !==
      -1
    ) {

      throw new Error(
        "Cash sale inventory effect must be -1."
      );

    }


    /*
     * Loyalty must increase.
     */

    if (
      !result.customer ||
      result.customer.loyaltyPointsAdded !==
      result.totalQuantity
    ) {

      throw new Error(
        "Cash sale loyalty points are incorrect."
      );

    }


    /*
     * Central Reference must exist.
     */

    if (!reference) {

      throw new Error(
        "Cash sale is missing central Reference ID."
      );

    }


    Logger.log(
      "Inventory Effect: " +
      result.inventoryEffect *
      result.totalQuantity
    );

    Logger.log(
      "Financial Effect: " +
      result.financialEffect
    );

    Logger.log(
      "Cash Effect: " +
      result.cashEffect
    );

    Logger.log(
      "Credit Effect: " +
      result.customerCreditEffect
    );

    Logger.log(
      "Loyalty Points Added: " +
      result.customer.loyaltyPointsAdded
    );


    /*
     * Inspect all central-reference children.
     */

    const details =
      getMairixReferenceDetails(
        reference
      );


    if (
      !details ||
      !details.transaction
    ) {

      throw new Error(
        "Central transaction was not found."
      );

    }


    Logger.log(
      "Transaction Reference: " +
      reference
    );


    Logger.log(
      "Transaction Lines: " +
      details.transactionLines.length
    );

    Logger.log(
      "Inventory Rows: " +
      details.inventory.length
    );

    Logger.log(
      "Financial Rows: " +
      details.financial.length
    );

    Logger.log(
      "Customer Ledger Rows: " +
      details.customerLedger.length
    );

    Logger.log(
      "Vendor Ledger Rows: " +
      details.vendorLedger.length
    );

    Logger.log(
      "Salesman Ledger Rows: " +
      details.salesmanLedger.length
    );

    Logger.log(
      "Tax Rows: " +
      details.taxes.length
    );

    Logger.log(
      "Commission Rows: " +
      details.commissions.length
    );

    Logger.log(
      "Loyalty Rows: " +
      details.loyalty.length
    );

    Logger.log(
      "Expense Rows: " +
      details.expenses.length
    );

    Logger.log(
      "Audit Rows: " +
      details.audit.length
    );


    Logger.log(
      "=========================================="
    );

    Logger.log(
      "MAIRIX CASH SALE CENTRAL FLOW TEST: PASS"
    );

    Logger.log(
      "=========================================="
    );


    return {

      success:
        true,

      referenceId:
        reference,

      result:
        result,

      details:
        details

    };

  } finally {

    /*
     * Always clear the test session.
     *
     * This guarantees that a failed test does
     * not leave a stale authenticated user
     * in UserProperties.
     */

    clearCurrentMAIRIXUser();

    Logger.log(
      "MAIRIX Test User Session Cleared."
    );

  }

}

