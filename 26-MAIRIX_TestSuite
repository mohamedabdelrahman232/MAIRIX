/************************************************
 * MAIRIX CLEAN ORPHAN USER WAREHOUSES
 *
 * SAFELY REMOVES ONLY RECORDS WHERE:
 *
 * - USER DOES NOT EXIST
 * OR
 * - WAREHOUSE DOES NOT EXIST
 *
 * DOES NOT TOUCH VALID PERMISSIONS
 ************************************************/

function mairixCleanOrphanUserWarehouses() {

  const spreadsheet =
    SpreadsheetApp.getActiveSpreadsheet();


  const usersSheet =
    spreadsheet.getSheetByName(
      "USERS"
    );


  const warehousesSheet =
    spreadsheet.getSheetByName(
      "WAREHOUSES"
    );


  const permissionsSheet =
    spreadsheet.getSheetByName(
      "USER_WAREHOUSES"
    );


  if (!usersSheet) {

    throw new Error(
      "USERS sheet not found."
    );

  }


  if (!warehousesSheet) {

    throw new Error(
      "WAREHOUSES sheet not found."
    );

  }


  if (!permissionsSheet) {

    throw new Error(
      "USER_WAREHOUSES sheet not found."
    );

  }


  /**********************************************
   * BUILD USERS LOOKUP
   **********************************************/

  const validUsers =
    mairixBuildAuditLookup(
      usersSheet,
      "User ID"
    );


  /**********************************************
   * BUILD WAREHOUSES LOOKUP
   **********************************************/

  const validWarehouses =
    mairixBuildAuditLookup(
      warehousesSheet,
      "Warehouse Code"
    );


  const lastRow =
    permissionsSheet.getLastRow();


  if (
    lastRow < 2
  ) {

    Logger.log(
      "USER_WAREHOUSES is already empty."
    );


    return {

      success: true,

      deleted: 0,

      remaining: 0

    };

  }


  const lastColumn =
    permissionsSheet.getLastColumn();


  const values =
    permissionsSheet
      .getRange(
        1,
        1,
        lastRow,
        lastColumn
      )
      .getValues();


  const headers =
    values[0].map(
      function(header) {

        return String(
          header || ""
        ).trim();

      }
    );


  const userIdIndex =
    headers.indexOf(
      "User ID"
    );


  const warehouseCodeIndex =
    headers.indexOf(
      "Warehouse Code"
    );


  if (
    userIdIndex === -1
  ) {

    throw new Error(
      "User ID column not found in USER_WAREHOUSES."
    );

  }


  if (
    warehouseCodeIndex === -1
  ) {

    throw new Error(
      "Warehouse Code column not found in USER_WAREHOUSES."
    );

  }


  /**********************************************
   * FIND ROWS TO DELETE
   **********************************************/

  const rowsToDelete = [];


  for (
    let rowIndex = 1;
    rowIndex < values.length;
    rowIndex++
  ) {

    const row =
      values[rowIndex];


    const userId =
      String(
        row[userIdIndex] || ""
      ).trim();


    const warehouseCode =
      String(
        row[warehouseCodeIndex] || ""
      ).trim();


    const userExists =
      userId &&
      validUsers.has(
        userId
      );


    const warehouseExists =
      warehouseCode &&
      validWarehouses.has(
        warehouseCode
      );


    if (
      !userExists ||
      !warehouseExists
    ) {

      rowsToDelete.push(
        rowIndex + 1
      );

    }

  }


  /**********************************************
   * DELETE FROM BOTTOM TO TOP
   **********************************************/

  rowsToDelete
    .reverse()
    .forEach(
      function(rowNumber) {

        permissionsSheet.deleteRow(
          rowNumber
        );

      }
    );


  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX ORPHAN USER WAREHOUSES CLEANUP"
  );

  Logger.log(
    "=========================================="
  );

  Logger.log(
    "DELETED: " +
    rowsToDelete.length
  );

  Logger.log(
    "REMAINING: " +
    (
      permissionsSheet.getLastRow() - 1
    )
  );


  return {

    success: true,

    deleted:
      rowsToDelete.length,

    remaining:
      Math.max(
        0,
        permissionsSheet.getLastRow() - 1
      )

  };

}


