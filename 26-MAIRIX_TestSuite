/************************************************
 * TEST ROLE HELPER
 ************************************************/

function ensureMAIRIXTestRole(
  roleCode
) {

  const sheet =
    mairixAccessSheet(
      MAIRIX_ACCESS_CONFIG
        .SHEETS
        .ROLES
    );

  const lastRow =
    sheet.getLastRow();


  if (
    lastRow >= 2
  ) {

    const values =
      sheet
        .getRange(
          2,
          1,
          lastRow - 1,
          1
        )
        .getDisplayValues();


    for (
      let i = 0;
      i < values.length;
      i++
    ) {

      if (
        mairixAccessClean(
          values[i][0]
        ).toUpperCase() ===
        roleCode
      ) {

        return;

      }

    }

  }


  mairixCreateRole(
    roleCode,
    "Test Operator",
    "Temporary security test role.",
    false
  );

}


