/************************************************
 * TEST RESULT OBJECT
 ************************************************/

function mairixCreateTestResult(name) {

  return {

    name: name,
    success: true,
    message: "",
    details: [],
    startedAt: new Date(),
    finishedAt: null

  };

}


/************************************************
 * ADD TEST DETAIL
 ************************************************/

function mairixTestDetail(result, message) {

  if (!result.details || !Array.isArray(result.details)) {
    result.details = [];
  }

  result.details.push(message);

}


/************************************************
 * FAIL TEST
 ************************************************/

function mairixFailTest(result, error) {

  result.success = false;

  result.message =
    error && error.message
      ? error.message
      : String(error);

}


/************************************************
 * FINISH TEST
 ************************************************/

function mairixFinishTest(result) {

  result.finishedAt = new Date();

  return result;

}


/************************************************
 * ASSERT
 ************************************************/

function mairixAssert(condition, message) {

  if (!condition) {
    throw new Error(message);
  }

}


/************************************************
 * ASSERT EQUAL
 ************************************************/

function mairixAssertEqual(actual, expected, message) {

  if (actual !== expected) {

    throw new Error(
      message +
      " | Expected: " + expected +
      " | Actual: " + actual
    );

  }

}


/************************************************
 * RUN ONE TEST
 ************************************************/

function mairixRunTest(name, callback) {

  const result =
    mairixCreateTestResult(name);

  try {

    callback(result);

  } catch (error) {

    mairixFailTest(
      result,
      error
    );

  }

  mairixFinishTest(result);

  Logger.log(
    JSON.stringify(
      result,
      null,
      2
    )
  );

  return result;

}


/************************************************
 * CREATE INVALID TEST RESULT
 ************************************************/

function mairixCreateInvalidTestResult(
  name,
  message,
  details
) {

  return {

    name: name,
    success: false,
    message: message,
    details:
      Array.isArray(details)
        ? details
        : [],
    startedAt: new Date(),
    finishedAt: new Date()

  };

}


/************************************************
 * RUN REGISTERED TEST SAFELY
 ************************************************/

function mairixRunRegisteredTest(
  name,
  testFunction
) {

  try {

    if (typeof testFunction !== "function") {

      return mairixCreateInvalidTestResult(
        name,
        "Test function is unavailable.",
        [
          "Expected a callable test function."
        ]
      );

    }

    const result =
      testFunction();

    if (
      !result ||
      typeof result !== "object"
    ) {

      return mairixCreateInvalidTestResult(
        name,
        "Test did not return a valid result object.",
        [
          "Returned value: " +
          String(result)
        ]
      );

    }

    if (
      typeof result.success !== "boolean"
    ) {

      result.success = false;

      result.message =
        result.message ||
        "Test result is missing a valid success property.";

    }

    if (!Array.isArray(result.details)) {
      result.details = [];
    }

    if (!result.name) {
      result.name = name;
    }

    if (!result.startedAt) {
      result.startedAt = new Date();
    }

    if (!result.finishedAt) {
      result.finishedAt = new Date();
    }

    return result;

  } catch (error) {

    return mairixCreateInvalidTestResult(
      name,
      error && error.message
        ? error.message
        : String(error),
      [
        "Test execution threw an exception."
      ]
    );

  }

}


