    "=========================================="
  );

  Logger.log(
    "MAIRIX MASTER DATA STRUCTURE AUDIT"
  );

  Logger.log(
    "=========================================="
  );


  masterSheets.forEach(
    function(sheetName) {

      const sheet =
        spreadsheet.getSheetByName(
          sheetName
        );


      /********************************************
       * SHEET NOT FOUND
       ********************************************/

      if (!sheet) {

        result[sheetName] = {

          exists: false,

          headers: [],

          lastRow: 0,

          realDataRows: 0

        };


        Logger.log(
          sheetName +
          ": NOT FOUND"
        );


        return;

      }


      const lastRow =
        sheet.getLastRow();


      const lastColumn =
        sheet.getLastColumn();


      let headers = [];

      let realDataRows = 0;


      /********************************************
       * READ HEADERS
       ********************************************/

      if (
        lastRow >= 1 &&
        lastColumn >= 1
      ) {

        headers =
          sheet
            .getRange(
              1,
              1,
              1,
              lastColumn
            )
            .getValues()[0]
            .map(
              function(value) {

                return String(
                  value || ""
                ).trim();

              }
            );

      }


      /********************************************
       * COUNT REAL DATA ROWS
       ********************************************/

      if (
        lastRow > 1 &&
        lastColumn > 0
      ) {

        const rows =
          sheet
            .getRange(
              2,
              1,
              lastRow - 1,
              lastColumn
            )
            .getValues();


        rows.forEach(
          function(row) {

            const hasData =
              row.some(
                function(cell) {

                  return String(
                    cell || ""
                  ).trim() !== "";

                }
              );


            if (hasData) {

              realDataRows++;

            }

          }
        );

      }


      /********************************************
       * SAVE RESULT
       ********************************************/

      result[sheetName] = {

        exists: true,

        headers: headers,

        lastRow: lastRow,

        realDataRows: realDataRows

      };


      Logger.log(
        "------------------------------------------"
      );

      Logger.log(
        "SHEET: " +
        sheetName
      );

      Logger.log(
        "LAST ROW: " +
        lastRow
      );

      Logger.log(
        "REAL DATA ROWS: " +
        realDataRows
      );

      Logger.log(
        "HEADERS:"
      );

      Logger.log(
        JSON.stringify(
          headers
