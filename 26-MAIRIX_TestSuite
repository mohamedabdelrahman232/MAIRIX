 * a dedicated blank spreadsheet.
 ************************************************/

function mairixTestEnvironmentCheck() {

  const ss =
    SpreadsheetApp
      .getActiveSpreadsheet();


  const required =
    [

      "SETTINGS",
      "USERS",
      "PERMISSIONS",
      "ITEMS",
      "CUSTOMERS",
      "VENDORS",
      "WAREHOUSES",
      "TAX_TYPES",
      "INVENTORY_LEDGER",
      "CASH_LEDGER",
      "CUSTOMER_LEDGER",
      "VENDOR_LEDGER",
      "TAX_LEDGER",
      "FINANCIAL_LEDGER",
      "AUDIT_TRAIL"

    ];


  const missing = [];


  required.forEach(
    function(name) {

      if (
        !ss.getSheetByName(name)
      ) {

        missing.push(
          name
        );

      }

    }
  );


  return {

    success:
      missing.length === 0,

    missing:
      missing

  };

}


/************************************************
 * MASTER TEST ENTRY
 ************************************************/

function testMairixEverything() {

  const environment =
    mairixTestEnvironmentCheck();


  if (
    !environment.success
  ) {

    throw new Error(
      "MAIRIX test environment is incomplete. Missing: " +
      environment.missing.join(", ")
    );

  }


  /*
   * Run structural suite.
   */

  return runMairixTestSuite();

}

