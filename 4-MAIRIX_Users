/************************************************
 * MAIRIX ERP
 * 4-MAIRIX_Users.gs
 *
 * USER & ACCESS FOUNDATION
 *
 * PURPOSE
 * ------------------------------------------------
 * 1) Create users
 * 2) Update users
 * 3) Activate / deactivate users
 * 4) Identify current Google user
 * 5) Connect user -> role
 * 6) Connect user -> warehouses
 * 7) Maintain audit trail
 * 8) Provide secure server-side user context
 *
 * IMPORTANT
 * ------------------------------------------------
 * - No old MAIF data dependency
 * - No hard-coded old User IDs
 * - UI supplied userId is NEVER trusted
 * - Current user is identified from Google account
 * - New users are ALWAYS inactive
 * - Permissions are NOT stored here
 * - Warehouse access is NOT hard-coded here
 * - Settings are centralized
 *
 * DEPENDENCIES
 * ------------------------------------------------
 * This file expects the foundation/settings layer
 * to provide:
 *
 *   MAIRIX
 *   mairixGetSetting()
 *   mairixGetSheet()
 *   mairixCleanText()
 *   mairixGetColumnNumber()
 *
 * If the helper layer uses different names,
 * only the adapter section needs adjustment.
 ************************************************/


/************************************************
 * CONFIGURATION
 ************************************************/

const MAIRIX_USERS_CONFIG = {

  SHEET_KEY:
    "USERS",

  LOG_SHEET_KEY:
    "AUDIT_LOG",

  DEFAULT_ACTIVE:
    false,

  USER_ID_PREFIX:
    "USR",

  USER_ID_PAD:
    5

};


/************************************************
 * INTERNAL SHEET ADAPTER
 ************************************************/

function mairixUsersGetSheet(
  key
) {

  /*
   * Preferred:
   * centralized MAIRIX settings/constants.
   */

  if (
    typeof MAIRIX !== "undefined" &&
    MAIRIX.SHEETS &&
    MAIRIX.SHEETS[key]
  ) {

    return SpreadsheetApp
      .getActiveSpreadsheet()
      .getSheetByName(
        MAIRIX.SHEETS[key]
      );

  }


  /*
   * Fallback for the new blank workbook.
   *
   * This fallback is NOT connected to
   * any old MAIF data.
   */

  return SpreadsheetApp
    .getActiveSpreadsheet()
    .getSheetByName(
      key
    );

}


/************************************************
 * TEXT NORMALIZER
 ************************************************/

function mairixUsersClean(
  value
) {

  if (
    typeof mairixCleanText ===
    "function"
  ) {

    return mairixCleanText(
      value
    );

  }

  if (
    value === null ||
    value === undefined
  ) {

    return "";

  }

  return String(
    value
  ).trim();

}


/************************************************
 * REQUIRED VALUE
 ************************************************/

function mairixUsersRequireValue(
  value,
  fieldName
) {

  const normalized =
    mairixUsersClean(
      value
    );

  if (!normalized) {

    throw new Error(
      fieldName +
      " is required."
    );

  }

  return normalized;

}


/************************************************
 * REQUIRED USERS SHEET
 ************************************************/

function mairixUsersSheet() {

  const sheet =
    mairixUsersGetSheet(
      MAIRIX_USERS_CONFIG.SHEET_KEY
    );


  if (!sheet) {

    throw new Error(
      "USERS sheet not found. " +
      "Run setupMAIRIXUsersSheet() first."
    );

  }


  return sheet;

}


/************************************************
 * USERS SHEET SETUP
 *
 * Safe to run on a blank workbook.
 ************************************************/

function setupMAIRIXUsersSheet() {

  const ss =
    SpreadsheetApp
      .getActiveSpreadsheet();


  let sheet =
    mairixUsersGetSheet(
      MAIRIX_USERS_CONFIG.SHEET_KEY
    );


  if (!sheet) {

    sheet =
      ss.insertSheet(
        MAIRIX_USERS_CONFIG.SHEET_KEY
      );

  }


  const headers = [

    "User ID",
    "Gmail",
    "Name",
    "Role",
    "Active",
    "Created At",
    "Created By",
    "Updated At",
    "Updated By"

  ];


  sheet.clear();


  sheet
    .getRange(
      1,
      1,
      1,
      headers.length
    )
    .setValues([
      headers
    ]);


  sheet
    .setFrozenRows(
      1
    );


  sheet
    .getRange(
      1,
      1,
      1,
      headers.length
    )
    .setFontWeight(
      "bold"
    );


  /*
   * Active checkbox column
   */

  sheet
    .getRange(
      2,
      5,
      Math.max(
        sheet.getMaxRows() - 1,
        1
      ),
      1
    )
    .insertCheckboxes();


  /*
   * Email as text
   */

  sheet
    .getRange(
      2,
      2,
      Math.max(
        sheet.getMaxRows() - 1,
        1
      ),
      1
    )
    .setNumberFormat(
      "@"
    );


  sheet.autoResizeColumns(
    1,
    headers.length
  );


  return {

    success:
      true,

    sheet:
      MAIRIX_USERS_CONFIG.SHEET_KEY,

    columns:
      headers.length

  };

}


/************************************************
 * GET CURRENT GOOGLE EMAIL
 ************************************************/

function mairixUsersGetCurrentEmail() {

  const email =
    Session
      .getActiveUser()
      .getEmail();


  const normalized =
    mairixUsersClean(
      email
    ).toLowerCase();


  if (!normalized) {

    throw new Error(
      "Unable to identify the current Google account."
    );

  }


  return normalized;

}


/************************************************
 * MAIRIX ERP
 * GET USER BY EMAIL
 *
 * Compatible with current USERS structure:
 *
 * User ID
 * Employee Code
 * Email
 * Name
 * Role Code
 * Role Name
 * Current Password
 * Password Last Changed At
 * Password Change Required
 * Active
 * Created At
 * Created By
 * Updated At
 * Updated By
 ************************************************/

function mairixGetUserByEmail(email) {

  var normalizedEmail =
    String(email || "")
      .trim()
      .toLowerCase();

  if (!normalizedEmail) {
    return null;
  }


  var ss =
    SpreadsheetApp.getActiveSpreadsheet();


  var sheet =
    ss.getSheetByName("USERS");


  if (!sheet) {
    throw new Error(
      "USERS sheet not found."
    );
  }


  var lastRow =
    sheet.getLastRow();


  if (lastRow < 2) {
    return null;
  }


  var lastColumn =
    sheet.getLastColumn();


  var headers =
    sheet
      .getRange(
        1,
        1,
        1,
        lastColumn
      )
      .getDisplayValues()[0]
      .map(function(header) {

        return String(header || "").trim();

      });


  /************************************************
   * REQUIRED COLUMNS
   ************************************************/

  var userIdIndex =
    headers.indexOf("User ID");

  var emailIndex =
    headers.indexOf("Gmail");

  var nameIndex =
    headers.indexOf("Name");

  var roleCodeIndex =
    headers.indexOf("Role Code");

  var roleNameIndex =
    headers.indexOf("Role Name");

  var activeIndex =
    headers.indexOf("Active");


  if (userIdIndex === -1) {

    throw new Error(
      'USERS sheet structure is incomplete: missing "User ID".'
    );

  }


  if (emailIndex === -1) {

    throw new Error(
      'USERS sheet structure is incomplete: missing "Gmail".'
    );

  }


  if (activeIndex === -1) {

    throw new Error(
      'USERS sheet structure is incomplete: missing "Active".'
    );

  }


  /************************************************
   * READ DATA
   ************************************************/

  var values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        lastColumn
      )
      .getValues();


  for (
    var i = 0;
    i < values.length;
    i++
  ) {

    var row =
      values[i];


    var rowEmail =
      String(
        row[emailIndex] || ""
      )
        .trim()
        .toLowerCase();


    if (
      rowEmail !== normalizedEmail
    ) {

      continue;

    }


    var active =
      mairixUsersIsTrue(
        row[activeIndex]
      );


    return {

      userId:
        String(
          row[userIdIndex] || ""
        ).trim(),

      employeeCode:
        headers.indexOf("Employee Code") !== -1
          ? String(
              row[
                headers.indexOf(
                  "Employee Code"
                )
              ] || ""
            ).trim()
          : "",

      email:
        String(
          row[emailIndex] || ""
        ).trim(),

      name:
        nameIndex !== -1
          ? String(
              row[nameIndex] || ""
            ).trim()
          : "",

      userName:
        nameIndex !== -1
          ? String(
              row[nameIndex] || ""
            ).trim()
          : "",

      roleCode:
        roleCodeIndex !== -1
          ? String(
              row[roleCodeIndex] || ""
            ).trim()
          : "",

      roleName:
        roleNameIndex !== -1
          ? String(
              row[roleNameIndex] || ""
            ).trim()
          : "",

      role:
        roleCodeIndex !== -1
          ? String(
              row[roleCodeIndex] || ""
            ).trim()
          : "",

      active:
        active

    };

  }


  return null;

}


/************************************************
 * BOOLEAN HELPER
 ************************************************/

function mairixUsersIsTrue(value) {

  if (value === true) {
    return true;
  }

  if (value === 1) {
    return true;
  }

  var normalized =
    String(
      value === null ||
      value === undefined
        ? ""
        : value
    )
      .trim()
      .toUpperCase();


  return (
    normalized === "TRUE" ||
    normalized === "1" ||
    normalized === "YES" ||
    normalized === "Y"
  );

}


/************************************************
 * GET USER BY ID
 ************************************************/

function mairixGetUserById(
  userId
) {

  const normalizedId =
    mairixUsersClean(
      userId
    );


  if (!normalizedId) {

    return null;

  }


  const sheet =
    mairixUsersSheet();


  const lastRow =
    sheet.getLastRow();


  const lastColumn =
    sheet.getLastColumn();


  if (
    lastRow < 2
  ) {

    return null;

  }


  const headers =
    sheet
      .getRange(
        1,
        1,
        1,
        lastColumn
      )
      .getDisplayValues()[0];


  const idIndex =
    headers.indexOf(
      "User ID"
    );


  const emailIndex =
    headers.indexOf(
      "Gmail"
    );


  const nameIndex =
    headers.indexOf(
      "Name"
    );


  const roleIndex =
    headers.indexOf(
      "Role"
    );


  const activeIndex =
    headers.indexOf(
      "Active"
    );


  if (
    idIndex === -1 ||
    emailIndex === -1 ||
    nameIndex === -1 ||
    roleIndex === -1 ||
    activeIndex === -1
  ) {

    throw new Error(
      "USERS sheet structure is incomplete."
    );

  }


  const rows =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        lastColumn
      )
      .getValues();


  for (
    let i = 0;
    i < rows.length;
    i++
  ) {

    const row =
      rows[i];


    if (
      mairixUsersClean(
        row[idIndex]
      ) !==
      normalizedId
    ) {

      continue;

    }


    return {

      userId:
        normalizedId,

      email:
        mairixUsersClean(
          row[emailIndex]
        ).toLowerCase(),

      name:
        mairixUsersClean(
          row[nameIndex]
        ),

      role:
        mairixUsersClean(
          row[roleIndex]
        ).toUpperCase(),

      active:
        mairixUsersIsTrue(
          row[activeIndex]
        )

    };

  }


  return null;

}


/************************************************
 * CURRENT USER
 *
 * SECURITY:
 * The UI does NOT provide the identity.
 ************************************************/

function mairixGetCurrentUser() {

  const email =
    mairixUsersGetCurrentEmail();


  return mairixGetUserByEmail(
    email
  );

}


/************************************************
 * REQUIRE CURRENT USER
 ************************************************/

function mairixRequireCurrentUser() {

  const user =
    mairixGetCurrentUser();


  if (!user) {

    throw new Error(
      "Current Google account is not registered in MAIRIX."
    );

  }


  if (
    user.active !== true
  ) {

    throw new Error(
      "Your MAIRIX account is inactive."
    );

  }


  return user;

}


/************************************************
 * GENERATE USER ID
 *
 * Format:
 *
 * USR-YYYYMMDD-00001
 ************************************************/

function mairixGenerateUserId() {

  const sheet =
    mairixUsersSheet();


  const dateKey =
    Utilities.formatDate(
      new Date(),
      Session.getScriptTimeZone(),
      "yyyyMMdd"
    );


  const prefix =
    MAIRIX_USERS_CONFIG.USER_ID_PREFIX +
    "-" +
    dateKey +
    "-";


  let nextNumber =
    1;


  const lastRow =
    sheet.getLastRow();


  if (
    lastRow >= 2
  ) {

    const idColumn =
      sheet
        .getRange(
          1,
          1
        )
        .getColumn();


    const values =
      sheet
        .getRange(
          2,
          idColumn,
          lastRow - 1,
          1
        )
        .getDisplayValues();


    values.forEach(
      function(row) {

        const id =
          mairixUsersClean(
            row[0]
          );


        if (
          id.indexOf(
            prefix
          ) !== 0
        ) {

          return;

        }


        const number =
          parseInt(
            id.substring(
              prefix.length
            ),
            10
          );


        if (
          !isNaN(number) &&
          number >= nextNumber
        ) {

          nextNumber =
            number + 1;

        }

      }
    );

  }


  return (
    prefix +
    String(nextNumber)
      .padStart(
        MAIRIX_USERS_CONFIG.USER_ID_PAD,
        "0"
      )
  );

}


/************************************************
 * CHECK DUPLICATE EMAIL
 ************************************************/

function mairixUsersEmailExists(
  email,
  ignoreUserId
) {

  const normalizedEmail =
    mairixUsersClean(
      email
    ).toLowerCase();


  const normalizedIgnore =
    mairixUsersClean(
      ignoreUserId
    );


  const sheet =
    mairixUsersSheet();


  const lastRow =
    sheet.getLastRow();


  if (
    lastRow < 2
  ) {

    return false;

  }


  const emailColumn =
    sheet
      .getRange(
        1,
        1,
        1,
        sheet.getLastColumn()
      )
      .getDisplayValues()[0]
      .indexOf(
        "Gmail"
      ) + 1;


  const idColumn =
    sheet
      .getRange(
        1,
        1,
        1,
        sheet.getLastColumn()
      )
      .getDisplayValues()[0]
      .indexOf(
        "User ID"
      ) + 1;


  const emails =
    sheet
      .getRange(
        2,
        emailColumn,
        lastRow - 1,
        1
      )
      .getDisplayValues();


  const ids =
    sheet
      .getRange(
        2,
        idColumn,
        lastRow - 1,
        1
      )
      .getDisplayValues();


  for (
    let i = 0;
    i < emails.length;
    i++
  ) {

    const rowEmail =
      mairixUsersClean(
        emails[i][0]
      ).toLowerCase();


    const rowId =
      mairixUsersClean(
        ids[i][0]
      );


    if (
      rowEmail ===
      normalizedEmail &&
      rowId !==
      normalizedIgnore
    ) {

      return true;

    }

  }


  return false;

}


/************************************************
 * CREATE USER
 *
 * New users ALWAYS inactive.
 *
 * No permissions are created here.
 * No warehouse access is created here.
 ************************************************/

function mairixCreateUser(
  data
) {

  const currentUser =
    mairixRequireCurrentUser();


  if (!data) {

    throw new Error(
      "User data is required."
    );

  }


  const email =
    mairixUsersRequireValue(
      data.email,
      "Gmail"
    )
      .toLowerCase();


  const name =
    mairixUsersRequireValue(
      data.name,
      "Name"
    );


  const role =
    mairixUsersRequireValue(
      data.role,
      "Role"
    )
      .toUpperCase();


  if (
    mairixUsersEmailExists(
      email
    )
  ) {

    throw new Error(
      "A user with this email already exists."
    );

  }


  const sheet =
    mairixUsersSheet();


  const userId =
    mairixGenerateUserId();


  const headers =
    sheet
      .getRange(
        1,
        1,
        1,
        sheet.getLastColumn()
      )
      .getDisplayValues()[0];


  const row =
    new Array(
      headers.length
    )
      .fill("");


  const set =
    function(
      header,
      value
    ) {

      const index =
        headers.indexOf(
          header
        );


      if (
        index !== -1
      ) {

        row[index] =
          value;

      }

    };


  set(
    "User ID",
    userId
  );


  set(
    "Gmail",
    email
  );


  set(
    "Name",
    name
  );


  set(
    "Role",
    role
  );


  set(
    "Active",
    false
  );


  set(
    "Created At",
    new Date()
  );


  set(
    "Created By",
    currentUser.email
  );


  sheet
    .getRange(
      sheet.getLastRow() + 1,
      1,
      1,
      row.length
    )
    .setValues([
      row
    ]);


  const newRow =
    sheet.getLastRow();


  const activeColumn =
    headers.indexOf(
      "Active"
    ) + 1;


  if (
    activeColumn > 0
  ) {

    sheet
      .getRange(
        newRow,
        activeColumn
      )
      .insertCheckboxes()
      .setValue(false);

  }


  const emailColumn =
    headers.indexOf(
      "Gmail"
    ) + 1;


  if (
    emailColumn > 0
  ) {

    sheet
      .getRange(
        newRow,
        emailColumn
      )
      .setNumberFormat("@");

  }


  mairixUsersAudit(
    "CREATE_USER",
    userId,
    "Created inactive user | " +
    email +
    " | Role: " +
    role
  );


  return {

    success:
      true,

    userId:
      userId,

    email:
      email,

    name:
      name,

    role:
      role,

    active:
      false

  };

}


/************************************************
 * UPDATE USER
 *
 * Active cannot be changed here.
 * Activation is a separate operation.
 ************************************************/

function mairixUpdateUser(
  userId,
  data
) {

  const currentUser =
    mairixRequireCurrentUser();


  const normalizedId =
    mairixUsersRequireValue(
      userId,
      "User ID"
    );


  if (!data) {

    throw new Error(
      "User data is required."
    );

  }


  const sheet =
    mairixUsersSheet();


  const user =
    mairixGetUserById(
      normalizedId
    );


  if (!user) {

    throw new Error(
      "User not found: " +
      normalizedId
    );

  }


  const lastColumn =
    sheet.getLastColumn();


  const headers =
    sheet
      .getRange(
        1,
        1,
        1,
        lastColumn
      )
      .getDisplayValues()[0];


  const rowNumber =
    mairixUsersFindRow(
      normalizedId
    );


  const row =
    sheet
      .getRange(
        rowNumber,
        1,
        1,
        lastColumn
      )
      .getValues()[0];


  const set =
    function(
      header,
      value
    ) {

      const index =
        headers.indexOf(
          header
        );


      if (
        index !== -1
      ) {

        row[index] =
          value;

      }

    };


  if (
    data.email !== undefined
  ) {

    const email =
      mairixUsersRequireValue(
        data.email,
        "Gmail"
      )
        .toLowerCase();


    if (
      mairixUsersEmailExists(
        email,
        normalizedId
      )
    ) {

      throw new Error(
        "Another user already uses this email."
      );

    }


    set(
      "Gmail",
      email
    );

  }


  if (
    data.name !== undefined
  ) {

    set(
      "Name",
      mairixUsersRequireValue(
        data.name,
        "Name"
      )
    );

  }


  if (
    data.role !== undefined
  ) {

    set(
      "Role",
      mairixUsersRequireValue(
        data.role,
        "Role"
      ).toUpperCase()
    );

  }


  if (
    data.active !== undefined
  ) {

    throw new Error(
      "Use mairixSetUserActive() to change user activation."
    );

  }


  set(
    "Updated At",
    new Date()
  );


  set(
    "Updated By",
    currentUser.email
  );


  sheet
    .getRange(
      rowNumber,
      1,
      1,
      row.length
    )
    .setValues([
      row
    ]);


  mairixUsersAudit(
    "UPDATE_USER",
    normalizedId,
    "User information updated."
  );


  return {

    success:
      true,

    userId:
      normalizedId

  };

}


/************************************************
 * ACTIVATE / DEACTIVATE
 *
 * IMPORTANT:
 *
 * This function changes only USER STATUS.
 *
 * Permissions and warehouse assignments
 * belong to their own centralized engines.
 ************************************************/

function mairixSetUserActive(
  userId,
  active
) {

  const currentUser =
    mairixRequireCurrentUser();


  const normalizedId =
    mairixUsersRequireValue(
      userId,
      "User ID"
    );


  const sheet =
    mairixUsersSheet();


  const user =
    mairixGetUserById(
      normalizedId
    );


  if (!user) {

    throw new Error(
      "User not found: " +
      normalizedId
    );

  }


  const rowNumber =
    mairixUsersFindRow(
      normalizedId
    );


  const headers =
    sheet
      .getRange(
        1,
        1,
        1,
        sheet.getLastColumn()
      )
      .getDisplayValues()[0];


  const activeIndex =
    headers.indexOf(
      "Active"
    );


  const updatedAtIndex =
    headers.indexOf(
      "Updated At"
    );


  const updatedByIndex =
    headers.indexOf(
      "Updated By"
    );


  if (
    activeIndex === -1
  ) {

    throw new Error(
      "USERS sheet is missing Active column."
    );

  }


  const newValue =
    Boolean(
      active
    );


  sheet
    .getRange(
      rowNumber,
      activeIndex + 1
    )
    .insertCheckboxes()
    .setValue(
      newValue
    );


  if (
    updatedAtIndex !== -1
  ) {

    sheet
      .getRange(
        rowNumber,
        updatedAtIndex + 1
      )
      .setValue(
        new Date()
      );

  }


  if (
    updatedByIndex !== -1
  ) {

    sheet
      .getRange(
        rowNumber,
        updatedByIndex + 1
      )
      .setValue(
        currentUser.email
      );

  }


  mairixUsersAudit(
    newValue
      ? "ACTIVATE_USER"
      : "DEACTIVATE_USER",
    normalizedId,
    "Status changed to " +
    (newValue ? "ACTIVE" : "INACTIVE")
  );


  return {

    success:
      true,

    userId:
      normalizedId,

    active:
      newValue

  };

}


/************************************************
 * FIND USER ROW
 ************************************************/

function mairixUsersFindRow(
  userId
) {

  const sheet =
    mairixUsersSheet();


  const lastRow =
    sheet.getLastRow();


  if (
    lastRow < 2
  ) {

    return -1;

  }


  const headers =
    sheet
      .getRange(
        1,
        1,
        1,
        sheet.getLastColumn()
      )
      .getDisplayValues()[0];


  const idIndex =
    headers.indexOf(
      "User ID"
    );


  if (
    idIndex === -1
  ) {

    throw new Error(
      "USERS sheet is missing User ID column."
    );

  }


  const values =
    sheet
      .getRange(
        2,
        idIndex + 1,
        lastRow - 1,
        1
      )
      .getDisplayValues();


  const normalized =
    mairixUsersClean(
      userId
    );


  for (
    let i = 0;
    i < values.length;
    i++
  ) {

    if (
      mairixUsersClean(
        values[i][0]
      ) ===
      normalized
    ) {

      return i + 2;

    }

  }


  return -1;

}


/************************************************
 * TRUE VALUE
 ************************************************/

function mairixUsersIsTrue(
  value
) {

  if (
    value === true
  ) {

    return true;

  }


  const normalized =
    mairixUsersClean(
      value
    ).toUpperCase();


  return (
    normalized === "TRUE" ||
    normalized === "YES" ||
    normalized === "1"
  );

}


/************************************************
 * AUDIT
 *
 * Audit is deliberately centralized later.
 *
 * This adapter allows the Users module
 * to work now without duplicating business
 * logic elsewhere.
 ************************************************/

function mairixUsersAudit(
  action,
  reference,
  details
) {

  try {

    const email =
      mairixUsersGetCurrentEmail();


    /*
     * If the centralized audit engine
     * exists, use it.
     */

    if (
      typeof mairixWriteAudit ===
      "function"
    ) {

      mairixWriteAudit({

        action:
          action,

        reference:
          reference,

        details:
          details,

        userEmail:
          email

      });


      return;

    }


    /*
     * Temporary foundation fallback.
     *
     * This does NOT affect ERP transactions.
     */

    const sheet =
      mairixUsersGetSheet(
        MAIRIX_USERS_CONFIG.LOG_SHEET_KEY
      );


    if (!sheet) {

      Logger.log(
        "[MAIRIX AUDIT] " +
        action +
        " | " +
        reference +
        " | " +
        details
      );

      return;

    }


    sheet.appendRow([

      new Date(),

      email,

      action,

      reference,

      details

    ]);

  } catch (error) {

    Logger.log(
      "MAIRIX Users Audit failed: " +
      error.message
    );

  }

}


