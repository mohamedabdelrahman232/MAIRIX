/************************************************
 * GET CURRENT USER PERMISSIONS
 *
 * PURPOSE
 * ------------------------------------------------
 * Return the final effective permissions of a user.
 *
 * IMPORTANT
 * ------------------------------------------------
 * - USER_PERMISSIONS is the final authority.
 * - ADMIN is evaluated independently.
 * - Role permissions are templates only.
 * - This function is QUERY ONLY.
 * - It does NOT throw Permission denied.
 * - It does NOT replace server-side enforcement.
 ************************************************/

function mairixGetCurrentUserPermissions(
  userId
) {

  const normalizedUserId =
    mairixUsersClean(
      userId
    );


  if (!normalizedUserId) {

    throw new Error(
      "User ID is required."
    );

  }


  const user =
    mairixGetUserById(
      normalizedUserId
    );


  if (!user) {

    throw new Error(
      "User not found: " +
      normalizedUserId
    );

  }


  /*
   * ADMIN is still returned as a special
   * UI/security context.
   *
   * Runtime transaction authorization must
   * continue to use the final permission engine.
   */

  const adminRole =
    (
      typeof MAIRIX_ACCESS_CONFIG !==
      "undefined" &&
      MAIRIX_ACCESS_CONFIG.ADMIN_ROLE
    )
      ? MAIRIX_ACCESS_CONFIG.ADMIN_ROLE
      : "ADMIN";


  if (
    mairixUsersClean(
      user.role
    ).toUpperCase() ===
    String(
      adminRole
    ).toUpperCase()
  ) {

    return {

      admin:
        true,

      fullAccess:
        true,

      permissions:
        []

    };

  }


  /*
   * Make sure role defaults exist for the user.
   *
   * This function belongs to the Access engine,
   * but it is intentionally called here only to
   * initialize missing USER_PERMISSIONS rows.
   */

  if (
    typeof mairixEnsureUserPermissions ===
    "function"
  ) {

    mairixEnsureUserPermissions(
      normalizedUserId
    );

  }


  /*
   * USER_PERMISSIONS is the final authority.
   */

  if (
    typeof mairixAccessSheet !==
    "function"
  ) {

    throw new Error(
      "MAIRIX Access engine is not available."
    );

  }


  const userPermissionsSheet =
    mairixAccessSheet(
      MAIRIX_ACCESS_CONFIG
        .SHEETS
        .USER_PERMISSIONS
    );


  if (
    !userPermissionsSheet
  ) {

    return {

      admin:
        false,

      fullAccess:
        false,

      permissions:
        []

    };

  }


  const lastRow =
    userPermissionsSheet.getLastRow();


  if (
    lastRow < 2
  ) {

    return {

      admin:
        false,

      fullAccess:
        false,

      permissions:
        []

    };

  }


  const headers =
    typeof mairixAccessHeaders ===
    "function"
      ? mairixAccessHeaders(
          userPermissionsSheet
        )
      : userPermissionsSheet
          .getRange(
            1,
            1,
            1,
            userPermissionsSheet.getLastColumn()
          )
          .getDisplayValues()[0];


  const requiredHeaders = [

    "User ID",
    "Permission Code",
    "View",
    "Create",
    "Edit",
    "Delete",
    "Export",
    "Active"

  ];


  requiredHeaders.forEach(
    function(header) {

      if (
        headers.indexOf(
          header
        ) === -1
      ) {

        throw new Error(
          'USER_PERMISSIONS is missing "' +
          header +
          '".'
        );

      }

    }
  );


  const rows =
    userPermissionsSheet
      .getRange(
        2,
        1,
        lastRow - 1,
        headers.length
      )
      .getValues();


  const userIdIndex =
    headers.indexOf(
      "User ID"
    );


  const permissionCodeIndex =
    headers.indexOf(
      "Permission Code"
    );


  const permissionNameIndex =
    headers.indexOf(
      "Permission Name"
    );


  const viewIndex =
    headers.indexOf(
      "View"
    );


  const createIndex =
    headers.indexOf(
      "Create"
    );


  const editIndex =
    headers.indexOf(
      "Edit"
    );


  const deleteIndex =
    headers.indexOf(
      "Delete"
    );


  const exportIndex =
    headers.indexOf(
      "Export"
    );


  const activeIndex =
    headers.indexOf(
      "Active"
    );


  const permissions = [];


  rows.forEach(
    function(row) {

      if (
        mairixUsersClean(
          row[userIdIndex]
        ) !==
        normalizedUserId
      ) {

        return;

      }


      permissions.push({

        permissionCode:
          mairixUsersClean(
            row[permissionCodeIndex]
          ).toUpperCase(),

        permissionName:
          permissionNameIndex === -1
            ? ""
            : mairixUsersClean(
                row[permissionNameIndex]
              ),

        View:
          mairixUsersIsTrue(
            row[viewIndex]
          ),

        Create:
          mairixUsersIsTrue(
            row[createIndex]
          ),

        Edit:
          mairixUsersIsTrue(
            row[editIndex]
          ),

        Delete:
          mairixUsersIsTrue(
            row[deleteIndex]
          ),

        Export:
          mairixUsersIsTrue(
            row[exportIndex]
          ),

        Active:
          mairixUsersIsTrue(
            row[activeIndex]
          )

      });

    }
  );


  return {

    admin:
      false,

    fullAccess:
      false,

    permissions:
      permissions

  };

}

/************************************************
 * MAIRIX ERP
 * ROLE PERMISSIONS REPAIR TOOL
 *
 * PURPOSE:
 * Rebuild ROLE_PERMISSIONS using the real roles
 * and PERMISSION_CATALOG.
 *
 * This does NOT bypass security.
 * It repairs the permission mappings.
 ************************************************/

function mairixRepairRolePermissions() {

  Logger.log("==========================================");
  Logger.log("MAIRIX ROLE PERMISSIONS REPAIR");
  Logger.log("==========================================");

  var ss = SpreadsheetApp.getActiveSpreadsheet();

  var rolesSheet = ss.getSheetByName("ROLES");
  var catalogSheet = ss.getSheetByName("PERMISSION_CATALOG");
  var mappingSheet = ss.getSheetByName("ROLE_PERMISSIONS");

  if (!rolesSheet) {
    throw new Error("ROLES sheet not found.");
  }

  if (!catalogSheet) {
    throw new Error("PERMISSION_CATALOG sheet not found.");
  }

  if (!mappingSheet) {
    throw new Error("ROLE_PERMISSIONS sheet not found.");
  }

  /************************************************
   * LOAD ACTIVE ROLES
   ************************************************/

  var rolesLastRow = rolesSheet.getLastRow();

  if (rolesLastRow < 2) {
    throw new Error("No roles found in ROLES sheet.");
  }

  var rolesLastColumn = rolesSheet.getLastColumn();

  var roleHeaders =
    rolesSheet
      .getRange(
        1,
        1,
        1,
        rolesLastColumn
      )
      .getDisplayValues()[0];

  var roleCodeIndex =
    roleHeaders.indexOf("Role Code");

  var roleActiveIndex =
    roleHeaders.indexOf("Active");

  if (roleCodeIndex === -1) {
    throw new Error('ROLES is missing "Role Code" header.');
  }

  if (roleActiveIndex === -1) {
    throw new Error('ROLES is missing "Active" header.');
  }

  var roleValues =
    rolesSheet
      .getRange(
        2,
        1,
        rolesLastRow - 1,
        rolesLastColumn
      )
      .getDisplayValues();

  var activeRoles = [];

  for (
    var i = 0;
    i < roleValues.length;
    i++
  ) {

    var roleCode =
      String(
        roleValues[i][roleCodeIndex] || ""
      )
        .trim()
        .toUpperCase();

    var active =
      isMAIRIXTrueValue(
        roleValues[i][roleActiveIndex]
      );

    if (
      roleCode &&
      active
    ) {

      activeRoles.push(roleCode);

    }

  }

  if (activeRoles.length === 0) {
    throw new Error("No active roles found.");
  }

  Logger.log(
    "ACTIVE ROLES: " +
    JSON.stringify(activeRoles)
  );


  /************************************************
   * LOAD ACTIVE PERMISSIONS
   ************************************************/

  var catalogLastRow =
    catalogSheet.getLastRow();

  if (catalogLastRow < 2) {
    throw new Error(
      "No permissions found in PERMISSION_CATALOG."
    );
  }

  var catalogLastColumn =
    catalogSheet.getLastColumn();

  var catalogHeaders =
    catalogSheet
      .getRange(
        1,
        1,
        1,
        catalogLastColumn
      )
      .getDisplayValues()[0];

  var permissionCodeIndex =
    catalogHeaders.indexOf(
      "Permission Code"
    );

  var permissionActiveIndex =
    catalogHeaders.indexOf(
      "Active"
    );

  if (permissionCodeIndex === -1) {
    throw new Error(
      'PERMISSION_CATALOG is missing "Permission Code".'
    );
  }

  if (permissionActiveIndex === -1) {
    throw new Error(
      'PERMISSION_CATALOG is missing "Active".'
    );
  }

  var permissionValues =
    catalogSheet
      .getRange(
        2,
        1,
        catalogLastRow - 1,
        catalogLastColumn
      )
      .getDisplayValues();

  var activePermissions = [];

  for (
    var p = 0;
    p < permissionValues.length;
    p++
  ) {

    var permissionCode =
      String(
        permissionValues[p][permissionCodeIndex] || ""
      )
        .trim()
        .toUpperCase();

    var permissionActive =
      isMAIRIXTrueValue(
        permissionValues[p][permissionActiveIndex]
      );

    if (
      permissionCode &&
      permissionActive
    ) {

      activePermissions.push(permissionCode);

    }

  }

  if (activePermissions.length === 0) {
    throw new Error(
      "No active permissions found."
    );
  }

  Logger.log(
    "ACTIVE PERMISSIONS COUNT: " +
    activePermissions.length
  );


  /************************************************
   * BUILD NEW ROLE PERMISSIONS
   *
   * ADMIN:
   * Full access to everything.
   *
   * Other roles:
   * Start with VIEW access only.
   *
   * This keeps the system secure while restoring
   * valid mappings.
   ************************************************/

  var newMappings = [];

  for (
    var r = 0;
    r < activeRoles.length;
    r++
  ) {

    var role =
      activeRoles[r];

    for (
      var q = 0;
      q < activePermissions.length;
      q++
    ) {

      var permission =
        activePermissions[q];

      var isAdmin =
        role === "ADMIN";

      var view =
        isAdmin || permission.indexOf("_VIEW") !== -1;

      var create =
        isAdmin;

      var edit =
        isAdmin;

      var remove =
        isAdmin;

      var exportPermission =
        isAdmin;

      /*
       * SALESMAN
       * Explicit sales permissions.
       */

      if (
        role === "SALESMAN"
      ) {

        if (
          permission === "SALES"
        ) {
          view = true;
        }

        if (
          permission === "SALES"
        ) {
          create = true;
        }

        if (
          permission === "SALES"
        ) {
          edit = true;
        }

      }


      /*
       * STOREKEEPER
       */

      if (
        role === "STOREKEEPER"
      ) {

        if (
          permission.indexOf("INVENTORY_") === 0 ||
          permission.indexOf("WAREHOUSES_") === 0
        ) {

          view = true;

        }

      }


      /*
       * ACCOUNTANT
       */

      if (
        role === "ACCOUNTANT"
      ) {

        if (
          permission.indexOf("FINANCIAL_") === 0 ||
          permission.indexOf("EXPENSES_") === 0 ||
          permission.indexOf("COLLECTIONS_") === 0 ||
          permission.indexOf("TAX_") === 0
        ) {

          view = true;

        }

      }


      /*
       * MANAGER
       * Operational visibility.
       */

      if (
        role === "MANAGER"
      ) {

        view = true;

      }


      newMappings.push([
        role,
        permission,
        view,
        create,
        edit,
        remove,
        exportPermission,
        true
      ]);

    }

  }


  /************************************************
   * CLEAR OLD INVALID MAPPINGS
   ************************************************/

  var mappingLastRow =
    mappingSheet.getLastRow();

  if (mappingLastRow > 1) {

    mappingSheet
      .getRange(
        2,
        1,
        mappingLastRow - 1,
        mappingSheet.getLastColumn()
      )
      .clearContent();

  }


  /************************************************
   * WRITE NEW MAPPINGS
   ************************************************/

  if (
    newMappings.length > 0
  ) {

    mappingSheet
      .getRange(
        2,
        1,
        newMappings.length,
        8
      )
      .setValues(
        newMappings
      );

  }


  SpreadsheetApp.flush();


  Logger.log(
    "ROLE PERMISSIONS CREATED: " +
    newMappings.length
  );

  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX ROLE PERMISSIONS REPAIR: COMPLETE"
  );

  Logger.log(
    "=========================================="
  );


  return {

    success: true,

    activeRoles:
      activeRoles,

    activePermissions:
      activePermissions.length,

    mappingsCreated:
      newMappings.length

  };

}

