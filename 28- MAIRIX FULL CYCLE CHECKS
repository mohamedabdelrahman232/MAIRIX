/************************************************
 * TEST OPERATOR / PERMISSIONS
 ************************************************/

function mairixFullCyclePrepareTestOperator(
  context
) {

  Logger.log(
    "OPERATOR CONTEXT TYPE: " +
    typeof context
  );

  Logger.log(
    "OPERATOR CONTEXT: " +
    JSON.stringify(context)
  );

  if (
    !context
  ) {

    throw new Error(
      "MAIRIX FULL CYCLE: OPERATOR CONTEXT IS UNDEFINED"
    );

  }

  if (
    !context.runId
  ) {

    throw new Error(
      "MAIRIX FULL CYCLE: OPERATOR CONTEXT HAS NO runId"
    );

  }

  if (
    !context.warehouse ||
    !context.warehouse.code
  ) {

    throw new Error(
      "MAIRIX FULL CYCLE: OPERATOR CONTEXT HAS NO warehouse.code"
    );

  }


  const roleCode =
    "TST_OPERATOR_" +
    context.runId;


  /*
   * Create role.
   */

  if (
    typeof mairixCreateRole ===
    "function"
  ) {

    try {

      mairixCreateRole(
        roleCode,
        MAIRIX_FULL_CYCLE_TEST
          .OPERATOR_NAME,
        "Full Cycle Test Operator",
        false
      );

    } catch (error) {

      Logger.log(
        "Role creation note: " +
        error.message
      );

    }

  }


  /*
   * Create a test user directly because
   * normal user creation requires an already
   * authenticated MAIRIX user.
   */

  const email =
    "mairix.fullcycle." +
    context.runId +
    "@test.local";


  const userId =
    "TST-USR-" +
    context.runId;


  const usersSheet =
    SpreadsheetApp
      .getActiveSpreadsheet()
      .getSheetByName(
        "USERS"
      );


  const headers =
    usersSheet
      .getRange(
        1,
        1,
        1,
        usersSheet.getLastColumn()
      )
      .getDisplayValues()[0];


  const existing =
    mairixFullCycleFindRowByValue(
      usersSheet,
      "User ID",
      userId
    );


  if (
    !existing
  ) {

    const row =
      new Array(
        headers.length
      ).fill("");


    mairixFullCycleSetHeader(
      row,
      headers,
      "User ID",
      userId
    );

    mairixFullCycleSetHeader(
      row,
      headers,
      "Gmail",
      email
    );

    mairixFullCycleSetHeader(
      row,
      headers,
      "Name",
      MAIRIX_FULL_CYCLE_TEST
        .OPERATOR_NAME
    );

    mairixFullCycleSetHeader(
      row,
      headers,
      "Role",
      roleCode
    );

    mairixFullCycleSetHeader(
      row,
      headers,
      "Active",
      true
    );

    mairixFullCycleSetHeader(
      row,
      headers,
      "Created At",
      new Date()
    );

    mairixFullCycleSetHeader(
      row,
      headers,
      "Created By",
      "MAIRIX FULL CYCLE TEST"
    );


    usersSheet.appendRow(
      row
    );

  }


  /*
   * Make the test role inherit EVERY
   * permission currently present in the
   * permission catalog.
   *
   * This guarantees the test environment
   * itself is not blocked by missing checkbox
   * permission configuration.
   */

  const catalog =
    SpreadsheetApp
      .getActiveSpreadsheet()
      .getSheetByName(
        "PERMISSION_CATALOG"
      );


  if (
    catalog &&
    typeof mairixSetRolePermission ===
    "function"
  ) {

    const rows =
      mairixFullCycleReadObjects(
        catalog
      );


    rows.forEach(
      function(row) {

        const code =
          row[
            "Permission Code"
          ] ||
          row[
            "Code"
          ];


        if (
          code
        ) {

          try {

            mairixSetRolePermission(
              roleCode,
              code,
              {

                View:
                  true,

                Create:
                  true,

                Edit:
                  true,

                Delete:
                  true,

                Export:
                  true,

                Active:
                  true

              }
            );

          } catch (error) {

            Logger.log(
              "Permission setup note [" +
              code +
              "]: " +
              error.message
            );

          }

        }

      }
    );

  }


  /*
   * Generate current permissions.
   */

  if (
    typeof mairixEnsureUserPermissions ===
    "function"
  ) {

    try {

      mairixEnsureUserPermissions(
        userId
      );

    } catch (error) {

      Logger.log(
        "Ensure user permissions note: " +
        error.message
      );

    }

  }


  /*
   * Warehouse access.
   */

  if (
    typeof mairixSetUserWarehouseAccess ===
    "function"
  ) {
    
      Logger.log(
    "WAREHOUSE ACCESS DEBUG: " +
    JSON.stringify({
      userId: userId,
      warehouse: context.warehouse
    })
  );

    mairixSetUserWarehouseAccess(
      userId,
      context.warehouse.code,
      {

        View:
          true,

        Operate:
          true,

        Active:
          true

      }
    );

  }


  return {

    userId:
      userId,

    email:
      email,

    role:
      roleCode,

    active:
      true,

    warehouse:
      context.warehouse.code

  };

}


/************************************************
 * COMMISSION PREPARATION
