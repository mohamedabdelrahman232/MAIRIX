/************************************************
 * CURRENT USER
 ************************************************/

function mairixFullCycleEnsureCurrentUser() {

  if (
    typeof setupMAIRIXUsersSheet ===
    "function"
  ) {

    setupMAIRIXUsersSheet();

  }


  const email =
    Session
      .getActiveUser()
      .getEmail()
      .trim()
      .toLowerCase();


  if (!email) {

    throw new Error(
      "Cannot identify current Google account."
    );

  }


  let user =
    mairixGetUserByEmail(
      email
    );


  if (
    user
  ) {

    if (
      !user.active
    ) {

      mairixFullCycleActivateUserDirect(
        user.userId
      );

    }

    return mairixGetUserById(
      user.userId
    );

  }


  /*
   * Bootstrap only.
   *
   * The application normally creates users
   * through mairixCreateUser().
   *
   * We cannot call mairixCreateUser()
   * before a current user exists.
   *
   * Therefore the first administrator is
   * bootstrapped directly by the test.
   */

  const sheet =
    SpreadsheetApp
      .getActiveSpreadsheet()
      .getSheetByName(
        "USERS"
      );


  const userId =
    mairixGenerateUserId();


  const headers =
    sheet
      .getRange(
        1,
        1,
        1,
        sheet.getLastColumn()
      )
      .getDisplayValues()[0];


  const row =
    new Array(
      headers.length
    ).fill("");


  mairixFullCycleSetHeader(
    row,
    headers,
    "User ID",
    userId
  );

  mairixFullCycleSetHeader(
    row,
    headers,
    "Gmail",
    email
  );

  mairixFullCycleSetHeader(
    row,
    headers,
    "Name",
    "MAIRIX TEST ADMIN"
  );

  mairixFullCycleSetHeader(
    row,
    headers,
    "Role",
    "ADMIN"
  );

  mairixFullCycleSetHeader(
    row,
    headers,
    "Active",
    true
  );

  mairixFullCycleSetHeader(
    row,
    headers,
    "Created At",
    new Date()
  );

  mairixFullCycleSetHeader(
    row,
    headers,
    "Created By",
    "MAIRIX FULL CYCLE TEST"
  );


  sheet.appendRow(
    row
  );


  return mairixGetUserById(
    userId
  );

}


/************************************************
 * DIRECT TEST ACTIVATION
 ************************************************/

function mairixFullCycleActivateUserDirect(
  userId
) {

  const sheet =
    SpreadsheetApp
      .getActiveSpreadsheet()
      .getSheetByName(
        "USERS"
      );


  const headers =
    sheet
      .getRange(
        1,
        1,
        1,
        sheet.getLastColumn()
      )
      .getDisplayValues()[0];


  const idIndex =
    headers.indexOf(
      "User ID"
    );

  const activeIndex =
    headers.indexOf(
      "Active"
    );


  if (
    idIndex === -1 ||
    activeIndex === -1
  ) {

    throw new Error(
      "USERS sheet is missing User ID or Active."
    );

  }


  const rows =
    sheet
      .getRange(
        2,
        1,
        sheet.getLastRow() - 1,
        sheet.getLastColumn()
      )
      .getValues();


  for (
    let i = 0;
    i < rows.length;
    i++
  ) {

    if (
      String(
        rows[i][idIndex]
      ).trim() ===
      userId
    ) {

      sheet
        .getRange(
          i + 2,
          activeIndex + 1
        )
        .insertCheckboxes()
        .setValue(
          true
        );

      return;

    }

  }

}


