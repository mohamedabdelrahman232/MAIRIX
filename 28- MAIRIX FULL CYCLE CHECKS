/************************************************
 * MAIRIX ERP
 * FILE 28 — MAIRIX FULL CYCLE CHECKS
 *
 * PURPOSE
 * ------------------------------------------------
 * Full integration / end-to-end verification.
 *
 * THIS TEST:
 *
 * 1. Prepares required MAIRIX setup.
 * 2. Registers the current test administrator if needed.
 * 3. Creates isolated test master data.
 * 4. Creates a dedicated test operator.
 * 5. Creates test role + permissions.
 * 6. Grants test warehouse access.
 * 7. Creates test commission rule when possible.
 * 8. Creates purchase.
 * 9. Verifies inventory increase.
 * 10. Creates vendor payment.
 * 11. Creates purchase return.
 * 12. Creates credit sale.
 * 13. Verifies inventory decrease.
 * 14. Verifies customer receivable.
 * 15. Verifies loyalty.
 * 16. Verifies commission.
 * 17. Creates customer collection.
 * 18. Creates sales return.
 * 19. Creates general expense.
 * 20. Creates item-loaded expense.
 * 21. Runs operational reports.
 * 22. Runs financial statements.
 * 23. Verifies signed effects.
 * 24. Verifies central references.
 * 25. Verifies no destructive report behavior.
 *
 * IMPORTANT
 * ------------------------------------------------
 * Test data is intentionally NOT deleted automatically.
 *
 * Use:
 *
 *   cleanupMAIRIXFullCycleTest()
 *
 * only after reviewing the generated test records.
 *
 ************************************************/


/************************************************
 * TEST CONFIGURATION
 ************************************************/

const MAIRIX_FULL_CYCLE_TEST = {

  PREFIX:
    "TST",

  VERSION:
    "1.0.0",

  CUSTOMER_NAME:
    "MAIRIX FULL CYCLE TEST CUSTOMER",

  VENDOR_NAME:
    "MAIRIX FULL CYCLE TEST VENDOR",

  ITEM_NAME:
    "MAIRIX FULL CYCLE TEST ITEM",

  WAREHOUSE_NAME:
    "MAIRIX FULL CYCLE TEST WAREHOUSE",

  SALESMAN_NAME:
    "MAIRIX FULL CYCLE TEST SALESMAN",

  OPERATOR_NAME:
    "MAIRIX FULL CYCLE TEST OPERATOR",

  PURCHASE_QTY:
    100,

  PURCHASE_UNIT_COST:
    100,

  PURCHASE_RETURN_QTY:
    5,

  CREDIT_SALE_QTY:
    10,

  CREDIT_SALE_UNIT_PRICE:
    150,

  SALES_RETURN_QTY:
    2,

  COLLECTION_AMOUNT:
    500,

  VENDOR_PAYMENT_AMOUNT:
    500,

  GENERAL_EXPENSE_AMOUNT:
    250,

  ITEM_EXPENSE_AMOUNT:
    100,

  SALE_DISCOUNT:
    5,

  COMMISSION_RATE:
    2

};


/************************************************
 * MAIN ENTRY
 ************************************************/

function testMAIRIXFullCycle() {

  const startedAt =
    new Date();

  const runId =
    mairixFullCycleRunId();

  const context = {

    runId:
      runId,

    startedAt:
      startedAt,

    currentUser:
      null,

    testOperator:
      null,

    customer:
      null,

    vendor:
      null,

    item:
      null,

    warehouse:
      null,

    salesman:
      null,

    purchase:
      null,

    purchaseReturn:
      null,

    vendorPayment:
      null,

    sale:
      null,

    collection:
      null,

    salesReturn:
      null,

    expenses:
      [],

    results:
      [],

    errors:
      []

  };


  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX FULL CYCLE CHECKS"
  );

  Logger.log(
    "=========================================="
  );

  Logger.log(
    "Run ID: " +
    runId
  );


  /**********************************************
   * 1. ENVIRONMENT
   **********************************************/

  mairixFullCycleStep(
    context,
    "01_ENVIRONMENT_SETUP",
    function() {

      mairixFullCycleSetupEnvironment();

      return {
        success:
          true
      };

    }
  );


  /**********************************************
   * 2. CURRENT USER
   **********************************************/

  mairixFullCycleStep(
    context,
    "02_CURRENT_USER_SECURITY",
    function() {

      context.currentUser =
        mairixFullCycleEnsureCurrentUser();

      return {
        success:
          true,

        userId:
          context.currentUser.userId,

        email:
          context.currentUser.email,

        role:
          context.currentUser.role

      };

    }
  );


  /**********************************************
   * 3. TEST MASTER DATA
   **********************************************/

  mairixFullCycleStep(
    context,
    "03_TEST_MASTER_DATA",
    function() {

      const data =
        mairixFullCycleCreateMasterData(
          runId
        );

      context.customer =
        data.customer;

      context.vendor =
        data.vendor;

      context.item =
        data.item;

      context.warehouse =
        data.warehouse;

      context.salesman =
        data.salesman;

      return data;

    }
  );

  Logger.log(
    "FULL CYCLE CONTEXT BEFORE OPERATOR: " +
    JSON.stringify(
      mairixFullCycleSafeJson(context)
    )
  );

  if (
    !context ||
    !context.runId ||
    !context.warehouse ||
    !context.warehouse.code
  ) {

    throw new Error(
      "FULL CYCLE CONTEXT INVALID BEFORE OPERATOR"
    );

  }

  /**********************************************
   * 4. TEST OPERATOR + PERMISSIONS
   **********************************************/

  mairixFullCycleStep(
    context,
    "04_TEST_OPERATOR_PERMISSIONS",
    function() {

      context.testOperator =
        mairixFullCyclePrepareTestOperator(
          context
        );

      return context.testOperator;

    }
  );


  /**********************************************
   * 5. COMMISSION SETUP
   **********************************************/

  mairixFullCycleStep(
    context,
    "05_COMMISSION_SETUP",
    function() {

      return mairixFullCyclePrepareCommission(
        context
      );

    }
  );


  /**********************************************
   * 6. PURCHASE
   **********************************************/

  mairixFullCycleStep(
    context,
    "06_PURCHASE_CREDIT",
    function() {

      const result =
        createPurchase({

          referenceNo:
            "TST-PUR-" +
            runId,

          date:
            new Date(),

          supplierCode:
            context.vendor.code,

          warehouseCode:
            context.warehouse.code,

          paymentType:
            "CREDIT",

          dueDate:
            new Date(
              Date.now() +
              30 *
              24 *
              60 *
              60 *
              1000
            ),

          currency:
            "EGP",

          discount:
            0,

          lines: [

            {

              itemCode:
                context.item.code,

              quantity:
                MAIRIX_FULL_CYCLE_TEST.PURCHASE_QTY,

              unitCost:
                MAIRIX_FULL_CYCLE_TEST
                  .PURCHASE_UNIT_COST,

              discount:
                0

            }

          ]

        });


      context.purchase =
        result;


      mairixFullCycleAssert(
        result &&
        result.success === true,
        "Purchase creation failed."
      );


      return result;

    }
  );


  /**********************************************
   * 7. INVENTORY AFTER PURCHASE
   **********************************************/

  mairixFullCycleStep(
    context,
    "07_INVENTORY_AFTER_PURCHASE",
    function() {

      context.stockAfterPurchase =
        mairixFullCycleGetStock(
          context.warehouse.code,
          context.item.code
        );

      mairixFullCycleAssert(
        context.stockAfterPurchase >=
        MAIRIX_FULL_CYCLE_TEST.PURCHASE_QTY,
        "Inventory did not increase after purchase."
      );


      return {
        stock:
          stock
      };

    }
  );


  /**********************************************
   * 8. VENDOR PAYMENT
   **********************************************/

  mairixFullCycleStep(
    context,
    "08_VENDOR_PAYMENT",
    function() {

      const purchaseReference =
        mairixFullCycleExtractPurchaseReference(
          context.purchase
        );


      const result =
        createVendorPayment({

          vendorId:
            context.vendor.code,

          amount:
            MAIRIX_FULL_CYCLE_TEST
              .VENDOR_PAYMENT_AMOUNT,

          paymentMethod:
            "CASH",

          paymentDate:
            new Date(),

          purchaseReference:
            purchaseReference,

          notes:
            "MAIRIX FULL CYCLE TEST"

        });


      context.vendorPayment =
        result;


      mairixFullCycleAssert(
        result &&
        result.success === true,
        "Vendor payment creation failed."
      );


      mairixFullCycleAssert(
        Number(
          result.cashEffect
        ) ===
        -MAIRIX_FULL_CYCLE_TEST
          .VENDOR_PAYMENT_AMOUNT,
        "Vendor payment cash effect must be negative."
      );


      mairixFullCycleAssert(
        Number(
          result.vendorPayableEffect
        ) ===
        -MAIRIX_FULL_CYCLE_TEST
          .VENDOR_PAYMENT_AMOUNT,
        "Vendor payment payable effect must be negative."
      );


      return result;

    }
  );


  /**********************************************
   * 9. PURCHASE RETURN
   **********************************************/

  mairixFullCycleStep(
    context,
    "09_PURCHASE_RETURN",
    function() {

      const purchaseId =
        mairixFullCycleExtractPurchaseId(
          context.purchase
        );


      const result =
        createPurchaseReturn({

          originalPurchaseId:
            purchaseId,

          referenceNo:
            "TST-PRT-" +
            runId,

          date:
            new Date(),

          lines: [

            {

              originalLineNo:
                1,

              itemCode:
                context.item.code,

              quantity:
                MAIRIX_FULL_CYCLE_TEST
                  .PURCHASE_RETURN_QTY

            }

          ]

        });


      context.purchaseReturn =
        result;


      mairixFullCycleAssert(
        result &&
        result.success === true,
        "Purchase return creation failed."
      );


      return result;

    }
  );


  /**********************************************
   * 10. INVENTORY AFTER PURCHASE RETURN
   **********************************************/

  mairixFullCycleStep(
        context,
        "10_INVENTORY_AFTER_PURCHASE_RETURN",
        function() {

          const stockAfterReturn =
      mairixFullCycleGetStock(
        context.warehouse.code,
        context.item.code
      );

    const expectedStock =
      context.stockAfterPurchase -
      MAIRIX_FULL_CYCLE_TEST.PURCHASE_RETURN_QTY;

    mairixFullCycleAssert(
      stockAfterReturn === expectedStock,
      "Purchase return inventory effect is incorrect."
    );

    return {

      stockBeforeReturn:
        context.stockAfterPurchase,

      stockAfterReturn:
        stockAfterReturn,

      inventoryEffect:
        stockAfterReturn -
        context.stockAfterPurchase

    };

  }
  );


  /**********************************************
   * 11. CREDIT SALE
   **********************************************/

  mairixFullCycleStep(
    context,
    "11_CREDIT_SALE",
    function() {

      const result =
        createMairixSale({

          customerCode:
            context.customer.code,

          salesmanCode:
            context.salesman.code,

          warehouseCode:
            context.warehouse.code,

          paymentMethod:
            "CREDIT",

          discountPercent:
            MAIRIX_FULL_CYCLE_TEST
              .SALE_DISCOUNT,

          referenceNote:
            "MAIRIX FULL CYCLE TEST",

          items: [

            {

              itemCode:
                context.item.code,

              quantity:
                MAIRIX_FULL_CYCLE_TEST
                  .CREDIT_SALE_QTY,

              unitPrice:
                MAIRIX_FULL_CYCLE_TEST
                  .CREDIT_SALE_UNIT_PRICE

            }

          ]

        });


      context.sale =
        result;


      mairixFullCycleAssert(
        result &&
        result.success === true,
        "Credit sale creation failed."
      );


      mairixFullCycleAssert(
        result.paymentMethod ===
        "CREDIT",
        "Sale payment method must be CREDIT."
      );


      mairixFullCycleAssert(
        Number(
          result.cashEffect
        ) === 0,
        "Credit sale must not increase cash."
      );


      mairixFullCycleAssert(
        Number(
          result.customerCreditEffect
        ) > 0,
        "Credit sale must increase customer receivable."
      );


      mairixFullCycleAssert(
        Number(
          result.discountPercent
        ) ===
        MAIRIX_FULL_CYCLE_TEST
          .SALE_DISCOUNT,
        "Sale discount was not applied."
      );


      return result;

    }
  );


  /**********************************************
   * 12. INVENTORY AFTER SALE
   **********************************************/

  mairixFullCycleStep(
        context,
        "12_INVENTORY_AFTER_SALE",
        function() {

          const stockAfterSale =
      mairixFullCycleGetStock(
        context.warehouse.code,
        context.item.code
      );

    const expectedStock =
      context.stockAfterPurchase -
      MAIRIX_FULL_CYCLE_TEST.PURCHASE_RETURN_QTY -
      MAIRIX_FULL_CYCLE_TEST.CREDIT_SALE_QTY;

    mairixFullCycleAssert(
      stockAfterSale === expectedStock,
      "Sale inventory effect is incorrect."
    );

    return {

      stockBeforeSale:
        context.stockAfterPurchase -
        MAIRIX_FULL_CYCLE_TEST.PURCHASE_RETURN_QTY,

      stockAfterSale:
        stockAfterSale,

      inventoryEffect:
        stockAfterSale -
        (
          context.stockAfterPurchase -
          MAIRIX_FULL_CYCLE_TEST.PURCHASE_RETURN_QTY
        )

    };
  }
  );


  /**********************************************
   * 13. LOYALTY
   **********************************************/

  mairixFullCycleStep(
    context,
    "13_LOYALTY",
    function() {

      const pointsAfter =
        Number(
          context.sale
            .customer
            .loyaltyPointsAfter ||
          0
        );


      const pointsAdded =
        Number(
          context.sale
            .customer
            .loyaltyPointsAdded ||
          0
        );


      mairixFullCycleAssert(
        pointsAdded ===
        MAIRIX_FULL_CYCLE_TEST
          .CREDIT_SALE_QTY,
        "Loyalty points must equal sold quantity."
      );


      mairixFullCycleAssert(
        pointsAfter >= pointsAdded,
        "Customer loyalty balance is invalid."
      );


      return {
        pointsAdded:
          pointsAdded,

        pointsAfter:
          pointsAfter

      };

    }
  );


  /**********************************************
   * 14. COMMISSION
   **********************************************/

  mairixFullCycleStep(
    context,
    "14_COMMISSION",
    function() {

      const reference =
        mairixFullCycleExtractSaleReference(
          context.sale
        );


      const ledger =
        mairixFullCycleReadByReference(
          [
            "COMMISSION_LEDGER",
            "MAIRIX_COMMISSION_LEDGER",
            "COMMISSIONS"
          ],
          reference
        );


      if (
        ledger.length === 0
      ) {

        throw new Error(
          "Commission ledger entry was not found for test sale: " +
          reference
        );

      }


      return {
        reference:
          reference,

        rows:
          ledger.length

      };

    }
  );


  /**********************************************
   * 15. CUSTOMER COLLECTION
   **********************************************/

  mairixFullCycleStep(
    context,
    "15_CUSTOMER_COLLECTION",
    function() {

      const invoiceId =
        mairixFullCycleExtractSaleReference(
          context.sale
        );


      const result =
        createMAIRIXCollection({

          customerId:
            context.customer.code,

          invoiceId:
            invoiceId,

          warehouseId:
            context.warehouse.code,

          paymentMethod:
            "CASH",

          amount:
            MAIRIX_FULL_CYCLE_TEST
              .COLLECTION_AMOUNT,

          notes:
            "MAIRIX FULL CYCLE TEST"

        });


      context.collection =
        result;


      mairixFullCycleAssert(
        result &&
        result.success === true,
        "Customer collection creation failed."
      );


      return result;

    }
  );


  /**********************************************
   * 16. SALES RETURN
   **********************************************/

  mairixFullCycleStep(
    context,
    "16_SALES_RETURN",
    function() {

      const saleReference =
        mairixFullCycleExtractSaleReference(
          context.sale
        );


      const result =
        createMairixSalesReturn({

          originalSaleReference:
            saleReference,

          returnDate:
            new Date(),

          customerCode:
            context.customer.code,

          warehouseCode:
            context.warehouse.code,

          returnType:
            "CREDIT",

          items: [

            {

              originalSaleLine:
                1,

              itemCode:
                context.item.code,

              quantity:
                MAIRIX_FULL_CYCLE_TEST
                  .SALES_RETURN_QTY

            }

          ]

        });


      context.salesReturn =
        result;


      mairixFullCycleAssert(
        result &&
        result.success === true,
        "Sales return creation failed."
      );


      mairixFullCycleAssert(
        Number(
          result.inventoryEffect
        ) ===
        MAIRIX.INVENTORY_EFFECT.SALES_RETURN,
        "Sales return inventory effect must be +1."
      );


      mairixFullCycleAssert(
        Number(
          result.loyaltyPointsEffect
        ) <= 0,
        "Sales return loyalty effect must be negative."
      );


      return result;

    }
  );

  /**********************************************
   * 16B. FINAL INVENTORY
   **********************************************/

  mairixFullCycleStep(
    context,
    "16B_FINAL_INVENTORY",
    function() {

      const stock =
        mairixFullCycleGetStock(
          context.warehouse.code,
          context.item.code
        );

      const expected =
        MAIRIX_FULL_CYCLE_TEST.PURCHASE_QTY -
        MAIRIX_FULL_CYCLE_TEST.PURCHASE_RETURN_QTY -
        MAIRIX_FULL_CYCLE_TEST.CREDIT_SALE_QTY +
        MAIRIX_FULL_CYCLE_TEST.SALES_RETURN_QTY;

      mairixFullCycleAssert(
        stock === expected,
        "Final inventory does not match the complete transaction cycle."
      );

      return {

        stock:
          stock,

        expected:
          expected,

        netEffect:
          stock -
          (
            MAIRIX_FULL_CYCLE_TEST.PURCHASE_QTY
          )

      };

    }
  );

  /**********************************************
   * 17. GENERAL EXPENSE
   **********************************************/

  mairixFullCycleStep(
    context,
    "17_GENERAL_EXPENSE",
    function() {

      const result =
        createExpense({

          date:
            new Date(),

          description:
            "MAIRIX FULL CYCLE TEST GENERAL EXPENSE",

          amount:
            MAIRIX_FULL_CYCLE_TEST
              .GENERAL_EXPENSE_AMOUNT,

          category:
            "OTH",

          loadingMethod:
            "GENERAL",

          paymentMethod:
            "CASH",

          financialStatementCode:
            "ADMIN_EXPENSE",

          financialAccountCode:
            "TEST-EXPENSE",

          salesmanId:
            "",

          salesmanName:
            ""

        });


      context.expenses.push(
        result
      );


      mairixFullCycleAssert(
        result &&
        result.success === true,
        "General expense creation failed."
      );


      return result;

    }
  );


  /**********************************************
   * 18. ITEM EXPENSE
   **********************************************/

  mairixFullCycleStep(
    context,
    "18_ITEM_EXPENSE",
    function() {

      const result =
        createExpense({

          date:
            new Date(),

          description:
            "MAIRIX FULL CYCLE TEST ITEM EXPENSE",

          amount:
            MAIRIX_FULL_CYCLE_TEST
              .ITEM_EXPENSE_AMOUNT,

          category:
            "SHP",

          loadingMethod:
            "ITEM",

          itemId:
            context.item.code,

          paymentMethod:
            "CASH",

          financialAccountCode:
            "TEST-SHIPPING"

        });


      context.expenses.push(
        result
      );


      mairixFullCycleAssert(
        result &&
        result.success === true,
        "Item expense creation failed."
      );


      return result;

    }
  );


  /**********************************************
   * 19. SIGN VERIFICATION
   **********************************************/

  mairixFullCycleStep(
    context,
    "19_SIGNED_EFFECTS",
    function() {

      mairixFullCycleAssert(
  MAIRIX.INVENTORY_EFFECT.SALE === -1,
  "SALE inventory sign must be -1."
    );

    mairixFullCycleAssert(
      MAIRIX.INVENTORY_EFFECT.SALES_RETURN === 1,
      "SALES_RETURN inventory sign must be +1."
    );

    mairixFullCycleAssert(
      MAIRIX.INVENTORY_EFFECT.PURCHASE === 1,
      "PURCHASE inventory sign must be +1."
    );

    mairixFullCycleAssert(
      MAIRIX.INVENTORY_EFFECT.PURCHASE_RETURN === -1,
      "PURCHASE_RETURN inventory sign must be -1."
    );

    mairixFullCycleAssert(
      MAIRIX.FINANCIAL_EFFECT.CASH.CUSTOMER_COLLECTION === 1,
      "Customer collection cash sign must be +1."
    );

    mairixFullCycleAssert(
      MAIRIX.FINANCIAL_EFFECT.CASH.VENDOR_PAYMENT === -1,
      "Vendor payment cash sign must be -1."
    );

    mairixFullCycleAssert(
      MAIRIX.FINANCIAL_EFFECT.COMMISSION_PAYABLE.COMMISSION_EARNED === 1,
      "Commission earned sign must be +1."
    );

    mairixFullCycleAssert(
      MAIRIX.FINANCIAL_EFFECT.COMMISSION_PAYABLE.COMMISSION_SETTLEMENT === -1,
      "Commission settlement sign must be -1."
    );


      return {
        success:
          true
      };

    }
  );


  /**********************************************
   * 20. REPORTS
   **********************************************/

  mairixFullCycleStep(
    context,
    "20_OPERATIONAL_REPORTS",
    function() {

      const start =
        new Date(
          Date.now() -
          24 *
          60 *
          60 *
          1000
        );

      const end =
        new Date(
          Date.now() +
          24 *
          60 *
          60 *
          1000
        );


      const report =
        getMAIRIXInventoryMovementReport(
          start,
          end,
          {
            warehouseCode:
              context.warehouse.code,

            itemCode:
              context.item.code,

            postedOnly:
              true

          }
        );


      mairixFullCycleAssert(
        report &&
        Array.isArray(
          report.rows
        ),
        "Inventory report did not return rows."
      );


      return {
        rows:
          report.rows.length,

        quantityEffect:
          report.totalQuantityEffect,

        inventoryEffect:
          report.totalInventoryEffect

      };

    }
  );


  /**********************************************
   * 21. INVENTORY REPORT BY ITEM
   **********************************************/

  mairixFullCycleStep(
    context,
    "21_INVENTORY_REPORT_BY_ITEM",
    function() {

      const start =
        new Date(
          Date.now() -
          24 *
          60 *
          60 *
          1000
        );

      const end =
        new Date(
          Date.now() +
          24 *
          60 *
          60 *
          1000
        );


      const report =
        getMAIRIXInventoryMovementByItem(
          start,
          end,
          {
            warehouseCode:
              context.warehouse.code,

            itemCode:
              context.item.code,

            postedOnly:
              true

          }
        );


      mairixFullCycleAssert(
        report &&
        Array.isArray(
          report.rows
        ),
        "Inventory by item report did not return rows."
      );


      return {
        rows:
          report.rows.length
      };

    }
  );


  /**********************************************
   * 22. FINANCIAL STATEMENTS
   **********************************************/

  mairixFullCycleStep(
    context,
    "22_FINANCIAL_STATEMENTS",
    function() {

      if (
        typeof getMAIRIXIncomeStatement ===
        "function"
      ) {

        const income =
          getMAIRIXIncomeStatement(
            new Date(
              Date.now() -
              24 *
              60 *
              60 *
              1000
            ),
            new Date(
              Date.now() +
              24 *
              60 *
              60 *
              1000
            )
          );


        mairixFullCycleAssert(
          income !== null &&
          income !== undefined,
          "Income Statement returned no result."
        );

      }


      if (
        typeof getMAIRIXBalanceSheet ===
        "function"
      ) {

        const balance =
          getMAIRIXBalanceSheet(
            new Date(
              Date.now() -
              24 *
              60 *
              60 *
              1000
            ),
            new Date(
              Date.now() +
              24 *
              60 *
              60 *
              1000
            )
          );


        mairixFullCycleAssert(
          balance !== null &&
          balance !== undefined,
          "Balance Sheet returned no result."
        );

      }


      return {
        success:
          true,

        note:
          "Available financial statement APIs were executed."

      };

    }
  );


  /**********************************************
   * 23. CENTRAL REFERENCES
   **********************************************/

  mairixFullCycleStep(
    context,
    "23_CENTRAL_REFERENCES",
    function() {

      const checks = {

        purchase:
          mairixFullCycleExtractPurchaseReference(
            context.purchase
          ),

        sale:
          mairixFullCycleExtractSaleReference(
            context.sale
          ),

        collection:
          context.collection &&
          (
            context.collection.reference ||
            context.collection.referenceNo ||
            context.collection.collectionId
          ),

        vendorPayment:
          context.vendorPayment &&
          (
            context.vendorPayment.reference ||
            context.vendorPayment.paymentId
          ),

        salesReturn:
          context.salesReturn &&
          (
            context.salesReturn.reference ||
            context.salesReturn.returnReference
          )

      };


      Object.keys(
        checks
      ).forEach(
        function(key) {

          if (
            !checks[key]
          ) {

            throw new Error(
              "Missing central reference for: " +
              key
            );

          }

        }
      );


      return checks;

    }
  );


  /**********************************************
   * 24. BOOLEAN / CHECKBOX PRINCIPLE
   **********************************************/

  mairixFullCycleStep(
    context,
    "24_BOOLEAN_CHECKBOX_PRINCIPLE",
    function() {

      const values = [
        true,
        false,
        "TRUE",
        "FALSE",
        "YES",
        "NO"
      ];


      values.forEach(
        function(value) {

          const result =
            mairixFullCycleBoolean(
              value
            );


          if (
            typeof result !==
            "boolean"
          ) {

            throw new Error(
              "Boolean normalization failed for: " +
              value
            );

          }

        }
      );


      return {
        success:
          true,

        rule:
          "TRUE/FALSE and YES/NO are treated as boolean checkbox values."

      };

    }
  );


  /**********************************************
   * 25. FINALIZE
   **********************************************/

  const finishedAt =
    new Date();

  const passed =
    context.results.filter(
      function(row) {
        return row.status === "PASS";
      }
    ).length;

  const failed =
    context.results.filter(
      function(row) {
        return row.status === "FAIL";
      }
    ).length;

  const skipped =
    context.results.filter(
      function(row) {
        return row.status === "SKIP";
      }
    ).length;


  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX FULL CYCLE RESULT"
  );

  Logger.log(
    "=========================================="
  );

  Logger.log(
    "Run ID: " +
    runId
  );

  Logger.log(
    "PASS: " +
    passed
  );

  Logger.log(
    "FAIL: " +
    failed
  );

  Logger.log(
    "SKIP: " +
    skipped
  );

  Logger.log(
    "Started: " +
    startedAt
  );

  Logger.log(
    "Finished: " +
    finishedAt
  );


  Logger.log(
    "=========================================="
  );


  context.finishedAt =
    finishedAt;

  context.summary = {

    runId:
      runId,

    pass:
      passed,

    fail:
      failed,

    skip:
      skipped,

    success:
      failed === 0

  };


  Logger.log(
    JSON.stringify(
      context.summary
    )
  );


  Logger.log(
    "=========================================="
  );


  if (
    failed > 0
  ) {

    throw new Error(
      "MAIRIX FULL CYCLE FAILED. " +
      failed +
      " check(s) failed. " +
      "Review execution log."
    );

  }


  return context;

}


