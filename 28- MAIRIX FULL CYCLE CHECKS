}


/************************************************
 * STEP RUNNER
 ************************************************/

function mairixFullCycleStep(
  context,
  name,
  callback
) {

  const started =
    new Date();

  try {

    const result =
      callback();

    const finished =
      new Date();

    context.results.push({

      name:
        name,

      status:
        "PASS",

      startedAt:
        started,

      finishedAt:
        finished,

      result:
        mairixFullCycleSafeJson(
          result
        )

    });

    Logger.log(
      "PASS | " +
      name
    );

    return result;

  } catch (error) {

    const finished =
      new Date();

    context.results.push({

      name:
        name,

      status:
        "FAIL",

      startedAt:
        started,

      finishedAt:
        finished,

      error:
        error.message,

      stack:
        error.stack

    });

    context.errors.push({

      name:
        name,

      message:
        error.message

    });

    Logger.log(
      "FAIL | " +
      name +
      " | " +
      error.message
    );

    throw error;

  }

}


