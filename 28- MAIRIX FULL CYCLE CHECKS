/************************************************
 * MAIRIX FULL CYCLE
 * REAL ROLLBACK VERIFICATION
 *
 * PURPOSE
 * ------------------------------------------------
 * Verify application-level rollback by:
 *
 * 1. Creating dedicated temporary test sheets.
 * 2. Taking a complete snapshot.
 * 3. Applying multiple modifications.
 * 4. Forcing an intentional failure.
 * 5. Restoring the original snapshot.
 * 6. Comparing the sheets before/after.
 *
 * IMPORTANT
 * ------------------------------------------------
 * This is an application-level rollback test.
 *
 * Google Sheets does not provide a native
 * multi-sheet database transaction.
 *
 * The rollback mechanism tested here is therefore
 * snapshot + restore.
 ************************************************/

function testMAIRIXFullCycleRollback() {

  const ss =
    SpreadsheetApp
      .getActiveSpreadsheet();


  const runId =
    "TST-RB-" +
    mairixFullCycleRunId();


  const sheetNames = [

    "TST_RB_A_" + runId,

    "TST_RB_B_" + runId,

    "TST_RB_C_" + runId

  ];


  let snapshots =
    {};

  let rollbackExecuted =
    false;

  let intentionalFailure =
    false;


  Logger.log(
    "=========================================="
  );

  Logger.log(
    "MAIRIX FULL CYCLE ROLLBACK TEST"
  );

  Logger.log(
    "=========================================="
  );

  Logger.log(
    "Rollback Run ID: " +
    runId
  );


  try {

    /********************************************
     * 1. CREATE ISOLATED TEST DATA
     ********************************************/

    sheetNames.forEach(
      function(name, index) {

        const sheet =
          ss.insertSheet(
            name
          );


        sheet
          .getRange(
            1,
            1,
            3,
            3
          )
          .setValues([

            [
              "Reference",
              "Type",
              "Amount"
            ],

            [
              "ORIGINAL-" + index,
              "ORIGINAL",
              100 + index
            ],

            [
              "KEEP-" + index,
              "ORIGINAL",
              200 + index
            ]

          ]);

      }
    );


    Logger.log(
      "ISOLATED TEST DATA: PASS"
    );


    /********************************************
     * 2. CREATE COMPLETE SNAPSHOT
     ********************************************/

    snapshots =
      mairixFullCycleCreateSheetSnapshots(
        ss,
        sheetNames
      );


    mairixFullCycleAssert(
      Object.keys(
        snapshots
      ).length ===
      sheetNames.length,
      "Rollback snapshot was not created for all test sheets."
    );


    Logger.log(
      "SNAPSHOT: PASS"
    );


    /********************************************
     * 3. APPLY MULTI-SHEET MODIFICATIONS
     ********************************************/

    sheetNames.forEach(
      function(name, index) {

        const sheet =
          ss.getSheetByName(
            name
          );


        /*
         * Modify an existing record.
         */

        sheet
          .getRange(
            2,
            3
          )
          .setValue(
            999999
          );


        /*
         * Create a new record.
         */

        sheet
          .getRange(
            4,
            1,
            1,
            3
          )
          .setValues([

            [
              "CREATED-" + index,
              "MODIFIED",
              5000 + index
            ]

          ]);

      }
    );


    Logger.log(
      "MULTI-SHEET MODIFICATION: APPLIED"
    );


    /********************************************
     * 4. VERIFY MODIFICATION REALLY HAPPENED
     ********************************************/

    sheetNames.forEach(
      function(name) {

        const sheet =
          ss.getSheetByName(
            name
          );


        const modifiedValue =
          sheet
            .getRange(
              2,
              3
            )
            .getValue();


        mairixFullCycleAssert(
          Number(
            modifiedValue
          ) === 999999,
          "Existing record modification was not applied."
        );


        const createdReference =
          sheet
            .getRange(
              4,
              1
            )
            .getValue();


        mairixFullCycleAssert(
          String(
            createdReference
          ).indexOf(
            "CREATED-"
          ) === 0,
          "New record was not created."
        );

      }
    );


    Logger.log(
      "MODIFICATION VERIFICATION: PASS"
    );


    /********************************************
     * 5. FORCE INTENTIONAL FAILURE
     ********************************************/

    try {

      throw new Error(
        "MAIRIX INTENTIONAL ROLLBACK FAILURE"
      );

    } catch (error) {

      intentionalFailure =
        true;


      Logger.log(
        "INTENTIONAL FAILURE: PASS"
      );

      Logger.log(
        "Failure message: " +
        error.message
      );


      /******************************************
       * 6. RESTORE SNAPSHOT
       ******************************************/

      mairixFullCycleRestoreSheetSnapshots(
        ss,
        snapshots
      );


      rollbackExecuted =
        true;


      Logger.log(
        "ROLLBACK EXECUTION: PASS"
      );

    }


    /********************************************
     * 7. VERIFY COMPLETE RESTORATION
     ********************************************/

    const verification =
      mairixFullCycleVerifySheetSnapshots(
        ss,
        snapshots
      );


    mairixFullCycleAssert(
      verification &&
      verification.success === true,
      "Rollback verification failed."
    );


    /********************************************
     * 8. VERIFY MODIFIED VALUES ARE GONE
     ********************************************/

    sheetNames.forEach(
      function(name) {

        const sheet =
          ss.getSheetByName(
            name
          );


        /*
         * Original value must be restored.
         */

        const restoredValue =
          sheet
            .getRange(
              2,
              3
            )
            .getValue();


        mairixFullCycleAssert(
          Number(
            restoredValue
          ) !== 999999,
          "Modified value still exists after rollback."
        );


        /*
         * Created row must be removed.
         */

        const createdReference =
          sheet
            .getRange(
              4,
              1
            )
            .getValue();


        mairixFullCycleAssert(
          String(
            createdReference
          ).indexOf(
            "CREATED-"
          ) === -1,
          "Created rollback record still exists."
        );


        /*
         * Original values must exist.
         */

        const originalReference =
          sheet
            .getRange(
              2,
              1
            )
            .getValue();


        mairixFullCycleAssert(
          String(
            originalReference
          ).indexOf(
            "ORIGINAL-"
          ) === 0,
          "Original record was not restored."
        );

      }
    );


    Logger.log(
      "CELL-LEVEL ROLLBACK VERIFICATION: PASS"
    );


    /********************************************
     * 9. FINAL STATE ASSERTIONS
     ********************************************/

    mairixFullCycleAssert(
      intentionalFailure === true,
      "Intentional failure was not generated."
    );


    mairixFullCycleAssert(
      rollbackExecuted === true,
      "Rollback was not executed."
    );


    mairixFullCycleAssert(
      verification.verifiedSheets ===
      sheetNames.length,
      "Not all rollback sheets were verified."
    );


    Logger.log(
      "=========================================="
    );

    Logger.log(
      "ROLLBACK VERIFICATION: PASS"
    );

    Logger.log(
      "=========================================="
    );


    Logger.log(
      "Sheets verified: " +
      verification.verifiedSheets
    );


    Logger.log(
      "Intentional failure: " +
      intentionalFailure
    );


    Logger.log(
      "Rollback executed: " +
      rollbackExecuted
    );


    return {

      success:
        true,

      intentionalFailure:
        intentionalFailure,

      rollbackExecuted:
        rollbackExecuted,

      verifiedSheets:
        verification.verifiedSheets,

      runId:
        runId

    };

  } finally {

    /********************************************
     * 10. REMOVE ONLY OUR TEMPORARY SHEETS
     ********************************************/

    sheetNames.forEach(
      function(name) {

        const sheet =
          ss.getSheetByName(
            name
          );


        if (
          sheet
        ) {

          ss.deleteSheet(
            sheet
          );

        }

      }
    );


    Logger.log(
      "Rollback test temporary data cleaned."
    );

  }

}


/************************************************
 * CREATE SHEET SNAPSHOTS
 ************************************************/

function mairixFullCycleCreateSheetSnapshots(
  ss,
  sheetNames
) {

  const snapshots = {};


  sheetNames.forEach(
    function(name) {

      const sheet =
        ss.getSheetByName(
          name
        );


      if (
        !sheet
      ) {

        throw new Error(
          "Cannot snapshot missing sheet: " +
          name
        );

      }


      const lastRow =
        Math.max(
          sheet.getLastRow(),
          1
        );


      const lastColumn =
        Math.max(
          sheet.getLastColumn(),
          1
        );


      const range =
        sheet.getRange(
          1,
          1,
          lastRow,
          lastColumn
        );


      snapshots[name] = {

        rows:
          lastRow,

        columns:
          lastColumn,

        values:
          range.getValues(),

        formulas:
          range.getFormulas(),

        backgrounds:
          range.getBackgrounds(),

        numberFormats:
          range.getNumberFormats()

      };

    }
  );


  return snapshots;

}


/************************************************
 * RESTORE SHEET SNAPSHOTS
 *
 * IMPORTANT
 * ------------------------------------------------
 * Restore values first.
 *
 * Then restore ONLY cells that originally
 * contained formulas.
 *
 * We must NOT call setFormulas() over the
 * entire range because empty formula strings
 * would erase normal cell values.
 ************************************************/

function mairixFullCycleRestoreSheetSnapshots(
  ss,
  snapshots
) {

  Object.keys(
    snapshots
  ).forEach(
    function(name) {

      const snapshot =
        snapshots[name];

      const sheet =
        ss.getSheetByName(
          name
        );


      if (
        !sheet
      ) {

        throw new Error(
          "Cannot rollback missing sheet: " +
          name
        );

      }


      /********************************************
       * 1. CLEAR CURRENT CONTENT
       ********************************************/

      const currentRows =
        Math.max(
          sheet.getMaxRows(),
          snapshot.rows
        );

      const currentColumns =
        Math.max(
          sheet.getMaxColumns(),
          snapshot.columns
        );


      sheet
        .getRange(
          1,
          1,
          currentRows,
          currentColumns
        )
        .clearContent();


      /********************************************
       * 2. RESTORE ORIGINAL VALUES
       ********************************************/

      const targetRange =
        sheet.getRange(
          1,
          1,
          snapshot.rows,
          snapshot.columns
        );


      targetRange.setValues(
        snapshot.values
      );


      /********************************************
       * 3. RESTORE ONLY REAL FORMULAS
       *
       * DO NOT use setFormulas() on the entire
       * range because "" would erase ordinary
       * values.
       ********************************************/

      for (
        let r = 0;
        r < snapshot.rows;
        r++
      ) {

        for (
          let c = 0;
          c < snapshot.columns;
          c++
        ) {

          const formula =
            snapshot.formulas[r][c];


          if (
            formula !== null &&
            formula !== undefined &&
            String(formula).trim() !== ""
          ) {

            sheet
              .getRange(
                r + 1,
                c + 1
              )
              .setFormula(
                formula
              );

          }

        }

      }


      /********************************************
       * 4. RESTORE BACKGROUNDS
       ********************************************/

      targetRange.setBackgrounds(
        snapshot.backgrounds
      );


      /********************************************
       * 5. RESTORE NUMBER FORMATS
       ********************************************/

      targetRange.setNumberFormats(
        snapshot.numberFormats
      );

    }
  );

}


/************************************************
 * VERIFY SHEET SNAPSHOTS
 ************************************************/

function mairixFullCycleVerifySheetSnapshots(
  ss,
  snapshots
) {

  const differences = [];

  let verifiedSheets =
    0;


  Object.keys(
    snapshots
  ).forEach(
    function(name) {

      const snapshot =
        snapshots[name];


      const sheet =
        ss.getSheetByName(
          name
        );


      if (
        !sheet
      ) {

        differences.push(
          "Missing sheet: " +
          name
        );

        return;

      }


      const range =
        sheet.getRange(
          1,
          1,
          snapshot.rows,
          snapshot.columns
        );


      const values =
        range.getValues();


      const formulas =
        range.getFormulas();


      for (
        let r = 0;
        r < snapshot.rows;
        r++
      ) {

        for (
          let c = 0;
          c < snapshot.columns;
          c++
        ) {

          const originalFormula =
            snapshot.formulas[r][c];


          const currentFormula =
            formulas[r][c];


          /*
           * If the original cell contained a
           * formula, verify the formula itself.
           */

          if (
            originalFormula
          ) {

            if (
              String(
                originalFormula
              ) !==
              String(
                currentFormula
              )
            ) {

              differences.push(

                name +
                " | Row " +
                (r + 1) +
                " | Column " +
                (c + 1) +
                " | Formula Before: " +
                originalFormula +
                " | Formula After: " +
                currentFormula

              );

            }

            continue;

          }


          /*
           * Otherwise verify the actual value.
           */

          const before =
            mairixFullCycleNormalizeValue(
              snapshot.values[r][c]
            );


          const after =
            mairixFullCycleNormalizeValue(
              values[r][c]
            );


          if (
            before !== after
          ) {

            differences.push(

              name +
              " | Row " +
              (r + 1) +
              " | Column " +
              (c + 1) +
              " | Before: " +
              before +
              " | After: " +
              after

            );

          }

        }

      }


      verifiedSheets++;

    }
  );


  if (
    differences.length > 0
  ) {

    Logger.log(
      "ROLLBACK DIFFERENCES:"
    );


    differences.forEach(
      function(value) {

        Logger.log(
          value
        );

      }
    );


    return {

      success:
        false,

      verifiedSheets:
        verifiedSheets,

      differences:
        differences

    };

  }


  return {

    success:
      true,

    verifiedSheets:
      verifiedSheets,

    differences:
      []

  };

}


/************************************************
 * NORMALIZE SNAPSHOT VALUE
 ************************************************/

function mairixFullCycleNormalizeValue(
  value
) {

  if (
    value instanceof Date
  ) {

    return value
      .getTime()
      .toString();

  }


  if (
    value === null ||
    value === undefined
  ) {

    return "";

  }


  return String(
    value
  );

}
