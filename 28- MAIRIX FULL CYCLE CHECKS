/************************************************
 * BOOLEAN NORMALIZER
 *
 * CENTRAL TEST PRINCIPLE:
 *
 * TRUE / FALSE
 * YES / NO
 * 1 / 0
 *
 * represent boolean checkbox values.
 ************************************************/

function mairixFullCycleBoolean(
  value
) {

  if (
    value === true
  ) {

    return true;

  }


  if (
    value === false
  ) {

    return false;

  }


  const normalized =
    String(
      value
    )
      .trim()
      .toUpperCase();


  if (
    normalized ===
      "TRUE" ||
    normalized ===
      "YES" ||
    normalized ===
      "Y" ||
    normalized ===
      "1"
  ) {

    return true;

  }


  if (
    normalized ===
      "FALSE" ||
    normalized ===
      "NO" ||
    normalized ===
      "N" ||
    normalized ===
      "0"
  ) {

    return false;

  }


  throw new Error(
    "Invalid boolean value: " +
    value
  );

}


/************************************************
 * SAFE JSON
 ************************************************/

function mairixFullCycleSafeJson(
  value
) {

  if (
    value ===
    undefined
  ) {

    return null;

  }


  try {

    return JSON.parse(
      JSON.stringify(
        value
      )
    );

  } catch (error) {

    return String(
      value
    );

  }

}


/************************************************
 * RUN ID
 ************************************************/

function mairixFullCycleRunId() {

  const date =
    Utilities.formatDate(
      new Date(),
      Session.getScriptTimeZone(),
      "yyyyMMdd-HHmmss"
    );


  const random =
    Math.floor(
      Math.random() *
      1000
    )
      .toString()
      .padStart(
        3,
        "0"
      );


  return (
    date +
    "-" +
    random
  );

}


/************************************************
 * CLEANUP
 *
 * IMPORTANT:
 * This is intentionally manual.
 *
 * It only removes records that carry the
 * selected TEST prefix.
 *
 * Default run:
 *
 *   cleanupMAIRIXFullCycleTest()
 *
 ************************************************/

function cleanupMAIRIXFullCycleTest() {

  const ss =
    SpreadsheetApp
      .getActiveSpreadsheet();


  const sheets = [

    {
      name:
        "CUSTOMERS",

      columns: [
        "Customer Code"
      ]

    },

    {
      name:
        "VENDORS",

      columns: [
        "Vendor Code"
      ]

    },

    {
      name:
        "ITEMS",

      columns: [
        "Item Code"
      ]

    },

    {
      name:
        "WAREHOUSES",

      columns: [
        "Warehouse Code"
      ]

    },

    {
      name:
        "EMPLOYEES",

      columns: [
        "Employee Code"
      ]

    }

  ];


  let deleted =
    0;


  sheets.forEach(
    function(config) {

      const sheet =
        ss.getSheetByName(
          config.name
        );


      if (
        !sheet ||
        sheet.getLastRow() < 2
      ) {

        return;

      }


      const headers =
        sheet
          .getRange(
            1,
            1,
            1,
            sheet.getLastColumn()
          )
          .getDisplayValues()[0];


      let keyIndex =
        -1;


      for (
        let i = 0;
        i < config.columns.length;
        i++
      ) {

        const index =
          headers.indexOf(
            config.columns[i]
          );


        if (
          index !== -1
        ) {

          keyIndex =
            index;

          break;

        }

      }


      if (
        keyIndex === -1
      ) {

        return;

      }


      const rows =
        sheet
          .getRange(
            2,
            1,
            sheet.getLastRow() - 1,
            sheet.getLastColumn()
          )
          .getValues();


      for (
        let i =
          rows.length - 1;
        i >= 0;
        i--
      ) {

        const value =
          String(
            rows[i][keyIndex] ||
            ""
          );


        if (
          value.indexOf(
            "TST-"
          ) === 0
        ) {

          sheet.deleteRow(
            i + 2
          );

          deleted++;

        }

      }

    }
  );


  Logger.log(
    "MAIRIX FULL CYCLE TEST CLEANUP"
  );

  Logger.log(
    "Deleted master test rows: " +
    deleted
  );


  return {

    success:
      true,

    deleted:
      deleted

  };

}


