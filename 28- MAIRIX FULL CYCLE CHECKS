/************************************************
 * EXTRACT PURCHASE REFERENCE
 ************************************************/

function mairixFullCycleExtractPurchaseReference(
  result
) {

  if (!result) {

    return "";

  }


  return (
    result.referenceNo ||
    result.reference ||
    result.purchaseReference ||
    result["Reference No"] ||
    result["Purchase Reference"] ||
    result.purchaseId ||
    result.purchaseID ||
    result["Purchase ID"] ||
    ""
  );

}


/************************************************
 * EXTRACT PURCHASE ID
 ************************************************/

function mairixFullCycleExtractPurchaseId(
  result
) {

  if (!result) {

    return "";

  }


  return (
    result.purchaseId ||
    result.purchaseID ||
    result["Purchase ID"] ||
    result.id ||
    result.referenceNo ||
    result.reference ||
    ""
  );

}


/************************************************
 * EXTRACT SALE REFERENCE
 ************************************************/

function mairixFullCycleExtractSaleReference(
  result
) {

  if (!result) {

    return "";

  }


  return (
    result.referenceId ||
    result.saleId ||
    result.saleReference ||
    result.reference ||
    result["Sale Reference"] ||
    result["Reference"] ||
    ""
  );

}


/************************************************
 * READ BY REFERENCE
 ************************************************/

function mairixFullCycleReadByReference(
  sheetNames,
  reference
) {

  const ss =
    SpreadsheetApp
      .getActiveSpreadsheet();


  const output = [];


  sheetNames.forEach(
    function(name) {

      const sheet =
        ss.getSheetByName(
          name
        );


      if (
        !sheet
      ) {

        return;

      }


      const rows =
        mairixFullCycleReadObjects(
          sheet
        );


      rows.forEach(
        function(row) {

          const text =
            JSON.stringify(
              row
            );


          if (
            text.indexOf(
              reference
            ) !== -1
          ) {

            output.push(
              row
            );

          }

        }
      );

    }
  );


  return output;

}


/************************************************
 * READ SHEET OBJECTS
 ************************************************/

function mairixFullCycleReadObjects(
  sheet
) {

  if (
    !sheet ||
    sheet.getLastRow() < 2
  ) {

    return [];

  }


  const lastColumn =
    sheet.getLastColumn();


  const headers =
    sheet
      .getRange(
        1,
        1,
        1,
        lastColumn
      )
      .getDisplayValues()[0];


  const rows =
    sheet
      .getRange(
        2,
        1,
        sheet.getLastRow() - 1,
        lastColumn
      )
      .getValues();


  return rows.map(
    function(row) {

      const object = {};


      headers.forEach(
        function(header, index) {

          object[
            String(
              header
            ).trim()
          ] =
            row[index];

        }
      );


      return object;

    }
  );

}


/************************************************
 * FIND ROW BY VALUE
 ************************************************/

function mairixFullCycleFindRowByValue(
  sheet,
  header,
  value
) {

  if (
    !sheet ||
    sheet.getLastRow() < 2
  ) {

    return null;

  }


  const headers =
    sheet
      .getRange(
        1,
        1,
        1,
        sheet.getLastColumn()
      )
      .getDisplayValues()[0];


  const index =
    headers.indexOf(
      header
    );


  if (
    index === -1
  ) {

    return null;

  }


  const values =
    sheet
      .getRange(
        2,
        index + 1,
        sheet.getLastRow() - 1,
        1
      )
      .getDisplayValues();


  for (
    let i = 0;
    i < values.length;
    i++
  ) {

    if (
      String(
        values[i][0]
      ).trim() ===
      String(
        value
      ).trim()
    ) {

      return i + 2;

    }

  }


  return null;

}


/************************************************
