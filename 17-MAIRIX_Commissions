/************************************************
 * MAIRIX ERP
 * 17-MAIRIX_Commissions
 *
 * PURPOSE
 * ------------------------------------------------
 * Commission calculation and settlement engine.
 *
 * CORE RULES
 * ------------------------------------------------
 * 1. Commission is earned from SALES.
 * 2. Commission payment is recorded separately.
 * 3. Payment never changes the earned commission.
 * 4. Returned sales reverse the related commission.
 * 5. Commission calculations are server-side.
 * 6. Sales employees never see commission configuration.
 * 7. Commission configuration is administrator controlled.
 * 8. Every commission movement has a central reference.
 * 9. Reports distinguish:
 *
 *      Earned
 *      Reversed
 *      Paid
 *      Outstanding
 *
 * 10. Cash and credit balances remain separate.
 *
 * ARCHITECTURE
 * ------------------------------------------------
 *
 * SALES
 *    |
 *    +----> COMMISSION EARNED
 *    |
 *    +----> FINANCIAL EFFECT
 *
 * SALES RETURN
 *    |
 *    +----> COMMISSION REVERSAL
 *
 * EXPENSE / COMMISSION PAYMENT
 *    |
 *    +----> COMMISSION PAID
 *
 * REPORT
 *    |
 *    +----> Earned
 *    +----> Reversed
 *    +----> Paid
 *    +----> Outstanding
 *
 ************************************************/


/************************************************
 * CONSTANTS
 ************************************************/

var MAIRIX_COMMISSION = {

  SHEETS: {

    SETTINGS:
      "MAIRIX_SETTINGS",

    USERS:
      "MAIRIX_USERS",

    COMMISSION_RULES:
      "MAIRIX_COMMISSION_RULES",

    COMMISSION_LEDGER:
      "MAIRIX_COMMISSION_LEDGER"

  },

  MOVEMENT_TYPES: {

    SALE:
      "SALE",

    SALE_RETURN:
      "SALE_RETURN",

    PAYMENT:
      "PAYMENT",

    ADJUSTMENT:
      "ADJUSTMENT"

  },

  STATUS: {

    ACTIVE:
      "ACTIVE",

    INACTIVE:
      "INACTIVE",

    POSTED:
      "POSTED",

    REVERSED:
      "REVERSED"

  }

};


/************************************************
 * SETUP COMMISSION ENGINE
 *
 * Creates required sheets from zero.
 ************************************************/

function setupMAIRIXCommissions() {

  var ss =
    SpreadsheetApp.getActiveSpreadsheet();


  /**********************************************
   * COMMISSION RULES
   **********************************************/

  var rules =
    ss.getSheetByName(
      MAIRIX_COMMISSION.SHEETS.COMMISSION_RULES
    );


  if (!rules) {

    rules =
      ss.insertSheet(
        MAIRIX_COMMISSION.SHEETS.COMMISSION_RULES
      );

  }


  var rulesHeaders = [

    "Rule ID",
    "User ID",
    "Employee Name",
    "Rule Type",
    "Rate",
    "Fixed Amount",
    "Basis",
    "Effective From",
    "Effective To",
    "Active",
    "Notes",
    "Created At",
    "Created By"

  ];


  ensureSheetHeaders(
    rules,
    rulesHeaders
  );


  /**********************************************
   * COMMISSION LEDGER
   **********************************************/

  var ledger =
    ss.getSheetByName(
      MAIRIX_COMMISSION.SHEETS.COMMISSION_LEDGER
    );


  if (!ledger) {

    ledger =
      ss.insertSheet(
        MAIRIX_COMMISSION.SHEETS.COMMISSION_LEDGER
      );

  }


  var ledgerHeaders = [

    "Commission Movement ID",
    "Movement Date",
    "Movement Type",
    "Employee User ID",
    "Employee Name",
    "Source Reference",
    "Source Type",
    "Sale Reference",
    "Customer Reference",
    "Warehouse Reference",

    "Commission Rate",
    "Commission Basis",
    "Commission Amount",

    "Cash Effect",
    "Credit Effect",

    "Status",
    "Notes",

    "Created At",
    "Created By"

  ];


  ensureSheetHeaders(
    ledger,
    ledgerHeaders
  );


  formatCommissionSheets();


  return {

    success:
      true,

    rulesSheet:
      MAIRIX_COMMISSION.SHEETS.COMMISSION_RULES,

    ledgerSheet:
      MAIRIX_COMMISSION.SHEETS.COMMISSION_LEDGER

  };

}


/************************************************
 * CREATE COMMISSION RULE
 *
 * ADMIN ONLY
 *
 * This defines how an employee earns commission.
 *
 * Rule Types:
 *
 * RATE
 * FIXED
 *
 * Basis examples:
 *
 * NET_SALE
 * GROSS_SALE
 * ITEM_QUANTITY
 ************************************************/

function createCommissionRule(data) {

  var currentUser =
    requireMAIRIXCommissionAdmin();


  if (!data) {

    throw new Error(
      "Commission rule data is required."
    );

  }


  var userId =
    requireCommissionValue(
      data.userId,
      "User ID"
    );


  var ruleType =
    requireCommissionValue(
      data.ruleType,
      "Rule Type"
    )
      .toUpperCase();


  var basis =
    requireCommissionValue(
      data.basis,
      "Basis"
    )
      .toUpperCase();


  if (
    ruleType !== "RATE" &&
    ruleType !== "FIXED"
  ) {

    throw new Error(
      "Invalid commission rule type."
    );

  }


  if (
    [
      "NET_SALE",
      "GROSS_SALE",
      "ITEM_QUANTITY"
    ].indexOf(basis) === -1
  ) {

    throw new Error(
      "Invalid commission basis: " +
      basis
    );

  }


  var user =
    getCommissionUser(
      userId
    );


  if (!user) {

    throw new Error(
      "Commission employee not found: " +
      userId
    );

  }


  var sheet =
    getMAIRIXCommissionSheet(
      MAIRIX_COMMISSION.SHEETS.COMMISSION_RULES
    );


  var ruleId =
    generateCommissionRuleId();


  var headers =
    getCommissionHeaders(
      sheet
    );


  var row =
    new Array(
      headers.length
    ).fill("");


  setCommissionHeaderValue(
    row,
    headers,
    "Rule ID",
    ruleId
  );


  setCommissionHeaderValue(
    row,
    headers,
    "User ID",
    userId
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Employee Name",
    user.name
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Rule Type",
    ruleType
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Rate",
    Number(data.rate || 0)
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Fixed Amount",
    Number(data.fixedAmount || 0)
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Basis",
    basis
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Effective From",
    data.effectiveFrom || new Date()
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Effective To",
    data.effectiveTo || ""
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Active",
    true
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Notes",
    cleanCommissionText(
      data.notes
    )
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Created At",
    new Date()
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Created By",
    currentUser.email
  );


  sheet
    .getRange(
      sheet.getLastRow() + 1,
      1,
      1,
      row.length
    )
    .setValues([
      row
    ]);


  writeCommissionAudit(
    "CREATE_COMMISSION_RULE",
    ruleId,
    "Employee: " +
      userId +
      " | Type: " +
      ruleType +
      " | Basis: " +
      basis +
      " | Created By: " +
      currentUser.email
  );


  return {

    success:
      true,

    ruleId:
      ruleId,

    userId:
      userId,

    ruleType:
      ruleType,

    basis:
      basis

  };

}


/************************************************
 * DEACTIVATE COMMISSION RULE
 ************************************************/

function deactivateCommissionRule(
  ruleId
) {

  var currentUser =
    requireMAIRIXCommissionAdmin();


  var sheet =
    getMAIRIXCommissionSheet(
      MAIRIX_COMMISSION.SHEETS.COMMISSION_RULES
    );


  var row =
    findCommissionRow(
      sheet,
      "Rule ID",
      ruleId
    );


  if (row === -1) {

    throw new Error(
      "Commission rule not found: " +
      ruleId
    );

  }


  var activeColumn =
    getCommissionColumnNumber(
      sheet,
      "Active"
    );


  sheet
    .getRange(
      row,
      activeColumn
    )
    .setValue(false);


  writeCommissionAudit(
    "DEACTIVATE_COMMISSION_RULE",
    ruleId,
    "Changed By: " +
      currentUser.email
  );


  return {

    success:
      true,

    ruleId:
      ruleId,

    active:
      false

  };

}


/************************************************
 * CALCULATE COMMISSION
 *
 * Pure calculation.
 *
 * Does NOT post anything.
 ************************************************/

function calculateCommission(
  userId,
  saleData
) {

  var user =
    getCommissionUser(
      userId
    );


  if (!user) {

    throw new Error(
      "Commission employee not found."
    );

  }


  var rule =
    getActiveCommissionRule(
      userId,
      saleData &&
      saleData.date
        ? saleData.date
        : new Date()
    );


  if (!rule) {

    return {

      eligible:
        false,

      amount:
        0,

      reason:
        "No active commission rule."

    };

  }


  var basisValue =
    getCommissionBasisValue(
      rule.basis,
      saleData || {}
    );


  var amount =
    0;


  if (
    rule.ruleType === "RATE"
  ) {

    amount =
      basisValue *
      Number(rule.rate || 0) /
      100;

  }


  if (
    rule.ruleType === "FIXED"
  ) {

    /*
     * Fixed commission is multiplied
     * by quantity when the basis is
     * ITEM_QUANTITY.
     */

    if (
      rule.basis === "ITEM_QUANTITY"
    ) {

      amount =
        Number(rule.fixedAmount || 0) *
        Number(
          saleData.quantity || 0
        );

    } else {

      amount =
        Number(
          rule.fixedAmount || 0
        );

    }

  }


  amount =
    roundCommissionAmount(
      amount
    );


  return {

    eligible:
      true,

    userId:
      userId,

    employeeName:
      user.name,

    ruleId:
      rule.ruleId,

    ruleType:
      rule.ruleType,

    rate:
      Number(rule.rate || 0),

    basis:
      rule.basis,

    basisValue:
      basisValue,

    amount:
      amount

  };

}


/************************************************
 * POST COMMISSION FROM SALE
 *
 * Called by SALES engine.
 *
 * IMPORTANT:
 * Sale must already have a central reference.
 ************************************************/

function postCommissionFromSale(
  saleData
) {

  var currentUser =
    requireMAIRIXCommissionServerUser();


  if (!saleData) {

    throw new Error(
      "Sale data is required."
    );

  }


  var saleReference =
    requireCommissionValue(
      saleData.saleReference ||
      saleData.reference,
      "Sale Reference"
    );


  var userId =
    requireCommissionValue(
      saleData.employeeUserId ||
      saleData.salesmanUserId ||
      saleData.userId,
      "Employee User ID"
    );


  var calculation =
    calculateCommission(
      userId,
      saleData
    );


  if (
    !calculation.eligible ||
    calculation.amount <= 0
  ) {

    return {

      success:
        true,

      posted:
        false,

      amount:
        0,

      reason:
        calculation.reason ||
        "Commission amount is zero."

    };

  }


  var existing =
    findCommissionBySource(
      saleReference,
      MAIRIX_COMMISSION.MOVEMENT_TYPES.SALE
    );


  /*
   * Idempotency:
   *
   * The same sale must never create
   * commission twice.
   */

  if (existing) {

    return {

      success:
        true,

      posted:
        false,

      duplicate:
        true,

      movementId:
        existing.movementId,

      amount:
        Number(
          existing.amount || 0
        )

    };

  }


  var movementId =
    generateCommissionMovementId();


  var ledger =
    getMAIRIXCommissionSheet(
      MAIRIX_COMMISSION.SHEETS.COMMISSION_LEDGER
    );


  var headers =
    getCommissionHeaders(
      ledger
    );


  var row =
    new Array(
      headers.length
    ).fill("");


  setCommissionHeaderValue(
    row,
    headers,
    "Commission Movement ID",
    movementId
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Movement Date",
    saleData.date || new Date()
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Movement Type",
    MAIRIX_COMMISSION.MOVEMENT_TYPES.SALE
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Employee User ID",
    userId
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Employee Name",
    calculation.employeeName
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Source Reference",
    saleReference
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Source Type",
    "SALE"
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Sale Reference",
    saleReference
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Customer Reference",
    saleData.customerReference ||
      saleData.customerId ||
      ""
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Warehouse Reference",
    saleData.warehouseReference ||
      saleData.warehouseId ||
      ""
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Commission Rate",
    calculation.rate
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Commission Basis",
    calculation.basis
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Commission Amount",
    calculation.amount
  );


  /*
   * Commission itself is NOT cash.
   *
   * Payment happens separately.
   */

  setCommissionHeaderValue(
    row,
    headers,
    "Cash Effect",
    0
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Credit Effect",
    calculation.amount
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Status",
    MAIRIX_COMMISSION.STATUS.POSTED
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Notes",
    "Commission earned from sale."
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Created At",
    new Date()
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Created By",
    currentUser.email
  );


  ledger
    .getRange(
      ledger.getLastRow() + 1,
      1,
      1,
      row.length
    )
    .setValues([
      row
    ]);


  writeCommissionAudit(
    "POST_COMMISSION_FROM_SALE",
    movementId,
    "Sale: " +
      saleReference +
      " | Employee: " +
      userId +
      " | Amount: " +
      calculation.amount
  );


  return {

    success:
      true,

    posted:
      true,

    duplicate:
      false,

    movementId:
      movementId,

    saleReference:
      saleReference,

    employeeUserId:
      userId,

    amount:
      calculation.amount

  };

}


/************************************************
 * POST COMMISSION REVERSAL
 *
 * Called by SALES RETURNS.
 *
 * IMPORTANT:
 * We NEVER delete the original commission.
 * We create a reversing movement.
 ************************************************/

function postCommissionReversal(
  returnData
) {

  var currentUser =
    requireMAIRIXCommissionServerUser();


  var saleReference =
    requireCommissionValue(
      returnData.saleReference,
      "Original Sale Reference"
    );


  var returnReference =
    requireCommissionValue(
      returnData.returnReference ||
      returnData.reference,
      "Return Reference"
    );


  var original =
    findCommissionBySource(
      saleReference,
      MAIRIX_COMMISSION.MOVEMENT_TYPES.SALE
    );


  if (!original) {

    return {

      success:
        true,

      posted:
        false,

      amount:
        0,

      reason:
        "No commission found for original sale."

    };

  }


  var existingReversal =
    findCommissionBySource(
      returnReference,
      MAIRIX_COMMISSION.MOVEMENT_TYPES.SALE_RETURN
    );


  if (existingReversal) {

    return {

      success:
        true,

      posted:
        false,

      duplicate:
        true,

      movementId:
        existingReversal.movementId,

      amount:
        existingReversal.amount

    };

  }


  var originalAmount =
    Number(
      original.amount || 0
    );


  var reversalAmount =
    calculateReturnCommissionAmount(
      originalAmount,
      returnData
    );


  if (
    reversalAmount <= 0
  ) {

    return {

      success:
        true,

      posted:
        false,

      amount:
        0

    };

  }


  var movementId =
    generateCommissionMovementId();


  var ledger =
    getMAIRIXCommissionSheet(
      MAIRIX_COMMISSION.SHEETS.COMMISSION_LEDGER
    );


  var headers =
    getCommissionHeaders(
      ledger
    );


  var row =
    new Array(
      headers.length
    ).fill("");


  setCommissionHeaderValue(
    row,
    headers,
    "Commission Movement ID",
    movementId
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Movement Date",
    returnData.date || new Date()
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Movement Type",
    MAIRIX_COMMISSION.MOVEMENT_TYPES.SALE_RETURN
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Employee User ID",
    original.employeeUserId
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Employee Name",
    original.employeeName
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Source Reference",
    returnReference
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Source Type",
    "SALE_RETURN"
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Sale Reference",
    saleReference
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Customer Reference",
    returnData.customerReference ||
      ""
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Warehouse Reference",
    returnData.warehouseReference ||
      ""
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Commission Rate",
    original.rate
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Commission Basis",
    original.basis
  );


  /*
   * Reversal is negative.
   */

  setCommissionHeaderValue(
    row,
    headers,
    "Commission Amount",
    -reversalAmount
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Cash Effect",
    0
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Credit Effect",
    -reversalAmount
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Status",
    MAIRIX_COMMISSION.STATUS.POSTED
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Notes",
    "Commission reversed by sales return."
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Created At",
    new Date()
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Created By",
    currentUser.email
  );


  ledger
    .getRange(
      ledger.getLastRow() + 1,
      1,
      1,
      row.length
    )
    .setValues([
      row
    ]);


  writeCommissionAudit(
    "REVERSE_COMMISSION",
    movementId,
    "Return: " +
      returnReference +
      " | Original Sale: " +
      saleReference +
      " | Amount: -" +
      reversalAmount
  );


  return {

    success:
      true,

    posted:
      true,

    movementId:
      movementId,

    saleReference:
      saleReference,

    returnReference:
      returnReference,

    amount:
      -reversalAmount

  };

}


/************************************************
 * RECORD COMMISSION PAYMENT
 *
 * This is the settlement side.
 *
 * Payment is an expense/cash movement.
 *
 * Commission earned remains unchanged.
 ************************************************/

function recordCommissionPayment(
  data
) {

  var currentUser =
    requireMAIRIXCommissionServerUser();


  if (!data) {

    throw new Error(
      "Commission payment data is required."
    );

  }


  var employeeUserId =
    requireCommissionValue(
      data.employeeUserId,
      "Employee User ID"
    );


  var amount =
    Number(
      data.amount
    );


  if (
    !isFinite(amount) ||
    amount <= 0
  ) {

    throw new Error(
      "Commission payment amount must be greater than zero."
    );

  }


  var paymentReference =
    requireCommissionValue(
      data.paymentReference ||
      data.reference,
      "Payment Reference"
    );


  var employee =
    getCommissionUser(
      employeeUserId
    );


  if (!employee) {

    throw new Error(
      "Commission employee not found."
    );

  }


  var balance =
    getCommissionBalance(
      employeeUserId,
      data.beforeDate
    );


  if (
    amount >
    balance.outstanding + 0.0001
  ) {

    throw new Error(
      "Commission payment exceeds outstanding commission. " +
      "Outstanding: " +
      balance.outstanding
    );

  }


  /*
   * Payment movement:
   *
   * Cash = negative
   * Commission payable = negative
   *
   * It settles the employee liability.
   */

  var movementId =
    generateCommissionMovementId();


  var ledger =
    getMAIRIXCommissionSheet(
      MAIRIX_COMMISSION.SHEETS.COMMISSION_LEDGER
    );


  var headers =
    getCommissionHeaders(
      ledger
    );


  var row =
    new Array(
      headers.length
    ).fill("");


  setCommissionHeaderValue(
    row,
    headers,
    "Commission Movement ID",
    movementId
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Movement Date",
    data.date || new Date()
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Movement Type",
    MAIRIX_COMMISSION.MOVEMENT_TYPES.PAYMENT
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Employee User ID",
    employeeUserId
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Employee Name",
    employee.name
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Source Reference",
    paymentReference
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Source Type",
    "COMMISSION_PAYMENT"
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Sale Reference",
    ""
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Customer Reference",
    ""
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Warehouse Reference",
    "");


  setCommissionHeaderValue(
    row,
    headers,
    "Commission Rate",
    0
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Commission Basis",
    "SETTLEMENT"
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Commission Amount",
    0
  );


  /*
   * Cash decreases.
   */

  setCommissionHeaderValue(
    row,
    headers,
    "Cash Effect",
    -amount
  );


  /*
   * Payable decreases.
   */

  setCommissionHeaderValue(
    row,
    headers,
    "Credit Effect",
    -amount
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Status",
    MAIRIX_COMMISSION.STATUS.POSTED
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Notes",
    cleanCommissionText(
      data.notes
    ) ||
      "Commission payment."
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Created At",
    new Date()
  );


  setCommissionHeaderValue(
    row,
    headers,
    "Created By",
    currentUser.email
  );


  ledger
    .getRange(
      ledger.getLastRow() + 1,
      1,
      1,
      row.length
    )
    .setValues([
      row
    ]);


  writeCommissionAudit(
    "PAY_COMMISSION",
    movementId,
    "Employee: " +
      employeeUserId +
      " | Amount: " +
      amount +
      " | Payment Reference: " +
      paymentReference
  );


  return {

    success:
      true,

    movementId:
      movementId,

    paymentReference:
      paymentReference,

    employeeUserId:
      employeeUserId,

    amount:
      amount,

    outstandingBefore:
      balance.outstanding,

    outstandingAfter:
      roundCommissionAmount(
        balance.outstanding -
        amount
      )

  };

}


/************************************************
 * COMMISSION BALANCE
 *
 * Earned
 * + Reversed
 * - Paid
 ************************************************/

function getCommissionBalance(
  employeeUserId,
  beforeDate
) {

  var ledger =
    getMAIRIXCommissionSheet(
      MAIRIX_COMMISSION.SHEETS.COMMISSION_LEDGER
    );


  var lastRow =
    ledger.getLastRow();


  if (
    lastRow < 2
  ) {

    return {

      earned:
        0,

      reversed:
        0,

      paid:
        0,

      outstanding:
        0

    };

  }


  var rows =
    getSheetDataAsObjectsForCommission(
      ledger
    );


  var earned =
    0;

  var reversed =
    0;

  var paid =
    0;


  rows.forEach(
    function(row) {

      if (
        cleanCommissionText(
          row["Employee User ID"]
        ) !==
        employeeUserId
      ) {

        return;
      }


      if (
        beforeDate &&
        new Date(
          row["Movement Date"]
        ) >
        new Date(beforeDate)
      ) {

        return;
      }


      var type =
        cleanCommissionText(
          row["Movement Type"]
        );


      var amount =
        Number(
          row["Commission Amount"] || 0
        );


      if (
        type ===
        MAIRIX_COMMISSION.MOVEMENT_TYPES.SALE
      ) {

        earned +=
          Math.max(
            amount,
            0
          );

      }


      if (
        type ===
        MAIRIX_COMMISSION.MOVEMENT_TYPES.SALE_RETURN
      ) {

        reversed +=
          Math.abs(
            Math.min(
              amount,
              0
            )
          );

      }


      if (
        type ===
        MAIRIX_COMMISSION.MOVEMENT_TYPES.PAYMENT
      ) {

        paid +=
          Math.abs(
            Number(
              row["Cash Effect"] || 0
            )
          );

      }

    }
  );


  var outstanding =
    earned -
    reversed -
    paid;


  if (
    outstanding < 0 &&
    outstanding > -0.0001
  ) {

    outstanding = 0;

  }


  return {

    earned:
      roundCommissionAmount(
        earned
      ),

    reversed:
      roundCommissionAmount(
        reversed
      ),

    paid:
      roundCommissionAmount(
        paid
      ),

    outstanding:
      roundCommissionAmount(
        Math.max(
          outstanding,
          0
        )
      )

  };

}


/************************************************
 * COMMISSION REPORT
 *
 * Returns all employees or one employee.
 ************************************************/

function getCommissionReport(
  filters
) {

  var currentUser =
    requireMAIRIXCommissionServerUser();


  filters =
    filters || {};


  var ledger =
    getMAIRIXCommissionSheet(
      MAIRIX_COMMISSION.SHEETS.COMMISSION_LEDGER
    );


  var rows =
    getSheetDataAsObjectsForCommission(
      ledger
    );


  var employeeFilter =
    cleanCommissionText(
      filters.employeeUserId
    );


  var fromDate =
    filters.fromDate
      ? new Date(filters.fromDate)
      : null;


  var toDate =
    filters.toDate
      ? new Date(filters.toDate)
      : null;


  var employeeMap =
    {};


  rows.forEach(
    function(row) {

      var userId =
        cleanCommissionText(
          row["Employee User ID"]
        );


      if (
        !userId
      ) {

        return;
      }


      if (
        employeeFilter &&
        userId !==
        employeeFilter
      ) {

        return;
      }


      var movementDate =
        new Date(
          row["Movement Date"]
        );


      if (
        fromDate &&
        movementDate <
        fromDate
      ) {

        return;
      }


      if (
        toDate &&
        movementDate >
        toDate
      ) {

        return;
      }


      if (
        !employeeMap[userId]
      ) {

        employeeMap[userId] = {

          userId:
            userId,

          employeeName:
            cleanCommissionText(
              row["Employee Name"]
            ),

          earned:
            0,

          reversed:
            0,

          paid:
            0

        };

      }


      var item =
        employeeMap[userId];


      var type =
        cleanCommissionText(
          row["Movement Type"]
        );


      var amount =
        Number(
          row["Commission Amount"] || 0
        );


      if (
        type ===
        MAIRIX_COMMISSION.MOVEMENT_TYPES.SALE
      ) {

        item.earned +=
          Math.max(
            amount,
            0
          );

      }


      if (
        type ===
        MAIRIX_COMMISSION.MOVEMENT_TYPES.SALE_RETURN
      ) {

        item.reversed +=
          Math.abs(
            Math.min(
              amount,
              0
            )
          );

      }


      if (
        type ===
        MAIRIX_COMMISSION.MOVEMENT_TYPES.PAYMENT
      ) {

        item.paid +=
          Math.abs(
            Number(
              row["Cash Effect"] || 0
            )
          );

      }

    }
  );


  var report =
    Object.keys(
      employeeMap
    ).map(
      function(userId) {

        var item =
          employeeMap[userId];


        item.netEarned =
          roundCommissionAmount(
            item.earned -
            item.reversed
          );


        item.outstanding =
          roundCommissionAmount(
            Math.max(
              item.netEarned -
              item.paid,
              0
            )
          );


        return item;

      }
    );


  return {

    success:
      true,

    generatedAt:
      new Date(),

    generatedBy:
      currentUser.email,

    filters:
      filters,

    rows:
      report,

    totals:
      calculateCommissionReportTotals(
        report
      )

  };

}


