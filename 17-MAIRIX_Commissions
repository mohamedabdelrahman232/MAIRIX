/************************************************
 * GET ACTIVE COMMISSION RULE
 ************************************************/

function getActiveCommissionRule(
  userId,
  date
) {

  var sheet =
    getMAIRIXCommissionSheet(
      MAIRIX_COMMISSION.SHEETS.COMMISSION_RULES
    );


  var rows =
    getSheetDataAsObjectsForCommission(
      sheet
    );


  var targetDate =
    date
      ? new Date(date)
      : new Date();


  var candidates =
    [];


  rows.forEach(
    function(row) {

      if (
        cleanCommissionText(
          row["User ID"]
        ) !==
        userId
      ) {

        return;
      }


      if (
        !isCommissionTrue(
          row["Active"]
        )
      ) {

        return;
      }


      var from =
        row["Effective From"]
          ? new Date(
              row["Effective From"]
            )
          : null;


      var to =
        row["Effective To"]
          ? new Date(
              row["Effective To"]
            )
          : null;


      if (
        from &&
        targetDate < from
      ) {

        return;
      }


      if (
        to &&
        targetDate > to
      ) {

        return;
      }


      candidates.push({

        ruleId:
          cleanCommissionText(
            row["Rule ID"]
          ),

        userId:
          userId,

        ruleType:
          cleanCommissionText(
            row["Rule Type"]
          ).toUpperCase(),

        rate:
          Number(
            row["Rate"] || 0
          ),

        fixedAmount:
          Number(
            row["Fixed Amount"] || 0
          ),

        basis:
          cleanCommissionText(
            row["Basis"]
          ).toUpperCase(),

        effectiveFrom:
          from,

        effectiveTo:
          to

      });

    }
  );


  /*
   * Latest effective rule wins.
   */

  candidates.sort(
    function(a, b) {

      return (
        new Date(
          b.effectiveFrom || 0
        ) -
        new Date(
          a.effectiveFrom || 0
        )
      );

    }
  );


  return candidates.length
    ? candidates[0]
    : null;

}


/************************************************
