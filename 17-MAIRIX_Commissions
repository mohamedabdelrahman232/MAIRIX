/************************************************
 * GENERATE RULE ID
 ************************************************/

function generateCommissionRuleId() {

  var dateKey =
    Utilities.formatDate(
      new Date(),
      Session.getScriptTimeZone(),
      "yyyyMMdd"
    );


  var sheet =
    getMAIRIXCommissionSheet(
      MAIRIX_COMMISSION.SHEETS.COMMISSION_RULES
    );


  var prefix =
    "CMR-" +
    dateKey +
    "-";


  var counter =
    1;


  var lastRow =
    sheet.getLastRow();


  if (
    lastRow >= 2
  ) {

    var ids =
      sheet
        .getRange(
          2,
          1,
          lastRow - 1,
          1
        )
        .getDisplayValues();


    ids.forEach(
      function(row) {

        var value =
          cleanCommissionText(
            row[0]
          );


        if (
          value.indexOf(prefix) !== 0
        ) {

          return;
        }


        var number =
          parseInt(
            value.substring(
              prefix.length
            ),
            10
          );


        if (
          !isNaN(number) &&
          number >= counter
        ) {

          counter =
            number + 1;

        }

      }
    );

  }


  return (
    prefix +
    String(counter)
      .padStart(
        4,
        "0"
      )
  );

}


/************************************************
