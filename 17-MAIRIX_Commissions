    );

  }

}


/************************************************
 * VALIDATION HELPERS
 ************************************************/

function requireCommissionValue(
  value,
  label
) {

  var normalized =
    cleanCommissionText(
      value
    );


  if (!normalized) {

    throw new Error(
      label +
      " is required."
    );

  }


  return normalized;

}


function cleanCommissionText(
  value
) {

  if (
    value === null ||
    value === undefined
  ) {

    return "";

  }


  return String(
    value
  ).trim();

}


function isCommissionTrue(
  value
) {

  if (
    value === true
  ) {

    return true;

  }


  var normalized =
    cleanCommissionText(
      value
    ).toUpperCase();


  return (
    normalized === "TRUE" ||
    normalized === "YES" ||
    normalized === "1"
  );

}


function roundCommissionAmount(
  value
) {

  return Math.round(
    Number(value || 0) *
    100
  ) / 100;

}


