    throw new Error(
      "Required MAIRIX sheet not found: " +
      sheetName
    );

  }


  return sheet;

}


/************************************************
 * HEADER HELPERS
 ************************************************/

function getCommissionHeaders(
  sheet
) {

  return sheet
    .getRange(
      1,
      1,
      1,
      sheet.getLastColumn()
    )
    .getDisplayValues()[0];

}


function setCommissionHeaderValue(
  row,
  headers,
  header,
  value
) {

  var index =
    headers.indexOf(
      header
    );


  if (
    index === -1
  ) {

    throw new Error(
      'Missing commission header: "' +
      header +
      '"'
    );

  }


  row[index] =
    value;

}


/************************************************
 * COLUMN NUMBER
 ************************************************/

function getCommissionColumnNumber(
  sheet,
  header
) {

  var headers =
    getCommissionHeaders(
      sheet
    );


  var index =
    headers.indexOf(
      header
    );


  if (
    index === -1
  ) {

    throw new Error(
      'Header not found: "' +
      header +
      '"'
    );

  }


  return index + 1;

}


/************************************************
 * FIND ROW
 ************************************************/

function findCommissionRow(
  sheet,
  header,
  value
) {

  var column =
    getCommissionColumnNumber(
      sheet,
      header
    );


  var lastRow =
    sheet.getLastRow();


  if (
    lastRow < 2
  ) {

    return -1;

  }


  var values =
    sheet
      .getRange(
        2,
        column,
        lastRow - 1,
        1
      )
      .getDisplayValues();


  var normalized =
    cleanCommissionText(
      value
    );


  for (
    var i = 0;
    i < values.length;
    i++
  ) {

    if (
      cleanCommissionText(
        values[i][0]
      ) ===
      normalized
    ) {

      return i + 2;

    }

  }


  return -1;

}


/************************************************
 * SHEET -> OBJECTS
 ************************************************/

function getSheetDataAsObjectsForCommission(
  sheet
) {

  var lastRow =
    sheet.getLastRow();


  var lastColumn =
    sheet.getLastColumn();


  if (
    lastRow < 2 ||
    lastColumn < 1
  ) {

    return [];

  }


  var headers =
    sheet
      .getRange(
        1,
        1,
        1,
        lastColumn
      )
      .getDisplayValues()[0];


  var values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        lastColumn
      )
      .getValues();


  return values.map(
    function(row) {

      var object = {};


      headers.forEach(
        function(header, index) {

          object[
            cleanCommissionText(
              header
            )
          ] =
            row[index];

        }
      );


      return object;

    }
  );

}


/************************************************
 * ENSURE HEADERS
 ************************************************/

function ensureSheetHeaders(
  sheet,
  headers
) {

  if (
    sheet.getLastRow() === 0
  ) {

    sheet
      .getRange(
        1,
        1,
        1,
        headers.length
      )
      .setValues([
        headers
      ]);

    return;

  }


  var existing =
    sheet
      .getRange(
        1,
        1,
        1,
        Math.max(
          sheet.getLastColumn(),
          headers.length
        )
      )
      .getDisplayValues()[0];


  var missing = [];


  headers.forEach(
    function(header) {

      if (
        existing.indexOf(
          header
        ) === -1
      ) {

        missing.push(
          header
        );

      }

    }
  );


  if (
    missing.length
  ) {

    throw new Error(
      "MAIRIX sheet headers are incompatible. " +
      "Missing: " +
      missing.join(", ")
    );

  }

}


/************************************************
 * FORMAT
 ************************************************/

function formatCommissionSheets() {

  var ss =
    SpreadsheetApp
      .getActiveSpreadsheet();


  [
    MAIRIX_COMMISSION.SHEETS.COMMISSION_RULES,
    MAIRIX_COMMISSION.SHEETS.COMMISSION_LEDGER
  ].forEach(
    function(name) {

      var sheet =
        ss.getSheetByName(
          name
        );


      if (!sheet) {
        return;
      }


      sheet.setFrozenRows(1);


      var lastColumn =
        sheet.getLastColumn();


      if (
        lastColumn > 0
      ) {

        sheet
          .getRange(
            1,
            1,
            1,
            lastColumn
          )
          .setFontWeight(
            "bold"
          );


        sheet.autoResizeColumns(
          1,
          lastColumn
        );

      }

    }
  );

}


/************************************************
 * AUDIT
 ************************************************/

function writeCommissionAudit(
  action,
  reference,
  details
) {

  try {

    if (
      typeof logAction ===
      "function"
    ) {

      logAction(
        action,
        reference,
        details
      );

      return;

    }


    Logger.log(
      "[MAIRIX COMMISSION] " +
      action +
      " | " +
      reference +
      " | " +
      details
    );

  } catch (error) {

    Logger.log(
