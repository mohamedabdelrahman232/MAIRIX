/************************************************
 * CALCULATE BASIS
 ************************************************/

function getCommissionBasisValue(
  basis,
  saleData
) {

  if (
    basis === "NET_SALE"
  ) {

    return Number(
      saleData.netTotal ||
      saleData.netAmount ||
      0
    );

  }


  if (
    basis === "GROSS_SALE"
  ) {

    return Number(
      saleData.grossTotal ||
      saleData.grossAmount ||
      0
    );

  }


  if (
    basis === "ITEM_QUANTITY"
  ) {

    return Number(
      saleData.quantity ||
      saleData.totalQuantity ||
      0
    );

  }


  throw new Error(
    "Unsupported commission basis: " +
    basis
  );

}


/************************************************
 * RETURN COMMISSION CALCULATION
 ************************************************/

function calculateReturnCommissionAmount(
  originalAmount,
  returnData
) {

  var returnQuantity =
    Number(
      returnData.quantity ||
      returnData.returnQuantity ||
      0
    );


  var originalQuantity =
    Number(
      returnData.originalQuantity ||
      0
    );


  /*
   * If quantities are supplied,
   * reverse proportionally.
   */

  if (
    returnQuantity > 0 &&
    originalQuantity > 0
  ) {

    var ratio =
      returnQuantity /
      originalQuantity;


    ratio =
      Math.min(
        Math.max(
          ratio,
          0
        ),
        1
      );


    return roundCommissionAmount(
      originalAmount *
      ratio
    );

  }


  /*
   * Full return.
   */

  return roundCommissionAmount(
    originalAmount
  );

}


/************************************************
 * REPORT TOTALS
 ************************************************/

function calculateCommissionReportTotals(
  rows
) {

  var totals = {

    earned:
      0,

    reversed:
      0,

    paid:
      0,

    netEarned:
      0,

    outstanding:
      0

  };


  rows.forEach(
    function(row) {

      totals.earned +=
        Number(
          row.earned || 0
        );


      totals.reversed +=
        Number(
          row.reversed || 0
        );


      totals.paid +=
        Number(
          row.paid || 0
        );


      totals.netEarned +=
        Number(
          row.netEarned || 0
        );


      totals.outstanding +=
        Number(
          row.outstanding || 0
        );

    }
  );


  Object.keys(
    totals
  ).forEach(
    function(key) {

      totals[key] =
        roundCommissionAmount(
          totals[key]
        );

    }
  );


  return totals;

}


